    <customDetailFormulas>
        <calculatedFormula>IF(AND(AQB__Batch_Item__c.AQB__Signator__c.Account.Name!=AQB__Batch_Item__c.AQB__Account__c.Name__lookup, AQB__Batch_Item__c.AQB__Account__c.AQB__RecordTypeDeveloperName__c = &apos;Household&apos;),
