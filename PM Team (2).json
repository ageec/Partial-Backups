        "FORMULA12": {
            "action": "formula",
            "parameters": {
                "expressionType": "SQL",
                "fields": [
                    {
                        "defaultValue": "",
                        "formulaExpression": "case\r\nwhen Division = 'Arts & Sciences' then 'A&S'\r\nwhen Division = 'Brown School' then 'Brown'\r\nwhen Division = 'McKelvey Engineering' then 'McKelvey'\r\nwhen Division = 'Olin Business School' then 'Olin'\r\nwhen Division = 'Parent and Student Initiatives' then 'Parent & Student Initiatives'\r\nwhen Division = 'Public Health' then 'Public Health'\r\nwhen Division = 'Sam Fox School' then 'Sam Fox'\r\nwhen Division = 'School of Continuing & Professional Studies' then 'CAPS'\r\nwhen Division = 'School of Law' then 'Law'\r\nwhen Division in ('WashU Priorities', 'Danforth and University Initiatives') then 'Danforth & University Initiatives'\r\nend",
                        "label": "Gift Officer Divsion",
                        "name": "GiftOfficerDivision",
                        "precision": 255,
                        "type": "TEXT"
                    }
                ]
            },
            "sources": [
