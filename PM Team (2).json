            "parameters": {
                "expressionType": "SQL",
                "fields": [
                    {
                        "defaultValue": "",
                        "formulaExpression": "case \r\n\twhen RMTMemberRoleActive = 'Relationship Manager' and char_length(RMTMemberNameActive) > 0\r\n\tthen concat(\"RMTMemberNameActive\",'-','Primary Portfolio','/',\"RMTMemberNameActive\",'-','Total Portfolio')\r\n    when RMTMemberRoleActive = 'Proxy Officer' and char_length(RMTMemberNameActive) > 0 \r\n    then concat(\"RMTMemberNameActive\",'-','Primary Portfolio','/',\"RMTMemberNameActive\",'-','Total Portfolio')\r\n    when RMTMemberRoleActive = 'Annual Giving Officer' and char_length(RMTMemberNameActive) > 0\r\n    then concat(\"RMTMemberNameActive\",'-','Primary Portfolio','/',\"RMTMemberNameActive\",'-','Total Portfolio')\r\n    when RMTMemberRoleActive = 'Qualifying Gift Officer' and char_length(RMTMemberNameActive) > 0\r\n    then concat(\"RMTMemberNameActive\",'-','Qualification Portfolio','/',\"RMTMemberNameActive\",'-','Total Portfolio')\r\n    when RMTMemberRoleActive = 'Annual Giving Pipeline Officer' and char_length(RMTMemberNameActive) > 0\r\n    then concat(\"RMTMemberNameActive\",'-','Qualification Portfolio','/',\"RMTMemberNameActive\",'-','Total Portfolio')\r\n    when char_length(RMTMemberRoleActive) > 0 and RMTMemberRoleActive not in ('Relationship Manager', 'Proxy Officer', 'Annual Giving Officer', 'Qualifying Gift Officer', 'Annual Giving Pipeline Officer') and char_length(RMTMemberNameActive) > 0\r\n    then concat(\"RMTMemberNameActive\",'-','Total Portfolio')\r\n\telse ''\r\nend",
                        "label": "RMT Member Name + Role Group Active",
                        "name": "RMT_Member_Name_Role_GroupActive",
                        "precision": 255,
                        "type": "TEXT"
                    }
                ]
            },
            "sources": [
                "FORMULA7"
            ]
        },
        "FORMULA9": {
