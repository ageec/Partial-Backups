                        "defaultValue": "",
                        "formulaExpression": "case\r\n    when AQB__Active__c = 'true' and AQB__Role__c not in ('Relationship Manager', 'Proxy Officer', 'Annual Giving Officer', 'Qualifying Gift Officer', 'Annual Giving Pipeline Officer') then row_number()\r\n    else 0\r\n    end",
                        "label": "Secondary Role Same Type Row Number",
                        "name": "Secondary_Role_Same_Type_Row_Number",
                        "precision": 10,
                        "scale": 0,
                        "type": "NUMBER"
