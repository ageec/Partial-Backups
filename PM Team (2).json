        "FORMULA0": {
            "action": "formula",
            "parameters": {
                "expressionType": "SQL",
                "fields": [
                    {
                        "defaultValue": "",
                        "formulaExpression": "case \r\n\twhen AQB__Role__c = 'Relationship Manager'\r\n\tthen concat(\"User.Name\",'-','Primary Portfolio','/',\"User.Name\",'-','Total Portfolio')\r\n    when AQB__Role__c = 'Proxy Officer'\r\n    then concat(\"User.Name\",'-','Primary Portfolio','/',\"User.Name\",'-','Total Portfolio')\r\n    when AQB__Role__c = 'Annual Giving Officer'\r\n    then concat(\"User.Name\",'-','Primary Portfolio','/',\"User.Name\",'-','Total Portfolio')\r\n    when AQB__Role__c = 'Qualifying Gift Officer'\r\n    then concat(\"User.Name\",'-','Qualification Portfolio','/',\"User.Name\",'-','Total Portfolio')\r\n    when AQB__Role__c = 'Annual Giving Pipeline Officer'\r\n    then concat(\"User.Name\",'-','Qualification Portfolio','/',\"User.Name\",'-','Total Portfolio')\r\n\telse\r\n\tconcat(\"User.Name\",'-','Total Portfolio')\r\nend",
                        "label": "RMT Role Group",
                        "name": "RMTRoleGroup",
                        "precision": 255,
                        "type": "TEXT"
                    }
                ]
            },
            "sources": [
                "JOIN1"
            ]
        },
        "FORMULA1": {
            "action": "formula",
            "parameters": {
                "expressionType": "SQL",
                "fields": [
                    {
                        "formulaExpression": "split(RMTRoleGroup,'/')",
                        "label": "RMT Member Name + Role Group 2 Multivalue",
                        "name": "RMT_Member_Name_Role_Group2_Multivalue",
                        "type": "MULTIVALUE"
                    }
                ]
            },
            "sources": [
