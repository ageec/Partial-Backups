        },
        "FORMULA15": {
            "action": "formula",
            "parameters": {
                "expressionType": "SQL",
                "fields": [
                    {
                        "defaultValue": "",
                        "formulaExpression": "case\r\nwhen \"Division\" = 'Danforth Corporate Relations' then 'Corporate Rel'\r\nwhen \"Division\" = 'Danforth Foundation Relations' then 'Foundation Rel'\r\nwhen \"Division\" = 'International Advancement' then 'International'\r\nwhen \"Division\" = 'Planned Giving' then 'PG'\r\nwhen \"Division\" = 'Individual Giving' AND \"ARCH_UA_Territory__c\" = 'Central' then 'IG Central'\r\nwhen \"Division\" = 'Individual Giving' AND \"ARCH_UA_Territory__c\" = 'East' then 'IG East'\r\nwhen \"Division\" = 'Individual Giving' AND \"ARCH_UA_Territory__c\" = 'Missouri' then 'IG Missouri'\r\nwhen \"Division\" = 'Individual Giving' AND \"ARCH_UA_Territory__c\" = 'West' then 'IG West'\r\nwhen \"Division\" = 'Alumni & Programs' then 'Med Alumni'\r\nwhen \"Division\" = 'Patients & Friends (Med/Surg)' then 'Med/Surg'\r\nwhen \"Division\" = 'Patients & Friends (Neuro)' then 'Neuro'\r\nwhen \"Division\" = 'Medical Corporate and Foundation Relations' then 'Med CFR'\r\nwhen \"Division\" = 'Siteman' then 'Siteman'\r\nwhen \"Division\" = 'VC Office' then 'Med UA VC Office'\r\nwhen Division = 'Individual Giving VC' then 'Dev Vertical'\r\nend",
                        "label": "Gift Officer Team",
                        "name": "GiftOfficerTeam",
                        "precision": 255,
                        "type": "TEXT"
                    }
                ]
            },
            "sources": [
                "FORMULA12"
            ]
        },
