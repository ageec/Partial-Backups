l_Info\";\nq1 = filter q1 by 'StageName' in [\"Closed - Funded No Value\", \"Closed Won\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\", \"Closed - NPR Funded\", \"LOI/Concept Paper Submittal\", \"Negotiation/Review\", \"Proposal Preparation\", \"Proposal Submittal\", \"Solicitation\", \"Solicitation (PG)\"];\nq1 = filter q1 by date('AQC_Date_Asked__c_Year', 'AQC_Date_Asked__c_Month', 'AQC_Date_Asked__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by ('OppRecordType.Name' != \"Grateful Patients\" || 'OppRecordType.Name' is null);\n--q2 = filter q2 by 'GiftOfficerTeam' in [\"Med Alumni\", \"Med/Surg\", \"Neuro\", \"Med CFR\", \"Siteman\", \"Momentum/EVC/VC\", \"Other UA\"];\nq2 = filter q2 by date('AQB__LastGoalIntervalDate__c_Year', 'AQB__LastGoalIntervalDate__c_Month', 'AQB__LastGoalIntervalDate__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq3 = filter q2 by 'AQB__Classification__c' == \"Number of Opportunities Solicited\";\nq2 = filter q2 by 'AQB__Classification__c' == \"Opportunity Amount Solicited\";\nq = cogroup q1 by ('OpportunityTeamMember.GiftOfficerTeam', 'OpportunityTeamMember.Name') full, q2 by ('GiftOfficerTeam', 'User.Name') full, q3 by ('GiftOfficerTeam', 'User.Name');\nq = foreach q generate coalesce(q1.'OpportunityTeamMember.GiftOfficerTeam', q2.'GiftOfficerTeam', q3.'GiftOfficerTeam') as 'OpportunityTeamMember.GiftOfficerTeam', coalesce(q1.'OpportunityTeamMember.Name', q2.'User.Name', q3.'User.Name') as 'OpportunityTeamMember.Name', sum(q1.'AQC_Ask_Amount__c') as 'A', sum(q2.'AQB__GoalCurrencyAmount__c') as 'B', count(q1) as 'C', sum(q3.'AQB__GoalCount__c') as 'D';\nq = foreach q generate 'OpportunityTeamMember.GiftOfficerTeam', 'OpportunityTeamMember.Name', 'A' as '$ - Solicited Amount', 'B' as '$ - Goal', coalesce(A,0)/B as '$ - % to Goal', 'C' as '# - Solicited Count', 'D' as '# - Goal', coalesce(C,0)/D as '# - % to Goal';\nq = group q by rollup('OpportunityTeamMember.GiftOfficerTeam', 'OpportunityTeamMember.Name');\nq = foreach q generate q.'OpportunityTeamMember.GiftOfficerTeam' as 'OpportunityTeamMember.GiftOfficerTeam', q.'OpportunityTeamMember.Name' as 'OpportunityTeamMember.Name', sum(q.'$ - Solicited Amount') as '$ - Solicited Amount', sum(q.'$ - Goal') as '$ - Goal', sum(q.'$ - Solicited Amount') / sum(q.'$ - Goal') as '$ - % to Goal', sum('# - Solicited Count') as '# - Solicited Count', sum(q.'# - Goal') as '# - Goal', sum(q.'# - Solicited Count') / sum(q.'# - Goal') as '# - % to Goal', grouping(q.'OpportunityTeamMember.GiftOfficerTeam') as 'grouping_OpportunityTeamMember.GiftOfficerTeam', grouping(q.'OpportunityTeamMember.Name') as 'grouping_OpportunityTeamMember.Name';\ns = filter q by 'grouping_OpportunityTeamMember.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_OpportunityTeamMember.GiftOfficerTeam' == 0 and 'grouping_OpportunityTeamMember.Name' == 0;\nq = order q by ('OpportunityTeamMember.GiftOfficerTeam' asc, 'OpportunityTeamMember.Name' asc);\nq = limit q 10000;\nq = union q, s;\nq = limit q 10001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Med_GO___Solicited_b_2":{"broadcastFacet":false,"datasets":[{"name":"OpportunityDetail"}],"isGlobal":false,"label":"Med GO $ Solicited by 