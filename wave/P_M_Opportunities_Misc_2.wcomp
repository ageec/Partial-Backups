oseDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq1 = group q1 by ('Opportunity.Id','Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.CloseDate', 'Account.Id');\nq1 = foreach q1 generate 'Opportunity.Id','Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.CloseDate', 'Account.Id', row_number() over([..] partition by 'Account.Id' order by 'Opportunity.CloseDate') as AccountRowNumber, sum('Opportunity.Amount') as 'Opportunity.Amount';\nq1 = filter q1 by AccountRowNumber == 1;\n\nq = group q1 by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical');\nq = foreach q generate q1.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q1.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', sum(q1.'Opportunity.Amount') as 'A',  count(q1) as 'C';\nq = foreach q generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'A' as '$ - Closed/Won Amount', 'C' as '# - Donor Count';\n\nq = group q by rollup('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical');\nq = foreach q generate q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam',  q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', sum(q.'$ - Closed/Won Amount') as '$ - Closed/Won Amount', sum('# - Donor Count') as '# - Donor Count', grouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name', grouping(q.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical';\ns = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0 and 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 0;\nq = order q by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' asc, 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"GO___Solicited_by_OT_2":{"broadcastFacet":false,"datasets":[{"name":"OpportunityDetail"}],"isGlobal":false,"label":"GO $ Solicited by OTM Detail Table","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":["Name"],"limit":2000,"orders":[{"name":"Name","filters":[