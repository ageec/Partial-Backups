evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Territories___Solici_1":{"broadcastFacet":false,"groups":[],"label":"Territories $ Solicited Summary Table","numbers":[],"query":"q1 = load \"Opportunity_Info\";\nq2 = load \"Territory_Goals\";\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"[[parameter_1]]\";\nq3 = filter q2 by 'Goal' == \"Total # of Opps Solicited\";\nq2 = filter q2 by 'Goal' == \"Total $ of Opps Solicited\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed - Funded No Value\", \"Closed Won\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\", \"Negotiation/Review\", \"Proposal Submittal\", \"Solicitation\", \"Solicitation (PG)\"];\nq1 = filter q1 by date('Opportunity.AQC_Date_Asked__c_Year', 'Opportunity.AQC_Date_Asked__c_Month', 'Opportunity.AQC_Date_Asked__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq = cogroup q1 by ('Opportunity.ARCH_Territory__c', 'Opportunity.TerritorySort') full, q2 by ('Territory', 'Territory_Sort') full, q3 by ('Territory', 'Territory_Sort');\nq = foreach q generate coalesce(q1.'Opportunity.ARCH_Territory__c', q2.'Territory', q3.'Territory') as 'Opportunity.ARCH_Territory__c', coalesce(q1.'Opportunity.TerritorySort', q2.'Territory_Sort', q3.'Territory_Sort') as 'Opportunity.TerritorySort', sum(q1.'Opportunity.AQC_Ask_Amount__c') as 'A', sum(q2.'Amount') as 'B', count(q1) as 'C', sum(q3.'Amount') as 'D';\nq = foreach q generate 'Opportunity.ARCH_Territory__c', 'Opportunity.TerritorySort', 'A' as '$ - Solicited Amount', 'B' as '$ - Goal', coalesce(A,0)/B as '$ - % to Goal', 'C' as '# - Solicited Count', 'D' as '# - Goal', coalesce(C,0)/D as '# - % to Goal';\nq = group q by rollup('Opportunity.ARCH_Territory__c', 'Opportunity.TerritorySort');\nq = foreach q generate q.'Opportunity.ARCH_Territory__c' as 'Opportunity.ARCH_Territory__c', q.'Opportunity.TerritorySort' as 'Opportunity.TerritorySort', sum(q.'$ - Solicited Amount') as '$ - Solicited Amount', sum(q.'$ - Goal') as '$ - Goal', sum(q.'$ - Solicited Amount') / sum(q.'$ - Goal') as '$ - % to Goal', sum(q.'# - Solicited Count') as '# - Solicited Count', sum(q.'# - Goal') as '# - Goal', sum(q.'# - Solicited Count') / sum(q.'# - Goal') as '# - % to Goal', grouping(q.'Opportunity.ARCH_Territory__c') as 'grouping_Opportunity.ARCH_Territory__c', grouping(q.'Opportunity.TerritorySort') as 'grouping_Opportunity.TerritorySort';\ns = filter q by 'grouping_Opportunity.ARCH_Territory__c' == 1;\nq = filter q by 'grouping_Opportunity.ARCH_Territory__c' == 0 and 'grouping_Opportunity.TerritorySort' == 0;\nq = order q by 'Opportunity.TerritorySort' asc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadd