{"dataSourceLinksInfo":{"enableAutomaticLinking":true,"excludeRelationships":[],"links":[]},"filters":[],"gridLayouts":[{"name":"Default","numColumns":50,"pages":[{"label":"PrG $ Prg Solicited Summary","name":"2a973097-853e-4166-867c-d8c5f4b9ec1f","navigationHidden":false,"widgets":[{"colspan":29,"column":0,"name":"link_2","row":0,"rowspan":3,"widgetStyle":{"borderEdges":[]}},{"colspan":50,"column":0,"name":"table_1","row":3,"rowspan":30,"widgetStyle":{"borderEdges":[]}}]},{"label":"PrG $ Prg Solicited Detail","name":"9021f32a-8bce-45ee-84e8-69d38c27e765","navigationHidden":false,"widgets":[{"colspan":29,"column":0,"name":"link_3","row":0,"rowspan":3,"widgetStyle":{"borderEdges":[]}},{"colspan":50,"column":0,"name":"table_2","row":3,"rowspan":30,"widgetStyle":{"borderEdges":[]}}]},{"label":"PSO Opportunity Dean Summary Table","name":"47fc0fd4-2db8-4ff1-8f1c-66ac1f2b55ea","navigationHidden":false,"widgets":[{"colspan":50,"column":0,"name":"table_3","row":3,"rowspan":30,"widgetStyle":{"borderEdges":[]}},{"colspan":50,"column":0,"name":"link_1","row":0,"rowspan":3,"widgetStyle":{"borderEdges":[]}}]},{"label":"PSO Opportunity Dean Detail Table","name":"f94e325b-a36c-48c3-97a4-e66cf91edc64","navigationHidden":false,"widgets":[{"colspan":50,"column":0,"name":"table_4","row":3,"rowspan":30,"widgetStyle":{"borderEdges":[]}},{"colspan":50,"column":0,"name":"link_4","row":0,"rowspan":3,"widgetStyle":{"borderEdges":[]}}]},{"label":"PrG WHDLS New Members Summary","name":"6022cb93-04c5-4352-a25e-095c14d2c42e","navigationHidden":false,"widgets":[{"colspan":29,"column":0,"name":"link_5","row":0,"rowspan":3,"widgetStyle":{"borderEdges":[]}},{"colspan":50,"column":0,"name":"table_5","row":3,"rowspan":30,"widgetStyle":{"borderEdges":[]}}]},{"label":"PrG WHDLS New Members Detail","name":"ac447e61-3227-492a-83f7-64e99fa4db73","navigationHidden":false,"widgets":[{"colspan":29,"column":0,"name":"link_6","row":0,"rowspan":3,"widgetStyle":{"borderEdges":[]}},{"colspan":50,"column":0,"name":"table_7","row":3,"rowspan":30,"widgetStyle":{"borderEdges":[]}}]}],"rowHeight":"fine","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#F2F6FA","cellSpacingX":0,"cellSpacingY":0,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"parameters":[{"defaultValue":"0","description":"","label":"Fiscal Years Passed","name":"parameter_1"}],"steps":{"PSO_Opportunity_Deta_1":{"broadcastFacet":true,"groups":[],"label":"PSO Opportunity Detail Summary Table","numbers":[],"query":"q1 = load \"OpportunityDetail\";\nq2 = load \"P_M_Dean_Metrics\";\nq1 = filter q1 by 'StageName' in [\"Closed - Funded No Value\", \"Closed Won\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\", \"Negotiation/Review\", \"Proposal Submittal\", \"Solicitation\", \"Solicitation (PG)\"];\nq1 = filter q1 by 'OpportunityTeamMember.GiftOfficerDivision' is not null;\nq1 = filter q1 by ('OppRecordType.Name' != \"Grateful Patients\" || 'OppRecordType.Name' is null);\nq1 = filter q1 by 'DateAskedFiscalYearsPassed' == \"[[parameter_1]]\";\nq1 = filter q1 by 'OpportunityTeamMember.Name' matches \"Dean\";\nq1 = filter q1 by 'OppComp2.ARCH_Designation_Category_1__c' == \"Scholarships\";\nq1 = filter q1 by 'OpportunityTeamMember.GiftOfficerDivision' in [\"A&S\", \"Brown\", \"CAPS\", \"Law\", \"McKelvey\", \"Olin\", \"Sam Fox\"];\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"[[parameter_1]]\";\nq2 = filter q2 by 'Goal' == \"CFU Scholarships\";\nq2 = filter q2 by 'Gift_Officer_Division' in [\"A&S\", \"Brown\", \"CAPS\", \"Law\", \"McKelvey\", \"Olin\", \"Sam Fox\"];\nq = cogroup q1 by 'OpportunityTeamMember.GiftOfficerDivision' full, q2 by 'Gift_Officer_Division';\nq = foreach q generate coalesce(q1.'OpportunityTeamMember.GiftOfficerDivision', q2.'Gift_Officer_Division') as 'OpportunityTeamMember.GiftOfficerDivision', count(q1) as 'A', sum(q2.'Amount') as 'B';\nq = foreach q generate 'OpportunityTeamMember.GiftOfficerDivision', 'A', 'B', A/B as 'C';\nq = group q by rollup('OpportunityTeamMember.GiftOfficerDivision');\nq = foreach q generate q.'OpportunityTeamMember.GiftOfficerDivision' as 'OpportunityTeamMember.GiftOfficerDivision', sum(q.'A') as '# Opp Scholarships', sum(q.'B') as '# Opp Scholarships Goal', sum(q.'A')/sum(q.'B') as '% to Goal', grouping(q.'OpportunityTeamMember.GiftOfficerDivision') as 'grouping_OpportunityTeamMember.GiftOfficerDivision';\ns = filter q by 'grouping_OpportunityTeamMember.GiftOfficerDivision' == 1;\nq = filter q by 'grouping_OpportunityTeamMember.GiftOfficerDivision' == 0 and '# Opp Scholarships Goal' >0;\nq = order q by 'OpportunityTeamMember.GiftOfficerDivision' asc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{"# Opp Scholarships":{"tooltip":{"mode":"custom","text":"Solicited opportunities with a Dean as an opportunity team member"}},"# Opp Scholarships Goal":{"tooltip":{"mode":"custom","text":"Solicited opportunities with a Dean as an opportunity team member"}},"% to Goal":{"tooltip":{"mode":"custom","text":"Solicited opportunities with a Dean as an opportunity team member"}},"OpportunityTeamMember.GiftOfficerDivision":{"tooltip":{"mode":"custom","text":"Solicited opportunities with a Dean as an opportunity team member"}}},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"