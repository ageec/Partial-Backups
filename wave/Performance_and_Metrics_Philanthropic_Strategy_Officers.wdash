l year toggle\nq = load \"Activity_Report_Info\";\nq = filter q by 'AQB__Purpose__c' == \"Stewardship\" and 'AQB__ReportStatus__c' == \"Final\" and ('Account.Account.PrimaryContact.ARCH_CFY_Recognition_Credit__c' > 0 or 'Account.Account.PrimaryContact.ARCH_PFY_Recognition_Credit__c' > 0);\nq = group q by (Id, 'Account.Account.Id', AQB__Date__c, ARFiscalYearsPassed);\nq = foreach q generate Id as Id, 'Account.Account.Id' as 'Account.Account.Id', ARFiscalYearsPassed, AQB__Date__c;\n q = filter q by string_to_number(ARFiscalYearsPassed) == {{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}};   \n\n--get account row number per activity report\nq1 = group q by (Id, 'Account.Account.Id', AQB__Date__c, ARFiscalYearsPassed);\nq1 = foreach q1 generate Id as Id, 'Account.Account.Id' as 'Account.Account.Id', ARFiscalYearsPassed, AQB__Date__c,\n    row_number() over ([..] partition by 'Account.Account.Id' order by AQB__Date__c) as AccountRowNumberByARDate;\n\n--count unique accounts\nq2 = filter q1 by AccountRowNumberByARDate == 1;\nq2 = group q2 by all;\nq2 = foreach q2 generate count(q2) as 'A', 0 as 'B', 0 as 'C';\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_1":{"broadcastFacet":true,"datase