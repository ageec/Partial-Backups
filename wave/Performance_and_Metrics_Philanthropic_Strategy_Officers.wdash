":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Fiscal_Year_1":{"broadcastFacet":true,"datasets":[{"name":"FiscalYearSettings"}],"isGlobal":false,"label":"Fiscal Year","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[{"name":"Display","filters":[],"ascending":false},{"name":"Fiscal_Years_Passed","filters":[],"ascending":true},{"name":"Fiscal_Year","filters":[],"ascending":true},{"name":"PFY_Passed","filters":[],"ascending":true},{"name":"Eliot_Status","filters":[],"ascending":true},{"name":"Recognition_Credit","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{"FiscalYearSettings":{"filters":[["StartDate",[["fiscal_year",-1],["day",0]],"between"]]}},"sources":[{"columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["Display","Fiscal_Years_Passed","Fiscal_Year","PFY_Passed","Eliot_Status","Recognition_Credit"],"joins":[],"name":"FiscalYearSettings"}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"singlerequired","sortable":true,"start":"[[\"2026\",\"0\",\"current fiscal_year\",\"1\",\"CFY_Eliot_Status\",\"Contact.ARCH_CFY_Recognition_Credit__c\"]]","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","Display","Fiscal_Years_Passed","Fiscal_Year","PFY_Passed","Eliot_Status","Recognition_Credit"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Grad_Scholarships_Su_1":{"broadcastFacet":true,"groups":[],"label":"Grad Scholarships Summary Table","numbers":[],"query":"q1 = load \"GiftAndPledgeTransactionsExtension\";\nq2 = load \"P_M_Dean_Metrics\";\nq1 = filter q1 by 'Contact.Position' == 1;\nq1 = filter q1 by 'SoftCreditTransaction.Contact.ContactRowNumber' <= 1;\nq1 = filter q1 by 'SoftCreditTransaction.SoftCreditRowNumber' <= 1;\nq1 = filter q1 by 'SchoolUnitToggle' in [\"A&S\", \"Brown\", \"CAPS\", \"Law\", \"McKelvey\", \"Olin\", \"Sam Fox\"];\nq1 = filter q1 by 'COA.AQC_Primary_Purpose__c' in [\"Fellowship - Student - Graduate\", \"Scholarship - Need or Merit - Grad\", \"Scholarship Merit Only - Grad\", \"Scholarship Need Only - Grad\"];\nq1 = filter q1 by 'NewProductionARCHCreditedFiscalYearsPassed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}\";\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}\";\nq2 = filter q2 by 'Gift_Officer_Division' in [\"A&S\", \"Brown\", \"CAPS\", \"Law\", \"McKelvey\", \"Olin\", \"Sam Fox\"];\nq2 = filter q2 by 'Goal' == \"Grad Scholarships\";\nq = cogroup q1 by 'SchoolUnitToggle' full, q2 by 'Gift_Officer_Division';\nq = foreach q generate coalesce(q1.'SchoolUnitToggle', q2.'Gift_Officer_Division') as 'School Unit', sum(q1.'NewProductionAmountWithBequests') as '$ Received', sum(q2.'Amount') as '$ Goal';\nq = group q by rollup('School Unit');\nq = foreach q generate q.'School Unit' as 'School Unit', sum(q.'$ Received') as '$ Received', sum(q.'$ Goal') as '$ Goal', sum(q.'$ Received')/sum(q.'$ Goal') as '% to Goal', grouping(q.'School Unit') as 'grouping_School Unit';\ns = filter q by 'grouping_School Unit' == 1;\nq = filter q by 'grouping_School Unit' == 0;\nq = order q by 'School Unit' asc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"PST_Officer_Toggle_1":{"broadcastFacet":true,"datasets":[{"name":"User_Info"}],"isGlobal":false,"label":"PST Officer Toggle","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[{"name":"Name","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{},"sources":[{"columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["Name"],"joins":[],"name":"User_Info"}]},"receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"multi","sortable":true,"start":"[]","type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","Name"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"min