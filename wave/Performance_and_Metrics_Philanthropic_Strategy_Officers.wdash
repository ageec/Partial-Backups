[]}}},"visualizationType":"stackvbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"split":[],"trellis":[],"dimensionAxis":["Account.GiftOfficerDivision","Account.Name"],"plots":["E"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"normalize":false,"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"__Donors_Engaged_thr_2":{"broadcastFacet":false,"groups":[],"label":"% Committee Attendance by Active Members","numbers":[],"query":"--get active volunteers and contact row number\nq = load \"Volunteer_Positions\";\nq = filter q by 'Account.Name' is not null;\nq = filter q by 'AQB__ActiveFlag__c' == \"true\";\nq = filter q by 'Account.GiftOfficerDivision' is not null;\nq = group q by ('Id', 'Contact.Id', 'Contact.Name', 'Acct.Id', 'Acct.Name', 'Account.GiftOfficerDivision', 'Account.Name', 'Account.Id', 'Contact.AccountId');\nq = foreach q generate 'Id' as 'Volunteer Position ID', 'Contact.Id', 'Contact.Name', 'Acct.Id', 'Acct.Name', 'Account.GiftOfficerDivision', 'Account.Name' as 'Affiliated Org Name', 'Account.Id' as 'Affiliated Org Account Id', 'Contact.AccountId' as 'Member Account Id',\nrow_number() over ([..] partition by 'Contact.Id' order by Id) as ContactRowNumberByVolunteerPosition;\n\n--get current fiscal year event attendance\nq1 = load \"Events\";\nq1 = filter q1 by 'Event_Guest.AQB__Attendance__c' in [\"Attended\", \"Attended: Virtually\"];\nq1 = foreach q1 generate 'Event_Guest.AQB__Contact__c', 'CFYEventNamesByContactList' as 'CFYEventNamesByContactList', 'PFYEventNamesByContactList' as 'PFYEventNamesByContactList', 'EventStartDateFiscalYearsPassed';\nq1 = filter q1 by string_to_number(EventStartDateFiscalYearsPassed) == {{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}};   \n\n--get current fiscal year event attendance group 1\nq1 = group q1 by 'Event_Guest.AQB__Contact__c';\nq1 = foreach q1 generate 'Event_Guest.AQB__Contact__c', count(q1) as 'Event Attendance Count', 1 as 'Event Attendance Flag', first('CFYEventNamesByContactList') as 'CFY Meetings Attended', first('PFYEventNamesByContactList') as 'PFY Meetings Attended', 1 as 'ContactRowNumberByVolunteerPosition';\nq1 = filter q1 by 'Event Attendance Count' > 0;\n\n--get current fiscal year event attendance group 2\nq1_a = group q1 by 'Event_Guest.AQB__Contact__c';\nq1_a = foreach q1_a generate 'Event_Guest.AQB__Contact__c', count(q1) as 'Event Attendance Count', 1 as 'Event Attendance Flag', first('CFY Meetings Attended') as 'CFY Meetings Attended', first('PFY Meetings Attended') as 'PFY Meetings Attended', 2 as 'ContactRowNumberByVolunteerPosition';\n\n--get current fiscal year event attendance group 3\nq1_b = group q1 by 'Event_Guest.AQB__Contact__c';\nq1_b = foreach q1_b generate 'Event_Guest.AQB__Contact__c', count(q1) as 'Event Attendance Count', 1 as 'Event Attendance Flag', first('CFY Meetings Attended') as 'CFY Meetings Attended', first('PFY Meetings Attended') as 'PFY Meetings Attended', 3 as 'ContactRowNumberByVolunteerPosition';\n\n--get current fiscal year event attendance group 4\nq1_c = group q1 by 'Event_Guest.AQB__Contact__c';\nq1_c = foreach q1_c generate 'Event_Guest.AQB__Contact__c', count(q1) as 'Event Attendance Count', 1 as 'Event Attendance Flag', first('CFY Meetings Attended') as 'CFY Meetings Attended', first('PFY Meetings Attended') as 'PFY Meetings Attended', 4 as 'ContactRowNumberByVolunteerPosition';\n\n--get current fiscal year event attendance group 5\nq1_d = group q1 by 'Event_Guest.AQB__Contact__c';\nq1_d = foreach q1_d generate 'Event_Guest.AQB__Contact__c', count(q1) as 'Event Attendance Count', 1 as 'Event Attendance Flag', first('CFY Meetings Attended') as 'CFY Meetings Attended', first('PFY Meetings Attended') as 'PFY Meetings Attended', 5 as 'ContactRowNumberByVolunteerPosition';\n\n--union all event attendance groups in order to not drop event guests when joining to volunteers\nq1_e = union q1, q1_a, q1_b, q1_c, q1_d;\n\n\n--join active volunteers with event attendance\nq2 = cogroup q by ('Contact.Id', 'ContactRowNumberByVolunteerPosition') left, q1_e by ('Event_Guest.AQB__Contact__c', 'ContactRowNumberByVolunteerPosition');\nq2 = foreach q2 generate coalesce(q.'Contact.Id', q1_e.'Event_Guest.AQB__Contact__c') as 'Contact.Id', coalesce(q.'ContactRowNumberByVolunteerPosition', q1_e.'ContactRowNumberByVolunteerPosition') as 'ContactRowNumberByVolunteerPosition',  first(q.'Acct.Id') as 'Acct.Id', first(q.'Acct.Name') as 'Account Name of Active Member', first(q.'Contact.Name') as 'Contact Name of Active Member', first(q.'Account.GiftOfficerDivision') as 'Account.GiftOfficerDivision', first(q.'Affiliated Org Name') as 'Affiliated Org Name', first(q.'Affiliated Org Account Id') as 'Affiliated Org Account Id', first(q.'Member Account Id') as 'Member Account Id', sum(q1_e.'Event Attendance Flag') as 'Event Attendance Flag', first(q1_e.'CFY Meetings Attended') as 'CFY Meetings Attended', first(q1_e.'PFY Meetings Attended') as 'PFY Meetings Attended';\n\n--rollup totals\nq3 = group q2 by rollup('Account.GiftOfficerDivision', 'Affiliated Org Name');\nq3 = foreach q3 generate 'Account.GiftOfficerDivision' as 'Account.GiftOfficerDivision', 'Affiliated Org Name' as 'Affiliated Org Name', \n    count(q3) as '# of total Active Members', \n    sum(q3.'Event Attendance Flag') as 'Active Members Attended', \n    (sum(q3.'Event Attendance Flag')/count(q3)) as '% of Active Members Attended',\n    grouping('Account.GiftOfficerDivision') as 'grouping_GiftOfficerDivision', \n    grouping('Affiliated Org Name') as 'grouping_AffiliatedOrgName';\n\ns = filter q3 by 'grouping_GiftOfficerDivision' == 1 and 'grouping_AffiliatedOrgName' == 1;\n--q3 = filter q3 by 'grouping_GiftOfficerDivision' == 0 and 'grouping_AffiliatedOrgName' == 0;\n\n--q3 = order q3 by ('Account.GiftOfficerDivision' asc, 'Affiliated Org Name' asc);\n--q3 = limit q3 2000;\n--q3 = union q3, s;\n--q3 = limit q3 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"__Opportunity_Solici_1":{"broadcastFacet":false,"datasets":[{"name":"OpportunityDetail"},{"name":"P_M_Dean_Metrics"}],"isGlobal":false,"label":"# Opportunity Solicited Dean Chart","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":10000,"orders":[{"name":"OpportunityTeamMember.GiftOfficerDivision","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{"OpportunityDetail":{"filters":[["StageName",["Closed - Funded No Value","Closed Won","Closed/Lost","Closed/Won","Closed/Won - No Value","Negotiation/Review","Proposal Submittal","Solicitation","Solicitation (PG)"],"in"],["OpportunityTeamMember.GiftOfficerDivision",[],"isnotnull"],["OppRecord