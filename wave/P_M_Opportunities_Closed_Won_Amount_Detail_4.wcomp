nities Closed/Won\";\nq2 = cogroup q2_C by ('GiftOfficerDivision', 'User.Name') full, q2_D by ('GiftOfficerDivision', 'User.Name');\nq2 = foreach q2 generate coalesce(q2_C.'GiftOfficerDivision', q2_D.'GiftOfficerDivision') as 'GiftOfficerDivision', coalesce(q2_C.'User.Name', q2_D.'User.Name') as 'User.Name', sum(q2_C.'AQB__GoalCurrencyAmount__c') as 'C', sum(q2_D.'AQB__GoalCount__c') as 'D';\nq = cogroup q1 by ('OpportunityTeamMember.GiftOfficerDivision', 'OpportunityTeamMember.Name') left, q2 by ('GiftOfficerDivision', 'User.Name');\nq = foreach q generate coalesce(q1.'OpportunityTeamMember.GiftOfficerDivision', q2.'GiftOfficerDivision') as 'OpportunityTeamMember.GiftOfficerDivision', coalesce(q1.'OpportunityTeamMember.Name', q2.'User.Name') as 'OpportunityTeamMember.Name', sum(q1.'Amount') as '$ - Closed/Won Amount', first(q2.'C') as '$ - Goal', count(q1) as '# - Closed/Won Count', first(q2.'D') as '# - Goal';\nq = group q by rollup('OpportunityTeamMember.GiftOfficerDivision', 'OpportunityTeamMember.Name');\nq = foreach q generate q.'OpportunityTeamMember.GiftOfficerDivision' as 'OpportunityTeamMember.GiftOfficerDivision', q.'OpportunityTeamMember.Name' as 'OpportunityTeamMember.Name', sum(q.'$ - Closed/Won Amount') as '$ - Closed/Won Amount', sum(q.'$ - Goal') as '$ - Goal', sum(q.'$ - Closed/Won Amount') / sum(q.'$ - Goal') as '$ - % to Goal', sum(q.'# - Closed/Won Count') as '# - Closed/Won Count', sum(q.'# - Goal') as '# - Goal', sum(q.'# - Closed/Won Count') / sum(q.'# - Goal')  as '# - % to Goal', grouping(q.'OpportunityTeamMember.GiftOfficerDivision') as 'grouping_OpportunityTeamMember.GiftOfficerDivision', grouping(q.'OpportunityTeamMember.Name') as 'grouping_OpportunityTeamMember.Name';\ns = filter q by 'grouping_OpportunityTeamMember.GiftOfficerDivision' == 1 and 'grouping_OpportunityTeamMember.Name' == 1;\nq = filter q by 'grouping_OpportunityTeamMember.GiftOfficerDivision' == 0 and 'grouping_OpportunityTeamMember.Name' == 0;\nq = order q by ('OpportunityTeamMember.GiftOfficerDivision' asc, 'OpportunityTeamMember.Name' asc);\nq = limit q 20000;\nq = union q, s;\nq = limit q 20001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfFrozenColumns":0,"numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Gift_Officer___Close_4":{"broadcastFacet":false,"groups":[],"label":"Development Vertical $ Closed/Won Detail Table","numbers":[],"query":"q = load \"Opportunity_Info\";\nq = filter q by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq = filter q by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq = filter q by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq = group q by rollup('Opportunity.Name', 'Opportunity.Id', 'Account.AQC_Account_ARCH_ID__c', 'Account.Name', 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OppRecordType.Name', 'Account.Id', 'Opportunity.OpportunityOwner.Name', 'Opportunity.CloseDate');\nq = foreach q generate q.'Opportunity.Name' as 'Opportunity.Name', q.'Opportunity.Id' as 'Opportunity.Id', q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'Account.Name' as 'Account.Name', q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q.'Opportunity.ClosedWonGiftBandDevelopmentVertical' as 'Opportunity.ClosedWonGiftBandDevelopmentVertical', q.'Opportunity.OppRecordType.Name' as 'Opportunity.OppRecordType.Name', q.'Account.Id' as 'Account.Id', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', q.'Opportunity.CloseDate' as 'Opportunity.CloseDate', sum(q.'Opportunity.Amount') as '$ - Closed/Won Amount', count(q) as '# - Closed/Won Count', grouping(q.'Opportunity.Name') as 'grouping_Opportunity.Name', grouping(q.'Opportunity.Id') as 'grouping_Opportunity.Id', grouping(q.'Account.AQC_Account_ARCH_ID__c') as 'grouping_Account.AQC_Account_ARCH_ID__c', grouping(q.'Account.Name') as 'grouping_Account.Name', grouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical', grouping(q.'Opportunity.OppRecordType.Name') as 'grouping_Opportunity.OppRecordType.Name', grouping(q.'Account.Id') as 'grouping_Account.Id', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name', grouping(q.'Opportunity.CloseDate') as 'grouping_Opportunity.CloseDate';\n\ns = filter q by 'grouping_Opportunity.Name' == 1;\nq = filter q by 'grouping_Opportunity.Name' == 0 and 'grouping_Opportunity.Id' == 0 and 'grouping_Account.AQC_Account_ARCH_ID__c' == 0 and 'grouping_Account.Name' == 0 and 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 0 and 'grouping_Opportunity.OppRecordType.Name' == 0 and 'grouping_Account.Id' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0 and 'grouping_Opportunity.CloseDa