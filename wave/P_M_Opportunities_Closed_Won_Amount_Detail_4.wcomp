_Account_ARCH_ID__c', 'OpportunityTeamMember.Name', 'OpportunityTeamMember.TeamMemberRole', 'OpportunityTeamMember.GiftOfficerDivision', 'CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day', 'Id', 'Account.Id');\nq = foreach q generate q.'Name' as 'Opportunity Name', q.'Account.Name' as 'Account.Name', q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'OpportunityTeamMember.Name' as 'OpportunityTeamMember.Name', q.'OpportunityTeamMember.TeamMemberRole' as 'OpportunityTeamMember.TeamMemberRole', q.'OpportunityTeamMember.GiftOfficerDivision' as 'OpportunityTeamMember.GiftOfficerDivision', q.'CloseDate_Year' as 'CloseDate_Year', q.'CloseDate_Month' as 'CloseDate_Month', q.'CloseDate_Day' as 'CloseDate_Day', q.'Id' as 'Id', q.'Account.Id' as 'Account.Id', sum(q.'Amount') as '$ - Closed/Won Amount', count(q) as '# - Closed/Won Count', grouping(q.'Name') as 'grouping_Name', grouping(q.'Account.Name') as 'grouping_Account.Name', grouping(q.'Account.AQC_Account_ARCH_ID__c') as 'grouping_Account.AQC_Account_ARCH_ID__c', grouping(q.'OpportunityTeamMember.Name') as 'grouping_OpportunityTeamMember.Name', grouping(q.'OpportunityTeamMember.TeamMemberRole') as 'grouping_OpportunityTeamMember.TeamMemberRole', grouping(q.'OpportunityTeamMember.GiftOfficerDivision') as 'grouping_OpportunityTeamMember.GiftOfficerDivision', grouping(q.'CloseDate_Year') as 'grouping_CloseDate_Year', grouping(q.'CloseDate_Month') as 'grouping_CloseDate_Month', grouping(q.'CloseDate_Day') as 'grouping_CloseDate_Day', grouping(q.'Id') as 'grouping_Id', grouping(q.'Account.Id') as 'grouping_Account.Id';\ns = filter q by 'grouping_Name' == 1;\nq = filter q by 'grouping_Name' == 0 and 'grouping_Account.Name' == 0 and 'grouping_Account.AQC_Account_ARCH_ID__c' == 0 and 'grouping_OpportunityTeamMember.Name' == 0 and 'grouping_OpportunityTeamMember.TeamMemberRole' == 0 and 'grouping_OpportunityTeamMember.GiftOfficerDivision' == 0 and 'grouping_CloseDate_Year' == 0 and 'grouping_CloseDate_Month' == 0 and 'grouping_CloseDate_Day' == 0 and 'grouping_Id' == 0 and 'grouping_Account.Id' == 0;\nq = order q by ('Opportunity Name' asc, 'Account.Name' asc, 'Account.AQC_Account_ARCH_ID__c' asc, 'OpportunityTeamMember.Name' asc, 'OpportunityTeamMember.TeamMemberRole' asc, 'OpportunityTeamMember.GiftOfficerDivision' asc, 'CloseDate_Year' asc, 'CloseDate_Month' asc, 'CloseDate_Day' asc, 'Id' asc, 'Account.Id' asc);\nq = limit q 25000;\nq = union q, s;\nq = limit q 25001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"collapsible":false,"columnProperties":{},"columns":["Opportunity Name","Account.Name","Account.AQC_Account_ARCH_ID__c","OpportunityTeamMember.Name","OpportunityTeamMember.TeamMemberRole","OpportunityTeamMember.GiftOfficerDivision","CloseDate_Year","CloseDate_Month","CloseDate_Day","$ - Closed/Won Amount","# - Closed/Won Count"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfFrozenColumns":7,"numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"Med_Adv___Closed_Won_4":{"broadcastFacet":true,"datasets":[{"name":"OpportunityDetail"},{"name":"UA_Performance_Med_Team_Goals"}],"isGlobal":false,"label":"Med Adv $ Closed/Won Summary Table 2","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[{"name":"OpportunityTeamMember.MedOfficerTeam","filter