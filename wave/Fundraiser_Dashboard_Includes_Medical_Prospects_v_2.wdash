00","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Upcoming_Eliot_Renew_8":{"broadcastFacet":true,"groups":[],"label":"Upcoming Eliot Renewals Chart","numbers":[],"query":"q = load \"Eliot_Society_Status\";\nq = filter q by 'CFY_Eliot_Status' in [\"Downgrade\", \"Unrenewed\"] or ('Contact.ARCH_CFY_Annual_Fund_Pledged_Credit__c' > 0 and 'CFY_Eliot_Status' == \"Pledge Not Paid\");\nq = foreach q generate q.'Name' as 'Name', 'CFY_Eliot_Status', 'CFYEliot.AQB__Date__c' as 'CFY Summary Date',\n(case\n    when date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") == \"1970-01-01\"\n    then \"Date Needs Review\"\n    else date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") \n    end) as 'Renewal Date', \nq.'PFYEliot.SUM_ARCH_Selected_Fiscal_Year_Total__c' as 'PFY Amount', q.'PFYEliot.PFY_Giving_Level' as 'PFY Level', q.'ARCH_CFY_Annual_Fund_Recognition_Credit__c' as 'ARCH_CFY_Annual_Fund_Recognition_Credit__c', q.'AQB__OpenOpps__c' as 'AQB__OpenOpps__c',  q.'ARCH_PrimaryGiftOfficerName__c' as 'Primary Gift Officer',\n(case\n    when date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") == \"1970-01-01\" then 999999\n    else date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) \n    end) as 'Days from PFY Eliot Date', \n(case    \n    when date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") == \"1970-01-01\"\n    then \"Date Needs Review\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) > 730 then \"12+ Months\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 551 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=730 then \"06-12 Months\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 461 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=550 then \"03-06 Months\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 366 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=460 then \"00-03 Months\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 351 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=365 then \"0-14 Days\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 337 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=350 then \"15-30 Days\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 277 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=336 then \"31-60 Days\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=276 then \"61+ Days\"\n    else \"\"\n    end) as 'Time Until Renewal',\ntoDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH') as 'PFY Eliot Summary Date-Time', q.'Id' as 'Account ID';\nq = filter q by 'Days from PFY Eliot Date' <= 365;\n\nq1 = group q by 'Time Until Renewal';\nq1 = foreach q1 generate 'Time Until Renewal', count() as Count;\nq1 = order q1 by 'Time Until Renewal' asc;\nq1 = limit q1 100;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":false,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]},"description":"Eliot Society Members from previous fiscal year chart that have not renewed in the current fiscal year, but their previous fiscal year summary date is still less than or equal to 1 year ago. Chart grouped by weeks until due. \n"}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"Upcoming Eliot Renewals by Time Period","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":false,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"CFY_Opportunities_Cl_1":{"broadcastFacet":true,"groups":[],"label":"CFY Opportunities Open Solicited Sum","numbers":[],"query":"q = load \"Opportunity_Info\";\nq = filter q by   'Opportunity.StageName'  in [\"Solicitation\", \"Solicitation (PG)\", \"Negotiation/Review\",\"LOI/Concept Paper Submittal\", \"Proposal Preparation\", \"Proposal Submittal\"]\nand (date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"] \n|| date('Opportunity.AQC_Date_Asked__c_Year', 'Opportunity.AQC_Date_Asked__c_Month', 'Opportunity.AQC_Date_Asked__c_Day') in [\"current fiscal_year\"..\"current fiscal_year\"] \n|| date('Opportunity.AQC_Projected_Ask_Date__c_Year', 'Opportunity.AQC_Projected_Ask_Date__c_Month', 'Opportunity.AQC_Projected_Ask_Date__c_Day') in [\"current fiscal_year\"..\"current fiscal_year\"]);\nq = filter q by '{{cell(static_1.selection, 0, \"Value\").asString()}}' in {{coalesce(column(PMTeam_User_Name__Ro_1.selection, [\"PMTeam.User.Name\"]), \"all\").asString()}};\nq = group q by all;\nq = foreach q generate sum('Opportunity.Amount') as 'CFY Opportunities $ Open';\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Prospect_Strategy_La_1":{"broadcastFacet":true,"groups":[],"label":"Months Since Last Substantive AR","numbers":[],"query":"q = load \"Account_Info\";\nq = filter q by  'PMTeam.RMT_Member_Name_Role_Active' is not null;\nq = foreach q generate q.'Account.Name' as 'Account.Name', 'Account.PrimaryContact.Name',\n(case\n    when len(q.'Account.ActivityReport.Last_Substantive_Final_Activity_Report_Date') >11 then date_diff(\"day\",toDate(q.'Account.ActivityReport.Last_Substantive_Final_Activity_Report_Date', \"yyyy-MM-dd HH:mm:ss\"),now())\n    when len(q.'Account.ActivityReport.Last_Substantive_Final_Activity_Report_Date') >1 and (q.'Account.ActivityReport.Last_Substantive_Final_Activity_Report_Date' != \"1900-01-01\" || q.'Account.ActivityReport.Last_Substantive_Final_Activity_Report_Date' is null)then date_diff(\"day\",toDate(q.'Account.ActivityReport.Last_Substantive_Final_Activity_Report_Date', \"yyyy-MM-dd\"),now())\n    else 99999\n    end) as 'Days Since Last Substantive Final Activity Report',\nq.'Account.Id' as 'Account.Id', 'Account.AQB__PrimaryContact__c', q.'Account.Months_Since_Last_Substantive_Activity_Report_Category' as 'Account.Months_Since_Last_Substantive_Activity_Report_Category';\n\n--load days since last sustantive activity report\nq1 = foreach q generate q.'Account.Name' as 'Account.Name', 'Account.PrimaryContact.Name', q.'Days Since Last Substantive Final Activity Report' as 'Days Since Last Subs. Final AR',\n    (case\n        when q.'Days Since Last Substantive Final Activity Report' >= 1 and q.'Days Since Last Substantive Final Activity Report' <= 90 then \"00-03 Months\"\n        when q.'Days Since Last Substantive Final Activity Report' >= 91 and q.'Days Since Last Substantive Final Activity Report' <= 180 then \"03-06 Months\"\n        when q.'Days Since Last Substantive Final Activity Report' >= 181 and q.'Days Since Last Substantive Final Activity Report' <= 365 then \"06-12 Months\"\n        when q.'Days Since Last Substantive Final Activity Report' >= 366 then \"12+ Months\"\n        end) as 'Months Since Last Subs. Final AR',\n (case\n        when q.'Days Since Last Substantive Final Activity Report' >= 1 and q.'Days Since Last Substantive Final Activity Report' <= 90 then \"#FFFFFF\"\n        when q.'Days Since Last Substantive Final Activity Report' >= 91 and q.'Days Since Last Substantive Final Activity Report' <= 180 then \"#16325c\"\n        when q.'Days Since Last Substantive Final Activity Report' >= 181 and q.'Days Since Last Substantive Final Activity Report' <= 365 then \"#16325c\"\n        when q.'Days Since Last Substantive Final Activity Report' >= 366 then \"#16325c\"\n        end) as 'Text Conditional Formatting',\n (case\n        when q.'Days Since Last Substantive Final Activity Report' >= 1 and q.'Days Since Last Substantive Final Activity Report' <= 90 then \"#215732\"\n        when q.'Days Since Last Substantive Final Activity Report' >= 91 and q.'Days Since Last Substantive Final Activity Report' <= 180 then \"#63be7a\"\n        when q.'Days Since Last Substantive Final Activity Report' >= 181 and q.'Days Since Last Substantive Final Activity Report' <= 365 then \"#ffcd95\"\n        when q.'Days Since Last Substantive Final Activity Report' >= 366 then \"#EF9BA8\"\n        end) as 'Background Conditional Formatting',\n    q.'Account.Id' as 'Account.Id', 'Account.AQB__PrimaryContact__c';\nq1 = filter q1 by 'Months Since Last Subs. Final AR' in {{coalesce(column(ProspectsByActivePla_1.selection, [\"Months Since Last Subs. Final AR\"]),\"all\").asString()}};\nq1 = order q1 by 'Days Since Last Subs. Final AR' asc;\nq1 = limit q1 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Account.Name","Account.PrimaryContact.Name","Days Since Last Subs. Final AR","Months Since Last Subs. Final AR"],"customBulkActions":[],"evenRowColor":"#f4f6f9","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"input_1":{"label":"","start":"[99999]","type":"input","valueType":"number","values":[{"max":99999,"min":1}]},"Past_Due_Activities__2":{"broadcastFacet":true,"groups":[],"label":"Past Due Activities and Actitity Reports Count","numbers":[],"query":"q1 = load \"Activity_Report_Info\";\nq1 = filter q1 by Days_Until_Due <0 and AQB__Date__c is not null and date('AQB__Date__c_Year', 'AQB__Date__c_Month', 'AQB__Date__c_Day') in [\"3 fiscal_year ago\"..\"current fiscal_year\"] and (AQB__ReportStatus__c != \"Final\" || AQB__ReportStatus__c is null) and 'ActivityReportParticipant.User.Name' is not null and 'Account.Account.Name' is not null;\nq1 = foreach q1 generate 'Account.Account.Name', AQB__Subject__c, Days_Until_Due as 'Days Overdue', AQB__Date__c, coalesce(AQB__Type__c,\"-\") as Type, 'Months_Until_Due' as 'Time Until Due', \"Activity Report\" as 'Record Type';\n\nq2 = load \"Activities\";\nq2 = filter q2 by Days_Until_Due <0 and ActivityDate is not null and date('ActivityDate_Year', 'ActivityDate_Month', 'ActivityDate_Day') in [\"3 fiscal_year ago\"..\"current fiscal_year\"]  and ARCH_Event_Ended__c == \"false\" and 'User.Name' is not null and 'Account.Account.Name' is not null;\nq2 = foreach q2 generate 'Account.Account.Name', AQB__Subject__c, Days_Until_Due as 'Days Overdue', ActivityDate, coalesce(ActivityType,\"-\") as Type, 'Months_Until_Due' as 'Time Until Due', \"Activity\" as 'Record Type';\n\nq3 = union q1, q2;\nq3 = filter q3 by 'Record Type' in {{column(Activity_Report_or_A_1.selection, [\"Display\"]).asString()}};\nq3 = group q3 by all;\nq3 = filter q3 by coalesce(Type,\"-\") in {{coalesce(column(Upcoming_Activity_Re_1.selection, [\"Type\"]),\"all\").asString()}} and 'Time Until Due' in {{coalesce(column(Upcoming_Activities__8.selection, [\"Time Until Due\"]),\"all\").asString()}};\nq3 = foreach q3 generate count(q3) as 'Count';\nq3 = limit q3 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"input_2":{"label":"","start":"[-100]","type":"input","valueType":"number","values":[{"max":99999,"min":-100}]},"Past_Due_Activities__1":{"broadcastFacet":true,"groups":[],"label":"Past Due Activities and Actitity Reports Count","numbers":[],"query":"q1 = load \"Activity_Report_Info\";\nq1 = filter q1 by Days_Until_Due <0 and AQB__Date__c is not null and date('AQB__Date__c_Year', 'AQB__Date__c_Month', 'AQB__Date__c_Day') in [\"3 fiscal_year ago\"..\"current fiscal_year\"] and (AQB__ReportStatus__c != \"Final\" || AQB__ReportStatus__c is null) and 'Account.Account.Name' is not null and 'ActivityReportParticipant.User.Name' is not null;\nq1 = foreach q1 generate 'Account.Account.Name', AQB__Subject__c, Days_Until_Due as 'Days Overdue', AQB__Date__c;\nq2 = load \"Activities\";\nq2 = filter q2 by Days_Until_Due <0 and ActivityDate is not null and date('ActivityDate_Year', 'ActivityDate_Month', 'ActivityDate_Day') in [\"3 fiscal_year ago\"..\"current fiscal_year\"]  and ARCH_Event_Ended__c == \"false\" and 'Account.Account.Name' is not null and 'User.Name' is not null;\nq2 = foreach q2 generate 'Account.Account.Name', AQB__Subject__c, Days_Until_Due as 'Days Overdue', ActivityDate;\nq3 = union q1, q2;\nq3 = group q3 by all;\nq3 = foreach q3 generate count(q3) as 'A';\nq3 = limit q3 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColo