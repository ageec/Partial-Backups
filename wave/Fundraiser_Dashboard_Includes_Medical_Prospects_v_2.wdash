lFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"rgb(225, 229, 238)","borderWidth":1,"cell":{"backgroundColor":"rgb(242, 246, 250)","fontColor":"rgb(22, 50, 92)","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"rgb(242, 246, 250)","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"rgb(169, 183, 199)","innerMinorBorderColor":"rgb(225, 229, 238)","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#FFFFFF","showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"Account_VolunteerPos_1":{"broadcastFacet":true,"datasets":[{"name":"Account_Info"}],"isGlobal":false,"label":"Account_VolunteerPos_1","query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"VolunteerPositionsSuffixMultivalue\"],\"order\":[[\"VolunteerPositionsSuffixMultivalue\",{\"ascending\":true}]]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","sortable":true,"type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":["VolunteerPositionsSuffixMultivalue"],"plots":["count"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"DaysSinceLastActivit_5":{"broadcastFacet":true,"groups":[],"label":"ProspectsByActivePlan","numbers":[],"query":"q = load \"Account_Info\";\nq = filter q by  'PMTeam.RMT_Member_Name_Role_Active' is not null and 'Account.AQB__ProspectStatus__c' == \"Prospect\";\nq = group q by 'Account.ARCH_Active_Plan__c';\nq = foreach q generate q.'Account.ARCH_Active_Plan__c' as 'Account.ARCH_Active_Plan__c', unique(q.'Account.Id') as 'Count';\nq = order q by 'Account.ARCH_Active_Plan__c' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","centerText":"","legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"showMeasureTitle":true,"tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"pie","title":{"fontSize":14,"subtitleFontSize":11,"label":"Prospect by Active Plan Status","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[50,50],"enable":false,"type":"x","chartsPerLine":4},"inner":60,"columnMap":{"trellis":[],"dimension":["Account.ARCH_Active_Plan__c"],"plots":["Count"]},"showActionMenu":true,"centerValueType":"number","valueType":"compactNumber","theme":"wave","compactDecimalDigits":-1,"applyConditionalFormatting":true},"type":"chart"}},"Prospect_Status_Stew_1":{"broadcastFacet":true,"groups":[],"label":"Prospect Status Stewardship With 0-1 Pledge Payments Remaining Count","numbers":[],"query":"q1 = load \"Account_Info\";\nq1 = filter q1 by 'Account.AQB__ProspectStatus__c' == \"Stewardship\" and  'PMTeam.RMT_Member_Name_Role_Active' is not null and date('Account.AQB__ProspectStatusDate__c_Year', 'Account.AQB__ProspectStatusDate__c_Month', 'Account.AQB__ProspectStatusDate__c_Day') in [\"50 years ago\"..\"5 years ago\"];\n\nq2 = load \"GiftAndPledgeTransactionsExtension\";\nq2 = filter q2 by 'Transaction.AQB__Type__c' in [\"Pledge\", \"Pledge Soft Credit\"];\nq2 = filter q2 by 'Transaction.AQB__Balance__c' > 0;\nq2_B = filter q2 by 'Transaction.AQB__Type__c' in [\"Pledge\", \"Pledge Soft Credit\"] && 'Transaction.AQB__Balance__c' > 0;\n\nq3 = cogroup q1 by ('Account.Name', 'Account.Id') left, q2_B by ('AccountName', 'AccountID');\nq3 = foreach q3 generate coalesce(q1.'Account.Name', q2_B.'AccountName') as 'Account.Name', coalesce(q1.'Account.Id', q2_B.'AccountID') as 'Account.Id', first(q1.'Account.AQB__ProspectStatus__c') as 'Prospect Status', first(q1.'Account.AQB__ProspectStatusDate__c') as 'Prospect Status Date', count(q2_B) as 'Pledge Installments Remaining';\nq3 = filter q3 by 'Pledge Installments Remaining' <= 1;\n\nq4 = group q3 by all;\nq4 = foreach q4 generate count(q4) as Count;\n\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"verticalPadding":8},"type":"table"}},"ARCH_Primary_Visitor_1":{"broadcastFacet":false,"groups":[],"label":"ARCH_Primary_Visitor_1","numbers":[],"query":"q1 = load \"Account_Info\";\nAccount_Info = load \"Account_Info\";\nq1 = filter q1 by ('Account.ARCH_MedProspect__c' == \"false\" or 'Account.ARCH_MedProspect__c' is null) and 'PMTeam.RMT_Member_Name_Role_Active' is not null ;\nq1 = foreach q1 generate 'Account.Id' as 'Account.Id', 'Account.Name' as 'Account.Name', 'OverallAccountCapacityorWealthEngineCapacity' as 'OverallAccountCapacityorWealthEngineCapacity';\n\nq2 = load \"Prospects_Info\";\nq2 = filter q2 by Account_Row_Number ==1;\nq2 = foreach q2 generate 'Account.Account.Id' as 'Account.Account.Id', 'Account.Account.Name' as 'Account.Account.Name', Status__c as Status__c, ARCH_Fiscal_Year__c as ARCH_Fiscal_Year__c, Current_Fiscal_Year as Current_Fiscal_Year, CFY_ARCH_OutreachHistoryRollup__c_Sum_String as CFY_ARCH_OutreachHistoryRollup__c_Sum_String, Active_Prospect_List as Active_Prospect_List, Account_Row_Number as Account_Row_Number;\n\nq = cogroup q1 by 'Account.Id' left, q2 by 'Account.Account.Id';\nq = foreach q generate q1.'Account.Id' as 'Account.Id',\n(case\n    when first(q2.'Active_Prospect_List') is not null then first(q2.'Active_Prospect_List') \n    else \"false\"\n    end) as 'In Active Prospect List?'; \n\nq3 = group q by 'In Active Prospect List?';\nq3 = foreach q3 generate 'In Active Prospect List?', count() as 'Count';\nq3 = order q3 by 'In Active Prospect List?';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"TotalOpportunities_1":{"broadcastFacet":true,"groups":[],"label":"TotalClosedOpportunities","numbers":[],"query":"q = load \"Opportunity_Info\";\nq = filter q by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] ;\nq = filter q by '{{cell(static_1.selection, 0, \"Value\").asString()}}' in {{coalesce(column(PMTeam_User_Name__Ro_1.selection, [\"PMTeam.User.Name\"]), \"all\").asString()}};\nq = group q by all;\nq = foreach q generate count(q) as 'A', sum(q.'Opportunity.Amount') as 'B';\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":[],"plots":["A","B"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Upcoming_Activities__8":{"broadcastFacet":false,"groups":[],"label":"Upcoming Activities and Activity Reports Chart","numbers":[],"query":"q1 = load \"Activity_Report_Info\";\nq1 = filter q1 by Days_Until_Due <0 and AQB__Date__c is not null  and (AQB__ReportStatus__c != \"Final\" || AQB__ReportStatus__c is null) and 'Account.Account.Name' is not null and 'ActivityReportParticipant.User.Name' is not null;\nq1 = foreach q1 generate Months_Until_Due as Months_Until_Due, 'Id' as 'Id', AQB__Type__c as Type, \"Activity Report\" as 'Record Type';\n\nq2 = load \"Activities\";\nq2 = filter q2 by Days_Until_Due <0 and ActivityDate is not null  and ARCH_Event_Ended__c == \"false\" and 'Account.Account.Name' is not null and 'User.Name' is not null;\nq2 = foreach q2 generate Months_Until_Due as Months_Until_Due, 'Id' as 'Id', ActivityType as Type, \"Activity\" as 'Record Type';\n\nq3 = union q1, q2;\nq3 = group q3 by Months_Until_Due;\nq3 = filter q3 by Type in {{coalesce(column(Upcoming_Activity_Re_1.selection, [\"Type\"]),\"all\").asString()}} and 'Record Type' in {{column(Activity_Report_or_A_1.selection, [\"Display\"]).asString()}};\nq3 = foreach q3 generate Months_Until_Due as 'Time Until Due', count() as Count;\nq3 = order q3 by 'Time Until Due' asc;\nq3 = limit q3 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":false,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]},"description":"Activity Reports where Report Status is not Final and Date is <= Today. Activities where Completed = No and Date is >= Today. Grouped by Time Until Due .\n"}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"Past Due ARs and Activities by Days","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":false,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"CountByClassificatio_1":{"broadcastFacet":true,"datasets":[{"name":"User_Goal_Info"}],"isGlobal":false,"label":"CountByClassification","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[{"name":"AQB__Classification__c","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{"User_Goal_Info":{"filters":[["ARCH_Fiscal_Year__c",[["fiscal_year",-1],["fiscal_year",-1]],"between"],["AQB__Classification__c",["Number of Opportunities Closed/Won","Number of Opportunities Solicited","Qualification Activity Report","Substantive Activity Report"],"in"],["Opportunity.Opportunity.StageName",["Closed - Not Asked"],"not in"]]}},"sources":[{"columns":[{"field":["sum","AQB__GoalCount__c"],"name":"D"},{"field":["sum","AQB__ResultCount__c"],"name":"E"}],"filters":[],"groups":["AQB__Classification__c"],"joins":[],"name":"User_Goal_Info"},{"columns":[{"formula":"E/D","name":"F"},{"formula":"D * (1-(date_diff(\"day\", now(), fiscal_year_last_day( now()))/365))","name":"A"},{"formula":"E-A","name":"B"},{"formula":"B/D","name":"C"}],"filters":[],"groups":[],"joins":[]}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"rgb(225, 229, 238)","borderWidth":1,"cell":{"backgroundColor":"rgb(242, 246, 250)","fontColor":"#091A3E","fontSize":12,"textWrap":true},"columnProperties":{},"columnSubtotals":false,"columns":["E","D","F","AQB__Classification__c","A","B","C"],"customBulkActions":[],"evenRowColor":"rgb(242, 246, 250)","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"rgb(169, 183, 199)","innerMinorBorderColor":"rgb(225, 229, 238)","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#FFFFFF","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":false,"verticalPadding":4},"type":"table"}},"Past_Due_Eliot_Renew_2":{"broadcastFacet":true,"groups":[],"label":"Past Due Eliot Renewals Count","numbers":[],"query":"q = load \"Eliot_Society_Status\";\nq = filter q by 'CFY_Eliot_Status' in [\"Downgrade\", \"Unrenewed\"] or ('Contact.ARCH_CFY_Annual_Fund_Pledged_Credit__c' > 0 and 'CFY_Eliot_Status' == \"Pledge Not Paid\");\nq = foreach q generate q.'Name' as 'Name', 'CFY_Eliot_Status', 'CFYEliot.AQB__Date__c' as 'CFY Summary Date', q.'ARCH_CFY_Annual_Fund_Recognition_Credit__c' as 'ARCH_CFY_Annual_Fund_Recognition_Credit__c', \n(case\n    when date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") == \"1970-01-01\"\n    then \"Date Needs Review\"\n    else date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") \n    end) as 'PFY Renewal Date', \nq.'PFYEliot.SUM_ARCH_Selected_Fiscal_Year_Total__c' as 'PFY Amount', q.'PFYEliot.PFY_Giving_Level' as 'PFY Level', q.'AQB__OpenOpps__c' as 'AQB__OpenOpps__c',  q.'ARCH_PrimaryGiftOfficerName__c' as 'Primary Gift Officer', q.'PMTeam.TerritoryPartner' as 'Territory Partner', q.'PMTeam.ProxyOfficer' as 'Proxy Officer',\n(case\n    when date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") == \"1970-01-01\" then 999999\n    else date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) \n    end) as 'Days from PFY Eliot Date', \n(case    \n    when date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") == \"1970-01-01\" then \"Date Needs Review\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) > 425 then \"61+ Days\" -- > 730 then \"12+ Months\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 395 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=425 then \"31-60 Days\" -- <=730 then \"06-12 Months\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 380 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=394 then \"15-30 Days\" -- <=550 then \"03-06 Months\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 366 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=379 then \"0-14 Days\" -- <=460 then \"00-03 Months\"\n    --when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 351 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=365 then \"0-14 Days\"\n    --when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 337 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=350 then \"14-30 Days\"\n    --when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 277 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=336 then \"30-60 Days\"\n    --when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=276 then \"60+ Days\"\n    else \"\"\n    end) as 'Time Renewal Past Due',\ntoDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH') as 'PFY Eliot Summary Date-Time', q.'Id' as 'Account ID';\nq = filter q by 'Days from PFY Eliot Date' > 365 and 'Time Renewal Past Due' in {{coalesce(column(Upcoming_Eliot_Renew_9.selection, [\"Time Renewal Past Due\"]),\"all\").asString()}};\n\nq1 = group q by all;\nq1 = foreach q1 generate count (q1) as 'Count';\nq1 = limit q1 10000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"Outdated_Strategies_8":{"broadcastFacet":true,"groups":[],"label":"Opportunities with Unknown Designation","numbers":[],"query":"q = load \"Opportunity_Info\";\nq = filter q by ('Opportunity.OppComp1.ARCH_Designation_Category_1__c' == \"Unknown\" || 'Opportunity.OppComp2.ARCH_Designation_Category_1__c' == \"Unknown\" || 'Opportunity.OppComp3.ARCH_Designation_Category_1__c' == \"Unknown\")    and ('Opportunity.StageName' not in [\"Closed - Funded No Value\", \"Closed - Funded Unsolicited\", \"Closed - NPR Funded\", \"Closed - Not Asked\", \"Closed Deceased\", \"Closed Won\", \"Closed/Invalid\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\", \"Closed - Lost\"] || 'Opportunity.StageName' is null);\nq = filter q by '{{cell(static_1.selection, 0, \"Value\").asString()}}' in {{coalesce(column(PMTeam_User_Name__Ro_1.selection, [\"PMTeam.User.Name\"]), \"all\").asString()}};\nq = foreach q generate q.'Opportunity.Name' as 'Opportunity.Name', q.'Opportunity.StageName' as 'Opportunity.StageNam