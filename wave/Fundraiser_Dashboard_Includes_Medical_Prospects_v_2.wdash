onalFormatting":true},"type":"chart"}},"OpenOpportunitiesByA_2":{"broadcastFacet":true,"groups":[],"label":"OpenOpportunitiesByStage","numbers":[],"query":"q = load \"Opportunity_Info\";\nq = filter q by   ('Opportunity.StageName' not in [\"Closed - Funded No Value\", \"Closed - Funded Unsolicited\", \"Closed - NPR Funded\", \"Closed - Not Asked\", \"Closed Deceased\", \"Closed Won\", \"Closed/Invalid\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\", \"Closed - Lost\"] || 'Opportunity.StageName' is null) and ('Opportunity.Opportunity_Stage_Category' not in [\"01 - Identification/Research\", \"06 - Closed/Won\", \"07 - Closed/Lost\", \"\"] && 'Opportunity.Opportunity_Stage_Category' is not null);\nq = filter q by '{{cell(static_1.selection, 0, \"Value\").asString()}}' in {{coalesce(column(PMTeam_User_Name__Ro_1.selection, [\"PMTeam.User.Name\"]), \"all\").asString()}};\nq = group q by 'Opportunity.Opportunity_Stage_Category';\nq = foreach q generate q.'Opportunity.Opportunity_Stage_Category' as 'Opportunity.Opportunity_Stage_Category', {{cell(Map_Type_Toggle_2.selection, 0, \"Value\").asString()}} as {{cell(Map_Type_Toggle_2.selection, 0, \"Display\").asString()}};\nq = order q by 'Opportunity.Opportunity_Stage_Category' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":false,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"vbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"Open Opportunity Count/Amount By Stage","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"binValues":false,"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":false,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"OpenOpportunitiesByA_1":{"broadcastFacet":true,"groups":[],"label":"OpenOpportunitiesByAskAmount","numbers":[],"query":"q = load \"Opportunity_Info\";\nq = filter q by   ('Opportunity.StageName' not in [\"Closed - Funded No Value\", \"Closed - Funded Unsolicited\", \"Closed - NPR Funded\", \"Closed - Not Asked\", \"Closed Deceased\", \"Closed Won\", \"Closed/Invalid\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\", \"Closed - Lost\"] || 'Opportunity.StageName' is null);\nq = filter q by '{{cell(static_1.selection, 0, \"Value\").asString()}}' in {{coalesce(column(PMTeam_User_Name__Ro_1.selection, [\"PMTeam.User.Name\"]), \"all\").asString()}}; \nq = group q by '{{cell(Map_Type_Toggle_3.selection, 0, \"Category\").asString()}}';\nq = foreach q generate q.'{{cell(Map_Type_Toggle_3.selection, 0, \"Category\").asString()}}' as '{{cell(Map_Type_Toggle_3.selection, 0, \"Category\").asString()}}', sum(q.'{{cell(Map_Type_Toggle_3.selection, 0, \"Value\").asString()}}') as '{{cell(Map_Type_Toggle_3.selection, 0, \"Display\").asString()}}', count(q) as 'Count';\nq = order q by '{{cell(Map_Type_Toggle_3.selection, 0, \"Category\").asString()}}' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","stack":false,"showPoints":true,"compactDecimalDigitsOnLine":-1,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"top-center","inside":false},"axisMode":"dual","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"combo","missingValue":"connect","title":{"fontSize":14,"subtitleFontSize":11,"label":"Total Open Opportunities by {{cell(Map_Type_Toggle_3.selection, 0, \"Display\").asString()}}","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"plots":{"Amount":{"mark":"bar"},"Count":{"mark":"line"}},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueTypeOnLine":"none","theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":false,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Upcoming_Eliot_Renew_1":{"broadcastFacet":true,"groups":[],"label":"Upcoming Eliot Renewals","numbers":[],"query":"q = load \"Eliot_Society_Status\";\nq = filter q by 'CFY_Eliot_Status' in [\"Downgrade\", \"Unrenewed\"] or ('Contact.ARCH_CFY_Annual_Fund_Pledged_Credit__c' > 0 and 'CFY_Eliot_Status' == \"Pledge Not Paid\");\nq = foreach q generate q.'Name' as 'Name', 'Contact.Name' as 'Primary Contact Name', 'CFY_Eliot_Status', 'CFYEliot.AQB__Date__c' as 'CFY Summary Date', q.'ARCH_CFY_Annual_Fund_Recognition_Credit__c' as 'ARCH_CFY_Annual_Fund_Recognition_Credit__c',\n(case\n    when date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") == \"1970-01-01\"\n    then \"Date Needs Review\"\n    else date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") \n    end) as 'PFY Renewal Date', \nq.'PFYEliot.SUM_ARCH_Selected_Fiscal_Year_Total__c' as 'PFY Amount', q.'PFYEliot.PFY_Giving_Level' as 'PFY Level', q.'AQB__OpenOpps__c' as 'AQB__OpenOpps__c',  q.'ARCH_PrimaryGiftOfficerName__c' as 'Primary Gift Officer', q.'PMTeam.TerritoryPartner' as 'Territory Partner', q.'PMTeam.ProxyOfficer' as 'Proxy Officer',\n(case\n    when date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") == \"1970-01-01\" then 999999\n    else date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) \n    end) as 'Days from PFY Eliot Date', \n(case    \n    when date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") == \"1970-01-01\"\n    then \"Date Needs Review\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) > 730 then \"12+ Months\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 551 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=730 then \"06-12 Months\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 461 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=550 then \"03-06 Months\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 366 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=460 then \"00-03 Months\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 351 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=365 then \"0-14 Days\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 337 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=350 then \"15-30 Days\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 277 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=336 then \"31-60 Days\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=276 then \"61+ Days\"\n    else \"\"\n    end) as 'Time Until Renewal',\ntoDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH') as 'PFY Eliot Summary Date-Time', q.'Id' as 'Account ID', AQB__PrimaryContact__c;\nq = filter q by 'Days from PFY Eliot Date' <= 365 and 'Time Until Renewal' in {{coalesce(column(Upcoming_Eliot_Renew_8.selection, [\"Time Until Renewal\"]),\"all\").asString()}};\nq = order q by 'PFY Eliot Summary Date-Time' asc;\nq = limit q 10000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"rgb(225, 229, 238)","borderWidth":1,"cell":{"backgroundColor":"rgb(242, 246, 250)","fontColor":"#091A3E","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"rgb(242, 246, 250)","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"rgb(169, 183, 199)","innerMinorBorderColor":"rgb(225, 229, 238)","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#FFFFFF","showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Upcoming_Eliot_Renew_2":{"broadcastFacet":true,"groups":[],"label":"Past Due Eliot Renewals","numbers":[],"query":"q = load \"Eliot_Society_Status\";\nq = filter q by 'CFY_Eliot_Status' in [\"Downgrade\", \"Unrenewed\"] or ('Contact.ARCH_CFY_Annual_Fund_Pledged_Credit__c' > 0 and 'CFY_Eliot_Status' == \"Pledge Not Paid\");\nq = foreach q generate q.'Name' as 'Name', 'Contact.Name' as 'Primary Contact Name', 'CFY_Eliot_Status', 'CFYEliot.AQB__Date__c' as 'CFY Summary Date', q.'ARCH_CFY_Annual_Fund_Recognition_Credit__c' as 'ARCH_CFY_Annual_Fund_Recognition_Credit__c', \n(case\n    when date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") == \"1970-01-01\"\n    then \"Date Needs Review\"\n    else date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") \n    end) as 'PFY Renewal Date', \nq.'PFYEliot.SUM_ARCH_Selected_Fiscal_Year_Total__c' as 'PFY Amount', q.'PFYEliot.PFY_Giving_Level' as 'PFY Level', q.'AQB__OpenOpps__c' as 'AQB__OpenOpps__c',  q.'ARCH_PrimaryGiftOfficerName__c' as 'Primary Gift Officer', q.'PMTeam.TerritoryPartner' as 'Territory Partner', q.'PMTeam.ProxyOfficer' as 'Proxy Officer',\n(case\n    when date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") == \"1970-01-01\" then 999999\n    else date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) \n    end) as 'Days from PFY Eliot Date', \n(case    \n    when date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") == \"1970-01-01\" then \"Date Needs Review\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) > 425 then \"61+ Days\" -- > 730 then \"12+ Months\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 395 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=425 then \"31-60 Days\" -- <=730 then \"06-12 Months\