nal AR',\n    (case\n        when q.'Days Since Last Substantive Final Activity Report' >= 1 and q.'Days Since Last Substantive Final Activity Report' <= 90 then \"00-03 Months\"\n        when q.'Days Since Last Substantive Final Activity Report' >= 91 and q.'Days Since Last Substantive Final Activity Report' <= 180 then \"03-06 Months\"\n        when q.'Days Since Last Substantive Final Activity Report' >= 181 and q.'Days Since Last Substantive Final Activity Report' <= 365 then \"06-12 Months\"\n        when q.'Days Since Last Substantive Final Activity Report' >= 366 then \"12+ Months\"\n        end) as 'Months Since Last Subs. Final AR',\n    q.'Account.Id' as 'Account.Id';\n\n--group by months since last subs. ar\nq2 = group q1 by 'Months Since Last Subs. Final AR';\nq2 = foreach q2 generate q2.'Months Since Last Subs. Final AR' as 'Months Since Last Subs. Final AR', count(q1) as Count;\nq2 = order q2 by 'Months Since Last Subs. Final AR' asc;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":false,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]},"description":"Accounts where days since last substantive activity report is greater than 0, grouped by months since the occurance\n"}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"Months Since Last Substantive AR","align":"center","subtitleLabel":""},"trellis":{"f