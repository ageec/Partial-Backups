umberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"step":"Prospect_Status_Stew_2","totals":true,"verticalPadding":8},"type":"table"},"table_57":{"parameters":{"borderColor":"rgb(225, 229, 238)","borderWidth":1,"cell":{"backgroundColor":"rgb(242, 246, 250)","fontColor":"rgb(22, 50, 92)","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"rgb(242, 246, 250)","exploreLink":false,"header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"rgb(169, 183, 199)","innerMinorBorderColor":"rgb(225, 229, 238)","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#FFFFFF","showActionMenu":true,"showRowIndexColumn":false,"step":"Account_with_Open_PG_1","totals":true,"verticalPadding":8},"type":"table"},"table_58":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["AccountInfo.Account.ARCH_Account_ID__c","AccountInfo.Account.Name","User.Name","User.IsActive","AQB__Role__c","AQB__Active__c","Account.PrimaryGiftOfficer.Name","Account.PrimaryGiftOfficerRMT.Name","Account.PrimaryGiftOfficerRMT.AQB__Role__c","Account.PrimaryGiftOfficer.WUSTLKey","AccountInfo.Account.Id","Id"],"customBulkActions":[],"evenRowColor":"#f4f6f9","exploreLink":false,"header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","showActionMenu":true,"showRowIndexColumn":false,"step":"User_Inactive_but_RM_2","totals":true,"verticalPadding":8},"type":"table"},"table_59":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f4f6f9","exploreLink":false,"header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","showActionMenu":true,"showRowIndexColumn":false,"step":"Opportunity_where_Ow_2","totals":true,"verticalPadding":8},"type":"table"},"text_3":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#020821","size":"16px"},"insert":"This tab provides information about Prospect Lists—including Prospect Outreach and Annual Giving Prospect List record types—and related objects like Prospects, Prospect User Visitors, and Prospect Contact Visitors. The ‘Primary Visitor’ filter can be used by Gift Officers to view their Prospect Lists and the ‘Coordinator’ filter can help organizers view any Prospect Lists on which they collaborate. One or multiple Prospect Lists can be viewed at a time using filters on Prospect List. When Users filter Prospect Lists at the top of this tab, Detail Views below will update to show only Prospects, User Visitors, and Contact Visitors that align with those criteria.  Questions? Submit a case or reach out to askarch@wustl.edu.."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_2":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"16px","color":"#020821"},"insert":"This tab provides information about Opportunities and the key metrics. These include My Open Opportunities by Stage/Days in Stage, My Opportunities Win/Loss Ration, My Opportunities by Faculty Partner and My Faculty Approvals Awaiting Outreach. "},{"attributes":{"size":"16px","color":"#020821","bold":true},"insert":"Grateful Patient opportunities are exculded by default"},{"attributes":{"size":"16px","color":"#020821"},"insert":". To view key metrics specific to the Grateful Patient Opportunity Record Type for an individual Gift Officer, modify the 'Gift Officer' and 'Opportunity Record Type' filters. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_5":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ffffff","size":"20px"},"insert":"Detail View"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_4":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ffffff","size":"20px"},"insert":"My Open Opportunities by Stage/Days in Stage"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_7":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#020821","size":"16px"},"insert":"This tab provides information about any Open Pledge from Accounts in a particular portfolio. The Transaction Date Due filter can group expected payments in a variety of ways such as overdue payments, payments expected this fiscal year or payments expected in the upcoming months. The Amount shows the donors planned payments while the Balance shows if they have the full amount remaining to pay or a portion. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_6":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ffffff","size":"20px"},"insert":"Amount & Count by Gift Officer"},{"attributes":{"align":"left"},"insert":"\n"}