' == \"Household\";\nq = foreach q generate  q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'Account.Name' as 'Account.Name', q.'Account.PrimaryGiftOfficer.Name' as 'Account.PrimaryGiftOfficer.Name', 'Account.PrimaryGiftOfficerRMT.Name' as 'Primary Gift Officer PM Team Number', 'Account.PrimaryGiftOfficerRMT.AQB__Role__c' as 'Primary Gift Officer Role', 'Account.PrimaryGiftOfficer.WUSTLKey' as 'Primary Gift Officer WUSTL Key', q.'Account.AQB__ProspectStatus__c' as 'Account.AQB__ProspectStatus__c', q.'Account.Id' as 'Account.Id';\nq = order q by 'Account.Name' asc;\nq = limit q 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f4f6f9","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"Accounts_with_no_act_1":{"broadcastFacet":true,"groups":[],"label":"Accounts with no activities in 6 months table","numbers":[],"query":"--load accounts info dataset \nq = load \"Account_Info\";\nq = filter q by 'PMTeam.RMT_Member_Name_Role_Active' is not null;\nq = foreach q generate q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'Account.Id' as 'Account.Id', q.'Account.Name' as 'Account.Name', q.'Account.PrimaryGiftOfficer.Name' as 'Account.PrimaryGiftOfficer.Name', 'Account.PrimaryGiftOfficerRMT.Name' as 'Primary Gift Officer PM Team Number', 'Account.PrimaryGiftOfficerRMT.AQB__Role__c' as 'Primary Gift Officer Role', 'Account.PrimaryGiftOfficer.WUSTLKey' as 'Primary Gift Officer WUSTL Key';\n\n\n--load activities dataset to get last completed activity date\nq2 = load \"Activities\";\nq2 = filter q2 by 'AccountRowNumber' == 1 and ('Account.Account.ARCH_MedProspect__c' == \"false\" or 'Account.Account.ARCH_MedProspect__c' is null);\nq2 = foreach q2 generate q2.'Account.Account.Name' as 'Account.Account.Name', q2.'AccountRowNumber' as 'AccountRowNumber', \n(case\n    when q2.'LastCompletedActivityDate' == \"1900-01-01\" then \"-\"\n    else substr(q2.'LastCompletedActivityDate', 1,10)\n    end) as 'Last Completed Activity Date',\n(case\n    when len(q2.'LastCompletedActivityDate') >11 then date_diff(\"day\",toDate(q2.'LastCompletedActivityDate', \"yyyy-MM-dd HH:mm:ss\"),now())\n    when len(q2.'LastCompletedActivityDate') >1 and (q2.'LastCompletedActivityDate' != \"1900-01-01\" || q2.'LastCompletedActivityDate' is null) then date_diff(\"day\",toDate(q2.'LastCompletedActivityDate', \"yyyy-MM-dd\"),now())\n    else 99999\n    end) as 'Days Since Last Completed Activity',\n q2.'AccountId' as 'AccountId';\n\n\n--join Account Info and Activities datasets\nq3 = cogroup q by 'Account.Id' left, q2 by 'AccountId';\nq3 = foreach q3 generate first(q.'Account.AQC_Account_ARCH_ID__c') as 'Account.AQC_Account_ARCH_ID__c', first(q.'Account.Name') as 'Account.Name', first(q.'Account.PrimaryGiftOfficer.Name') as 'Account.PrimaryGiftOfficer.Name', first(q.'Primary Gift Officer PM Team Number') as 'Primary Gift Officer PM Team Number', first(q.'Primary Gift Officer Role') as 'Primary Gift Officer Role', first(q.'Primary Gift Officer WUSTL Key') as 'Primary Gift Officer WUSTL Key', first(q2.'Last Completed Activity Date') as 'Last Completed Activity Date', coalesce(first(q2.'Days Since Last Completed Activity'), 99999) as 'Days Since Last Completed Activity', coalesce(q.'Account.Id', q2.'AccountId') as 'Account ID';\nq3 = filter q3 by 'Days Since Last Completed Activity' > 180;\nq3 = order q3 by ('Days Since Last Completed Activity' desc, 'Account.Name' asc);\nq3 = limit q3 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"Accounts_with_no_pho_2":{"broadcastFacet":true,"datasets":[{"name":"Account_Info"}],"isGlobal":false,"label":"Accounts with no phone number summary","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[],"rowTotals":[],"sourceFilters":{"Account_Info":{"filters":[["PMTeam.User.Name",[],"isnotnull"],["Account.PrimaryContact.Phone",[],"isnull"],["Account.SecondaryContact.Phone",[],"isnull"],["Account.AccountRecordType.Name",["Household"],"in"]]}},"sources":[{"columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["all"],"joins":[],"name":"Account_Info"}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":