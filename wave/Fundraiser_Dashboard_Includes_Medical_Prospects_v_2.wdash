', Days_Until_Due as 'Days until due', AQB__Date__c as 'Date', 'Account.Account.Id', 'Id' as 'Id', \"Activity Report\" as 'Record Type';\n\nq2 = load \"Activities\";\nq2 = filter q2 by Days_Until_Due <0 and ActivityDate is not null and date('ActivityDate_Year', 'ActivityDate_Month', 'ActivityDate_Day') in [\"3 fiscal_year ago\"..\"current fiscal_year\"]  and ARCH_Event_Ended__c == \"false\" and  'Account.Account.Name' is not null and 'User.Name' is not null;\nq2 = foreach q2 generate 'Account.Account.Name' as 'Account Name', coalesce('ActivityType',\"-\") as 'Type', AQB__Subject__c as 'Subject', 'User.Name' as 'Assigned To', 'Months_Until_Due' as 'Time Until Due',  Days_Until_Due as 'Days until due', ActivityDate as 'Date', 'Account.Account.Id', 'Id' as 'Id', \"Activity\" as 'Record Type';\n\nq3 = union q1, q2;\nq3 = filter q3 by coalesce(Type,\"-\") in {{coalesce(column(Upcoming_Activity_Re_1.selection, [\"Type\"]),\"all\").asString()}} and 'Time Until Due' in {{coalesce(column(Upcoming_Activities__8.selection, [\"Time Until Due\"]),\"all\").asString()}} and 'Record Type' in {{column(Activity_Report_or_A_1.selection, [\"Display\"]).asString()}};\nq3 = order q3 by 'Time Until Due' asc;\nq3 = limit q3 10000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"rgb(242, 246, 250)","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"rgb(169, 183, 199)","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","showActionMenu":true,"showRow