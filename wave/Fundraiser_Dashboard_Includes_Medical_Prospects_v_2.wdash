n\nq2 = load \"Prospects_Info\";\nq2 = foreach q2 generate 'Account.Account.Id' as 'Account.Account.Id', 'Account.Account.Name' as 'Account.Account.Name', Status__c as Status__c, ARCH_Fiscal_Year__c as ARCH_Fiscal_Year__c, Current_Fiscal_Year as Current_Fiscal_Year, CFY_ARCH_OutreachHistoryRollup__c_Sum_String as CFY_ARCH_OutreachHistoryRollup__c_Sum_String, Account_Row_Number as Account_Row_Number, Last_Prospect_Outreach_Date, Outreach_History_Rollup_Active_Prospect_List_Name_List, Active_Prospect_List, ARCH_Outreach_History_Rollup__c;\n--q2 = filter q2 by ARCH_Fiscal_Year__c == Current_Fiscal_Year;\n\nq = cogroup q1 by 'Account.Id' left, q2 by 'Account.Account.Id';\nq = foreach q generate first(q1.'Account.Name') as 'Account Name', first(q1.'Account.PrimaryContact.Name') as 'Account.PrimaryContact.Name', first(q1.'Account.PrimaryGiftOfficer.Name') as 'Primary Gift Officer Name', first(q1.'Account.ARCH_Metro_Area__c') as 'Metro Area', \n(case\n    when first(q2.'CFY_ARCH_OutreachHistoryRollup__c_Sum_String') is not null then first(q2.'CFY_ARCH_OutreachHistoryRollup__c_Sum_String') \n    else \"Not in Prospect List\"\n    end) as 'CFY Outreach Count', \n(case\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 1 then \"01\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 2 then \"02\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 3 then \"03\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 4 then \"04\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 5 then \"05\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 6 then \"06\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 7 then \"07\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 8 then \"08\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 9 then \"09\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') > 0 then number_to_string(sum(q2.'ARCH_Outreach_History_Rollup__c'), \"#,###\") \n    else \"00\"\n    end) as 'Outreach History Rollup Sum2',\n    (case\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') > 0 then sum(q2.'ARCH_Outreach_History_Rollup__c') \n    else 0\n    end)  as 'Total Outreach Count',\n first(q2.Last_Prospect_Outreach_Date) as 'Last Prospect Outreach History Date', first(q2.Outreach_History_Rollup_Active_Prospect_List_Name_List) as 'Outreach History Rollup Active Prospect Lists', first(q1.OverallAccountCapacityorWealthEngineCapacity) as 'Overall Account Capacity', \n (case\n    when first(q2.'Active_Prospect_List') is not null then first(q2.'Active_Prospect_List') \n    else \"false\"\n    end) as 'In Active Prospect List?',\ncoalesce(q1.'Account.Id', q2.'Account.Account.Id') as 'Account ID', first(q1.'Account.AQB__PrimaryContact__c') as 'Account.AQB__PrimaryContact__c';\n --filter by chart selection\nq = filter q by  'Outreach History Rollup Sum2' in {{coalesce(column(Prospect_Outreach_Hi_1.selection, [\"Outreach History Rollup Sum\"]),\"all\").asString()}};\n--filter by \"in active prospect list?\" list-selector selection\nq = filter q by  'In Active Prospect List?' in {{coalesce(column(ARCH_Primary_Visitor_1.selection, [\"In Active Prospect List?\"]),\"all\").asString()}};\nq = order q by 'Account Name';\nq = limit q 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Account Name","Account.PrimaryContact.Name","Metro Area","CFY Outreach Count","Total Outreach Count","Last Prospect Outreach History Date","Outreach History Rollup Active Prospect Lists"],"customBulkActions":[],"evenRowColor":"#f4f6f9","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{"Total O