ers":{"compact":false,"displayMode":"filter","exploreLink":false,"filterStyle":{"titleColor":"#020821","valueColor":"#BA0C2F"},"instant":false,"interactions":[],"showActionMenu":true,"step":"static_2","title":"Display Fields"},"type":"listselector"},"listselector_8":{"parameters":{"compact":false,"displayMode":"filter","exploreLink":false,"filterStyle":{"titleColor":"#020821","valueColor":"#BA0C2F"},"instant":true,"interactions":[],"measureField":"count","showActionMenu":true,"step":"Opportunity_Opportun_1","title":"Opportunity Level"},"type":"listselector"},"text_29":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#020821","size":"16px"},"insert":"This tab provides information about Activities in ARCH. To view an individual Gift Officer's assigned Activities, use the filter 'Assigned To'. To view any Activity on your portfolio, use the filter 'RMT Member Name+Role'. Individual Activities are visible and linked through the All Activities Detail View at the bottom of the page. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"listselector_3":{"parameters":{"compact":false,"displayMode":"filter","exploreLink":false,"filterStyle":{"titleColor":"#020821","valueColor":"#BA0C2F"},"instant":true,"interactions":[],"measureField":"A","showActionMenu":true,"step":"Account_AQB__Capacit_1","title":"Overall Account Capacity"},"type":"listselector"},"text_28":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#020821","size":"16px"},"insert":"This tab provides information about Gift Officer's portfolios and their respective prospect strategies. To view an individual Gift Officer's portfolio, use the filter 'RMT Member Name+Role'. To view a team of Gift Officers’ portfolios, use the filter 'RMT UA Division'. The details of each portfolio are listed in the detail view and have key fields linked for ARCH navigation. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"listselector_2":{"parameters":{"compact":false,"displayMode":"filter","exploreLink":false,"filterStyle":{"titleColor":"#020821","valueColor":"#BA0C2F"},"instant":true,"interactions":[],"measureField":"count","showActionMenu":true,"step":"PMTeam_User_Name_1_1","title":"Assigned Territory Active"},"type":"listselector"},"listselector_5":{"parameters":{"compact":false,"displayMode":"filter","exploreLink":false,"filterStyle":{"titleColor":"#020821","valueColor":"#BA0C2F"},"instant":true,"interactions":[],"measureField":"Count","showActionMenu":true,"step":"Upcoming_Activity_Re_1","title":"Type"},"type":"listselector"},"listselector_4":{"parameters":{"compact":false,"displayMode":"filter","exploreLink":false,"filterStyle":{"titleColor":"#020821","valueColor":"#BA0C2F"},"instant":true,"interactions":[],"measureField":"Count","showActionMenu":true,"step":"Account_Account_AQB__1","title":"Type"},"type":"listselector"},"filterpanel_96":{"parameters":{"filterItemOptions":{"propertyColor":"#020821","valueColor":"#BA0C2F"},"filters":[{"dataset":{"name":"Account_Info"},"field":"Account.Primary_Contact_Interests.AllContactInterestTypes"}],"showAllFilters":false},"type":"filterpanel"},"text_25":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ffffff","size":"20px"},"insert":"Event Invitees with No Response (Campaign Member Status Blank or Sent; Event in next 180 Days)"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_24":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#020821","size":"16px"},"insert":"This tab provides information about Opportunities. To view an individual Gift Officer's opportunities, use the filter 'Opp Team Member Name+Role All'. To view a team of Gift Officers’ Opportunities, use the filter 'Opp Team UA Division All'. "},{"attributes":{"color":"#020821","bold":true},"insert":"Grateful Patient opportunities are exculded by default."},{"attributes":{"color":"#020821","size":"16px"},"insert":" Note the visualizations respond to the filter choices and highlight Opportunities Days in Current Stage, Opportunities by Gift Officer and School/Unit. Individual Opportunities are visible and linked through the Opportunity Detail View at the bottom of the page. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"filterpanel_97":{"parameters":{"filterItemOptions":{"propertyColor":"#020821","valueColor":"#BA0C2F"},"filters":[{"dataset":{"name":"Account_Info"},"field":"Account.Primary_Contact_Interests.AllContactInterestGroups"}],"showAllFilters":false},"type":"filterpanel"},"text_27":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"16px","color":"#020821"},"insert":"This tab provides information about Activity Reports in ARCH. To view an individual Gift Officer's Activity Report activity, use the filter 'Gift Officer'. To view a team of gift officers Activity Reports, use the filter 'Gift Officer' and select multiple names. To view Activity Report activity for an Account to which a Gift Officer is assigned, use the filter 'RMT Member Name+Role'. To view Activity Report activity for an Account to which a team of Gift Officers are assigned, use the filter 'RMT UA Division'. Note the visualizations respond to the filter selections and highlight Activity Report activity by month and by Gift Officer (and Purpose). Individual Activity Reports are visible and linked through the Activity Report by Contacts Detail View at the bottom of the page. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"filterpanel_98":{"parameters":{"filterItemOptions":{"propertyColor":"#020821","valueColor":"#BA0C2F"},"filters":[{"dataset":{"name":"Account_Info"},"field":"Account.Secondary_Contact_Interests.AllContactInterestTypes"}],"showAllFilters":false},"type":"filterpanel"},"text_26":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#020821","size":"14px"},"insert":"This tab provides information about Recent Gifts from Accounts in a particular portfolio. "},{"attributes":{"color":"#020821","size":"14px","bold":true},"insert":"Recent Gifts is defined as gifts or pledges processed in the previous 90 days."},{"attributes":{"color":"#020821","size":"14px"},"insert":" Note that all Transaction Types are either Payment, Grant Payment, Pledge, Pledge Soft Credit, or Soft Credit. To view a specific portfolio, use the 'RMT Member Name + Role' filter. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"filterpanel_99":{"parameters":{"filterItemOptions":{"propertyColor":"#020821","valueColor":"#BA0C2F"},"filters":[{"dataset":{"name":"Account_Info"},"field":"Account.Secondary_Contact_Interests.AllContactInterestGroups"}],"showAllFilters":false},"type":"filterpanel"},"text_21":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ffffff","size":"20px"},"insert":"Amount & Count by Fundraising Lane"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_20":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ffffff","size":"20px"},"insert":"Amount & Count by Classification"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_23":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#020821","size":"16px"},"insert":"This tab provides information about a Gift Officer or team of Gift Officers’ progress towards key metrics. These include Opportunity metrics—Count of Opportunities Closed/Won, Count of Opportunities Solicited, Opportunity Amount Closed/Won, and Opportunity Solicited Amount—and Substantive and Qualification Activity Report result metrics. "},{"attributes":{"color":"#020821"},"insert":"Note that Opportunities with Stage of \"Closed - Not Asked\" are excluded."},{"attributes":{"color":"#020821","size":"16px"},"insert":" To view key metrics for an individual Gift Officer, modify the 'Gift Officer' filter. To view a team of Gift Officers’ key metrics, modify the 'UA Division' filter. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_22":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ffffff","size":"14px"},"insert":"This tab provides information about a Gift Officer or team of Gift Officers’ progress towards key metrics. It is the visualization of key metrics for either a Gift Officer or team of Gift Officers. To view key metrics for an individual Gift Officer, modify the 'Gift Officer' filter. To view a team of Gift Officers’ key metrics, modify the 'UA Division' filter. Visualizations on this tab are meant to compliment the Progress Towards Goals Tab. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"size":"14px"},"insert":"."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"filterpanel_90":{"parameters":{"filterItemOptions":{"propertyColor":"#020821","valueColor":"#BA0C2F"},"filters":[{"dataset":{"name":"Education"},"field":"PreferredGraduationYear"}],"showAllFilters":false},"type":"filterpanel"},"filterpanel_91":{"parameters":{"filterItemOptions":{"propertyColor":"#020821","valueColor":"#BA0C2F"},"filters":[{"dataset":{"name":"Activity_Report_Info"},"field":"ARContactParticipant.Contact.Name"}],"showAllFilters":false},"type":"filterpanel"},"filterpanel_92":{"parameters":{"f