e,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"map":"World Countries","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"CFY_Opps_1":{"broadcastFacet":true,"groups":[],"label":"CFY Opps","numbers":[],"query":"q = load \"Opportunity_Info\";\nq = filter q by (date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"] \n|| date('Opportunity.AQC_Date_Asked__c_Year', 'Opportunity.AQC_Date_Asked__c_Month', 'Opportunity.AQC_Date_Asked__c_Day') in [\"current fiscal_year\"..\"current fiscal_year\"] \n|| date('Opportunity.AQC_Projected_Ask_Date__c_Year', 'Opportunity.AQC_Projected_Ask_Date__c_Month', 'Opportunity.AQC_Projected_Ask_Date__c_Day') in [\"current fiscal_year\"..\"current fiscal_year\"]);\nq = filter q by '{{cell(static_1.selection, 0, \"Value\").asString()}}' in {{coalesce(column(PMTeam_User_Name__Ro_1.selection, [\"PMTeam.User.Name\"]), \"all\").asString()}};\n--Solicited Filter\nq1 = filter q by  'Opportunity.StageName'  in [\"Solicitation\", \"Solicitation (PG)\", \"Negotiation/Review\", \"LOI/Concept Paper Submittal\", \"Proposal Preparation\", \"Proposal Submittal\"];\n--Planned Filter\nq2 = filter q by ('Opportunity.StageName' not in [\"Closed - Funded No Value\", \"Closed - Funded Unsolicited\", \"Closed - NPR Funded\", \"Closed - Not Asked\", \"Closed Deceased\", \"Closed Won\", \"Closed/Invalid\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\", \"Solicitation (PG)\", \"Solicitation\", \"Negotiation/Review\", \"Closed - Lost\", \"LOI/Concept Paper Submittal\", \"Proposal Preparation\", \"Proposal Submittal\"] || 'Opportunity.StageName' is null);\n--Closed/Won Filter\nq3 = filter q by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] and date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\n--Solicited\nq1 = foreach q1 generate case when q1.'Opportunity.StageName' in [\"Solicitation\", \"Solicitation (PG)\", \"Negotiation/Review\", \"LOI/Concept Paper Submittal\", \"Proposal Preparation\", \"Proposal Submittal\"] then \"2-Solicited\" end as 'Criteria', q1.'Opportunity.Amount' as 'Opportunity.Amount';\n--Planned\nq2 = foreach q2 generate case when (q2.'Opportunity.StageName' not in [\"Closed - Funded No Value\", \"Closed - Funded Unsolicited\", \"Closed - NPR Funded\", \"Closed - Not Asked\", \"Closed Deceased\", \"Closed Won\", \"Closed/Invalid\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\", \"Solicitation (PG)\", \"Solicitation\", \"Negotiation/Review\", \"Closed - Lost\", \"LOI/Concept Paper Submittal\", \"Proposal Preparation\", \"Proposal Submittal\"] || q2.'Opportunity.StageName' is null) then \"3-Planned\" end as 'Criteria', q2.'Opportunity.Amount' as 'Opportunity.Amount'; \n--Closed/Won\nq3 = foreach q3 generate \n    case \n    when (q3.'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] and date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"])\n    then \"1-Closed/Won\" \n    end as 'Criteria', q3.'Opportunity.Amount' as 'Opportunity.Amount';\nq = cogroup q1 by 'Criteria' full, q2 by 'Criteria' full, q3 by 'Criteria';\nq = foreach q generate coalesce(q1.'Criteria', q2.'Criteria', q3.'Criteria') as 'Criteria', sum(q1.'Opportunity.Amount') as 'CFY Opportunities $ Open Solicited', sum(q2.'Opportunity.Amount') as 'CFY Opportunities $ Open Planned', sum(q3.'Opportunity.Amount') as 'CFY Opportunities $ Closed-Won';\nq = foreach q generate q.'Criteria' as 'Criteria', coalesce(q.'CFY Opportunities $ Open Solicited', q.'CFY Opportunities $ Open Planned', q.'CFY Opportunities $ Closed-Won') as 'CFY Amount';\nq = order q by 'Criteria' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"top-center","inside":false},"axisMode":"sync","totalSumMode":"none","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]},"description":"Metric: SUM(Opportunity Amount)\nGoal: Goal Currency Amount\nClose Date OR Date Asked OR Projected Ask Date in Current Fiscal Year. \nStage excludes Closed-Lost\nGoal Date in Current Fiscal Year\nGoal Classification = \"Opportunity Amount Closed/Won\""}},"visualizationType":"stackvbar","title":{"fontSize":18,"subtitleFontSize":11,"label":"Path to Goal","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":true,"referenceLines":[{"color":"#215732","label":{"data":{"displayTemplate":"Close/Won Goal - [CFY Goal]","compact":false,"sourceType":"result","step":"CFY_Goal_1"},"type":"dynamic"},"value":{"data":{"field":"CFY Goal","sourceType":"result","step":"CFY_Goal_1"},"type":"dynamic"}}],"title":"","customDomain":{"showDomain":false}},"normalize":false,"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"