\"Closed - Lost\", \"LOI/Concept Paper Submittal\", \"Proposal Preparation\", \"Proposal Submittal\"] || 'Opportunity.StageName' is null);\n--Closed/Won Filter\nq3 = filter q by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] and date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\n--Goal\ng = filter g by date('AQB__LastGoalIntervalDate__c_Year', 'AQB__LastGoalIntervalDate__c_Month', 'AQB__LastGoalIntervalDate__c_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\ng = filter g by 'AQB__Classification__c' == \"Opportunity Amount Closed/Won\";\ng = filter g by '{{cell(static_1.selection, 0, \"GoalValue\").asString()}}' in {{coalesce(column(PMTeam_User_Name__Ro_1.selection, [\"PMTeam.User.Name\"]), \"all\").asString()}};\nq = cogroup q1 by all full, q2 by all full, q3 by all full, g by all;\nq = foreach q generate (coalesce(sum(q1.'Opportunity.Amount'),0) + coalesce(sum(q2.'Opportunity.Amount'),0) + coalesce(sum(q3.'Opportunity.Amount'),0)) / sum(g.'AQB__GoalCurrencyAmount__c') as '% to Goal';\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"CFY_Activity_Report__10":{"broadcastFacet":true,"datasets":[{"name":"Activity_Report_Info"}],"isGlobal":false,"label":"C