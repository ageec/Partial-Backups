ity.CloseDate_Day') in [\"5 fiscal_years ago\"..\"100 fiscal_years ahead\"];\nq = filter q by '{{cell(static_1.selection, 0, \"Value\").asString()}}' in {{coalesce(column(PMTeam_User_Name__Ro_1.selection, [\"PMTeam.User.Name\"]), \"all\").asString()}};\nq = group q by ('Opportunity.Days_In_Current_Stage', 'Opportunity.Opportunity_Stage_Category');\nq = foreach q generate q.'Opportunity.Days_In_Current_Stage' as 'Opportunity.Days_In_Current_Stage', q.'Opportunity.Opportunity_Stage_Category' as 'Opportunity.Opportunity_Stage_Category', {{cell(Map_Type_Toggle_2.selection, 0, \"Value\").asString()}} as {{cell(Map_Type_Toggle_2.selection, 0, \"Display\").asString()}};\nq = order q by ('Opportunity.Days_In_Current_Stage' asc, 'Opportunity.Opportunity_Stage_Category' asc);\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","totalSumMode":"absolute","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"stackvbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"Opportunity Count/Amount by Months in Stage Segmented by Stage Category","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"normalize":false,"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":false,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Prospect_Outreach_Hi_1":{"broadcastFacet":false,"groups":[],"label":"Prospect Outreach History","numbers":[],"query":"q1 = load \"Account_Info\";\nq1 = foreach q1 generate 'Account.Id' as 'Account.Id', 'Account.Name' as 'Account.Name', 'OverallAccountCapacityorWealthEngineCapacity' as 'OverallAccountCapacityorWealthEngineCapacity';\n\nq2 = load \"Prospects_Info\";\nq2 = foreach q2 generate 'Account.Account.Id' as 'Account.Account.Id', 'Account.Account.Name' as 'Account.Account.Name', ARCH_Outreach_History_Rollup__c as ARCH_Outreach_History_Rollup__c,  Active_Prospect_List, Account_Row_Number as Account_Row_Number;\n\nq = cogroup q1 by 'Account.Id' left, q2 by 'Account.Account.Id';\nq = foreach q generate q1.'Account.Id' as 'Account.Id', \n(case\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 1 then \"01\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 2 then \"02\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 3 then \"03\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 4 then \"04\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 5 then \"05\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 6 then \"06\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 7 then \"07\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 8 then \"08\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') == 9 then \"09\"\n    when sum(q2.'ARCH_Outreach_History_Rollup__c') > 0 then number_to_string(sum(q2.'ARCH_Outreach_History_Rollup__c'), \"#,###\") \n    else \"00\"\n    end) as 'Outreach History Rollup Sum',\n(case\n    when first(q2.'Active_Prospect_List') is not null then first(q2.'Active_Prospect_List') \n    else \"false\"\n    end) as 'In Active Prospect List?';\n--filter by \"in active prospect list?\" list-selector selection\nq = filter q by  'In Active Prospect List?' in {{coalesce(column(ARCH_Primary_Visitor_1.selection, [\"In Active Prospect List?\"]),\"all\").asString()}};     \nq = order q by 'Outreach History Rollup Sum';\n\n\nq3 = group q by 'Outreach History Rollup Sum';\nq3 = foreach q3 generate \n    (case\n        when 'Outreach History Rollup Sum' is null then \"00\"\n        else 'Outreach History Rollup Sum'\n        end) as 'Outreach History Rollup Sum', \n    count() as 'Count';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":false,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]},"description":"Accounts grouped by the Sum of Prospect Outreach History Rollup, which is the count of times a prospect was reached out to in the current fiscal year. \"No Outreach\" means the account is on prospect list this current fiscal year, but has not been contacted. \"Not in Prospect List\" means the Account is not on a Prospect List in the current fiscal year. \n"}},"visualizationType":"vbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"Prospect Count by Outreach Rollup History Sum","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"sho