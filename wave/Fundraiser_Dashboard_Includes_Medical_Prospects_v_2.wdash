Officer.Name';\n\n\n--load activities dataset to get last completed activity date\nq2 = load \"Activities\";\nq2 = filter q2 by 'AccountRowNumber' == 1;\nq2 = foreach q2 generate q2.'Account.Account.Name' as 'Account.Account.Name', q2.'AccountRowNumber' as 'AccountRowNumber', \n(case\n    when q2.'LastCompletedActivityDate' == \"1900-01-01\" then \"-\"\n    else substr(q2.'LastCompletedActivityDate', 1,10)\n    end) as 'Last Completed Activity Date',\n(case\n    when len(q2.'LastCompletedActivityDate') >11 then date_diff(\"day\",toDate(q2.'LastCompletedActivityDate', \"yyyy-MM-dd HH:mm:ss\"),now())\n    when len(q2.'LastCompletedActivityDate') >1 and (q2.'LastCompletedActivityDate' != \"1900-01-01\" || q2.'LastCompletedActivityDate' is null) then date_diff(\"day\",toDate(q2.'LastCompletedActivityDate', \"yyyy-MM-dd\"),now())\n    else 99999\n    end) as 'Days Since Last Completed Activity',\n q2.'AccountId' as 'AccountId';\n\n\n--join Account Info and Activities datasets\nq3 = cogroup q by 'Account.Id' left, q2 by 'AccountId';\nq3 = foreach q3 generate first(q.'Account.Name') as 'Account.Name', first(q.'Account.PrimaryGiftOfficer.Name') as 'Account.PrimaryGiftOfficer.Name', first(q2.'Last Completed Activity Date') as 'Last Completed Activity Date', coalesce(first(q2.'Days Since Last Completed Activity'), 99999) as 'Days Since Last Completed Activity', coalesce(q.'Account.Id', q2.'AccountId') as 'Account ID';\nq3 = filter q3 by 'Days Since Last Completed Activity' > 180;\n\n--count records\nq4 = group q3 by all;\nq4 = foreach q4 generate count(q3) as Count;\n\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"rgb(242, 246,