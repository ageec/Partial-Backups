{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Account_with_Open_PG_1":{"broadcastFacet":true,"groups":[],"label":"Account with Open PG Opp but No PG RMT Officer Table","numbers":[],"query":"q = load \"Opportunity_Info\";\nq = filter q by  ('Opportunity.StageName' not in [\"Closed - Funded No Value\", \"Closed - Funded Unsolicited\", \"Closed - NPR Funded\", \"Closed - Not Asked\", \"Closed Deceased\", \"Closed Won\", \"Closed/Invalid\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\",  \"Closed - Lost\"] || 'Opportunity.StageName' is null) and 'Opportunity.OppRecordType.Name' == \"Planned Gift\" and ('Opportunity.OpportunityTeamMember.TeamMemberRole' not in [\"Planned Giving Officer\"] || 'Opportunity.OpportunityTeamMember.TeamMemberRole' is null) and ('Opportunity.OpportunityTeamMember.User.Division' not in [\"Planned Giving\"] || 'Opportunity.OpportunityTeamMember.User.Division' is null);\nq = filter q by '{{cell(static_1.selection, 0, \"Value\").asString()}}' in {{coalesce(column(PMTeam_User_Name__Ro_1.selection, [\"PMTeam.User.Name\"]), \"all\").asString()}};\nq = foreach q generate q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'Account.Name' as 'Account.Name', q.'Opportunity.Name' as 'Opportunity.Name', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', 'Account.PrimaryGiftOfficer.Name', 'Account.PrimaryGiftOfficerRMT.Name' as 'Primary Gift Officer PM Team Number', 'Account.PrimaryGiftOfficerRMT.AQB__Role__c' as 'Primary Gift Officer Role', 'Account.PrimaryGiftOfficer.WUSTLKey' as 'Primary Gift Officer WUSTL Key',  q.'Account.Id' as 'Account.Id', q.'Opportunity.Id' as 'Opportunity.Id';\nq = order q by 'Account.Name';\nq = limit q 2000;  ","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"CFY_Opps_Total_1":{"broadcastFacet":true,"groups":[],"label":"CFY Opps Total","numbers":[],"query":"q = load \"Opportunity_Info\";\nq = filter q by (date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"] \n|| date('Opportunity.AQC_Date_Asked__c_Year', 'Opportunity.AQC_Date_Asked__c_Month', 'Opportunity.AQC_Date_Asked__c_Day') in [\"current fiscal_year\"..\"current fiscal_year\"] \n|| date('Opportunity.AQC_Projected_Ask_Date__c_Year', 'Opportunity.AQC_Projected_Ask_Date__c_Month', 'Opportunity.AQC_Projected_Ask_Date__c_Day') in [\"current fiscal_year\"..\"current fiscal_year\"]);\nq = filter q by '{{cell(static_1.selection, 0, \"Value\").asString()}}' in {{coalesce(column(PMTeam_User_Name__Ro_1.selection, [\"PMTeam.User.Name\"]), \"all\").asString()}};\n--Solicited Filter\nq1 = filter q by  'Opportunity.StageName'  in [\"Solicitation\", \"Solicitation (PG)\", \"Negotiation/Review\", \"LOI/Concept Paper Submittal\", \"Proposal Preparation\", \"Proposal Submittal\"];\n--Planned Filter\nq2 = filter q by ('Opportunity.StageName' not in [\"Closed - Funded No Value\", \"Closed - Funded Unsolicited\", \"Closed - NPR Funded\", \"Closed - Not Asked\", \"Closed Deceased\", \"Closed Won\", \"Closed/Invalid\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\", \"Solicitation (PG)\", \"Solicitation\", \"Negotiation/Review\", \"Closed - Lost\", \"LOI/Concept Paper Submittal\", \"Proposal Preparation\", \"Proposal Submittal\"] || 'Opportunity.StageName' is null);\n--Closed/Won Filter\nq3 = filter q by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] and date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq = cogroup q1 by all full, q2 by all full, q3 by all;\nq = foreach q generate coalesce(sum(q1.'Opportunity.Amount'),0) + coalesce(sum(q2.'Opportunity.Amount'),0) + coalesce(sum(q3.'Opportunity.Amount'),0) as 'CFY Opportunities $ Total';\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"Overall_Account_Capa_1":{"broadcastFacet":true,"groups":[],"label":"Overall Account Capacity","numbers":[],"query":"q = load \"Account_Info\";\nq = filter q by  'PMTeam.RMT_Member_Name_Role_Active' is not null;\nq = group q by 'OverallAccountCapacityorWealthEngineCapacity';\nq = foreach q generate 'OverallAccountCapacityorWealthEngineCapacity' as 'OverallAccountCapacityorWealthEngineCapacity', count() as Count;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_5":{"broadcastFacet":true,"groups":[],"label":"Portfolio","numbers":[],"query":"--load accounts info dataset to get last completed AR data\nq = load \"Account_Info\";\nq = filter q by 'PMTeam.RMT_Member_Name_Role_Active' is not null;\nq = foreach q generate q.'Account.Name' as 'Account.Name', 'Account.PrimaryContact.Name', q.'Account.PrimaryGiftOfficer.Name' as 'Account.PrimaryGiftOfficer.Name', q.'Account.AQB__ProspectStatus__c' as 'Account.AQB__ProspectStatus__c', q.'Account.ARCH_Active_Plan__c' as 'Active Prospect Strategy Plan', q.'ProspectStrategyPlan.Name' as 'Prospect Strategy Link', q.'ProspectStrategyPlan.ARCH_Note_Clean__c' as 'Prospect Strategy Note', q.'ActiveStewardshipPlan' as 'ActiveStewardshipPlan', q.'StewardshipPlan.Name' as 'StewardshipPlan.Name', q.'StewardshipPlan.ARCH_PlanObjective__c' as 'StewardshipPlan.ARCH_PlanObjective__c',\nsubstr(q.'Account.ActivityReport.Last_Final_Activity_Report_Date', 1,10) as 'Last Final AR Date',\n(case\n    when len(q.'Account.ActivityReport.Last_Final_Activity_Report_Date') >11 then date_diff(\"day\",toDate(q.'Account.ActivityReport.Last_Final_Activity_Report_Date', \"yyyy-MM-dd HH:mm:ss\"),now())\n    when len(q.'Account.ActivityReport.Last_Final_Activity_Report_Date') >1 and (q.'Account.ActivityReport.Last_Final_Activity_Report_Date' != \"1900-01-01\" || q.'Account.ActivityReport.Last_Final_Activity_Report_Date' is null) then date_diff(\"day\",toDate(q.'Account.ActivityReport.Last_Final_Activity_Report_Date', \"yyyy-MM-dd\"),now())\n    else 99999\n    end) as 'Days Since Last Final AR',\n(case\n    when q.'Account.ActivityReport.Last_Substantive_Final_Activity_Report_Date' == \"1900-01-01\" then \"-\"\n    else substr(q.'Account.ActivityReport.Last_Substantive_Final_Activity_Report_Date', 1,10) \n    end) as 'Last Subs. Final AR Date',\n(case\n    when len(q.'Account.ActivityReport.Last_Substantive_Final_Activity_Report_Date') >11 then date_diff(\"day\",toDate(q.'Account.ActivityReport.Last_Substantive_Final_Activity_Report_Date', \"yyyy-MM-dd HH:mm:ss\"),now())\n    when len(q.'Account.ActivityReport.Last_Substantive_Final_Activity_Report_Date') >1 and (q.'Account.ActivityReport.Last_Substantive_Final_Activity_Report_Date' != \"1900-01-01\" || q.'Account.ActivityReport.Last_Substantive_Final_Activity_Report_Date' is null)then date_diff(\"day\",toDate(q.'Account.ActivityReport.Last_Substantive_Final_Activity_Report_Date', \"yyyy-MM-dd\"),now())\n    else 99999\n    end) as 'Days Since Last Subs. Final AR',\n--insert columns to be used in field picker interaction further down the query script\n'RMT_Division_Active_List', 'Name', 'PMTeam.Relationship_Manager_Start_Date', 'PMTeam.Relationship_Manager_End_Date', 'PMTeam.RelationshipManagerPMTeamNumber', 'PMTeam.HandoffOfficerList', 'HandoffOfficerPMTeamNumberList', 'PMTeam.QualifyingGiftOfficerList', 'PMTeam.Qualifying_Gift_Officer_Start_Date', 'PMTeam.Qualifying_Gift_Officer_End_Date', 'QualifyingGiftOfficerPMTeamNumberList', 'PMTeam.AnnualGivingOfficerList', 'PMTeam.Annual_Giving_Officer_Start_Date', 'PMTeam.Annual_Giving_Officer_End_Date', 'AnnualGivingOfficePMTeamNumberList', 'PMTeam.AnnualGivingPipelineOfficerList', 'PMTeam.Annual_Giving_Pipeline_Offcer_Start_Date', 'PMTeam.Annual_Giving_Pipeline_Officer_End_Date', 'AnnualGivingPipelineOfficerPMTeamNumberList', 'Account.AQC_Account_ARCH_ID__c', 'Account.Secondary_Account_Types_List', 'Account.PrimaryContact.LastName', 'Account.SecondaryContact.LastName', 'Account.ARCH_Total_Gifts_and_Pledges_all_types__c', 'Account.AQB__MostRecentGiftDate__c', 'Account.AQB__OpenOpps__c', 'Account.ARCH_Target_Market__c', 'Account.ARCH_Metro_Area__c', 'Account.ARCH_Territory__c', 'Account.BillingCity', 'Account.BillingState', 'Account.BillingPostalCode', 'Account.BillingCountry', 'Account.AQB__Greeting__c', 'Account.PrimaryContact.AQB__Greeting__c', 'Account.SecondaryContact.AQB__Greeting__c', 'Account.PrimaryContact.Email', 'Account.PrimaryContact.Phone', 'Account.AQB__AccountType__c','Account.AQB__Capacity__c', 'Account.ARCH_Donor_Status__c', 'Account.ARCH_CFYPFY_Eliot_Society_Member__c', 'Account.PrimaryContact.ARCH_CFY_Annual_Fund_Recognition_Credit__c', 'Account.PrimaryContact.ARCH_PFY_Annual_Fund_Recognition_Credit__c', 'PMTeam.CorpsFoundsOfficerList', 'CorpsFoundsOfficerPMTeamNumberList', 'PMTeam.DonorRelationsOfficerList', 'DonorRelationsOfficerPMTeamNumberList', 'PMTeam.