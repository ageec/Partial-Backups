Activities\";\nq2 = filter q2 by 'AccountRowNumber' == 1 and ('Account.Account.ARCH_MedProspect__c' == \"false\" or 'Account.Account.ARCH_MedProspect__c' is null);\nq2 = foreach q2 generate q2.'Account.Account.Name' as 'Account.Account.Name', q2.'AccountRowNumber' as 'AccountRowNumber', \n(case\n    when len(q2.'LastCompletedActivityDate') >11 and (q2.'LastCompletedActivityDate' != \"1900-01-01\" || q2.'LastCompletedActivityDate' is null) then date_diff(\"day\",toDate(q2.'LastCompletedActivityDate', \"yyyy-MM-dd HH:mm:ss\"),now())\n    when len(q2.'LastCompletedActivityDate') >1 and (q2.'LastCompletedActivityDate' != \"1900-01-01\" || q2.'LastCompletedActivityDate' is null) then date_diff(\"day\",toDate(q2.'LastCompletedActivityDate', \"yyyy-MM-dd\"),now())\n    else 99999\n    end) as 'Days Since Last Completed Activity',\n q2.'AccountId' as 'AccountId';\n\nq3 = cogroup q by 'Account.Id' left, q2 by 'AccountId';\nq3 = foreach q3 generate first(q.'Account.AQC_Account_ARCH_ID__c') as 'Account.AQC_Account_ARCH_ID__c', first(q.'Account.Name') as 'Account.Name', first(q.'Account.PrimaryGiftOfficer.Name') as 'Account.PrimaryGiftOfficer.Name', first(q.'Primary Gift Officer PM Team Number') as 'Primary Gift Officer PM Team Number', first(q.'Primary Gift Officer Role') as 'Primary Gift Officer Role', first(q.'Primary Gift Officer WUSTL Key') as 'Primary Gift Officer WUSTL Key', first(q.'Account.AQB__ProspectStatus__c') as 'Account.AQB__ProspectStatus__c', first(q.'Account.ActivityReport.CFY_Activity_Report_Count') as 'Account.ActivityReport.CFY_Activity_Report_Count', first(q.'Days Since Last Final Activity Report') as 'Days Since Last Final Activity Report',\n(case\n    when first(q2.'Days Since Last Completed Activity') > 0 then first(q2.'Days Since Last Completed Activity')\n    else 99999\n    end) as 'Days Since Last Complete Activity', \ncoalesce(q.'Account.Id', q2.'AccountId') as 'Account ID';\nq3 = order q3 by 'Account.Name' asc;\nq3 = limit q3 2000;","receiveFacetS