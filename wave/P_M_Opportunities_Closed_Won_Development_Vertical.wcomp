rouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q.'Account.Name') as 'grouping_Account.Name', grouping(q.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical', grouping(q.'Account.Id') as 'grouping_Account.Id', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name', grouping(q.'Opportunity.CloseDate') as 'grouping_Opportunity.CloseDate';\n\ns = filter q by 'grouping_Opportunity.Name' == 1;\nq = filter q by 'grouping_Opportunity.Name' == 0 and 'grouping_Account.AQC_Account_ARCH_ID__c' == 0 and 'grouping_Opportunity.Id' == 0 and 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Account.Name' == 0 and 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 0 and 'grouping_Account.Id' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0 and 'grouping_Opportunity.CloseDate' == 0;\nq = order q by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' asc, 'Opportunity.ClosedWonGiftBandDevelopmentVertical' asc, 'Account.Name' asc, 'Opportunity.Name' asc,  'Opportunity.CloseDate'asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Opportunity.OpportunityOwner.GiftOfficerTeam","Opportunity.OpportunityOwner.Name","Opportunity.ClosedWonGiftBandDevelopmentVertical","Account.AQC_Account_ARCH_ID__c","Account.Name","Opportunity.Name","Opportunity.CloseDate","$ - Closed/Won Amount","# - Closed/Won Count"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":175,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"Donors_by_Gift_Band__1":{"broadcastFacet":true,"groups":[],"label":"Donors by Gift Band Table","numbers":[],"query":"--load selected fy opps\nq2 = load \"Opportunity_Info\";\nq2 = filter q2 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq2 = filter q2 by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq2 = filter q2 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq2 = group q2 by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OpportunityOwner.Name');\nq2 = foreach q2 generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', sum('Opportunity.Amount') as 'Opportunity.Amount', count(q2) as Count, \n--get row number by account\nrow_number() over([..] partition by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical') order by 'Opportunity.ClosedWonGiftBandDevelopmentVertical') as AccountRowNumber; \n\n--get unique selected fiscal year accounts\nq2_a = filter q2 by AccountRowNumber == 1;\n\n--load selected previous fy opps\nq1 = load \"Opportunity_Info\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq1 = filter q1 by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_3]]\"..\"[[parameter_3]]\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq1 = group q1 by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OpportunityOwner.Name');\nq1 = foreach q1 generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', sum('Opportunity.Amount') as 'Opportunity.Amount', count(q1) as Count, \n--get row number by account\nrow_number() over([..] partition by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical') order by 'Opportunity.ClosedWonGiftBandDevelopmentVertical') as AccountRowNumber; \n\n--get unique previous fiscal year accounts\nq1_a = filter q1 by AccountRowNumber == 1;\n\n--full join selected fy and previous fy opps\nq = cogroup q2_a by ( 'Opportunity.ClosedWonGiftBandDevelopmentVertical') full, q1_a by ( 'Opportunity.ClosedWonGiftBandDevelopmentVertical');\nq = foreach q generate   coalesce(q2_a.'Opportunity.ClosedWonGiftBandDevelopmentVertical', q1_a.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'Opportunity.ClosedWonGiftBandDevelopmentVertical',\n--get selected fy opps\nsum(q2_a.'Opportunity.Amount') as '$ - Selected FY Closed/Won Amount', sum(q2_a.'Count') as '# - Selected FY Donor Count',\n--get selected previous fy opps\nsum(q1_a.'Opportunity.Amount') as '$ - Previous FY Closed/Won Amount', sum(q1_a.'Count') as '# - Previous FY Donor Count';\n\n--group query to get account row number\nq3 = group q by ('Opportunity.ClosedWonGiftBandDevelopmentVertical');\nq3 = foreach q3 generate 'Opportunity.ClosedWonGiftBandDevelopmentVertical', \n--get selected fy opps\n sum('$ - Selected FY Closed/Won Amount') as '$ - Selected FY Closed/Won Amount', sum('# - Selected FY Donor Count') as '# - Selected FY Donor Count', \n--get selected previous fy opps\n sum('$ - Previous FY Closed/Won Amount') as '$ - Previous FY Closed/Won Amount', sum('# - Previous FY Donor Count') as '# - Previous FY Donor Count', sum('# - Previous FY Donor Count') * 1.05 as '# - Donor Count Goal', sum('# - Selected FY Donor Count')/(sum('# - Previous FY Donor Count') * 1.05 ) as '% to Donor Count Goal'; \n\n--filter for unique accounts and rollup by account\nq4 = group q3 by rollup('Opportunity.ClosedWonGiftBandDevelopmentVertical');\nq4 = foreach q4 generate 'Opportunity.ClosedWonGiftBandDevelopmentVertical', \n--get selected fy opps\n sum('$ - Selected FY Closed/Won Amount') as '$ - Selected FY Closed/Won Amount', sum('# - Selected FY Donor Count') as '# - Selected FY Donor Count', \n--get selected previous fy opps\n sum('$ - Previous FY Closed/Won Amount') as '$ - Previous FY Closed/Won Amount', sum('# - Previous FY Donor Count') as '# - Previous FY Donor Count', sum('# - Donor Count Goal') as '# - Donor Count Goal', avg('% to Donor Count Goal') as '% to Donor Count Goal',\n--grouping functions\ngrouping(q4.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical';\n\ns = filter q4 by 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 1;\nq4 = filter q4 by 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 0;\nq4 = order q4 by ('Opportunity.ClosedWonGiftBandDevelopmentVertical' asc);\nq4 = limit q4 2000;\nq4 = union q4, s;\nq4 = limit q4 2001;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"_1M__Opps_Detail_Tab_1":{"broadcastFacet":true,"groups":[],"label":"$1M+ Opps by Opp Owner Table","numbers":[],"query":"q = load \"Opportunity_Info\";\nq = filter q by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] and 'Opportunity.Amount' >= 1000000;\nq = filter q by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq = filter q by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq = group q by rollup('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OpportunityOwner.Name');\nq = foreach q generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', sum(q.'Opportunity.Amount') as '$ - Closed/Won Amount', count(q) as '# - Closed/Won Count', 30 as 'Goal', count(q)/30 as '% to Goal', grouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam',  grouping(q.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name';\n\ns = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0;\nq = foreach q generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', sum(q.'$ - Closed/Won Amount') as '$ - Closed/Won Amount', sum('# - Closed/Won Count') as '# - Closed/Won Count', 0 as 'Goal', 0 as '% to Goal';\nq = order q by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' asc, 'Opportunity.ClosedWonGiftBandDevelopmentVertical' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":175,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"Annual_Fund_Opps_Det_1":{"broadcastFacet":true,"groups":[],"label":"Annual Fund Opps by Opp Owner Table","numbers":[],"query":"q1 = load \"Opportunity_Info\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq1 = filter q1 by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\n\nq2 = load \"GiftAndPledgeTransactionsExtension\";\nq2 = filter q2 by 'Transaction.Annual_Fund__c' == \"true\" and 'Transaction.AQB__Amount__c' > 0;\n\nq3 = cogroup q1 by 'Opportunity.Id', q2 by 'AQB__CreditedOpportunity__c';\nq3 = foreach q3 generate q1.'Opportunity.Id' as 'Opportunity.Id', first(q1.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'Opportunity.OpportunityOwner.GiftOfficerTeam', first(q1.'Opportunity.OpportunityOwner.Name') as 'Opportunity.OpportunityOwner.Name', first(q1.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'Opportunity.ClosedWonGiftBandDevelopmentVertical', sum(q1.'Opportunity.Amount') as '$ - Closed/Won Amount', count(q1) as '# - Closed/Won Count';\n\nq = group q3 by rollup('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OpportunityOwner.Name');\nq = foreach q generate q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', q.'Opportunity.ClosedWonGiftBandDevelopmentVertical' as 'Opportunity.ClosedWonGiftBandDevelopmentVertical', sum(q.'$ - Closed/Won Amount') as '$ - Closed/Won Amount', sum('# - Closed/Won Count') as '# - Closed/Won Count', 20200000 as Goal, sum(q.'$ - Closed/Won Amount')/20200000 as '% to Goal', grouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name';\n\ns = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 0 and  'grouping_Opportunity.OpportunityOwner.Name' == 0;\nq = foreach q generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', sum(q.'$ - Closed/Won Amount') as '$ - Closed/Won Amount', sum('# - Closed/Won Count') as '# - Closed/Won Count', 0 as Goal, 0 as '% to Goal';\nq = order q by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' asc, 'Opportunity.ClosedWonGiftBandDevelopmentVertical' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":175,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_1":{"broadcastFacet":true,"datasets":[{"name":"Opportunity_Component"}],"isGlobal":false,"label":"Opps Closed/Won by Component School Unit","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":["Opportunity.Opportunity.Name"],"limit":2000,"orders":[{"name":"Opportunity.Opportunity.Name","filters":[],"ascending":true},{"name":"Opportunity.Account.Name","filters":[],"ascending":true},{"name":"Opportunity.Account.ARCH_Account_ID__c","filters":[],"ascending":true},{"name":"Opportunity.Opportunity.OpportunityOwner.Name","filters":[],"ascending":true},{"name":"Opportunity.PMTeam.StrategyOfficerList","filters":[],"ascending":true},{"name":"SchoolUnitToggle","filters":[],"ascending":true},{"name":"Opportunity.Opportunity.CloseDate_Year","filters":[],"ascending":true},{"name":"Opportunity.Opportunity.CloseDate_Month","filters":[],"ascending":true},{"name":"Opportunity.Opportunity.CloseDate_Day","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{"Opportunity_Component":{"filters":[["Opportunity.Opportunity.StageName",["Closed/Won","Closed Won"],"in"],["Opportunity.Opportunity.CloseDateFiscalYearsPassed",["[[parameter_1]]"],"in"],["AQB__Amount__c",[0],">"],["Opportunity.Opportunity.OppRecordType.Name",["Grateful Patients"],"not in"]]}},"sources":[{"columns":[{"field":["count","*"],"name":"A"},{"field":["sum","AQB__Amount__c"],"name":"B"}],"filters":[],"groups":["Opportunity.Opportunity.Name","Opportunity.Account.Name","Opportunity.Account.ARCH_Account_ID__c","Opportunity.Opportunity.OpportunityOwner.Name","Opportunity.PMTeam.StrategyOfficerList","SchoolUnitToggle","Opportunity.Opportunity.CloseDate_Year","Opportunity.Opportunity.CloseDate_Month","Opportunity.Opportunity.CloseDate_Day"],"joins":[],"name":"Opportunity_Component"}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["B","A","Opportunity.Opportunity.Name","Opportunity.Account.Name","Opportunity.Account.ARCH_Account_ID__c","Opportunity.Opportunity.OpportunityOwner.Name","Opportunity.PMTeam.StrategyOfficerList","SchoolUnitToggle","Opportunity.Opportunity.CloseDate_Year~~~Opportunity.Opportunity.CloseDate_Month~~~Opportunity.Opportunity.CloseDate_Day"],"customBulkActions":[],"evenRowColor":"#f4f6f9","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Conversion___by_Opp__1":{"broadcastFacet":true,"groups":[],"label":"Conversion % by Opp Owner Detail Table","numbers":[],"query":"--load opportunities\nq = load \"Opportunity_Info\";\nq = filter q by 'Opportunity.StageName' in [\"Closed - Funded No Value\", \"Closed Won\",  \"Closed/Won\", \"Closed/Won - No Value\", \"Closed/Lost\"];\nq = filter q by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq = filter q by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq = group q by ('Opportunity.Name', 'Opportunity.StageName', 'Account.AQC_Account_ARCH_ID__c', 'Opportunity.Id', 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Account.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Account.Id', 'Opportunity.OpportunityOwner.Name', 'Opportunity.CloseDate');\nq = foreach q generate q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', q.'Opportunity.ClosedWonGiftBandDevelopmentVertical' as 'Opportunity.ClosedWonGiftBandDevelopmentVertical', q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'Account.Name' as 'Account.Name', q.'Opportunity.Name' as 'Opportunity.Name', q.'Opportunity.CloseDate' , q.'Opportunity.Id' as 'Opportunity.Id',   q.'Account.Id' as 'Account.Id', \n    (case\n        when 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] then sum('Opportunity.Amount') \n        else 0\n    end) as '$ - Closed/Won Amount',\n    (case\n        when 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] then sum('Opportunity.AQC_Ask_Amount__c') \n        else 0\n    end) as '$ - Closed/Won Ask Amount',\n    (case\n        when 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] then sum('Opportunity.AQC_Ask_Amount__c')*0.5 \n        else 0\n    end) as '$ - Closed/Won Amount Goal',\n    (case\n        when 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] then 1\n        else 0\n    end) as '# - Closed/Won Count',  \ncount(q) as '# - Closed Count', \ncount(q)*0.5 as '# - Closed/Won Count Goal'; \n\n\n--rollup grouping\nq1 = group q by rollup('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OpportunityOwner.Name');\nq1 = foreach q1 generate q1.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q1.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', q1.'Opportunity.ClosedWonGiftBandDevelopmentVertical' as 'Opportunity.ClosedWonGiftBandDevelopmentVertical',\nsum('$ - Closed/Won Amount') as '$ - Closed/Won Amount',   \nsum('$ - Closed/Won Ask Amount') as '$ - Closed/Won Ask Amount',\nsum('$ - Closed/Won Amount')/sum('$ - Closed/Won Ask Amount') as '$ - Closed/Won Conversion %',\nsum('$ - Closed/Won Amount Goal') as '$ - Closed/Won Amount Goal',\nsum('# - Closed/Won Count') as '# - Closed/Won Count',  \nsum('# - Closed Count') as '# - Closed Count', \nsum('# - Closed/Won Count')/sum('# - Closed Count') as '# - Closed/Won Conversion %',\nsum('# - Closed/Won Count Goal') as '# - Closed/Won Count Goal', \ngrouping(q1.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q1.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical', grouping(q1.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name';\n\ns = filter q1 by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam'  == 1;\nq1 = filter q1 by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 0  and 'grouping_Opportunity.OpportunityOwner.Name' == 0;\nq1 = order q1 by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.ClosedWonGiftBandDevelopmentVertical' asc, 'Opportunity.OpportunityOwner.Name' asc);\nq1 = limit q1 2000;\nq1 = union q1, s;\nq1 = limit q1 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":170,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}}},"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#747474","borderEdges":[],"borderRadius":0,"borderWidth":1,"tooltipStyle":{"backgroundColor":"#16325c","labelColor":"#9faab5","valueColor":"#ffffff"}},"widgets":{"text_250":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#020821","size":"12px"},"insert":"$1M+ Opps by Opp Owner"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[{"actions":[{"destinationLink":{"name":"32df6666-4414-4b71-adc6-fb5809731a4f"},"destinationType":"page","type":"navigate"}],"event":"click"}],"showActionMenu":true},"type":"text"},"text_3