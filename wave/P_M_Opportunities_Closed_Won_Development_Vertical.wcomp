umberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Med_Adv___Closed_Won_1":{"broadcastFacet":true,"groups":[],"label":"Med Adv $ Closed/Won Summary Table","numbers":[],"query":"q1 = load \"Opportunity_Info\";\nq2 = load \"UA_Performance_Med_Team_Goals\";\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"[[parameter_1]]\";\nq2 = filter q2 by 'Goal' == \"$ of Opportunities Closed/Won\";\nq2 = filter q2 by 'Med_Team' in [\"Med Alumni\", \"Community Fundraising\", \"Med CFR\", \"Momentum/EVC/VC\", \"Med/Surg\", \"Neuro\", \"Siteman\"];\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] and date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"] and ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null) and 'Opportunity.OpportunityTeamMember.MedOfficerTeam' in [\"Med Alumni\", \"Community Fundraising\", \"Med CFR\", \"Momentum/EVC/VC\", \"Med/Surg\", \"Neuro\", \"Siteman\"];\nq = cogroup q1 by 'Opportunity.OpportunityTeamMember.MedOfficerTeam' right, q2 by 'Med_Team';\nq = foreach q generate coalesce(q1.'Opportunity.OpportunityTeamMember.MedOfficerTeam', q2.'Med_Team') as 'Opportunity.OpportunityTeamMember.MedOfficerTeam', sum(q1.'Opportunity.Amount') as 'A', sum(q2.'Amount') as 'B';\nq = foreach q generate 'Opportunity.OpportunityTeamMember.MedOfficerTeam', 'A' as '$ Opps Closed/Won', 'B' as 'Goal', coalesce(A,0)/B as '% to Goal';\nq = group q by rollup('Opportunity.OpportunityTeamMember.MedOfficerTeam');\nq = foreach q generate q.'Opportunity.OpportunityTeamMember.MedOfficerTeam' as 'Opportunity.OpportunityTeamMember.MedOfficerTeam', sum(q.'$ Opps Closed/Won') as '$ Opps Closed/Won', sum(q.'Goal') as 'Goal', sum(q.'$ Opps Closed/Won') / sum(q.'Goal') as '% to Goal', grouping(q.'Opportunity.OpportunityTeamMember.MedOfficerTeam') as 'grouping_Opportunity.OpportunityTeamMember.MedOfficerTeam';\ns = filter q by 'grouping_Opportunity.OpportunityTeamMember.MedOfficerTeam' == 1;\nq = filter q by 'grouping_Opportunity.OpportunityTeamMember.MedOfficerTeam' == 0;\nq = order q by 'Opportunity.OpportunityTeamMember.MedOfficerTeam' asc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Opps_by_Record_Type__5":{"broadcastFacet":false,"groups":[],"label":"Annual Fund Opps Detail Table","numbers":[],"query":"q1 = load \"Opportunity_Info\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq1 = filter q1 by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\n\nq2 = load \"GiftAndPledgeTransactionsExtension\";\nq2 = filter q2 by 'Transaction.Annual_Fund__c' == \"true\" and 'Transaction.AQB__Amount__c' > 0;\n\nq3 = cogroup q1 by 'Opportunity.Id', q2 by 'AQB__CreditedOpportunity__c';\nq3 = foreach q3 generate q1.'Opportunity.Id' as 'Opportunity.Id', first(q1.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'Opportunity.OpportunityOwner.GiftOfficerTeam', first(q1.'Opportunity.OpportunityOwner.Name') as 'Opportunity.OpportunityOwner.Name', first(q1.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'Opportunity.ClosedWonGiftBandDevelopmentVertical', first(q1.'Account.AQC_Account_ARCH_ID__c') as 'Account.AQC_Account_ARCH_ID__c', first(q1.'Account.Name') as 'Account.Name', first(q1.'Opportunity.Name') as 'Opportunity.Name',  first(q1.'Account.Id') as 'Account.Id', first(q1.'Opportunity.CloseDate') as 'Opportunity.CloseDate', sum(q1.'Opportunity.Amount') as '$ - Closed/Won Amount', count(q1) as '# - Closed/Won Count';\n\nq = group q3 by rollup('Opportunity.Name', 'Account.AQC_Account_ARCH_ID__c', 'Opportunity.Id', 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Account.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Account.Id', 'Opportunity.OpportunityOwner.Name', 'Opportunity.CloseDate');\nq = foreach q generate q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', q.'Opportunity.ClosedWonGiftBandDevelopmentVertical' as 'Opportunity.ClosedWonGiftBandDevelopmentVertical', q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'Account.Name' as 'Account.Name', q.'Opportunity.Name' as 'Opportunity.Name',  q.'Opportunity.CloseDate', q.'Opportunity.Id' as 'Opportunity.Id',  q.'Account.Id' as 'Account.Id',  sum(q.'$ - Closed/Won Amount') as '$ - Closed/Won Amount', sum('# - Closed/Won Count') as '# - Closed/Won Count', grouping(q.'Opportunity.Name') as 'grouping_Opportunity.Name', grouping(q.'Account.AQC_Account_ARCH_ID__c') as 'grouping_Account.AQC_Account_ARCH_ID__c', grouping(q.'Opportunity.Id') as 'grouping_Opportunity.Id', grouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q.'Account.Name') as 'grouping_Account.Name',  grouping(q.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical', grouping(q.'Account.Id') as 'grouping_Account.Id', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name', grouping(q.'Opportunity.CloseDate') as 'grouping_Opportunity.CloseDate';\n\ns = filter q by 'grouping_Opportunity.Name' == 1;\nq = filter q by 'grouping_Opportunity.Name' == 0 and 'grouping_Account.AQC_Account_ARCH_ID__c' == 0 and 'grouping_Opportunity.Id' == 0 and 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Account.Name' == 0  and 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 0 and 'grouping_Account.Id' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0 and 'grouping_Opportunity.CloseDate' == 0;\nq = order q by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' asc, 'Opportunity.ClosedWonGiftBandDevelopmentVertical' asc, 'Account.Name' asc, 'Opportunity.Name' asc,  'Opportunity.CloseDate'asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Opportunity.OpportunityOwner.GiftOfficerTeam","Opportunity.OpportunityOwner.Name","Opportunity.ClosedWonGiftBandDevelopmentVertical","Account.AQC_Account_ARCH_ID__c","Account.Name","Opportunity.Name","Opportunity.CloseDate","$ - Closed/Won Amount","# - Closed/Won Count"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","