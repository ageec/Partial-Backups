l Patients"],"not in"]]}},"sources":[{"columns":[{"field":["sum","Opportunity.Amount"],"name":"A"},{"field":["count","*"],"name":"B"}],"filters":[],"groups":["Opportunity.Name","Opportunity.Id","Account.AQC_Account_ARCH_ID__c","Account.Name","Opportunity.ARCH_Territory__c","Opportunity.OpportunityOwner.Name","Opportunity.CloseDate_Year","Opportunity.CloseDate_Month","Opportunity.CloseDate_Day","Account.Id"],"joins":[],"name":"Opportunity_Info"}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","Opportunity.Name","Account.Name","Account.AQC_Account_ARCH_ID__c","Opportunity.OpportunityOwner.Name","Opportunity.ARCH_Territory__c","Opportunity.CloseDate_Year~~~Opportunity.CloseDate_Month~~~Opportunity.CloseDate_Day","B"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Territories___Closed_1":{"broadcastFacet":false,"groups":[],"label":"Total $ Closed/Won Summary Table","numbers":[],"query":"q1 = load \"Opportunity_Info\";\nq2 = load \"Territory_Goals\";\nq3 = filter q2 by 'Goal' == \"Total $ of Opps Closed/Won\";\nq3 = filter q3 by 'Fiscal_Years_Passed' == \"[[parameter_1]]\";\nq2 = filter q2 by 'Goal' == \"Total # of Opps Closed/Won\";\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"[[parameter_1]]\";\nq1 = filter q1 by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq = cogroup q1 by ('Opportunity.ARCH_Territory__c', 'Opportunity.TerritorySort') full, q2 by ('Territory', 'Territory_Sort') full, q3 by ('Territory', 'Territory_Sort');\nq = foreach q generate coalesce(q1.'Opportunity.ARCH_Territory__c', q2.'Territory', q3.'Territory') as 'Opportunity.ARCH_Territory__c', coalesce(q1.'Opportunity.TerritorySort', q2.'Territory_Sort', q3.'Territory_Sort') as 'Opportunity.TerritorySort', sum(q1.'Opportunity.Amount') as '$ - Closed/Won Amount', sum(q3.'Amount') as '$ - Goal', coalesce(sum(q1.'Opportunity.Amount'),0)/sum(q3.'Amount') as '$ - % to Goal', count(q1) as '# - Closed/Won Count', sum(q2.'Amount') as '# - Goal', coalesce(count(q1),0)/sum(q2.'Amount') as '# - % to Goal';\nq = group q by rollup('Opportunity.ARCH_Territory__c', 'Opportunity.TerritorySort');\nq = foreach q generate 'Opportunity.ARCH_Territory__c' as 'Opportunity.ARCH_Territory__c', 'Opportunity.TerritorySort' as 'Opportunity.TerritorySort', sum(q.'$ - Closed/Won Amount') as '$ - Closed/Won Amount', sum(q.'$ - Goal') as '$ - Goal', sum(q.'$ - Closed/Won Amount') / sum(q.'$ - Goal') as '$ - % to Goal', sum('# - Closed/Won Count') as '# - Closed/Won Count', sum(q.'# - Goal') as '# - Goal', sum(q.'# - Closed/Won Count') / sum(q.'# - Goal') as '# - % to Goal', grouping(q.'Opportunity.ARCH_Territory__c') as 'grouping_Opportunity.ARCH_Territory__c', grouping(q.'Opportunity.TerritorySort') as 'grouping_Opportunity.TerritorySort';\ns = filter q by 'grouping_Opportunity.ARCH_Territory__c' == 1 and 'grouping_Opportunity.TerritorySort' == 1;\nq = filter q by 'grouping_Opportunity.ARCH_Territory__c' == 0 and 'grouping_Opportunity.TerritorySort' == 0;\nq = order q by 'Opportunity.TerritorySort' asc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"collapsible":false,"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfFrozenColumns":0,"numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Opps_by_Record_Type__2":{"broadcastFacet":false,"groups":[],"label":"Time to Close Opp Detail Table","numbers":[],"query":"q = load \"Opportunity_Info\";\nq = filter q by 'Opportunity.StageName' in [\"Closed - Funded No Value\", \"Closed Won\", \"Closed/Won\", \"Closed/Won - No Value\"];\nq = filter q by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq = filter q by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq = group q by rollup('Opportunity.Name', 'Account.AQC_Account_ARCH_ID__c', 'Opportunity.Id', 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Account.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Account.Id', 'Opportunity.OpportunityOwner.Name', 'Opportunity.AQC_Date_Asked__c', 'Opportunity.CloseDate');\nq = foreach q generate q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', q.'Opportunity.ClosedWonGiftBandDevelopmentVertical' as 'Opportunity.ClosedWonGiftBandDevelopmentVertical', q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'Account.Name' as 'Account.Name', q.'Opportunity.Name' as 'Opportunity.Name', 'Opportunity.AQC_Date_Asked__c',  q.'Opportunity.CloseDate', avg('Opportunity.DaysFromAskDateToCloseDate') as 'Opportunity.DaysFromAskDateToCloseDate', q.'Opportunity.Id' as 'Opportunity.Id',  q.'Account.Id' as 'Account.Id',  sum(q.'Opportunity.Amount') as '$ - Closed Amount', count(q) as '# - Closed Count', grouping(q.'Opportunity.Name') as 'grouping_Opportunity.Name', grouping(q.'Account.AQC_Account_ARCH_ID__c') as 'grouping_Account.AQC_Account_ARCH_ID__c', grouping(q.'Opportunity.Id') as 'grouping_Opportunity.Id', grouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q.'Account.Name') as 'grouping_Account.Name',  grouping(q.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical', grouping(q.'Account.Id') as 'grouping_Account.Id', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name', grouping('Opportunity.AQC_Date_Asked__c') as 'grouping_Opportunity.AQC_Date_Asked__c', grouping(q.'Opportunity.CloseDate') as 'grouping_Opportunity.CloseDate';\n\ns = filter q by 'grouping_Opportunity.Name' == 1;\nq = filter q by 'grouping_Opportunity.Name' == 0 and 'grouping_Account.AQC_Account_ARCH_ID__c' == 0 and 'grouping_Opportunity.Id' == 0 and 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Account.Name' == 0 and 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 0 and 'grouping_Account.Id' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0 and 'grouping_Opportunity.AQC_Date_Asked__c' == 0 and 'grouping_Opportunity.CloseDate' == 0;\nq = order q by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' asc, 'Opportunity.ClosedWonGiftBandDevelopmentVertical' asc, 'Account.Name' asc, 'Opportunity.Name' asc,  'Opportunity.CloseDate'asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Opportunity.OpportunityOwner.GiftOfficerTeam","Opportunity.OpportunityOwner.Name","Opportunity.ClosedWonGiftBandDevelopmentVertical","Account.AQC_Account_ARCH_ID__c","Account.Name","Opportunity.Name","Opportunity.AQC_Date_Asked__c","Opportunity.CloseDate","Opportunity.DaysFromAskDateToCloseDate","$ - Closed Amount","# - Closed Count"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":175,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"PSO___Opportunity_Cl_3":{"broadcastFacet":false,"groups":[],"label":"PSO $ Opportunity Closed/Won Detail Table","numbers":[],"query":"q = load \"OpportunityDetail\";\nq = filter q by 'StageName' in [\"Closed Won\", \"Closed/Won\"];\nq = filter q by 'OpportunityTeamMember.GiftOfficerDivision' is not null;\nq = filter q by ('OppRecordType.Name' != \"Grateful Patients\" || 'OppRecordType.Name' is null);\nq = filter q by 'Amount' > 0;\n--q = filter q by date('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq = group q by rollup('Name', 'Account.Name', 'Account.AQC_Account_ARCH_ID__c', 'OpportunityTeamMember.Name', 'OpportunityTeamMember.TeamMemberRole', 'OpportunityTeamMember.GiftOfficerDivision', 'CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day', 'Id', 'Account.Id');\nq = foreach q generate q.'Name' as 'Opportunity Name', q.'Account.Name' as 'Account.Name', q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'OpportunityTeamMember.Name' as 'OpportunityTeamMember.Name', q.'OpportunityTeamMember.TeamMemberRole' as 'OpportunityTeamMember.TeamMemberRole', q.'OpportunityTeamMember.GiftOfficerDivision' as 'OpportunityTeamMember.GiftOfficerDivision', q.'CloseDate_Year' as 'CloseDate_Year', q.'CloseDate_Month' as 'CloseDate_Month', q.'CloseDate_Day' as 'CloseDate_Day', q.'Id' as 'Id', q.'Account.Id' as 'Account.Id', sum(q.'Amount') as 'B', count(q) as 'A', grouping(q.'Name') as 'grouping_Name', grouping(q.'Account.Name') as 'grouping_Account.Name', grouping(q.'Account.AQC_Account_ARCH_ID__c') as 'grouping_Account.AQC_Account_ARCH_ID__c', grouping(q.'OpportunityTeamMember.Name') as 'grouping_OpportunityTeamMember.Name', grouping(q.'OpportunityTeamMember.TeamMemberRole') as 'grouping_OpportunityTeamMember.TeamMemberRole', grouping(q.'OpportunityTeamMember.GiftOfficerDivision') as 'grouping_OpportunityTeamMember.GiftOfficerDivision', grouping(q.'CloseDate_Year') as 'grouping_CloseDate_Year', grouping(q.'CloseDate_Month') as 'grouping_CloseDate_Month', grouping(q.'CloseDate_Day') as 'grouping_CloseDate_Day', grouping(q.'Id') as 'grouping_Id', grouping(q.'Account.Id') as 'grouping_Account.Id';\ns = filter q by 'grouping_Name' == 1;\nq = filter q by 'grouping_Name' == 0 and 'grouping_Account.Name' == 0 and 'grouping_Account.AQC_Account_ARCH_ID__c' == 0 and 'grouping_OpportunityTeamMember.Name' == 0 and 'grouping_OpportunityTeamMember.TeamMemberRole' == 0 and 'grouping_OpportunityTeamMember.GiftOfficerDivision' == 0 and 'grouping_CloseDate_Year' == 0 and 'grouping_CloseDate_Month' == 0 and 'grouping_CloseDate_Day' == 0 and 'grouping_Id' == 0 and 'grouping_Account.Id' == 0;\nq = order q by ('Opportunity Name' asc, 'Account.Name' asc, 'Account.AQC_Account_ARCH_ID__c' asc, 'OpportunityTeamMember.Name' asc, 'OpportunityTeamMember.TeamMemberRole' asc, 'OpportunityTeamMember.GiftOfficerDivision' asc, 'CloseDate_Year' asc, 'CloseDate_Month' asc, 'CloseDate_Day' asc, 'Id' asc, 'Account.Id' asc);\nq = limit q 25000;\nq = union q, s;\nq = limit q 25001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"collapsible":false,"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfFrozenColumns":7,"numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"Gift_Officer___Close_1":{"broadcastFacet":true,"groups":[],"label":"Opps by Record Type, Opp Owner Table","numbers":[],"query":"q1 = load \"Opportunity_Info\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq1 = filter q1 by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\n\nq = group q1 by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OppRecordType.Name');\nq = foreach q generate 'Opportunity.OpportunityOwner.GiftOfficerTeam','Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OpportunityOwner.Name', 'Opportunity.OppRecordType.Name', sum(q1.'Opportunity.Amount') as '$ - Closed/Won Amount', count(q1) as '# - Closed/Won Count';\n\nq = group q by rollup('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OppRecordType.Name');\nq = foreach q generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', q.'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OppRecordType.Name', sum(q.'$ - Closed/Won Amount') as '$ - Closed/Won Amount', sum('# - Closed/Won Count') as '# - Closed/Won Count', grouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name', grouping('Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical', grouping('Opportunity.OppRecordType.Name') as 'grouping_Opportunity.OppRecordType.Name';\ns = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0 and 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 0 and 'grouping_Opportunity.OppRecordType.Name' == 0;\nq = order q by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' asc, 'Opportunity.ClosedWonGiftBandDevelopmentVertical' asc, 'Opportunity.OppRecordType.Name' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Planned_Gift_Opps_by_1":{"broadcastFacet":true,"groups":[],"label":"Planned Gift Opps by Opp Detail Table","numbers":[],"query":"q = load \"Opportunity_Info\";\nq = filter q by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq = filter q by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq = filter q by ('Opportunity.OppRecordType.Name' == \"Planned Gift\");\nq = group q by rollup('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ARCH_Instrument__c');\nq = foreach q generate q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name',  q.'Opportunity.ARCH_Instrument__c' as 'Opportunity.ARCH_Instrument__c', sum(q.'Opportunity.Amount') as '$ - Closed/Won Amount', count(q) as '# - Closed/Won Count', grouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q.'Opportunity.ARCH_Instrument__c') as 'grouping_Opportunity.ARCH_Instrument__c', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name';\n\ns = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 1;\nq = filter q by'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Opportunity.ARCH_Instrument__c' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0;\nq = order q by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' asc, 'Opportunity.ARCH_Instrument__c');\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":175,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"Opps_by_Record_Type__1":{"broadcastFacet":false,"groups":[],"label":"Conversion % by Opp Owner Detail Table","numbers":[],"query":"--load opportunities\nq = load \"Opportunity_Info\";\nq = filter q by 'Opportunity.StageName' in [\"Closed - Funded No Value\", \"Closed Won\", \"Closed/Won\", \"Closed/Won - No Value\", \"Closed/Lost\"];\nq = filter q by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq = filter q by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq = group q by ('Opportunity.Name', 'Opportunity.StageName', 'Account.AQC_Account_ARCH_ID__c', 'Opportunity.Id', 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Account.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Account.Id', 'Opportunity.OpportunityOwner.Name', 'Opportunity.CloseDate');\nq = foreach q generate q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', q.'Opportunity.ClosedWonGiftBandDevelopmentVertical' as 'Opportunity.ClosedWonGiftBandDevelopmentVertical', q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'Account.Name' as 'Account.Name', q.'Opportunity.Name' as 'Opportunity.Name', q.'Opportunity.CloseDate' , q.'Opportunity.Id' as 'Opportunity.Id',   q.'Account.Id' as 'Account.Id', \n    (case\n        when 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] then sum('Opportunity.Amount') \n        else 0\n    end) as '$ - Closed/Won Amount',\n    (case\n        when 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] then sum('Opportunity.AQC_Ask_Amount__c') \n        else 0\n    end) as '$ - Closed/Won Ask Amount',\n    (case\n        when 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] then sum('Opportunity.AQC_Ask_Amount__c')*0.5 \n        else 0\n    end) as '$ - Closed/Won Amount Goal',\n    (case\n        when 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] then 1\n        else 0\n    end) as '# - Closed/Won Count',  \ncount(q) as '# - Closed Count', \ncount(q)*0.5 as '# - Closed/Won Count Goal';\n\n\n--rollup grouping\nq1 = group q by rollup('Opportunity.Name','Account.AQC_Account_ARCH_ID__c', 'Opportunity.Id', 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Account.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Account.Id', 'Opportunity.OpportunityOwner.Name', 'Opportunity.CloseDate');\nq1 = foreach q1 generate q1.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q1.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', q1.'Opportunity.ClosedWonGiftBandDevelopmentVertical' as 'Opportunity.ClosedWonGiftBandDevelopmentVertical', q1.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q1.'Account.Name' as 'Account.Name', q1.'Opportunity.Name' as 'Opportunity.Name', q1.'Opportunity.CloseDate' , q1.'Opportunity.Id' as 'Opportunity.Id',   q1.'Account.Id' as 'Account.Id', \nsum('$ - Closed/Won Amount') as '$ - Closed/Won Amount',   \nsum('$ - Closed/Won Ask Amount') as '$ - Closed/Won Ask Amount',\nsum('$ - Closed/Won Amount')/sum('$ - Closed/Won Ask Amount') as '$ - Closed/Won Conversion %',\nsum('$ - Closed/Won Amount Goal') as '$ - Closed/Won Amount Goal',\nsum('# - Closed/Won Count') as '# - Closed/Won Count',  \nsum('# - Closed Count') as '# - Closed Count', \nsum('# - Closed/Won Count')/sum('# - Closed Count') as '# - Closed/Won Conversion %',\ngrouping(q1.'Opportunity.Name') as 'grouping_Opportunity.Name',  grouping(q1.'Account.AQC_Account_ARCH_ID__c') as 'grouping_Account.AQC_Account_ARCH_ID__c', grouping(q1.'Opportunity.Id') as 'grouping_Opportunity.Id', grouping(q1.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q1.'Account.Name') as 'grouping_Account.Name',  grouping(q1.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical', grouping(q1.'Account.Id') as 'grouping_Account.Id', grouping(q1.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name', grouping(q1.'Opportunity.CloseDate') as 'grouping_Opportunity.CloseDate';\n\ns = filter q1 by 'grouping_Opportunity.Name' == 1;\nq1 = filter q1 by 'grouping_Opportunity.Name' == 0 and  'grouping_Account.AQC_Account_ARCH_ID__c' == 0 and 'grouping_Opportunity.Id' == 0 and 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Account.Name' == 0  and 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 0 and 'grouping_Account.Id' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0 and 'grouping_Opportunity.CloseDate' == 0;\nq1 = order q by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' asc, 'Opportunity.ClosedWonGiftBandDevelopmentVertical' asc, 'Account.Name' asc, 'Opportunity.Name' asc,  'Opportunity.CloseDate'asc);\nq1 = limit q1 2000;\nq1 = union q1, s;\nq1 = limit q1 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Opportunity.OpportunityOwner.GiftOfficerTeam","Opportunity.OpportunityOwner.Name","Opportunity.ClosedWonGiftBandDevelopmentVertical","Account.AQC_Account_ARCH_ID__c","Account.Name","Opportunity.Name","Opportunity.CloseDate","$ - Closed/Won Amount","$ - Closed/Won Ask Amount","$ - Closed/Won Amount Goal","# - Closed/Won Count","# - Closed Count","# - Closed/Won Count Goal","$ - Closed/Won Conversion %","# - Closed/Won Conversion %"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":175,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivot