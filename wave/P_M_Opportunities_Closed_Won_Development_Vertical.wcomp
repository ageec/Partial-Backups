 q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', q.'Opportunity.ClosedWonGiftBandDevelopmentVertical' as 'Opportunity.ClosedWonGiftBandDevelopmentVertical', avg('Opportunity.DaysFromAskDateToCloseDate') as 'Opportunity.DaysFromAskDateToCloseDate', sum(q.'Opportunity.Amount') as '$ - Closed Amount', count(q) as '# - Closed Count', grouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam',  grouping(q.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name';\n\ns = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0;\nq = order q by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' asc, 'Opportunity.ClosedWonGiftBandDevelopmentVertical' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":17