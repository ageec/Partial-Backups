ount_ARCH_ID__c","Opportunity.OpportunityOwner.Name","Opportunity.CloseDate_Year~~~Opportunity.CloseDate_Month~~~Opportunity.CloseDate_Day"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fittocontainer","numberOfFrozenColumns":0,"numberOfLines":1,"pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Gift_Officer___Close_5":{"broadcastFacet":false,"groups":[],"label":"Donors by Gift Band Opp Detail Table","numbers":[],"query":"--load selected fy opps\nq2 = load \"Opportunity_Info\";\nq2 = filter q2 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq2 = filter q2 by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq2 = filter q2 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq2 = foreach q2 generate 'Account.AQC_Account_ARCH_ID__c', 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Account.Name','Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Account.Id', 'Opportunity.OpportunityOwner.Name', 'Opportunity.Name',  'Opportunity.CloseDate', 'Opportunity.Amount', 'Opportunity.Id', 1 as 'Donor Count';\n\n--load selected previous fy opps\nq1 = load \"Opportunity_Info\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq1 = filter q1 by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_3]]\"..\"[[parameter_3]]\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq1 = foreach q1 generate 'Account.AQC_Account_ARCH_ID__c', 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Account.Name','Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Account.Id', 'Opportunity.OpportunityOwner.Name', 'Opportunity.Name',  'Opportunity.CloseDate', 'Opportunity.Amount', 'Opportunity.Id', 1 as 'Donor Count';\n\n\n--full join selected fy and previous fy opps\nq = cogroup q2 by ('Account.AQC_Account_ARCH_ID__c', 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Account.Name','Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Account.Id', 'Opportunity.OpportunityOwner.Name') full, q1 by ('Account.AQC_Account_ARCH_ID__c', 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Account.Name','Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Account.Id', 'Opportunity.OpportunityOwner.Name');\nq = foreach q generate coalesce(q2.'Account.AQC_Account_ARCH_ID__c', q1.'Account.AQC_Account_ARCH_ID__c') as 'Account.AQC_Account_ARCH_ID__c', coalesce(q2.'Account.Name', q1.'Account.Name')  as 'Account.Name', coalesce(q2.'Opportunity.OpportunityOwner.GiftOfficerTeam', q1.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'Opportunity.OpportunityOwner.GiftOfficerTeam', coalesce(q2.'Opportunity.OpportunityOwner.Name', q1.'Opportunity.OpportunityOwner.Name') as 'Opportunity.OpportunityOwner.Name', coalesce(q2.'Opportunity.ClosedWonGiftBandDevelopmentVertical', q1.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'Opportunity.ClosedWonGiftBandDevelopmentVertical', coalesce(q2.'Account.Id', q1.'Account.Id') as 'Account.Id', \n--get selected fy opps\nfirst(q2.'Opportunity.Name') as 'Selected FY Opp Name',  first(q2.'Opportunity.CloseDate') as 'Selected FY Opp Close Date', sum(q2.'Opportunity.Amount') as '$ - Selected FY Closed/Won Amount', first(q2.'Opportunity.Id') as 'Selected FY Opportunity ID', sum(q2.'Donor Count') as 'Selected FY Donor Count',\n--get selected previous fy opps\nfirst(q1.'Opportunity.Name') as 'Previous FY Opp Name',  first(q1.'Opportunity.CloseDate') as 'Previous FY Opp Close Date', sum(q1.'Opportunity.Amount') as '$ - Previous FY Closed/Won Amount', first(q1.'Opportunity.Id') as 'Previous FY Opportunity ID', sum(q1.'Donor Count') as 'Previous FY Donor Count'; \n\n--group query to get account row number\nq3 = group q by ('Account.AQC_Account_ARCH_ID__c', 'Account.Name', 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Account.Id');\nq3 = foreach q3 generate 'Account.AQC_Account_ARCH_ID__c', 'Account.Name', 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Account.Id', \n--get selected fy opps\nfirst('Selected FY Opp Name') as 'Selected FY Opp Name',  first('Selected FY Opp Close Date') as 'Selected FY Opp Close Date', first('$ - Selected FY Closed/Won Amount') as '$ - Selected FY Closed/Won Amount', first('Selected FY Opportunity ID') as 'Selected FY Opportunity ID', sum('Selected FY Donor Count') as 'Selected FY Donor Count',\n--get selected previous fy opps\nfirst('Previous FY Opp Name') as 'Previous FY Opp Name',  first('Previous FY Opp Close Date') as 'Previous FY Opp Close Date', first('$ - Previous FY Closed/Won Amount') as '$ - Previous FY Closed/Won Amount', first('Previous FY Opportunity ID') as 'Previous FY Opportunity ID',  sum('Previous FY Donor Count') as 'Previous FY Donor Count', \n--get row number by account\nrow_number() over([..] partition by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Account.Id') order by 'Opportunity.ClosedWonGiftBandDevelopmentVertical') as AccountRowNumber;\n\n\n--filter for unique accounts and rollup by account\n--q4 = filter q3 by AccountRowNumber == 1;\nq4 = group q3 by rollup('Account.AQC_Account_ARCH_ID__c', 'Account.Name', 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Account.Id', 'Selected FY Opp Name',  'Selected FY Opp Close Date', 'Selected FY Opportunity ID', 'Previous FY Opp Name',  'Previous FY Opp Close Date', 'Previous FY Opportunity ID');\nq4 = foreach q4 generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Account.AQC_Account_ARCH_ID__c', 'Account.Name', 'Account.Id', \n--get selected fy opps\n'Selected FY Opp Name',  'Selected FY Opp Close Date', sum('$ - Selected FY Closed/Won Amount') as '$ - Selected FY Closed/Won Amount', 'Selected FY Opportunity ID', sum('Selected FY Donor Count') as 'Selected FY Donor Count',\n--get selected previous fy opps\n'Previous FY Opp Name',  'Previous FY Opp Close Date', sum('$ - Previous FY Closed/Won Amount') as '$ - Previous FY Closed/Won Amount', 'Previous FY Opportunity ID', sum('Previous FY Donor Count') as 'Previous FY Donor Count', \n--grouping functions\ngrouping(q4.'Account.AQC_Account_ARCH_ID__c') as 'grouping_Account.AQC_Account_ARCH_ID__c', grouping(q4.'Account.Name') as 'grouping_Account.Name',   grouping(q4.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q4.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name', grouping(q4.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical', grouping(q4.'Account.Id') as 'grouping_Account.Id', grouping('Selected FY Opp Name') as 'grouping_Selected FY Opp Name',  grouping('Selected FY Opp Close Date') as 'grouping_Selected FY Opp Close Date', grouping('Selected FY Opportunity ID') as 'grouping_Selected FY Opportunity ID', grouping('Previous FY Opp Name') as 'grouping_Previous FY Opp Name',  grouping('Previous FY Opp Close Date') as 'grouping_Previous FY Opp Close Date', grouping('Previous FY Opportunity ID') as 'grouping_Previous FY Opportunity ID';\n\ns = filter q4 by 'grouping_Account.AQC_Account_ARCH_ID__c' == 1;\nq4 = filter q4 by 'grouping_Account.AQC_Account_ARCH_ID__c' == 0 and 'grouping_Account.Name' == 0 and 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Account.Name' == 0  and 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 0 and 'grouping_Account.Id' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0 and 'grouping_Selected FY Opp Name' == 0 and 'grouping_Selected FY Opp Close Date' == 0 and 'grouping_Selected FY Opportunity ID' == 0 and 'grouping_Previous FY Opp Name' == 0 and 'grouping_Previous FY Opp Close Date' == 0 and 'grouping_Previous FY Opportunity ID' == 0;\nq4 = order q4 by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' asc, 'Opportunity.ClosedWonGiftBandDevelopmentVertical' asc,'Account.Name' asc);\nq4 = limit q4 2000;\nq4 = union q4, s;\nq4 = limit q4 2001;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Opportunity.OpportunityOwner.GiftOfficerTeam","Opportunity.OpportunityOwner.Name","Opportunity.ClosedWonGiftBandDevelopmentVertical","Account.AQC_Account_ARCH_ID__c","Account.Name","Selected FY Opp Name","Selected FY Opp Close Date","$ - Selected FY Closed/Won Amount","Selected FY Donor Count","Previous FY Opp Name","Previous FY Opp Close Date","$ - Previous FY Closed/Won Amount","Previous FY Donor Count"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":175,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Gift_Officer___Close_6":{"broadcastFacet":true,"groups":[],"label":"Donors by Gift Band, Opp Owner Table","numbers":[],"query":"--load selected fy opps\nq2 = load \"Opportunity_Info\";\nq2 = filter q2 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq2 = filter q2 by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq2 = filter q2 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq2 = group q2 by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OpportunityOwner.Name');\nq2 = foreach q2 generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', sum('Opportunity.Amount') as 'Opportunity.Amount', count(q2) as Count, \n--get row number by account\nrow_number() over([..] partition by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical') order by 'Opportunity.ClosedWonGiftBandDevelopmentVertical') as AccountRowNumber; \n\n--get unique selected fiscal year accounts\nq2_a = filter q2 by AccountRowNumber == 1;\n\n--load selected previous fy opps\nq1 = load \"Opportunity_Info\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq1 = filter q1 by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_3]]\"..\"[[parameter_3]]\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq1 = group q1 by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OpportunityOwner.Name');\nq1 = foreach q1 generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', sum('Opportunity.Amount') as 'Opportunity.Amount', count(q1) as Count, \n--get row number by account\nrow_number() over([..] partition by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical') order by 'Opportunity.ClosedWonGiftBandDevelopmentVertical') as AccountRowNumber; \n\n--get unique previous fiscal year accounts\nq1_a = filter q1 by AccountRowNumber == 1;\n\n--full join selected fy and previous fy opps\nq = cogroup q2_a by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OpportunityOwner.Name') full, q1_a by ( 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.ClosedWonGiftBandDevelopmentVertical',  'Opportunity.OpportunityOwner.Name');\nq = foreach q generate  coalesce(q2_a.'Opportunity.OpportunityOwner.GiftOfficerTeam', q1_a.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'Opportunity.OpportunityOwner.GiftOfficerTeam', coalesce(q2_a.'Opportunity.OpportunityOwner.Name', q1_a.'Opportunity.OpportunityOwner.Name') as 'Opportunity.OpportunityOwner.Name', coalesce(q2_a.'Opportunity.ClosedWonGiftBandDevelopmentVertical', q1_a.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'Opportunity.ClosedWonGiftBandDevelopmentVertical',\n--get selected fy opps\nsum(q2_a.'Opportunity.Amount') as '$ - Selected FY Closed/Won Amount', sum(q2_a.'Count') as '# - Selected FY Donor Count',\n--get selected previous fy opps\nsum(q1_a.'Opportunity.Amount') as '$ - Previous FY Closed/Won Amount', sum(q1_a.'Count') as '# - Previous FY Donor Count';\n\n--group query to get account row number\nq3 = group q by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical');\nq3 = foreach q3 generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', \n--get selected fy opps\n sum('$ - Selected FY Closed/Won Amount') as '$ - Selected FY Closed/Won Amount', sum('# - Selected FY Donor Count') as '# - Selected FY Donor Count', \n--get selected previous fy opps\n sum('$ - Previous FY Closed/Won Amount') as '$ - Previous FY Closed/Won Amount', sum('# - Previous FY Donor Count') as '# - Previous FY Donor Count', sum('# - Previous FY Donor Count') * 1.05 as '# - Donor Count Goal', sum('# - Selected FY Donor Count')/(sum('# - Previous FY Donor Count') * 1.05 ) as '% to Donor Count Goal'; \n\n--filter for unique accounts and rollup by account\nq4 = group q3 by rollup('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical');\nq4 = foreach q4 generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', \n--get selected fy opps\n sum('$ - Selected FY Closed/Won Amount') as '$ - Selected FY Closed/Won Amount', sum('# - Selected FY Donor Count') as '# - Selected FY Donor Count', \n--get selected previous fy opps\n sum('$ - Previous FY Closed/Won Amount') as '$ - Previous FY Closed/Won Amount', sum('# - Previous FY Donor Count') as '# - Previous FY Donor Count', sum('# - Donor Count Goal') as '# - Donor Count Goal', avg('% to Donor Count Goal') as '% to Donor Count Goal',\n--grouping functions\ngrouping(q4.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q4.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name', grouping(q4.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical';\n\ns = filter q4 by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 1;\nq4 = filter q4 by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0;\nq4 = order q4 by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' asc, 'Opportunity.ClosedWonGiftBandDevelopmentVertical' asc);\nq4 = limit q4 2000;\nq4 = union q4, s;\nq4 = limit q4 2001;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":175,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"PS___Closed_Won_by_S_1":{"broadcastFacet":false,"datasets":[{"name":"Opportunity_Info"}],"isGlobal":false,"label":"PS $ Closed/Won by School/Unit Summary Table","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":["Opportunity.Component.SchoolUnitToggle"],"limit":2000,"orders":[{"name":"Opportunity.Component.SchoolUnitToggle","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{"Opportunity_Info":{"filters":[["Opportunity.StageName",["Closed Won","Closed/Won"],"in"],["Opportunity.CloseDateFiscalYearsPassed",["[[parameter_1]]"],"in"],["Opportunity