Color":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfFrozenColumns":8,"numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Med_Adv_Qualificatio_2":{"broadcastFacet":true,"groups":[],"label":"Med Adv Qualification Outreaches Summary Table","numbers":[],"query":"q1 = load \"Activity_Report_Info\";\nq2 = load \"UA_Performance_Med_Team_Goals\";\nq1 = filter q1 by date('AQB__Date__c_Year', 'AQB__Date__c_Month', 'AQB__Date__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by 'AQB__Purpose__c' == \"Qualification\";\nq1 = filter q1 by 'AQB__ReportStatus__c' == \"Final\";\nq1 = filter q1 by ('RecordType.Name' != \"Corporate Engagement\" || 'RecordType.Name' is null);\nq1 = filter q1 by 'ActivityReportParticipant.User.Department' == \"Medical Advancement\";\nq1 = filter q1 by 'ActivityReportParticipant.MedOfficerTeam' in [\"Med Alumni\", \"Community Fundraising\", \"Med CFR\", \"Momentum/EVC/VC\", \"Med/Surg\", \"Neuro\", \"Siteman\"];\nq2 = filter q2 by 'Goal' == \"# of Qualifications\";\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"[[parameter_1]]\";\nq = cogroup q1 by 'ActivityReportParticipant.MedOfficerTeam' full, q2 by 'Med_Team';\nq = foreach q generate coalesce(q1.'ActivityReportParticipant.MedOfficerTeam', q2.'Med_Team') as 'ActivityReportParticipant.MedOfficerTeam', count(q1) as 'A', sum(q2.'Amount') as 'B';\nq = foreach q generate 'ActivityReportParticipant.MedOfficerTeam', 'A', 'B', A/B as 'C';\nq = group q by rollup('ActivityReportParticipant.MedOfficerTeam');\nq = foreach q generate q.'ActivityReportParticipant.MedOfficerTeam' as 'ActivityReportParticipant.MedOfficerTeam', sum(q.'A') as 'Qualification Outreaches', sum(q.'B') as 'Goal', sum(q.'A') / sum(q.'B') as '% to Goal', grouping(q.'ActivityReportParticipant.MedOfficerTeam') as 'grouping_ActivityReportParticipant.MedOfficerTeam';\ns