fication__c == \"Number of Opportunities Closed/Won\" and date('AQB_LastGoalIntervalDate__c_Year', 'AQB_LastGoalIntervalDate__c_Month', 'AQB_LastGoalIntervalDate__c_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"99 fiscal_years ago\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\n\nq = group q by all;\nq = foreach q generate sum(AQB__GoalCount__c) as 'Sum Goal';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Individual_Total_Fun_5":{"broadcastFacet":true,"groups":[],"label":"Individual Total Funders Count % to Goal","numbers":[],"query":"--load Goals Division dataset to get goals by UA division\nq = load \"User_Goal_Info\";\nq = filter q by 'AQB__Classification__c' == \"Number of Funders\" and date('AQB__LastGoalIntervalDate__c_Year', 'AQB__LastGoalIntervalDate__c_Month', 'AQB__LastGoalIntervalDate__c_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"99 fiscal_years ago\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\nq = foreach q generate sum('AQB__GoalCount__c') as 'SumGoal';\n\n--load opportunity info dataset to get results count\nq1 = load \"Opportunity_Info\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\", \"Closed - NPR Funded\"] and date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"99 fiscal_years ago\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\n--get unique accounts\nq1 = group q1 by 'Account.Id';\nq1 = foreach q1 generate 'Account.Id', sum(q1.'Opportunity.Amount') as 'B';\nq1 = limit q1 2000;\n\n--count unique accounts and sum the Opportunity Amount\nq2 = group q1 by all;\nq2 = foreach q2 generate count(q2) as TotalCount, sum('B') as TotalAmount;\n\nq3 = cogroup q2 by all full, q by all;\nq3 = foreach q3 generate (sum(q2.TotalCount)/sum(q.SumGoal)) as '% to Goal';\n","receiveFacetSource":{"mode":"exclude","steps":["Opportunity_AQC_Date_1","ProspectStrategyPlan_1"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","