eDate_Year_Fiscal', q.'Opportunity.StageName',\n--incorporate toggle selection  \n{{cell(Funding_Received_or__2.selection, 0, \"API\").asString()}} as {{cell(Funding_Received_or__2.selection, 0, \"Label\").asString()}};\nq = order q by ('Opportunity.CloseDate_Year_Fiscal' asc, 'Opportunity.StageName' asc);","receiveFacetSource":{"mode":"exclude","steps":["Opportunity_AQC_Date_1","Opportunity_CloseDat_2","ProspectStrategyPlan_1"]},"selectMode":"single","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","legend":{"descOrder":false,"showHeader":false,"show":false,"customSize":"auto","position":"top-center","inside":false},"axisMode":"dual","totalSumMode":"absolute","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]},"description":"Count of unique Accounts with a Closed/Won or Closed - NPR Funded Stage.  Sum of Closed/Won and Closed - NPR Funded Opportunity Amount. This chart is hard-coded to display the past 5 years of data and excludes filtering from 'Date Asked' and 'Close Date' filters at the top of the page. "}},"visualizationType":"stackvbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":true,"showTitle":true,"showAxis":true,"referenceLines":[{"color":"#00B531","label":{"data":{"noResultsLabel":"No Results Found","displayTemplate":"[Sum Goal] Individual Goal","compact":true,"sourceType":"result","step":"Individual_Goal_Fund_6"},"type":"dynamic"},"value":{"data":{"fi