ns\";\nq = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"current fiscal_year\"];\nq = filter q by 'Transaction.AQB__Type__c' == \"Payment\";\nq = filter q by 'Transaction.AQB__Method__c' in [\"Personal Property\", \"Real Property\"];\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq = filter q by 'Account.AQB__AccountType__c' in [\"Corporation\", \"Foundation\", \"Government\", \"Group\", \"Organization\"];\nq = group q by ('Credited_Fiscal_Year_Date_MMDDYYYY_Year_Fiscal', 'Account.AQB__AccountType__c');\nq = foreach q generate q.'Credited_Fiscal_Year_Date_MMDDYYYY_Year_Fiscal' as 'Credited_Fiscal_Year_Date_MMDDYYYY_Year_Fiscal', q.'Account.AQB__AccountType__c' as 'Account.AQB__AccountType__c', sum(q.'Transaction.AQB__Amount__c') as 'Sum Transaction Amount';\nq = order q by ('Credited_Fiscal_Year_Date_MMDDYYYY_Year_Fiscal' asc, 'Account.AQB__AccountType__c' asc);\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","totalSumMode":"absolute","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]},"description":"Sum of transaction amount where: \n\nTransaction Type = “Payment”\n\nTransaction Method in (“Personal Property”, “Real Property”)\n\nTransaction Non-Philanthropic = false\n\nAccount Type in (“Corporation”, “Foundation”, “Government”, “Group”, “Organization”)"}},"visualizationType":"stackvbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel"