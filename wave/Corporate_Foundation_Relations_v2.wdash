"},"text_13":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ffffff","size":"20px"},"insert":"Prospect Research Projects"},{"attributes":{"align":"center"},"insert":"\n"}]},"interactions":[],"showActionMenu":true,"tooltip":"Completion of Prospect Research Projects is a team effort. It includes, but is not limited to, completion of profiles, employee lookups, qualifications, targeted prospect research projects, and executive/leadership briefings."},"type":"text"},"filterpanel_65":{"parameters":{"filterItemOptions":{"propertyColor":"#020821","valueColor":"#BA0C2F"},"filters":[{"dataset":{"name":"Opportunity_Info"},"field":"Account.AQB__SecondaryTypes__c"}],"showAllFilters":false},"type":"filterpanel"},"text_16":{"parameters":{"content":{"richTextContent":[{"attributes":{},"insert":"This metric includes the creation of materials for and contact with corporations and organizations meant to acknowledge and/or inform an organization of its relationship with the university. Effective stewardship is an investment in the partnership, with the goal of further engaging the donor to motivate it to continue giving/engaging and increase its commitment/engagement.\n \nThis tab provides a list of Substantive Activity Reports where the Subject Line contains \"Stewardship Effort”, Purpose = \"Stewardship\", and Report Status = \"Final\". Questions? Submit a case or reach out to "},{"attributes":{"color":"#1868db"},"insert":"askarch@wustl.edu"},{"attributes":{},"insert":"."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"filterpanel_66":{"parameters":{"filterItemOptions":{"propertyColor":"#020821","valueColor":"#BA0C2F"},"filters":[{"dataset":{"name":"Opportunity_Info"},"field":"Account.ARCH_Account_ID__c"}],"showAllFilters":false},"type":"filterpanel"},"text_15":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"24px"},"insert":"📋"},{"attributes":{"align":"center"},"insert":"\n"}]},"inter