umberSize":18,"showActionMenu":true,"step":"Team_Total_Amount_So_2","textAlignment":"left","title":"Team % To Goal","titleBold":false,"titleColor":"#BA0C2F","titleItalic":false,"titleSize":14,"tooltip":{"customizeTooltip":false,"showTitleTooltip":true}},"type":"number"},"text_18":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#020821"},"insert":"The Fiscal year toggle filters goals and results. Deselect the fiscal year toggle to use the individual opportunity and activity report filters to return data from outside the current and previous fiscal year. Note that when the fiscal year toggle is deselected, the goals are the sum all fiscal year's goals."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"number_51":{"parameters":{"compact":true,"exploreLink":false,"interactions":[],"measureField":"Sum Goal","noResultsLabel":"-","numberBold":false,"numberColor":"#020821","numberItalic":false,"numberSize":18,"showActionMenu":true,"step":"Team_Goal_Total_Amou_2","textAlignment":"left","title":"Team Goal","titleBold":false,"titleColor":"#BA0C2F","titleItalic":false,"titleSize":14,"tooltip":{"content":{"description":{"displayTemplate":"GoalsDivisionCorporationFoundationRelations .csv file-derived dataset AQB__Classification__c = \"Opportunity Amount Solicited\""}},"customizeTooltip":true,"showTitleTooltip":true}},"type":"number"},"container_15":{"parameters":{"alignmentX":"left","alignmentY":"top","fit":"original","interactions":[]},"type":"container"},"text_17":{"parameters":{"content":{"richTextContent":[{"attributes":{},"insert":"This metric captures interactions with university leadership, faculty, and other departments and institutes at the university outside of University Advancement.\n\nThese meetings help to further clarify funding priorities, case and opportunity development, and other potential avenues for corporate and organizational engagement with WashU. It helps us to proactively match