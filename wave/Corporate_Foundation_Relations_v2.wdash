ion dataset to get goals by UA division\nq = load \"GoalsDivisionCorporationFoundationRelations\";\nq = filter q by AQB__Classification__c == \"Opportunity Amount Solicited\" and date('AQB_LastGoalIntervalDate__c_Year', 'AQB_LastGoalIntervalDate__c_Month', 'AQB_LastGoalIntervalDate__c_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"99 fiscal_years ago\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\nq = group q by all;\nq = foreach q generate sum(AQB__GoalCurrencyAmount__c) as SumGoal;\n\n--load opportunity info dataset to get results count\nq1 = load \"Opportunity_Info\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"LOI/Concept Paper Submittal\", \"Proposal Submittal\", \"Negotiation/Review\", \"Closed Won\", \"Closed/Lost\", \"Closed/Won\", \"Closed - Lost\", \"Closed – NPR Funded\"] and date('Opportunity.AQC_Date_Asked__c_Year', 'Opportunity.AQC_Date_Asked__c_Month', 'Opportunity.AQC_Date_Asked__c_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"99 fiscal_years ago\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\nq1 = group q1 by all;\nq1 = foreach q1 generate count(q1) as 'A', sum(q1.'Opportunity.Amount') as 'B';\nq1 = limit q1 2000;\n\nq2 = cogroup q1 by all full, q by all;\nq2 = foreach q2 generate (sum(q1.B)/sum(q.SumGoal)) as '% to Goal';","receiveFacetSource":{"mode":"exclude","steps":["Opportunity_CloseDat_2","ProspectStrategyPlan_2"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"au