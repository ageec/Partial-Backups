esce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"99 fiscal_years ago\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\nq = group q by all;\nq = foreach q generate sum(AQB__GoalCount__c) as SumGoal;\n\n--load activity reports info dataset\nq1 = load \"Activity_Report_Info\";\n--filter for substantive activity reports with faculty/staff meeting type\nq1 = filter q1 by AQB__Type__c == \"Faculty/Staff Meeting\" and AQB__ReportStatus__c == \"Final\" and date('AQB__Date__c_Year', 'AQB__Date__c_Month', 'AQB__Date__c_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"99 fiscal_years ago\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\nq1 = group q1 by all;\nq1 = foreach q1 generate count() as ResultCount;\n\n\nq2 = cogroup q1 by all full, q by all;\nq2 = foreach q2 generate (sum(q1.ResultCount)/sum(q.SumGoal)) as '% to Goal';\n","receiveFacetSource":{"mode":"exclude","steps":["AQB__EssentialMove___1","Substantive_Activity_5"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100]