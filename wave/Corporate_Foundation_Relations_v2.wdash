duation Date', q.'AwardeeContact.PrimaryEducation.AQB__GraduationYear__c' as 'Awardee Graduation Year', q.'AQB__Award.AQB__Note__c' as 'Recipient Note', q.'AQC_FundingStatus__c' as 'Award Funding Status', q.'AQC_FiscalYearEstablished__c', q.'DesignationAmount.SUM_AQB__Amount__c' as 'Amount Donated', q.'COA.Name' as 'Designation Name', q.'ARCH_Designation_Account_School_Unit__c' as 'Designation School/Unit', q.'COA.AQB__Department__c' as 'Designation Department', q.'Account.ARCH_Account_ID__c' as 'Account.ARCH_Account_ID__c', q.'Account.Name' as 'Account.Name', q.'AQB__KeyCo.ARCH_Account_Type__c' as 'AQB__KeyCo.ARCH_Account_Type__c', q.'Secondary_Account_Types_List' as 'Secondary Account Types', q.'ParentAccount.ARCH_Account_ID__c' as 'Parent ARCH Account ID', q.'ParentAccount.Name' as 'Parent Account Name', q.'KeyContactContact.Account.ARCH_PrimaryGiftOfficerName__c' as 'Primary Gift Officer', q.'RelationshipManager.Name' as 'RelationshipManager.Name', q.'KeyContactContact.AccountInfo.PMTeam.QualifyingGiftOfficerList' as 'Qualifying Gift Officer', q.'KeyContactContact.AccountInfo.PMTeam.CorpsFoundsOfficerList' as 'Corps/Founds Officer', q.'Account.BillingStreet' as 'Donor Street', q.'Account.BillingCity' as 'Donor City', q.'Account.BillingState' as 'Donor State/Province', q.'Account.BillingPostalCode' as 'Donor Zip/Postal Code', q.'Account.BillingCountry' as 'Donor Country'\n--field picker interaction\n{{coalesce(join(column(Organizations_with_A_1.selection, [\"API\"]),''),'').asString()}},\n q.'AQB__Award.Id' as 'System Award Recipient ID', q.'AwardeeContact.Id' as 'System Awardee Contact ID', q.'Id' as 'System Award ID', q.'Account.Id' as 'System Account ID';\nq = order q by ('Award Name' asc, 'Award Start Date' desc);\nq = limit q 250000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","border