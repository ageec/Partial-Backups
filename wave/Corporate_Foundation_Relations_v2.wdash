PR_Funded_Opportunity_Count' > 0 || 'AccountCorpFoundRel.Opportunity.CFY_Open_Opportunity_Count' > 0);\n--group by parent-account and account\nq = group q by ('Account.Parent_ARCH_Account_ID_ARCH_Account_ID', 'Account.Parent_Account_Name_Account_Name', 'Account.ARCH_Account_ID__c');\n--display columns\nq = foreach q generate q.'Account.Parent_ARCH_Account_ID_ARCH_Account_ID' as 'Parent ARCH Account ID', q.'Account.Parent_Account_Name_Account_Name'  as 'Parent Account Name', 'Account.ARCH_Account_ID__c' as 'Account.ARCH_Account_ID__c', first('Account.Name') as 'Account.Name', first('Account.AQB__AccountType__c') as 'Account.AQB__AccountType__c', first(q.'Account.Secondary_Account_Types_List') as 'Secondary Account Types', first('AccountCorpFoundRel.ActivityReport.CFY_Activity_Report_Substantive_Final_Count') as 'AccountCorpFoundRel.ActivityReport.CFY_Activity_Report_Substantive_Final_Count', first(q.'AccountCorpFoundRel.OppTeamARParticipant.CFY_Activity_Report_Participant_List') as 'CFY Substantive Activity Report Participant(s) Name(s)', first(q.'AccountCorpFoundRel.OppTeamARParticipant.CFY_Activity_Report_Participant_Division_List') as 'CFY Substantive Activity Report Participant(s) UA Division(s)', first(q.'AccountCorpFoundRel.OppTeamARParticipant.CFY_AR_Assigned_To_List') as 'Activity Report Assigned to Name', first(q.'AccountCorpFoundRel.OppTeamARParticipant.CFY_AR_Assigned_To_Division_List') as 'Activity Report Assigned To Division', first(q.'AccountCorpFoundRel.OppTeamARParticipant.Activity_Report_Last_Modified_Date') as 'Activity Report Last Modified Date', first(q.'AccountCorpFoundRel.OppTeamARParticipant.Activity_Report_Last_Modified_By') as 'Activity Report Last Modified By', first(q.'AccountCorpFoundRel.OppTeamARParticipant.CFY_Opp_Team_Member_AR_User_Participant_List') as 'CFY Opportunity AR Participant(s) Name(s)', first(q.'AccountCorpFoundRel.OppTeamARParticipant.CFY_Opp_Team_Division_AR_User_Division_List') as 'CFY Opportunity AR Participant(s) UA Div