"Display\":\"Account Interest Groups\",\"API\":\",'Account Interest Groups'\"}","{\"Display\":\"Primary Contact Interest Types\",\"API\":\",'Primary Contact Interest Types'\"}","{\"Display\":\"Primary Contact Interest Groups\",\"API\":\",'Primary Contact Interest Groups'\"}","{\"Display\":\"Campaign Appeal Name\",\"API\":\",'Campaign_Appeal.Name'\"}","{\"Display\":\"Instrument Descriptor\",\"API\":\",'Transaction.ARCH_Instrument_Descriptor__c'\"}","{\"Display\":\"Handoff Officer\",\"API\":\",'Handoff Officer'\"}","{\"Display\":\"Annual Giving Officer\",\"API\":\",'Annual Giving Officer'\"}","{\"Display\":\"Annual Giving Pipeline Officer\",\"API\":\",'Annual Giving Pipeline Officer'\"}","{\"Display\":\"Corporate Engagement Partner\",\"API\":\",'Corporate Engagement Partner'\"}","{\"Display\":\"Donor Relations Officer\",\"API\":\",'Donor Relations Officer'\"}","{\"Display\":\"Employer Development Partner\",\"API\":\",'Employer Development Partner'\"}","{\"Display\":\"Employer Engagement Partner\",\"API\":\",'Employer Engagement Partner'\"}","{\"Display\":\"Executive Partner\",\"API\":\",'Executive Partner'\"}","{\"Display\":\"Lead\",\"API\":\",'Lead'\"}","{\"Display\":\"Medicine Giving Officer\",\"API\":\",'Medicine Giving Officer'\"}","{\"Display\":\"Planned Giving Officer\",\"API\":\",'Planned Giving Officer'\"}","{\"Display\":\"Principal Gifts Liaison\",\"API\":\",'Principal Gifts Liaison'\"}","{\"Display\":\"Prospect Management Consultant\",\"API\":\",'Prospect Management Consultant'\"}","{\"Display\":\"Prospect Researcher\",\"API\":\",'Prospect Researcher'\"}","{\"Display\":\"Proxy Officer\",\"API\":\",'Proxy Officer'\"}","{\"Display\":\"Stewardship Officer\",\"API\":\",'Stewardship Officer'\"}","{\"Display\":\"Strategy Officer\",\"API\":\",'Strategy Officer'\"}","{\"Display\":\"Territory Partner\",\"API\":\",'Territory Partner'\"}","{\"Display\":\"Volunteer Manager\",\"API\":\",'Volunteer Manager'\"}","{\"Display\":\"System Account ID\",\"API\":\",'System Account ID'\"}","{\"Display\":\"System Parent Account ID\",\"API\":\",'System Parent Account ID'\"}"]},"lens_1_3":{"broadcastFacet":true,"groups":[],"label":"Gifts-in-kind detail table","numbers":[],"query":"--load Gifts and Pledge Transactions dataset\nq = load \"Gifts_and_Pledge_Transactions\";\nq = filter q by 'Transaction.AQB__Type__c' == \"Payment\" and 'Transaction.AQB__Method__c' in [\"Personal Property\", \"Real Property\"] and 'Transaction.ARCH_Non_Philanthropic__c' == \"false\" and 'Account.Record_Type.Name' in [\"Corporation\", \"Foundation\", \"Government\", \"Group\", \"Organization\"];\nq = foreach q generate q.'Account.ARCH_Account_ID__c' as 'Account.ARCH_Account_ID__c', q.'Account.Name' as 'Account.Name', q.'Account.AQB__AccountType__c', q.'Secondary_Account_Types_List' as 'Secondary Account Types', q.'ParentAccount.ARCH_Account_ID__c' as 'Parent ARCH Account ID', q.'ParentAccount.Account.Related_Account.Name' as 'Parent Account Name', q.'Account.AQB__AccountStatus__c', q.'Transaction.AQC_Date_Processed__c' as 'Transaction.AQC_Date_Processed__c', q.'Transaction.ARCH_CreditedFiscalYearDate__c' as 'Transaction.ARCH_CreditedFiscalYearDate__c', q.'Transaction.Name' as 'Transaction.Name', q.'Transaction.AQB__Amount__c' as 'Transaction.AQB__Amount__c', q.'Transaction.AQB__Method__c' as 'Transaction.AQB__Method__c', q.'TransactionStatus', q.'Transaction.AQB__Description__c' as 'Transaction.AQB__Description__c', q.'Transaction.AQB__PropertyCategory__c' as 'Transaction.AQB__PropertyCategory__c', q.'AQB__DesignationText__c' as 'AQB__DesignationText__c', q.'COA.AQB__SchoolUnit__c' as 'COA.AQB__SchoolUnit__c', q.'COA.AQB__Department__c', q.'COA.AQB__Category__c', q.'COA.AQC_WorkdayGiftID__c' as 'COA.AQC_WorkdayGiftID__c', q.'COA.AQC_WorkdayProjectID__c' as 'COA.AQC_WorkdayProjectID__c', q.'COA.AQC_WorkdayCostCenterID__c' as 'COA.AQC_WorkdayCostCenterID__c', q.'COA.AQC_WorkdayBusinessUnitID__c' as 'COA.AQC_WorkdayBusinessUnitID__c', q.'COA.AQC_WorkdayFundID__c' as 'COA.AQC_WorkdayFundID__c', q.'Transaction.AQB__Voided__c' as 'Transaction.AQB__Voided__c', q.'Transaction.AQB__VoidNotation__c' as 'Transaction.AQB__VoidNotation__c', q.'Transaction.ARCH_Prior_Adjusted_Transaction__c' as 'Transaction.ARCH_Prior_Adjusted_Transaction__c', q.'Prior_Adjusted_Transaction_Amount' as 'Prior_Adjusted_Transaction_Amount', q.'Prior_Adjusted_Transaction_Date_Processed' as 'Prior_Adjusted_Transaction_Date_Processed', 'Transaction.Id', 'Account.Id', 'Account.ParentId',\n --insert fields to be used in field picker in later query\n q.'Accounts.ARCH_Total_Gifts_and_Pledges_all_types__c' as 'Accounts.ARCH_Total_Gifts_and_Pledges_all_types__c', q.'Account.ARCH_Total_Legal_Gifts_and_Pledges__c' as 'Account.ARCH_Total_Legal_Gifts_and_Pledges__c', q.'Account.ARCH_Metro_Area__c' as 'Account.ARCH_Metro_Area__c', q.'Account.BillingState' as 'Donor State/Province', q.'Account.BillingCountry' as 'Donor Country', q.'Account.ARCH_Target_Market__c' as 'Account.ARCH_Target_Market__c', q.'Account.ARCH_Territory__c' as 'Account.ARCH_Territory__c', q.'COA.AQC_PrimaryPurposeType__c' as 'COA.AQC_PrimaryPurposeType__c', q.'COA.AQC_Primary_Purpose__c' as 'COA.AQC_Primary_Purpose__c', q.'AlternatePurpose' as 'Alternate Purposes', q.'Transaction.Annual_Fund__c' as 'Transaction.Annual_Fund__c', q.'COA.ARCH_RelatedtoCancer__c' as 'COA.ARCH_RelatedtoCancer__c', q.'ARCH_Tribute_Gift__c' as 'ARCH_Tribute_Gift__c', q.'Accounts.Account_Interests.AccountInterestTypesList' as 'Account Interest Types', q.'Accounts.Account_Interests.AccountInterestGroupsList' as 'Account Interest Groups', q.'Accounts.Primary_Contact_Interests.AllContactInterestTypes' as 'Primary Contact Interest Types', q.'Accounts.Primary_Contact_Interests.AllContactInterestGroupsList' as 'Primary Contact Interest Groups', q.'Campaign_Appeal.Name' as 'Campaign_Appeal.Name', q.'Transaction.ARCH_Instrument_Descriptor__c' as 'Transaction.ARCH_Instrument_Descriptor__c';\n\n\n--load Account Info dataset\nq1 = load \"Account_Info\";\nq1 = foreach q1 generate 'Account.ARCH_Account_ID__c', \"Transaction Number\" as 'Transaction Number', 'Account.AQB__AccountStatus__c' as 'Account Status', 'Account.PrimaryGiftOfficer.Name' as 'Primary Gift Officer', 'Account.PrimaryGiftOfficer.Division' as 'Primary Gift Officer UA Division', 'Name' as 'Relationship Manager', 'PMTeam.QualifyingGiftOfficerList' as 'Qualifying Gift Officer', 'PMTeam.CorpsFoundsOfficerList' as 'Corps/Founds Officer', 'RMT_Division_Active_List' as 'RMT UA Division', 'PMTeam.HandoffOfficerList' as 'Handoff Officer', 'PMTeam.AnnualGivingOfficerList' as 'Annual Giving Officer', 'PMTeam.AnnualGivingPipelineOfficerList' as 'Annual Giving Pipeline Officer', 'Corporate_Engagement_Partner_List' as 'Corporate Engagement Partner', 'PMTeam.DonorRelationsOfficerList' as 'Donor Relations Officer', 'Employer_Development_Partner_List' as 'Employer Development Partner', 'Employer_Engagement_Partner_List' as 'Employer Engagement Partner', 'PMTeam.ExecutivePartnerList' as 'Executive Partner', 'PMTeam.LeadList' as 'Lead', 'PMTeam.MedicineGivingOfficerList' as 'Medicine Giving Officer', 'PMTeam.PlannedGivingOfficerList' as 'Planned Giving Officer', 'PMTeam.PrincipalGiftsLiaisonList' as 'Principal Gifts Liaison', 'PMTeam.ProspectManagementConsultantList' as 'Prospect Management Consultant', 'PMTeam.ProspectResearcherList' as 'Prospect Researcher', 'PMTeam.ProxyOfficerList' as 'Proxy Officer', 'PMTeam.StewardshipOfficerList' as 'Stewardship Officer', 'PMTeam.StrategyOfficerList' as 'Strategy Officer', 'PMTeam.TerritoryPartnerList' as 'Territory Partner', 'PMTeam.VolunteerManagerList' as 'Volunteer Manager', 'Account.Id' as 'System Account ID', 'Account.ParentId' as 'System Parent Account ID';\n\n--cogroup Gifts and Pledge Transactions with Account Info dataset\nq2 = cogroup q by ('Account.ARCH_Account_ID__c', 'Transaction.Name') left, q1 by ('Account.ARCH_Account_ID__c', 'Transaction Number');\nq2 = foreach q2 generate q.'Account.ARCH_Account_ID_