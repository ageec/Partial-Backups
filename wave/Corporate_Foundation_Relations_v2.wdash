ent.ARCH_Account_ID__c' as 'Parent ARCH Account ID', q.'Account.Parent.Name' as 'Parent Account Name', q.'Opportunity.Name' as 'Opportunity.Name', q.'Opportunity.OppRecordType.Name' as 'Opportunity.OppRecordType.Name', q.'Opportunity.ARCH_Strategy_Clean__c' as 'Opportunity Strategy', q.'Opportunity.StageName' as 'Opportunity.StageName', q.'Opportunity.AQB__StageDate__c' as 'Opportunity.AQB__StageDate__c', q.'Opportunity.AQC_Date_Asked__c' as 'Opportunity.AQC_Date_Asked__c', q.'Opportunity.AQC_Date_Asked__c_Year_Fiscal' as 'Opportunity.AQC_Date_Asked__c_Year_Fiscal', q.'Opportunity.AQC_Ask_Amount__c'  as 'Opportunity.AQC_Ask_Amount__c', q. 'Opportunity.CloseDate' as  'Opportunity.CloseDate', q.'Opportunity.Amount' as 'Opportunity.Amount', q.'Opportunity.OppComp1.ARCH_Designation_Category_1__c' as 'Opportunity.OppComp1.ARCH_Designation_Category_1__c', q.'Opportunity.OppComp1.AQB__Description__c', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity Owner Name', q.'Opportunity.OpportunityOwner.User.Division'  as 'Opportunity Owner Division', q.'Opportunity.OppTeamMemberActiveList' as 'Opportunity Team Member List (Active)', q.'Opportunity.OppTeamMemberDivisionActiveList' as 'Opportunity Team Member Division List (Active)', q.'Opportunity.Opportunity_Contact_Name_Role_List' as 'Opportunity Contact(s) Name + Role', q.'Name' as 'Relationship Manager', q.'Division' as 'Relationship Manager Division',  q.'Opportunity.LastModifiedDate' as 'Opportunity.LastModifiedDate'\n --insert field picker field interaction\n {{coalesce(join(column(OpportunityFields_2.selection, [\"API_Text\"]),''),'').asString()}},\n q.'Opportunity.Opportunity_Strategy_Format_Color' as 'Opportunity.Opportunity_Strategy_Format_Color', q.'Opportunity.Last_Modified_Date_Format_Color' as 'Opportunity.Last_Modified_Date_Format_Color', q.'Opportunity.Close_Date_Format_Color' as 'Opportunity.Close_Date_Format_Color', q.'Relationship_Manager_Format_Color' as 'Relationship_Manager_Format_Color';\nq = limit q 250