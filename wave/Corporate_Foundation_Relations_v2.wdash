ate__c_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"99 fiscal_years ago\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\nq = foreach q generate sum(AQB__GoalCount__c) as SumGoal;\n\n--load opportunity info dataset to get results count\nq1 = load \"Opportunity_Info\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\", \"Closed - NPR Funded\"] and date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"99 fiscal_years ago\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\n--get unique accounts\nq1 = group q1 by 'Account.Id';\nq1 = foreach q1 generate 'Account.Id', sum(q1.'Opportunity.Amount') as 'B';\nq1 = limit q1 2000;\n\n--count unique accounts and sum the Opportunity Amount\nq2 = group q1 by all;\nq2 = foreach q2 generate count(q2) as TotalCount, sum('B') as TotalAmount;\n\nq3 = cogroup q2 by all full, q by all;\nq3 = foreach q3 generate (sum(q2.TotalCount)/sum(q.SumGoal)) as '% to Goal';\n","receiveFacetSource":{"mode":"exclude","steps":["Opportunity_AQC_Date_1","ProspectStrategyPlan_1"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}