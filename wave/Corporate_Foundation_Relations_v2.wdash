e Current Fiscal Year. This metric excludes filtering from the 'Close Date' filter at the top of the page since this metric is based on the 'Date Asked' field. "}},"visualizationType":"flatgauge","exploreLink":false,"medium":33,"title":{"fontSize":14,"subtitleFontSize":11,"label":"Amount Solicited","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"colors":{"mediumColor2":"#F29946","mediumColor1":"#FED444","lowColor1":"#F71979","lowColor2":"#CC203D","highColor1":"#7BDE4E","highColor2":"#169913"},"high":66,"showActionMenu":true,"min":0,"valueType":"compactNumber","theme":"wave","step":"Opportunities_Won_Fl_1","referenceLines":[{"color":"#63BE7A","label":{"data":{"displayTemplate":"Individual Goal [Sum Goal]","compact":true,"sourceType":"result","step":"Individual_Goal_CFY__2"},"type":"dynamic"},"value":{"data":{"field":"Sum Goal","sourceType":"result","step":"Individual_Goal_CFY__2"},"type":"dynamic"}},{"color":"#215732","label":{"data":{"displayTemplate":"Team Goal [Sum Goal]","compact":true,"sourceType":"result","step":"Team_Goal_Total_Amou_2"},"type":"dynamic"},"value":{"data":{"field":"Sum Goal","sourceType":"result","step":"Team_Goal_Total_Amou_2"},"type":"dynamic"}}],"compactDecimalDigits":-1,"applyConditionalFormatting":true},"type":"chart"},"text_3":{"parameters":{"content":{"richTextContent":[{"attributes":{},"insert":"This tab provides information about Solicited Opportunities. To view the Opportunities for an individual Gift Officer, use the filter “Opportunity Team Member Name + Role”. To view a team of Gift Officers’ Opportunities, use the filter “Opportunity Team Member Division”. Note the visualizations respond to the filter choices and highlight the Amount Solicited and Opportunities Submitted by Gift Officer and Gift Officer Division. Individual Opportunities are visible and linked through the Opportunity Detail View at the bottom of the page. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"listselector_45":{"parameters":{"compact":false,"displayMode":"filter","exploreLink":false,"filterStyle":{"titleColor":"#020821","valueColor":"#BA0C2F"},"instant":false,"interactions":[],"measureField":"count","showActionMenu":true,"step":"PMTeam_RM_Team_Membe_9","title":"RMT Division"},"type":"listselector"},"text_2":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ba0c2f","size":"22px"},"insert":"Corporate & Foundation Relations"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"chart_5":{"parameters":{"autoFitMode":"keepLabels","max":100,"legend":{"showHeader":true,"show":false,"position":"right-top","inside":false},"tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]},"description":"Count of unique Accounts with a Closed/Won or Closed - NPR Funded Stage. This metric excludes filtering from the 'Date Asked' filter at the top of the page since this metric is based on the 'Close Date' field. "}},"visualizationType":"flatgauge","exploreLink":false,"medium":33,"title":{"fontSize":14,"subtitleFontSize":11,"label":"Funders","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"colors":{"mediumColor2":"#F29946","mediumColor1":"#FED444","lowColor1":"#F71979","lowColor2":"#CC203D","highColor1":"#7BDE4E","highColor2":"#169913"},"high":66,"showActionMenu":true,"min":0,"valueType":"compactNumber","theme":"wave","step":"Funding_Received_Cha_2","referenceLines":[{"color":"#63BE7A","label":{"data":{"displayTemplate":"Individual Goal [Sum Goal]","compact":false,"sourceType":"result","step":"Individual_Goal_Fund_4"},"type":"dynamic"},"value":{"data":{"field":"Sum Goal","sourceType":"result","step":"Individual_Goal_Fund_4"},"type":"dynamic"}},{"color":"#215732","label":{"data":{"displayTemplate":"Team Goal [Sum Goal]","sourceType":"result","step":"Team_Goal_Funders_Co_2"},"type":"dynamic"},"value":{"data":{"field":"Sum Goal","sourceType":"result","step":"Team_Goal_Funders_Co_2"},"type":"dynamic"}}],"compactDecimalDigits":-1,"applyConditionalFormatting":true},"type":"chart"},"listselector_44":{"parameters":{"compact":false,"displayMode":"filter","exploreLink":false,"filterStyle":{"titleColor":"#020821","valueColor":"#BA0C2F"},"instant":false,"interactions":[],"measureField":"count","showActionMenu":true,"step":"AQB__EssentialMove___1","title":"Substantive Activity"},"type":"listselector"},"text_5":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"16px","color":"#020821"},"insert":"This page displays non-household Accounts that have at least one Substantive Activity Report, Closed/Won Opportunity, Closed – NPR Funded Opportunity, or Open Opportunity in the Current Fiscal Year (CFY) involving a member of the Danforth Campus or School of Medicine Corporate & Foundation Relations team. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"chart_8":{"parameters":{"autoFitMode":"keepLabels","max":100,"legend":{"showHeader":true,"show":false,"position":"right-top","inside":false},"tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]},"description":"Count of Closed/Won and Closed - NPR Funded Opportunities with Close Date in the Current Fiscal Year. This metric excludes filtering from the 'Date Asked' filter at the top of the page since this metric is based on the 'Close Date' field. "}},"visualizationType":"flatgauge","exploreLink":false,"medium":33,"title":{"fontSize":14,"subtitleFontSize":11,"label":"Opportunities Won","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"colors":{"mediumColor2":"#F29946","mediumColor1":"#FED444","lowColor1":"#F71979","lowColor2":"#CC203D","highColor1":"#7BDE4E","highColor2":"#169913"},"high":66,"showActionMenu":true,"min":0,"valueType":"compactNumber","theme":"wave","step":"Funders_Flat_Gauge_C_1","referenceLines":[{"color":"#63BE7A","label":{"data":{"displayTemplate":"Individual Goal [Sum Goal]","sourceType":"result","step":"Individual_Goal_Oppo_6"},"type":"dynamic"},"value":{"data":{"field":"Sum Goal","sourceType":"result","step":"Individual_Goal_Oppo_6"},"type":"dynamic"}},{"color":"#215732","label":{"data":{"displayTemplate":"Team Goal [Sum Goal]","sourceType":"result","step":"Team_Goal_Opportunit_6"},"type":"dynamic"},"value":{"data":{"field":"Sum Goal","sourceType":"result","step":"Team_Goal_Opportunit_6"},"type":"dynamic"}}],"compactDecimalDigits":-1,"applyConditionalFormatting":true},"type":"chart"},"listselector_43":{"parameters":{"compact":false,"displayMode":"filter","exploreLink":false,"filterStyle":{"titleColor":"#020821","valueColor":"#BA0C2F"},"instant":false,"interactions":[],"measureField":"count","showActionMenu":true,"step":"Award_Number_List_Se_2","title":"Award Number"},"type":"listselector"},"text_4":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#020821"},"insert":"This tab provides a list of Substantive Activity Reports where the Subject Line contains “University Assist”. “Assists” to other departments are measured to capture the value the team brings to the university by using a holistic approach. Assists occur when a team member helps increase the engagement of a corporation or organization with the university by assisting a university partner in achieving their goals (e.g., getting a letter for a federal grant, bringing a company to a career fair, etc.). Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"listselector_42":{"parameters":{"compact":false,"displayMode":"filter","exploreLink":false,"filterStyle":{"titleColor":"#020821","valueColor":"#BA0C2F"},"instant":false,"interactions":[],"measureField":"count","showActionMenu":true,"step":"Awardee_Major_List_S_1","title":"Awardee Graduation Year"},"type":"listselector"},"chart_2":{"parameters":{"autoFitMode":"keepLabels","legend":{"descOrder":false,"showHeader":false,"show":false,"customSize":"auto","position":"top-center","inside":false},"axisMode":"sync","totalSumMode":"absolute","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]},"description":"Count of unique Accounts with a Closed/Won or Closed - NPR Funded Stage.  Sum of Closed/Won and Closed - NPR Funded Opportunity Amount. This chart is hard-coded to display the past 5 years of data based on Date Asked. "}},"visualizationType":"stackvbar","exploreLink":false,"title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":true,"showTitle":true,"showAxis":true,"referenceLines":[{"color":"#006714","label":{"data":{"displayTemplate":"[Sum Goal] Team Goal","compact":true,"sourceType":"result","step":"Team_Goal_CFY_Amount_1"},"type":"dynamic"},"value":{"data":{"field":"Sum Goal","sourceType":"result","step":"Team_Goal_CFY_Amount_1"},"type":"dynamic"}},{"color":"#00B531","label":{"da