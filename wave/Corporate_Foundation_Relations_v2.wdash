n_Opportunity_Count' > 0 || 'AccountCorpFoundRel.Opportunity.CFY_Closed_NPR_Funded_Opportunity_Count' > 0 || 'AccountCorpFoundRel.Opportunity.CFY_Open_Opportunity_Count' > 0;\nq = group q by 'AccountCorpFoundRel.OppTeamARParticipant.CFY_Opp_Team_Division_AR_User_Division_All';\nq = foreach q generate 'AccountCorpFoundRel.OppTeamARParticipant.CFY_Opp_Team_Division_AR_User_Division_All', count() as 'count';\nq = order q by 'AccountCorpFoundRel.OppTeamARParticipant.CFY_Opp_Team_Division_AR_User_Division_All' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Team_Activities_with_1":{"broadcastFacet":true,"groups":[],"label":"Team Stewardship Efforts % to Goal","numbers":[],"query":"--load Goals Division dataset to get goals by UA division\nq = load \"GoalsDivisionCorporationFoundationRelations\";\nq = filter q by AQB__Classification__c == \"Number of Stewardship Efforts\" and date('AQB_LastGoalIntervalDate__c_Year', 'AQB_LastGoalIntervalDate__c_Month', 'AQB_LastGoalIntervalDate__c_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"99 fiscal_years ago\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\nq = group q by all;\nq = foreach q generate sum(AQB__GoalCount__c) as 'Sum Goal';\n\n--load activity reports info dataset\nq1 = load \"Activity_Report_Info\";\nq1 = filter q1 by AQB__EssentialMove__c == \"true\" and AQB__Purpose__c == \"Stewardship\" and AQB__Subject__c matches \"Stewardship Effort\" and AQB__ReportStatus__c == \"Final\" and date('AQB__Date__c_Year', 'AQB__Date__c_Month', 'AQB__Date__c_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"99 fiscal_years ago\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\nq1 = group q1 by all;\nq1 = foreach q1 generate count() as ResultCount;\n\nq2 = cogroup q1 by all full, q by all;\nq2 = foreach q2 generate (sum(q1.ResultCount)/sum(q.'Sum Goal')) as '% to Goal';\n","receiveFacetSource":{"mode":"exclude","steps":["Substantive_Activity_5"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":t