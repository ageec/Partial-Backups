fiscal_year\").asString()}}\"];\n\nq = group q by all;\nq = foreach q generate count() as RecordCount;\n\n--load opportunities\nq1 = load \"Opportunity_Info\";\nq1 = filter q1 by ('Opportunity.StageName' in [\"LOI/Concept Paper Submittal\", \"Proposal Submittal\", \"Negotiation/Review\"] and date('Opportunity.AQC_Date_Asked__c_Year', 'Opportunity.AQC_Date_Asked__c_Month', 'Opportunity.AQC_Date_Asked__c_Day') in {{coalesce(cell(static_3.selection,0, \"API\"),\"all\").asString()}} and date('Opportunity.AQC_Date_Asked__c_Year', 'Opportunity.AQC_Date_Asked__c_Month', 'Opportunity.AQC_Date_Asked__c_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"99 fiscal_years ago\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"]) \n|| \n('Opportunity.StageName' in [\"Closed Won\", \"Closed/Lost\", \"Closed/Won\", \"Closed - Lost\", \"Closed – NPR Funded\"] and date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in {{coalesce(cell(static_3.selection,0, \"API\"),\"all\").asString()}} and date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"99 fiscal_years ago\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"]);\n\nq1 = group q1 by all;\nq1 = foreach q1 generate count() as RecordCount;\n\n--append AR count to Opp count, then sum together\nq2 = union q, q1;\nq2 = group q2 by all;\nq2 = foreach q2 generate sum(RecordCount) as 'Substantive Activity Count';\n\n\nq4 = cogroup q2 by all full, q3 by all;\nq4 = foreach q4 generate (sum(q2.'Substantive Activity Count')/sum(q3.SumGoal)) as '% to Goal';\n","receiveFacetSource":{"mode":"exclude","steps":["Substantive_Activity_5","Opportunity_CloseDat_2","Opportunity_AQC_Date_1","ProspectStrategyPlan_1"]},"selectMode":"single",