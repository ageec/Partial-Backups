IntervalDate__c_Month', 'AQB_LastGoalIntervalDate__c_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"99 fiscal_years ago\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\nq = group q by all;\nq = foreach q generate sum(AQB__GoalCurrencyAmount__c) as SumGoal;\n\n--load opportunity info dataset to get results count\nq1 = load \"Opportunity_Info\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\", \"Closed - NPR Funded\"] and date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"99 fiscal_years ago\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\n\nq1 = group q1 by all;\nq1 = foreach q1 generate count(q1) as 'A', sum(q1.'Opportunity.Amount') as 'B';\n\nq2 = cogroup q1 by all full, q by all;\nq2 = foreach q2 generate (sum(q1.B)/sum(q.SumGoal)) as '% to Goal';\n","receiveFacetSource":{"mode":"exclude","steps":["Opportunity_AQC_Date_1","ProspectStrategyPlan_1"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":fal