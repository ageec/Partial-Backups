Strategy Officer'\"}","{\"Display\":\"Territory Partner\",\"API\":\",'Territory Partner'\"}","{\"Display\":\"Volunteer Manager\",\"API\":\",'Volunteer Manager'\"}"]},"Stewardship_Efforts__1":{"broadcastFacet":true,"groups":[],"label":"Prospect Research Projects Flat Gauge Chart","numbers":[],"query":"--load Case dataset\nq = load \"Case\";\n--filter for specific case types\nq = filter q by (ARCH_Record_Type_Developer_Name__c == \"Corporate_Engagement\" and Type == \"Prospect Research (CFR)\") || (ARCH_Record_Type_Developer_Name__c == \"Prospect_Research\" and Type == \"Request Research Report\") and date('ClosedDate_Year', 'ClosedDate_Month', 'ClosedDate_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"99 fiscal_years ago\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\nq = group q by all;\nq = foreach q generate count() as A;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","max":100,"legend":{"showHeader":true,"show":false,"position":"right-top","inside":false},"tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]},"description":"Corporate Engagement Cases with the Type of Prospect Research (CFR) OR\nProspect Research Cases with the Type of Request Research Report and Created Date in current fiscal year."}},"visualizationType":"flatgauge","medium":33,"title":{"fontSize":14,"subtitleFontSize":11,"label":"Prospect Research Projects","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"colors":{"mediumColor2":"#F29946","mediumColor1":"#FED444","lowColor1":"#F71979","lowColor2":"#CC203D","highColor1":"#7BDE4E","highColor2":"#169913"},"high":66,"showActionMenu":true,"min":0,"valueType":"compactNumber","theme":"wave","referenceLines":[{"color":"#006714","label":{"data":{"displayTemplate":"Team Goal [Sum Goal]","compact":false,"sourceType":"result","step":"Team_Goal_Activities_2"},"type":"dynamic"},"value":{"data":{"field":"Sum Goal","sourceType":"result","step":"Team_Goal_Activities_2"},"type":"dynamic"}}],"compactDecimalDigits":-1,"applyConditionalFormatting":true},"type":"chart"}},"Key_Contact_Details_1":{"broadcastFacet":true,"groups":[],"label":"Key Contact Details","numbers":[],"query":"--load Awards dataset\nq = load \"Awards\";\n--filter for Key Contacts since Awards is an appended dataset with key contacts stacked on top of award recipients. \nq = filter q by 'Who.Affiliation_Type' == \"Key Contact\";\n--filter for awards that have a least one key contact that is a non-household account but still allow household account key contact rows to display\nq = filter q by Award_Key_Contact_Non_Household_Sum > 0;\n--group by award\nq = group q by ('ARCH_Award_ID__c', 'Name', 'Who.JoinKeyContacts.KeyContactLookup.Name');\n--generate rows\nq = foreach q generate q.'ARCH_Award_ID__c' as 'ARCH Award ID', q.'Name' as 'Award Name', q.'Who.JoinKeyContacts.KeyContactLookup.Name' as 'Key Contact Number', first(q.'Who.Account.ARCH_Account_ID__c') as 'Who.Account.ARCH_Account_ID__c', first(q.'Who.Account.Name') as 'Who.Account.Name', first(q.'Who.Account.AQB__AccountType__c') as 'Who.Account.AQB__AccountType__c', first(q.'Secondary_Account_Types_List') as 'Secondary Account Types', first(q.'Who.Account.ParentAccount.ARCH_Account_ID__c') as 'Parent ARCH Account ID', first(q.'Who.Account.ParentAccount.Name') as 'Parent Account Name', first(q.'AQC_FormalAwardName__c') as 'AQC_FormalAwardName__c', first(q.'AQC_RecognitionName__c') as 'AQC_RecognitionName__c', first(q.'AQB__Description__c') as 'AQB__Description__c', first(q.'AQB__AwardTerms__c') as 'AQB__AwardTerms__c', first(q.'ARCH_Active__c') as 'ARCH_Active__c', first(q.'AQC_AwardType__c') as 'AQC_AwardType__c', first(q.'Award.FundingStatusTransformed') as 'Award.FundingStatusTransformed', first(q.'AQC_FiscalYearEstablished__c') as 'AQC_FiscalYearEstablished__c', first(q.'Transaction.Sum_of_Lifetime_Amount') as 'Amount Donated', first(q.'CFYAmount.SUM_AQB__Amount__c') as 'Current FY Amount for Designation', first(q.'PFYAmount.SUM_AQB__Amount__c') as 'Past FY Amount for Designation', first(q.'PPFYAmount.SUM_AQB__Amount__c') as 'Previous Past FY Amount for Designation', first(q.'CalculatePldgBal.SUM_AQB__Balance__c') as 'Balance for Designation', first(q.'COA.Name') as 'Designation Name', first(q.'Award.AwardSchoolUnitTransformed') as 'Designation School/Unit', first(q.'AwardDesignationDepartment') as 'Designation Department', first(q.'DesignationAmount.SUM_AQB__Amount__c') as 'Total Amount for Designation',  first(q.'Who.JoinKeyContacts.KeyContactLookup.AQB__LevelofAnonmity__c') as 'Level of Anonymity', first(q.'Who.ARCH_Active__c') as 'Who.ARCH_Active__c', first(q.'Who.AQB__Role__c') as 'Who.AQB__Role__c', first(q.'Who.Contact.Name') as 'Key Contact Name', first(q.'Who.Account.AccountInfo2.Account.PrimaryGiftOfficer.Name') as 'Primary Gift Officer', first(q.'Who.Account.Relationship_Manager.User.Name') as 'Who.Account.Relationship_Manager.User.Name', first(q.'Who.Account.AccountInfo2.PMTeam.QualifyingGiftOfficerList') as 'Qualifying Gift Officer', first(q.'Who.Account.AccountInfo2.PMTeam.CorpsFoundsOfficerList') as 'Corps/Founds Officer', first(q.'Who.Account.ARCH_Metro_Area__c') as 'Who.Account.ARCH_Metro_Area__c', first(q.'Who.Account.ARCH_Target_Market__c') as 'Who.Account.ARCH_Target_Market__c', first(q.'Who.Account.BillingStreet') as 'Donor Street', first(q.'Who.Account.BillingCity') as 'Donor City', first(q.'Who.Account.BillingState') as 'Donor State/Province', first(q.'Who.Account.BillingPostalCode') as 'Donor Zip/Postal Code', first(q.'Who.Account.BillingCountry') as 'Donor Country',\n--insert field picker fields to be used later\nfirst('AQB__DateofFirstAward__c') as 'AQB__DateofFirstAward__c', first('AQB__DateofLastAward__c') as 'AQB__DateofLastAward__c', first('Who.Account.AccountInfo2.Corporate_Engagement_Partner_List') as 'Who.Account.AccountInfo2.Corporate_Engagement_Partner_List', first('Who.Account.AccountInfo2.Employer_Development_Partner_List') as 'Who.Account.AccountInfo2.Employer_Development_Partner_List', first('Who.Account.AccountInfo2.Employer_Engagement_Partner_List') as 'Who.Account.AccountInfo2.Employer_Engagement_Partner_List', first('Who.Account.AccountInfo2.PMTeam.AnnualGivingOfficerList') as 'Who.Account.AccountInfo2.PMTeam.AnnualGivingOfficerList', first('Who.Account.AccountInfo2.PMTeam.AnnualGivingPipelineOfficerList') as 'Who.Account.AccountInfo2.PMTeam.AnnualGivingPipelineOfficerList', first('Who.Account.AccountInfo2.PMTeam.DonorRelationsOfficerList') as 'Who.Account.AccountInfo2.PMTeam.DonorRelationsOfficerList', first('Who.Account.AccountInfo2.PMTeam.HandoffOfficerList') as 'Who.Account.AccountInfo2.PMTeam.HandoffOfficerList', first('Who.Account.AccountInfo2.PMTeam.LeadList') as 'Who.Account.AccountInfo2.PMTeam.LeadList', first('Who.Account.AccountInfo2.PMTeam.MedicineGivingOfficerList') as 'Who.Account.AccountInfo2.PMTeam.MedicineGivingOfficerList', first('Who.Account.AccountInfo2.PMTeam.PlannedGivingOfficerList') as 'Who.Account.AccountInfo2.PMTeam.PlannedGivingOfficerList', first('Who.Account.AccountInfo2.PMTeam.PrincipalGiftsLiaisonList') as 'Who.Account.AccountInfo2.PMTeam.PrincipalGiftsLiaisonList', first('Who.Account.AccountInfo2.PMTeam.ProspectManagementConsultantList') as 'Who.Account.AccountInfo2.PMTeam.ProspectManagementConsultantList', first('Who.Account.AccountInfo2.PMTeam.ProspectResearcherList') as 'Who.Account.AccountInfo2.PMTeam.ProspectResearcherList', first('Who.Account.AccountInfo2.PMTeam.ProxyOfficerList') as 'Who.Account.AccountInfo2.PMTeam.ProxyOfficerL