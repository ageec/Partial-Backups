nity.Name"],"limit":25000,"orders":[{"name":"Opportunity.Name","filters":[],"ascending":true},{"name":"Account.Name","filters":[],"ascending":true},{"name":"Opportunity.OpportunityOwner.MedOfficerTeam","filters":[],"ascending":true},{"name":"Account.AQC_Account_ARCH_ID__c","filters":[],"ascending":true},{"name":"Opportunity.OpportunityOwner.Name","filters":[],"ascending":true},{"name":"Opportunity.CloseDate_Year","filters":[],"ascending":true},{"name":"Opportunity.CloseDate_Month","filters":[],"ascending":true},{"name":"Opportunity.CloseDate_Day","filters":[],"ascending":true},{"name":"Opportunity.Id","filters":[],"ascending":true},{"name":"Account.Id","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{"Opportunity_Info":{"booleanFilterLogic":"1 AND 2 AND 3 AND 4","filters":[["Opportunity.OppRecordType.Name",["Grateful Patients"],"in"],["Opportunity.LeadSource",["Physician Referral"],"in"],["Opportunity.OpportunityTeamMember.MedOfficerTeam",["Med Alumni","Community Fundraising","Med CFR","Momentum/EVC/VC","P&F Med/Surg","P&F Neuro","Siteman"],"in"],["Opportunity.CloseDateFiscalYearsPassed",["[[parameter_1]]"],"in"]]}},"sources":[{"columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["Opportunity.Name","Account.Name","Opportunity.OpportunityOwner.MedOfficerTeam","Account.AQC_Account_ARCH_ID__c","Opportunity.OpportunityOwner.Name","Opportunity.CloseDate_Year","Opportunity.CloseDate_Month","Opportunity.CloseDate_Day","Opportunity.Id","Account.Id"],"joins":[],"name":"Opportunity_Info"}]},"receiveFacetSource":{"mode":"include","steps":["Med_Adv___Grateful_P_2"]},"selectMode":"single","sortable":true,"type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","Opportunity.Name","Account.Name","Account.AQC_Account_ARCH_ID__c","Opportunity.OpportunityOwner.Name","Opportunity.OpportunityOwner.MedOfficerTeam","Opportunity.CloseDate_Year~~~Opportunity.CloseDate_Month~~~Opportunity.CloseDate_Day"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"rgb(9, 26, 62)","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"PrG_Trustee_Solicite_2":{"broadcastFacet":false,"groups":[],"label":"PrG Trustee Solicited Detail Table","numbers":[],"query":"q1 = load \"Account_Info\";\nq2 = load \"Opportunity_Info\";\nq1_A = filter q1 by 'Account.AQB__SecondaryTypes__c' in [\"Trustee-Current\", \"Trustee-Emeritus\", \"Trustee-Honorary Emeritus\"];\nq2_B = filter q2 by date('Opportunity.AQC_Date_Asked__c_Year', 'Opportunity.AQC_Date_Asked__c_Month', 'Opportunity.AQC_Date_Asked__c_Day') in [\"current fiscal_year\"..\"current fiscal_year\"] && 'Opportunity.StageName' in [\"Closed - Funded No Value\", \"Closed Won\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\", \"Negotiation/Review\", \"Proposal Submittal\", \"Solicitation\", \"Solicitation (PG)\"] && 'Account.AQB__SecondaryTypes__c' in [\"Trustee-Current\", \"Trustee-Emeritus\", \"Trustee-Honorary Emeritus\"] && ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq = cogroup q1_A by ('Account.Name', 'Account.AQC_Account_ARCH_ID__c', 'Account.Id', 'Account.AQB__SecondaryTypes__c') left, q2_B by ('Account.Name', 'Account.AQC_Account_ARCH_ID__c', 'Account.Id', 'Account.AQB__SecondaryTypes__c');\nq = foreach q generate coalesce(q1_A.'Account.Name', q2_B.'Account.Name') as 'Account.Name', coalesce(q1_A.'Account.AQC_Account_ARCH_ID__c', q2_B.'Account.AQC_Account_ARCH_ID__c') as 'Account.AQC_Account_ARCH_ID__c', coalesce(q1_A.'Account.Id', q2_B.'Account.Id') as 'Account.Id', coalesce(q1_A.'Account.AQB__SecondaryTypes__c', q2_B.'Account.AQB__SecondaryTypes__c') as 'Account.AQB__SecondaryTypes__c', unique(q2_B.'Account.Id') as 'Solicited', unique(q1_A.'Account.Id') as 'Trustees';\nq = group q by rollup('Account.Name', 'Account.AQC_Account_ARCH_ID__c', 'Account.Id', 'Account.AQB__SecondaryTypes__c');\nq = foreach q generate q.'Account.Name' as 'Account.Name', q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'Account.Id' as 'Account.Id', q.'Account.AQB__SecondaryTypes__c' as 'Account.AQB__SecondaryTypes__c', sum(q.'Solicited') as 'Solicited', sum(q.'Trustees') as 'Trustees', grouping(q.'Account.Name') as 'grouping_Account.Name', grouping(q.'Account.AQC_Account_ARCH_ID__c') as 'grouping_Account.AQC_Account_ARCH_ID__c', grouping(q.'Account.Id') as 'grouping_Account.Id', grouping(q.'Account.AQB__SecondaryTypes__c') as 'grouping_Account.AQB__SecondaryTypes__c';\ns = filter q by 'grouping_Account.Name' == 1;\nq = filter q by 'grouping_Account.Name' == 0 and 'grouping_Account.AQC_Account_ARCH_ID__c' == 0 and 'grouping_Account.Id' == 0 and 'grouping_Account.AQB__SecondaryTypes__c' == 0;\nq = order q by ('Solicited' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Account.Name","Account.AQC_Account_ARCH_ID__c","Account.AQB__SecondaryTypes__c","Solicited","Trustees"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"PrG_Trustee_Solicite_1":{"broadcastFacet":false,"datasets":[{"name":"Account_Info"},{"name":"Opportunity_Info"}],"isGlobal":false,"label":"PrG Trustee Solicited Summary Table","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[],"rowTotals":[],"sourceFilters":{},"sources":[{"cogroupType":"left","columns":[{"field":["unique","Account.Id"],"name":"A"}],"filters":[["Account.AQB__SecondaryTypes__c",["Trustee-Current","Trustee-Emeritus","Trustee-Honorary Emeritus"],"in"]],"groups":["all"],"joins":[],"name":"Account_Info"},{"columns":[{"field":["unique","Account.Id"],"name":"B"}],"filters":[["Opportunity.AQC_Date_Asked__c",[["fiscal_year",0],["fiscal_year",0]],"between"],["Opportunity.StageName",["Closed - Funded No Value","Closed Won","Closed/Lost","Closed/Won","Closed/Won - No Value","Negotiation/Review","Proposal Submittal","Solicitation","Solicitation (PG)"],"in"],["Account.AQB__SecondaryTypes__c",["Trustee-Current","Trustee-Emeritus","Trustee-Honorary Emeritus"],"in"],["Opportunity.OppRecordType.Name",["Grateful Patients"],"not in"]],"groups":["all"],"joins":[],"name":"Opportunity_Info"},{"columns":[{"formula":"B/A","name":"C"},{"formula":".40","name":"D"},{"formula":"C/D","name":"E"}],"filters":[],"groups":[],"joins":[]}]},"receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","sortable":true,"type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize