full","columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["Opportunity.OpportunityOwner.GiftOfficerTeam","Opportunity.OpportunityOwner.Name"],"joins":[],"name":"Opportunity_Info"},{"columns":[{"field":["sum","AQB__GoalCount__c"],"name":"B"}],"filters":[],"groups":["GiftOfficerTeam","User.Name"],"joins":[],"name":"User_Goal_Info"},{"columns":[{"formula":"coalesce(A,0)/B","name":"C"}],"filters":[],"groups":[],"joins":[]}]},"receiveFacetSource":{"mode":"include","steps":[]},"selectMode":"single","sortable":true,"type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","B","C","Opportunity.OpportunityOwner.GiftOfficerTeam","Opportunity.OpportunityOwner.Name"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Renewed_Eliot_Count__1":{"broadcastFacet":true,"groups":[],"label":"Updgrade Eliot Count Number","numbers":[],"query":"q1 = load \"Eliot_Society_Status\";\nq1 = foreach q1 generate 'PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'ARCH_Account_ID__c', 'CFY_Eliot_Status', 'PFY_Eliot_Status'; \nq1 = filter q1 by {{coalesce(cell(Fiscal_Year_2.selection, 0, \"Eliot_Status\"), 0).asString()}} in [\"Upgrade\"];\n\nq2 = load \"User_Goal_Info\";\nq2 = filter q2 by 'AQB__Classification__c' == \"Number of New/Reactivated Eliots\";\nq2 = foreach q2 generate 'GiftOfficerTeam', 'User.Name', 'AQB__GoalCount__c', 'LastGoalIntervalFiscalYearsPassed';\nq2 = filter q2 by string_to_number('LastGoalIntervalFiscalYearsPassed') == {{coalesce(cell(Fiscal_Year_2.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}};\n\nq = cogroup q1 by ('PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c') full, q2 by ('GiftOfficerTeam', 'User.Name');\nq = foreach q generate coalesce(q1.'PrimaryGiftOfficer.GiftOfficerTeam', q2.'GiftOfficerTeam') as 'PrimaryGiftOfficer.GiftOfficerTeam', coalesce(q1.'ARCH_PrimaryGiftOfficerName__c', q2.'User.Name') as 'ARCH_PrimaryGiftOfficerName__c', count(q1) as 'A', sum(q2.'AQB__GoalCount__c') as 'B';\nq = foreach q generate 'PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'A' as 'Result Count', 'B' as 'Goal', A/B as '% to Goal';\n\nq = group q by rollup('PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c');\nq = foreach q generate q.'PrimaryGiftOfficer.GiftOfficerTeam' as 'PrimaryGiftOfficer.GiftOfficerTeam', q.'ARCH_PrimaryGiftOfficerName__c' as 'ARCH_PrimaryGiftOfficerName__c', sum(q.'Result Count') as 'Result Count', sum(q.'Goal') as 'Goal', sum(q.'Result Count') / sum(q.'Goal') as '% to Goal', grouping(q.'PrimaryGiftOfficer.GiftOfficerTeam') as 'grouping_PrimaryGiftOfficer.GiftOfficerTeam', grouping(q.'ARCH_PrimaryGiftOfficerName__c') as 'grouping_ARCH_PrimaryGiftOfficerName__c';\ns = filter q by 'grouping_PrimaryGiftOfficer.GiftOfficerTeam' == 1;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Closed_Won_Opp_Conve_1":{"broadcastFacet":true,"groups":[],"label":"Closed/Won Opp Conversion % Number","numbers":[],"query":"--load opportunities\nq = load \"Opportunity_Info\";\nq = filter q by 'Opportunity.StageName' in [\"Closed - Funded No Value\", \"Closed Won\",  \"Closed/Won\", \"Closed/Won - No Value\", \"Closed/Lost\"];\nq = filter q by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq = group q by ('Opportunity.Name', 'Opportunity.StageName', 'Account.AQC_Account_ARCH_ID__c', 'Opportunity.Id', 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Account.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Account.Id', 'Opportunity.OpportunityOwner.Name', 'Opportunity.CloseDate', 'Opportunity.CloseDateFiscalYearsPassed');\nq = foreach q generate q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', q.'Opportunity.ClosedWonGiftBandDevelopmentVertical' as 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.CloseDateFiscalYearsPassed', q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'Account.Name' as 'Account.Name', q.'Opportunity.Name' as 'Opportunity.Name', q.'Opportunity.CloseDate' , q.'Opportunity.Id' as 'Opportunity.Id',   q.'Account.Id' as 'Account.Id', \n    (case\n        when 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] then sum('Opportunity.Amount') \n        else 0\n    end) as '$ - Closed/Won Amount',\n    (case\n        when 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] then sum('Opportunity.AQC_Ask_Amount__c') \n        else 0\n    end) as '$ - Closed/Won Ask Amount',\n    (case\n        when 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] then sum('Opportunity.AQC_Ask_Amount__c')*0.5 \n        else 0\n    end) as '$ - Closed/Won Amount Goal',\n    (case\n        when 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] then 1\n        else 0\n    end) as '# - Closed/Won Count',  \ncount(q) as '# - Closed Count', \ncount(q)*0.5 as '# - Closed/Won Count Goal'; \nq = filter q by string_to_number('Opportunity.CloseDateFiscalYearsPassed') == {{coalesce(cell(Fiscal_Year_2.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}};  \n\n\n--rollup grouping\nq1 = group q by rollup('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OpportunityOwner.Name');\nq1 = foreach q1 generate q1.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q1.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', q1.'Opportunity.ClosedWonGiftBandDevelopmentVertical' as 'Opportunity.ClosedWonGiftBandDevelopmentVertical',\nsum('$ - Closed/Won Amount') as '$ - Closed/Won Amount',   \nsum('$ - Closed/Won Ask Amount') as '$ - Closed/Won Ask Amount',\nsum('$ - Closed/Won Amount')/sum('$ - Closed/Won Ask Amount') as '$ - Closed/Won Conversion %',\nsum('$ - Closed/Won Amount Goal') as '$ - Closed/Won Amount Goal',\nsum('# - Closed/Won Count') as '# - Closed/Won Count',  \nsum('# - Closed Count') as '# - Closed Count', \nsum('# - Closed/Won Count')/sum('# - Closed Count') as '# - Closed/Won Conversion %',\nsum('# - Closed/Won Count Goal') as '# - Closed/Won Count Goal', \ngrouping(q1.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q1.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical', grouping(q1.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name';\n\ns = filter q1 by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam'  == 1;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"___1M__Opportunities_1":{"broadcastFacet":true,"groups":[],"label":"# $1M+ Opportunities Closed/Won Number","numbers":[],"query":"q1 = load \"Opportunity_Info\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] and 'Opportunity.Amount' >= 1000000;\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq1 = foreach q1 generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', sum(q1.'Opportunity.Amount') as 'Opportunity.Amount', 'Opportunity.CloseDateFiscalYearsPassed';\nq1 = filter q1 by string_to_number('Opportunity.CloseDateFiscalYearsPassed') == {{coalesce(cell(Fiscal_Year_2.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}};  \n\n\nq = group q1 by rollup('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OpportunityOwner.Name');\nq = foreach q generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', sum(q.'Opportunity.Amount') as '$ - Closed/Won Amount', count(q1) as '# - Closed/Won Count', 30 as 'Goal', count(q1)/30 as '% to Goal',  grouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam',  grouping(q.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name';\n\ns = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 1;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":["Opportunity.OpportunityOwner.GiftOfficerTeam","Opportunity.OpportunityOwner.Name","Opportunity.ClosedWonGiftBandDevelopmentVertical"],"plots":["$ - Closed/Won Amount","# - Closed/Won Count","Goal","% to Goal"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Donor_Count_Number_1":{"broadcastFacet":true,"groups":[],"label":"Donor Count Number","numbers":[],"query":"--load selected fy opps\nq2 = load \"Opportunity_Info\";\nq2 = filter q2 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq2 = filter q2 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq2 = group q2 by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OpportunityOwner.Name', 'Opportunity.CloseDateFiscalYearsPassed');\nq2 = foreach q2 generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.CloseDateFiscalYearsPassed', sum('Opportunity.Amount') as 'Opportunity.Amount', count(q2) as Count, \n--get row number by account\nrow_number() over([..] partition by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical') order by 'Opportunity.ClosedWonGiftBandDevelopmentVertical') as AccountRowNumber; \nq2 = filter q2 by string_to_number('Opportunity.CloseDateFiscalYearsPassed') == {{coalesce(cell(Fiscal_Year_2.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}};  \n\n--get unique selected fiscal year accounts\nq2_a = filter q2 by AccountRowNumber == 1;\n\n--load selected previous fy opps\nq1 = load \"Opportunity_Info\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq1 = group q1 by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OpportunityOwner.Name', 'Opportunity.CloseDateFiscalYearsPassed');\nq1 = foreach q1 generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.CloseDateFiscalYearsPassed', sum('Opportunity.Amount') as 'Opportunity.Amount', count(q1) as Count, \n--get row number by account\nrow_number() over([..] partition by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical') order by 'Opportunity.ClosedWonGiftBandDevelopmentVertical') as AccountRowNumber; \nq2 = filter q2 by string_to_number('Opportunity.CloseDateFiscalYearsPassed') == {{coalesce(cell(Fiscal_Year_2.selection, 0, \"PFY_Passed\"), 0).asString()}};  \n\n--get unique previous fiscal year accounts\nq1_a = filter q1 by AccountRowNumber == 1;\n\n--full join selected fy and previous fy opps\nq = cogroup q2_a by ( 'Opportunity.ClosedWonGiftBandDevelopmentVertical') full, q1_a by ( 'Opportunity.ClosedWonGiftBandDevelopmentVertical');\nq = foreach q generate   coalesce(q2_a.'Opportunity.ClosedWonGiftBandDevelopmentVertical', q1_a.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'Opportunity.ClosedWonGiftBandDevelopmentVertical',\n--get selected fy opps\nsum(q2_a.'Opportunity.Amount') as '$ - Selected FY Closed/Won Amount', sum(q2_a.'Count') as '# - Selected FY Donor Count',\n--get selected previous fy opps\nsum(q1_a.'Opportunity.Amount') as '$ - Previous FY Closed/Won Amount', sum(q1_a.'Count') as '# - Previous FY Donor Count';\n\n--group query to get account row number\nq3 = group q by ('Opportunity.ClosedWonGiftBandDevelopmentVertical');\nq3 = foreach q3 generate 'Opportunity.ClosedWonGiftBandDevelopmentVertical', \n--get selected fy opps\n sum('$ - Selected FY Closed/Won Amount') as '$ - Selected FY Closed/Won Amount', sum('# - Selected FY Donor Count') as '# - Selected FY Donor Count', \n--get selected previous fy opps\n sum('$ - Previous FY Closed/Won Amount') as '$ - Previous FY Closed/Won Amount', sum('# - Previous FY Donor Count') as '# - Previous FY Donor Count', sum('# - Previous FY Donor Count') * 1.05 as '# - Donor Count Goal', sum('# - Selected FY Donor Count')/(sum('# - Previous FY Donor Count') * 1.05 ) as '% to Donor Count Goal'; \n\n--filter for unique accounts and rollup by account\nq4 = group q3 by rollup('Opportunity.ClosedWonGiftBandDevelopmentVertical');\nq4 = foreach q4 generate 'Opportunity.ClosedWonGiftBandDevelopmentVertical', \n--get selected fy opps\n sum('$ - Selected FY Closed/Won Amount') as '$ - Selected FY Closed/Won Amount', sum('# - Selected FY Donor Count') as '# - Selected FY Donor Count', \n--get selected previous fy opps\n sum('$ - Previous FY Closed/Won Amount') as '$ - Previous FY Closed/Won Amount', sum('# - Previous FY Donor Count') as '# - Previous FY Donor Count', sum('# - Donor Count Goal') as '# - Donor Count Goal', avg('% to Donor Count Goal') as '% to Donor Count Goal',\n--grouping functions\ngrouping(q4.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical';\n\ns = filter q4 by 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 1;\n\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"lens_3":{"broadcastFacet":true,"groups":[],"label":"Annual Fund Opportunities Closed/Won Number","numbers":[],"query":"q1 = load \"Opportunity_Info\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.Op