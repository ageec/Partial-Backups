rtunity.Amount', count(q) as '# - Closed/Won Count', 'Opportunity.CloseDateFiscalYearsPassed';\nq = filter q by string_to_number('Opportunity.CloseDateFiscalYearsPassed') == {{coalesce(cell(Fiscal_Year_2.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}};\n\nq1 = group q by rollup('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ARCH_Instrument__c', 'Opportunity.CloseDateFiscalYearsPassed');\nq1 = foreach q1 generate q1.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q1.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name',  q1.'Opportunity.ARCH_Instrument__c' as 'Opportunity.ARCH_Instrument__c', sum(q1.'Opportunity.Amount') as '$ - Closed/Won Amount', sum('# - Closed/Won Count') as '# - Closed/Won Count', grouping(q1.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q1.'Opportunity.ARCH_Instrument__c') as 'grouping_Opportunity.ARCH_Instrument__c', grouping(q1.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name';\n\ns = filter q1 by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 1;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Planned_Giving_New_P_1":{"broadcastFacet":true,"groups":[],"label":"Planned Giving New Production Realized Bequests","numbers":[],"query":"q1 = load \"GiftAndPledgeTransactionsExtension\";\nq1 = filter q1 by date('NewProductionARCHCreditedFiscalYearDate_Year', 'NewProductionARCHCreditedFiscalYearDate_Month', 'NewProductionARCHCreditedFiscalYearDate_Day') in [\"{{coalesce(cell(Fiscal_Year_2.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_2.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\nq1 = filter q1 by 'Record_Type.Name' == \"Planned Gift\";\nq1 = filter q1 by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq1 = filter q1 by 'ARCH_TotalDollarsReceived__c' > 0;\n\nq1 = group q1 by 'Transaction.Name';\nq1 = foreach q1 generate q1.'Transaction.Name' as 'Transaction.Name', avg(q1.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests';\n\nq = group q1 by all;\nq = foreach q generate sum(q1.'NewProductionAmountWithBequests') as 'New Production w/ Bequests';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Eliot_Count_Number_1":{"broadcastFacet":true,"groups":[],"label":"Eliot Count Number","numbers":[],"query":"q1 = load \"Eliot_Society_Status\";\n\n--get current Eliots\nq1_a = group q1 by ( 'PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'ARCH_Account_ID__c', 'CFY_Eliot_Status', 'PFY_Eliot_Status');\nq1_a = foreach q1_a generate 'PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'ARCH_Account_ID__c', 'CFY_Eliot_Status', 'PFY_Eliot_Status'; \nq1_a = filter q1_a by {{coalesce(cell(Fiscal_Year_2.selection, 0, \"Eliot_Status\"), 0).asString()}} in [\"New\", \"Reactivated\", \"Renewed\", \"Upgrade\", \"Downgrade\"];\n\n--get unrenewed or lapsed Eliots\nq1_b = group q1 by ('PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'ARCH_Account_ID__c', 'CFY_Eliot_Status', 'PFY_Eliot_Status');\nq1_b = foreach q1_b generate 'PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'ARCH_Account_ID__c', 'CFY_Eliot_Status', 'PFY_Eliot_Status'; \nq1_b = filter q1_b by {{coalesce(cell(Fiscal_Year_2.selection, 0, \"Eliot_Status\"), 0).asString()}} in [\"Pledge Not Paid\", \"Unrenewed\", \"Lapsed\"];\n\n--join current eliots with eliots needing attention by gift officer team and primary gift officer\nq = cogroup q1_a by ('PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c') full, q1_b by ('PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c');\nq = foreach q generate coalesce(q1_a.'PrimaryGiftOfficer.GiftOfficerTeam', q1_b.'PrimaryGiftOfficer.GiftOfficerTeam') as 'PrimaryGiftOfficer.GiftOfficerTeam', coalesce(q1_a.'ARCH_PrimaryGiftOfficerName__c', q1_b.'ARCH_PrimaryGiftOfficerName__c') as 'ARCH_PrimaryGiftOfficerName__c', count(q1_a) as 'Eliot Count', count(q1_b) as 'Eliots Needing Attention';\n\nq = group q by rollup('PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c');\nq = foreach q generate q.'PrimaryGiftOfficer.GiftOfficerTeam' as 'PrimaryGiftOfficer.GiftOfficerTeam', q.'ARCH_PrimaryGiftOfficerName__c' as 'ARCH_PrimaryGiftOfficerName__c', sum(q.'Eliot Count') as 'Eliot Count', sum(q.'Eliots Needing Attention') as 'Eliots Needing Attention', 3000 as 'Goal', sum(q.'Eliot Count')/ 3000 as '% to Goal', grouping(q.'PrimaryGiftOfficer.GiftOfficerTeam') as 'grouping_PrimaryGiftOfficer.GiftOfficerTeam', grouping(q.'ARCH_PrimaryGiftOfficerName__c') as 'grouping_ARCH_PrimaryGiftOfficerName__c';\n\ns = filter q by 'grouping_PrimaryGiftOfficer.GiftOfficerTeam' == 1;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":"