Groups":[],"columnTotals":[],"limit":2000,"orders":[],"rowTotals":[],"sourceFilters":{"Activity_Report_Info":{"filters":[["AQB__ReportStatus__c",["Final"],"in"],["AQB__EssentialMove__c",["true"],"in"],["AQB__Type__c",["Faculty/Staff Meeting"],"not in"],["RecordType.Name",["Corporate Engagement"],"not in"],["ARFiscalYearsPassed",["{{coalesce(cell(Fiscal_Year_2.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}"],"in"]]},"User_Goal_Info":{"filters":[["AQB__Classification__c",["Substantive Activity Report"],"in"],["LastGoalIntervalFiscalYearsPassed",["{{coalesce(cell(Fiscal_Year_2.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}"],"in"]]}},"sources":[{"cogroupType":"full","columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["all"],"joins":[],"name":"Activity_Report_Info"},{"columns":[{"field":["sum","AQB__GoalCount__c"],"name":"B"}],"filters":[],"groups":["all"],"joins":[],"name":"User_Goal_Info"},{"columns":[{"formula":"coalesce(A,0)/coalesce(B,0)","name":"C"}],"filters":[],"groups":[],"joins":[]}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","B","C"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"_1M___Prospects_Qual_1":{"broadcastFacet":true,"groups":[],"label":"$1M + Prospects Qualified Number","numbers":[],"query":"--Get active PM Team records with identification, qualification, or prospect status with account capacity >= 1000000\nq = load \"PMTeam\";\nq = filter q by 'AQB__Active__c' == \"true\" and 'Account.ARCH_Capacity_Conversion__c' >= 1000000; \nq = foreach q generate 'User.GiftOfficerTeam', 'User.Name', Id, 'AccountInfo.Account.Id', 'Account.AQB__ProspectStatus__c', 'Account.AQB__ProspectStatusDate__c', 'Prospect_Date_Fiscal_Years_Passed',\n    (case \n        when 'Account.AQB__ProspectStatus__c' == \"Prospect\" \n        then 1\n        else 0\n        end) as '# $1M+ Prospects Qualified';\nq = filter q by ('Account.AQB__ProspectStatus__c' in [\"Identification\", \"Qualification\", \"Pre-Cultivation\"] or ('Account.AQB__ProspectStatus__c' == \"Prospect\"\n          and  string_to_number('Prospect_Date_Fiscal_Years_Passed') == {{coalesce(cell(Fiscal_Year_2.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}})\n            );\n\n--calculate how many prospect have been qualified this fiscal year against how many there were to qualify\nq1 = group q by rollup('User.GiftOfficerTeam', 'User.Name');\nq1 = foreach q1 generate 'User.GiftOfficerTeam' as 'User.GiftOfficerTeam', 'User.Name' as 'User.Name', \n    count(q) as '# $1M+ Total Prospects', \n    sum('# $1M+ Prospects Qualified') as '# $1M+ Prospects Qualified', \n    sum('# $1M+ Prospects Qualified')/count(q) as '% $1M+ Prospects Qualified', \n    64 as Goal,\n    sum('# $1M+ Prospects Qualified')/64 as '% to Goal', \n    grouping('User.GiftOfficerTeam') as 'grouping_User.GiftOfficerTeam', \n    grouping('User.Name') as 'grouping_User.Name';\n    \ns = filter q1 by 'grouping_User.GiftOfficerTeam' == 1 and 'grouping_User.Name' == 1;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Time_to_Close_Opport_1":{"broadcastFacet":true,"groups":[],"label":"Time to Close Opportunity Number","numbers":[],"query":"q1 = load \"Opportunity_Info\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed - Funded No Value\", \"Closed Won\",  \"Closed/Won\", \"Closed/Won - No Value\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq1 = foreach q1 generate q1.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q1.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', q1.'Opportunity.ClosedWonGiftBandDevelopmentVertical' as 'Opportunity.ClosedWonGiftBandDevelopmentVertical', avg('Opportunity.DaysFromAskDateToCloseDate') as 'Opportunity.DaysFromAskDateToCloseDate', 'Opportunity.CloseDateFiscalYearsPassed', sum(q1.'Opportunity.Amount') as '$ - Closed Amount';\nq1 = filter q1 by string_to_number('Opportunity.CloseDateFiscalYearsPassed') == {{coalesce(cell(Fiscal_Year_2.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}};  \n\nq = group q1 by rollup('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.CloseDateFiscalYearsPassed');\nq = foreach q generate q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', q.'Opportunity.ClosedWonGiftBandDevelopmentVertical' as 'Opportunity.ClosedWonGiftBandDevelopmentVertical', avg('Opportunity.DaysFromAskDateToCloseDate') as 'Opportunity.DaysFromAskDateToCloseDate', 'Opportunity.CloseDateFiscalYearsPassed', sum('$ - Closed Amount') as '$ - Closed Amount', count(q1) as '# - Closed Count', grouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam',  grouping(q.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name';\n\ns = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam'  == 1;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":fal