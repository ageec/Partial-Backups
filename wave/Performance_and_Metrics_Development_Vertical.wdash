0,"name":"text_18","row":74,"rowspan":4,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#D9D9D6","borderEdges":["left","right","bottom"],"borderRadius":0,"borderWidth":2}},{"colspan":6,"column":18,"name":"number_37","row":65,"rowspan":9,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#D7D2CB","borderEdges":["left","top","right"],"borderRadius":0,"borderWidth":2}},{"colspan":6,"column":18,"name":"text_19","row":74,"rowspan":4,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#D9D9D6","borderEdges":["left","right","bottom"],"borderRadius":0,"borderWidth":2}},{"colspan":8,"column":10,"name":"link_2","row":7,"rowspan":3,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#747474","borderEdges":["bottom"],"borderRadius":0,"borderWidth":1}},{"colspan":8,"column":1,"name":"link_3","row":7,"rowspan":3,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#747474","borderEdges":["bottom"],"borderRadius":0,"borderWidth":1}}]},{"label":"Dashboard Filter","name":"2381d5e5-fd34-41f2-b39c-a352df205a23","navigationHidden":false,"widgets":[{"colspan":9,"column":0,"name":"filterpanel_1","row":0,"rowspan":4,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#747474","borderEdges":["all"],"borderRadius":4,"borderWidth":1}}]}],"rowHeight":"fine","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#F2F6FA","cellSpacingX":0,"cellSpacingY":0,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"steps":{"New_Reactivated_Elio_2":{"broadcastFacet":true,"groups":[],"label":"Renewed Eliot Count Number","numbers":[],"query":"q1 = load \"Eliot_Society_Status\";\nq1 = foreach q1 generate 'PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'ARCH_Account_ID__c', 'CFY_Eliot_Status', 'PFY_Eliot_Status'; \nq1 = filter q1 by {{coalesce(cell(Fiscal_Year_2.selection, 0, \"Eliot_Status\"), 0).asString()}} in [\"Renewed\", \"Upgrade\", \"Downgrade\"];\n\nq2 = load \"User_Goal_Info\";\nq2 = filter q2 by 'AQB__Classification__c' == \"Number of New/Reactivated Eliots\";\nq2 = foreach q2 generate 'GiftOfficerTeam', 'User.Name', 'AQB__GoalCount__c', 'LastGoalIntervalFiscalYearsPassed';\nq2 = filter q2 by string_to_number('LastGoalIntervalFiscalYearsPassed') == {{coalesce(cell(Fiscal_Year_2.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}};\n\nq = cogroup q1 by ('PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c') full, q2 by ('GiftOfficerTeam', 'User.Name');\nq = foreach q generate coalesce(q1.'PrimaryGiftOfficer.GiftOfficerTeam', q2.'GiftOfficerTeam') as 'PrimaryGiftOfficer.GiftOfficerTeam', coalesce(q1.'ARCH_PrimaryGiftOfficerName__c', q2.'User.Name') as 'ARCH_PrimaryGiftOfficerName__c', count(q1) as 'A', sum(q2.'AQB__GoalCount__c') as 'B';\nq = foreach q generate 'PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'A' as 'Result Count', 'B' as 'Goal', A/B as '% to Goal';\n\nq = group q by rollup('PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c');\nq = foreach q generate q.'PrimaryGiftOfficer.GiftOfficerTeam' as 'PrimaryGiftOfficer.GiftOfficerTeam', q.'ARCH_PrimaryGiftOfficerName__c' as 'ARCH_PrimaryGiftOfficerName__c', sum(q.'Result Count') as 'Result Count', sum(q.'Goal') as 'Goal', sum(q.'Result Count') / sum(q.'Goal') as '% to Goal', grouping(q.'PrimaryGiftOfficer.GiftOfficerTeam') as 'grouping_PrimaryGiftOfficer.GiftOfficerTeam', grouping(q.'ARCH_PrimaryGiftOfficerName__c') as 'grouping_ARCH_PrimaryGiftOfficerName__c';\ns = filter q by 'grouping_PrimaryGiftOfficer.GiftOfficerTeam' == 1;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"leg