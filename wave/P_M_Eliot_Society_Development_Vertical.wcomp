liot_Status',\ngrouping(q.'PFYEliot.PFY_Giving_Level') as 'grouping_PFYEliot.PFY_Giving_Level',\ngrouping(q.'PFY_Eliot_Status') as 'grouping_PFY_Eliot_Status';\n\ns = filter q by 'grouping_PrimaryGiftOfficer.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_PrimaryGiftOfficer.GiftOfficerTeam' == 0 and 'grouping_ARCH_PrimaryGiftOfficerName__c' == 0 and 'grouping_ARCH_Account_ID__c' ==0 and 'grouping_Id'==0 and 'grouping_Name' == 0 and 'grouping_ARCH_Metro_Area__c' ==0 and 'grouping_CFYEliot.CFY_Giving_Level' == 0 and 'grouping_CFY_Eliot_Status' == 0 and 'grouping_PFYEliot.PFY_Giving_Level' == 0 and 'grouping_PFY_Eliot_Status' == 0;\nq = order q by ('PrimaryGiftOfficer.GiftOfficerTeam' asc, 'ARCH_PrimaryGiftOfficerName__c' asc, 'Name' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["PrimaryGiftOfficer.GiftOfficerTeam","ARCH_PrimaryGiftOfficerName__c","ARCH_Account_ID__c","Name","ARCH_Metro_Area__c","CFYEliot.CFY_Giving_Level","CFY_Eliot_Status","PFYEliot.PFY_Giving_Level","PFY_Eliot_Status","Count"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"New_or_Renewed_Eliot_5":{"broadcastFacet":true,"groups":[],"label":"Total Eliot Status Gift Officer Table","numbers":[],"query":"q1 = load \"Eliot_Society_Status\";\n\n--get current Eliots\nq1_a = group q1 by ( 'PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'ARCH_Account_ID__c', 'CFY_Eliot_Status', 'PFY_Eliot_Status');\nq1_a = foreach q1_a generate 'PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'ARCH_Account_ID__c', 'CFY_Eliot_Status', 'PFY_Eliot_Status'; \nq1_a = filter q1_a by [[parameter_2]] in [\"New\", \"Reactivated\", \"Renewed\", \"Upgrade\", \"Downgrade\"];\n\n--get unrenewed or lapsed Eliots\nq1_b = group q1 by ('PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'ARCH_Account_ID__c', 'CFY_Eliot_Status', 'PFY_Eliot_Status');\nq1_b = foreach q1_b generate 'PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'ARCH_Account_ID__c', 'CFY_Eliot_Status', 'PFY_Eliot_Status'; \nq1_b = filter q1_b by [[parameter_2]] in [\"Pledge Not Paid\", \"Unrenewed\", \"Lapsed\"];\n\n--join current eliots with eliots needing attention by gift officer team and primary gift officer\nq = cogroup q1_a by ('PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c') full, q1_b by ('PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c');\nq = foreach q generate coalesce(q1_a.'PrimaryGiftOfficer.GiftOfficerTeam', q1_b.'PrimaryGiftOfficer.GiftOfficerTeam') as 'PrimaryGiftOfficer.GiftOfficerTeam', coalesce(q1_a.'ARCH_PrimaryGiftOfficerName__c', q1_b.'ARCH_PrimaryGiftOfficerName__c') as 'ARCH_PrimaryGiftOfficerName__c', count(q1_a) as 'Eliot Count', count(q1_b) as 'Eliots Needing Attention';\n\nq = group q by rollup('PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c');\nq = foreach q generate q.'PrimaryGiftOfficer.GiftOfficerTeam' as 'PrimaryGiftOfficer.GiftOfficerTeam', q.'ARCH_PrimaryGiftOfficerName__c' as 'ARCH_PrimaryGiftOfficerName__c', sum(q.'Eliot Count') as 'Eliot Count', sum(q.'Eliots Needing Attention') as 'Eliots Needing Attention', 3000 as 'Goal', sum(q.'Eliot Count')/ 3000 as '% to Goal', grouping(q.'PrimaryGiftOfficer.GiftOfficerTeam') as 'grouping_PrimaryGiftOfficer.GiftOfficerTeam', grouping(q.'ARCH_PrimaryGiftOfficerName__c') as 'grouping_ARCH_PrimaryGiftOfficerName__c';\n\ns = filter q by 'grouping_PrimaryGiftOfficer.GiftOfficerTeam' == 1;\n\nq = filter q by 'grouping_PrimaryGiftOfficer.GiftOfficerTeam' == 0 and 'grouping_ARCH_PrimaryGiftOfficerName__c' == 0;\nq = group q by ('PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c');\nq = foreach q generate q.'PrimaryGiftOfficer.GiftOfficerTeam' as 'PrimaryGiftOfficer.GiftOfficerTeam', q.'ARCH_PrimaryGiftOfficerName__c' as 'ARCH_PrimaryGiftOfficerName__c', sum(q.'Eliot Count') as 'Eliot Count', sum(q.'Eliots Needing Attention') as 'Eliots Needing Attention', 0 as 'Goal', 0 as '% to Goal';\nq = order q by ('PrimaryGiftOfficer.GiftOfficerTeam' asc, 'ARCH_PrimaryGiftOfficerName__c' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"Renewed_Eliot_Count__2":{"broadcastFacet":true,"groups":[],"label":"Renewed Eliot Count Summary","numbers":[],"query":"q1 = load \"Eliot_Society_Status\";\nq1 = foreach q1 generate 'PrimaryGiftOfficer.GiftOfficerTe