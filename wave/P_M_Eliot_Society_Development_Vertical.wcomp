}],"rowHeight":"fine","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#F2F6FA","cellSpacingX":0,"cellSpacingY":0,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"parameters":[{"defaultValue":"0","description":"","label":"Fiscal Years Passed","name":"parameter_1"},{"defaultValue":"CFY_Eliot_Status","description":"","label":"Eliot Status","name":"parameter_2"},{"defaultValue":"current fiscal_year","description":"","label":"Fiscal Year","name":"parameter_3"}],"steps":{"New_or_Renewed_Eliot_1":{"broadcastFacet":true,"groups":[],"label":"New or Renewed Eliot Status Gift Officer Table","numbers":[],"query":"q1 = load \"Eliot_Society_Status\";\nq1 = foreach q1 generate 'PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'ARCH_Account_ID__c', 'CFY_Eliot_Status', 'PFY_Eliot_Status'; \nq1 = filter q1 by [[parameter_2]] in [\"New\", \"Reactivated\"];\n\nq2 = load \"User_Goal_Info\";\nq2 = filter q2 by 'AQB__Classification__c' == \"Number of New/Reactivated Eliots\";\nq2 = filter q2 by date('AQB__LastGoalIntervalDate__c_Year', 'AQB__LastGoalIntervalDate__c_Month', 'AQB__LastGoalIntervalDate__c_Day') in [\"[[parameter_3]]\"..\"[[parameter_3]]\"];\n\nq = cogroup q1 by ('PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c') full, q2 by ('GiftOfficerTeam', 'User.Name');\nq = foreach q generate coalesce(q1.'PrimaryGiftOfficer.GiftOfficerTeam', q2.'GiftOfficerTeam') as 'PrimaryGiftOfficer.GiftOfficerTeam', coalesce(q1.'ARCH_PrimaryGiftOfficerName__c', q2.'User.Name') as 'ARCH_PrimaryGiftOfficerName__c', count(q1) as 'A', sum(q2.'AQB__GoalCount__c') as 'B';\nq = foreach q generate 'PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'A' as 'Result Count', 'B' as 'Goal', A/B as '% to Goal';\n\nq = group q by rollup('PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c');\nq = foreach q generate q.'PrimaryGiftOfficer.GiftOfficerTeam' as 'PrimaryGiftOfficer.GiftOfficerTeam', q.'ARCH_PrimaryGiftOfficerName__c' as 'ARCH_PrimaryGiftOfficerName__c', sum(q.'Result Count') as 'Result Count', sum(q.'Goal') as 'Goal', sum(q.'Result Count') / sum(q.'Goal') as '% to Goal', grouping(q.'PrimaryGiftOfficer.GiftOfficerTeam') as 'grouping_PrimaryGiftOfficer.GiftOfficerTeam', grouping(q.'ARCH_PrimaryGiftOfficerName__c') as 'grouping_ARCH_PrimaryGiftOfficerName__c';\ns = filter q by 'grouping_PrimaryGiftOfficer.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_PrimaryGiftOfficer.GiftOfficerTeam' == 0 and 'grouping_ARCH_PrimaryGiftOfficerName__c' == 0;\nq = order q by ('PrimaryGiftOfficer.GiftOfficerTeam' asc, 'ARCH_PrimaryGiftOfficerName__c' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["PrimaryGiftOfficer.GiftOfficerTeam","ARCH_PrimaryGiftOfficerName__c","Result Count"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"New_or_Renewed_Eliot_2":{"broadcastFacet":false,"groups":[],"label":"New or Renewed Eliot Status Gift Officer Table Detail","numbers":[],"query":"q1 = load \"Eliot_Society_Status\";\nq1 = group q1 by ('PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'ARCH_Account_ID__c','Id', 'Name', 'ARCH_Metro_Area__c', 'CFYEliot.CFY_Giving_Level', 'CFY_Eliot_Status', 'PFY_Eliot_Status');\nq1 = foreach q1 generate 'PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'ARCH_Account_ID__c', 'Id', 'Name', 'ARCH_Metro_Area__c', 'CFYEliot.CFY_Giving_Level', 'CFY_Eliot_Status', 'PFY_Eliot_Status'; \nq1 = filter q1 by [[parameter_2]] in [\"New\", \"Reactivated\"];\n\nq = group q1 by rollup('PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'ARCH_Account_ID__c','Id', 'Name', 'ARCH_Metro_Area__c', 'CFYEliot.CFY_Giving_Level', 'CFY_Eliot_Status', 'PFY_Eliot_Status');\nq = foreach q generate 'PrimaryGiftOfficer.GiftOfficerTeam', 'ARCH_PrimaryGiftOfficerName__c', 'ARCH_Account_ID__c','Id', 'Name', 'ARCH_Metro_Area__c', 'CFYEliot.CFY_Giving_Level', 'CFY_Eliot_Status', 'PFY_Eliot_Status', count(q1) as Count, \ngrouping(q.'PrimaryGiftOfficer.GiftOfficerTeam') as 'grouping_PrimaryGiftOfficer.GiftOfficerTeam', \ngrouping(q.'ARCH_PrimaryGiftOfficerName__c') as 'grouping_ARCH_PrimaryGiftOfficerName__c',\ngrouping(q.'ARCH_Account_ID__c') as 'grouping_ARCH_Account_ID__c',\ngrouping(q.'Id') as 'grouping_Id',\ngrouping(q.'Name') as 'grouping_Name',\ngrouping(q.'ARCH_Metro_Area__c') as 'grouping_ARCH_Metro_Area__c',\ngrouping(q.'CFYEliot.CFY_Giving_Level') as 'grouping_CFYEliot.CFY_Giving_Level',\ngrouping(q.'CFY_Eliot_Status') as 'grouping_CFY_Eliot_Status',\ngrouping(q.'PFY_Eliot_Status') as 'grouping_PFY_Eliot_Status';\n\ns = filter q by 'grouping_PrimaryGiftOfficer.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_PrimaryGiftOfficer.GiftOfficerTeam' == 0 and 'grouping_ARCH_PrimaryGiftOfficerName__c' == 0 and 'grouping_ARCH_Account_ID__c' ==0 and 'grouping_Id'==0 and 'grouping_Name' == 0 and 'grouping_ARCH_Metro_Area__c' ==0 and 'grouping_CFYEliot.CFY_Giving_Level' == 0 and 'grouping_CFY_Eliot_Status' == 0 and 'grouping_PFY_Eliot_Status' == 0;\nq = order q by ('PrimaryGiftOfficer.GiftOfficerTeam' asc, 'ARCH_PrimaryGiftOfficerName__c' asc, 'Name' 