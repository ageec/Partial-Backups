ew\", \"Proposal Preparation\", \"Proposal Submittal\", \"Solicitation\", \"Solicitation (PG)\"] and date('Opportunity.AQC_Date_Asked__c_Year', 'Opportunity.AQC_Date_Asked__c_Month', 'Opportunity.AQC_Date_Asked__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"] and ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null) and 'Opportunity.OpportunityTeamMember.MedOfficerTeam' in [\"Med Alumni\", \"Community Fundraising\", \"Med CFR\", \"Momentum/EVC/VC\", \"Med/Surg\", \"Neuro\", \"Siteman\"]; --and 'Opportunity.SolicitedMedGiftBand' in [\"01 - $1,000,000+\",\"02 - $100,000 to $999,999\"];\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"[[parameter_1]]\";\nq2 = filter q2 by 'Goal' == \"# of Opportunities Solicited\"; -- and 'Gift_Band' in [\"01 - $1,000,000+\",\"02 - $100,000 to $999,999\"];\nq = cogroup q1 by 'Opportunity.SolicitedMedGiftBand' left, q2 by 'Gift_Band';\nq = foreach q generate coalesce(q1.'Opportunity.SolicitedMedGiftBand', q2.'Gift_Band') as 'Opportunity.SolicitedMedGiftBand', count(q1) as 'A', sum(q2.'Amount') as 'B';\nq = foreach q generate 'Opportunity.SolicitedMedGiftBand', 'A' as '# Opps Solicited', 'B' as 'Goal', coalesce(A,0)/B as '% to Goal';\nt = foreach q generate 'Opportunity.SolicitedMedGiftBand', '# Opps Solicited', 'Goal', '% to Goal';\nq = filter q by 'Opportunity.SolicitedMedGiftBand' in [\"01 - $1,000,000+\",\"02 - $100,000 to $999,999\"];\nq = group q by rollup('Opportunity.SolicitedMedGiftBand');\nq = foreach q generate q.'Opportunity.SolicitedMedGiftBand' as 'Opportunity.SolicitedMedGiftBand', sum(q.'# Opps Solicited') as '# Opps Solicited', sum(q.'Goal') as 'Goal', sum(q.'# Opps Solicited') / sum(q.'Goal') as '% to Goal', grouping(q.'Opportunity.SolicitedMedGiftBand') as 'grouping_Opportunity.SolicitedMedGiftBand';\ns = filter q by 'grouping_Opportunity.SolicitedMedGiftBand' == 1;\nq = filter q by 'grouping_Opportunity.SolicitedMedGiftBand' == 0;\nq = order q by 'Opportunity.SolicitedMedGiftBand' asc;\nq = limit q 2000;\nq = union t, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"PSO___Opportunity_So_2":{"broadcastFacet":false,"datasets":[{"name":"OpportunityDetail"}],"isGlobal":false,"label":"PSO # Opportunity Solicited Summary Table","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":["OpportunityTeamMember.GiftOfficerDivision"],"limit":10000,"orders":[{"name":"OpportunityTeamMember.GiftOfficerDivision","filters":[],"ascending":true},{"name":"OpportunityTeamMember.Name","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{"OpportunityDetail":{"filters":[["StageName",["Closed - Funded No Value","Closed Won","Closed/Lost","Closed/Won","Closed/Won - No Value","Negotiation/Review","Proposal Submittal","Solicitation","Solicitation (PG)"],"in"],["DateAskedFiscalYearsPassed",["[[parameter_1]]"],"in"],["OpportunityTeamMember.GiftOfficerDivision",[],"isnotnull"],["OppRecordType.Name",["Grateful Patients"],"not in"]]}},"sources":[{"columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["OpportunityTeamMember.GiftOfficerDivision","OpportunityTeamMember.Name"],"joins":[],"name":"OpportunityDetail"}]},"receiveFa