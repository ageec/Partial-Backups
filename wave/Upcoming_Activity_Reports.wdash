{"dataSourceLinksInfo":{"enableAutomaticLinking":true,"excludeRelationships":[],"links":[]},"filters":[],"gridLayouts":[{"name":"Default","numColumns":12,"pages":[{"label":"Past Due Eliot Renewals","name":"db818730-510f-4035-890b-a077b705ac1e","navigationHidden":false,"widgets":[{"colspan":12,"column":0,"name":"number_3","row":0,"rowspan":1,"widgetStyle":{"backgroundColor":"#D9D9D6","borderColor":"#747474","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":3,"column":0,"name":"chart_3","row":1,"rowspan":6,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#D9D9D6","borderEdges":["all"],"borderRadius":8,"borderWidth":1}},{"colspan":9,"column":3,"name":"table_5","row":1,"rowspan":6,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#747474","borderEdges":[],"borderRadius":0,"borderWidth":1}}]},{"label":"Logged In User","name":"ac70ab3a-05fd-4ba5-9ccd-f530e18bb091","navigationHidden":true,"widgets":[{"colspan":8,"column":0,"name":"table_2","row":0,"rowspan":2,"widgetStyle":{"borderEdges":[]}},{"colspan":8,"column":0,"name":"table_3","row":3,"rowspan":2,"widgetStyle":{"borderEdges":[]}}]}],"rowHeight":"normal","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#F2F6FA","cellSpacingX":8,"cellSpacingY":8,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"steps":{"Past_Due_Eliot_Renew_4":{"broadcastFacet":true,"groups":[],"label":"Past Due Eliot Renewals Count","numbers":[],"query":"q = load \"Eliot_Society_Status\";\n--filter for logged in user as primary gift officer\nq = filter q by 'PrimaryGiftOfficerId' in [\"{{cell(lens_1.result, 0, \"Id\").asString()}}\"];\nq = filter q by 'CFY_Eliot_Status' in [\"Downgrade\", \"Unrenewed\"] or ('Contact.ARCH_CFY_Annual_Fund_Pledged_Credit__c' > 0 and 'CFY_Eliot_Status' == \"Pledge Not Paid\");\nq = foreach q generate q.'Name' as 'Name', 'CFY_Eliot_Status', 'CFYEliot.AQB__Date__c' as 'CFY Summary Date', q.'ARCH_CFY_Annual_Fund_Recognition_Credit__c' as 'ARCH_CFY_Annual_Fund_Recognition_Credit__c',\n(case\n    when date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") == \"1970-01-01\"\n    then \"Date Needs Review\"\n    else date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") \n    end) as 'PFY Renewal Date', \nq.'PFYEliot.SUM_ARCH_Selected_Fiscal_Year_Total__c' as 'PFY Amount', q.'PFYEliot.PFY_Giving_Level' as 'PFY Level',  q.'AQB__OpenOpps__c' as 'AQB__OpenOpps__c',  q.'ARCH_PrimaryGiftOfficerName__c' as 'Primary Gift Officer', q.'PMTeam.TerritoryPartner' as 'Territory Partner', q.'PMTeam.ProxyOfficer' as 'Proxy Officer',\n(case\n    when date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") == \"1970-01-01\" then 999999\n    else date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) \n    end) as 'Days from PFY Eliot Date', \n(case    \n    when date_to_string(toDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'),\"yyyy-MM-dd\") == \"1970-01-01\" then \"Date Needs Review\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) > 425 then \"61+ Days\" -- > 730 then \"12+ Months\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 395 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=425 then \"31-60 Days\" -- <=730 then \"06-12 Months\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 380 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=394 then \"15-30 Days\" -- <=550 then \"03-06 Months\"\n    when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 366 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=379 then \"0-14 Days\" -- <=460 then \"00-03 Months\"\n    --when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 351 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=365 then \"0-14 Days\"\n    --when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 337 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=350 then \"14-30 Days\"\n    --when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now()) >= 277 and date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=336 then \"30-60 Days\"\n    --when date_diff(\"day\", toDate(q.'PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH'), now())  <=276 then \"60+ Days\"\n    else \"\"\n    end) as 'Time Renewal Past Due',\ntoDate('PFYEliot.ARCH_Renewal_Date__c_SEC_EPOCH') as 'PFY Eliot Summary Date-Time', q.'Id' as 'Account ID';\nq = filter q by 'Days from PFY Eliot Date' > 365 and 'Time Renewal Past Due' in {{coalesce(column(Past_Due_Eliot_Renew_5.selection, [\"Time Renewal Past Due\"]),\"all\").asString()}};\nq1 = group q by all;\nq1 = foreach q1 generate count (q1) as 'Count';\nq1 = limit q1 10000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"Past_Due_Eliot_Renew_5":{"broadcastFacet":true,"groups":[],"label":"Past Due Eliot Renewals Chart","numbers":[],"query":"q = load \"Eliot_