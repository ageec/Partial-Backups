\"]),\"all\").asString()}};\nq = order q by 'PFY Eliot Summary Date-Time' asc;\nq = limit q 10000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"rgb(225, 229, 238)","borderWidth":1,"cell":{"backgroundColor":"rgb(242, 246, 250)","fontColor":"#091A3E","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"rgb(242, 246, 250)","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"rgb(169, 183, 199)","innerMinorBorderColor":"rgb(225, 229, 238)","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#FFFFFF","showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Upcoming_Activities__1":{"broadcastFacet":true,"groups":[],"label":"Upcoming Activity Reports Count","numbers":[],"query":"q1 = load \"Activity_Report_Info\";\nq1 = filter q1 by 'ActivityReportParticipant.AQB__User__c' in [\"{{cell(lens_1.result, 0, \"Id\").asString()}}\"];\nq1 = filter q1 by Days_Until_Due >=0 and AQB__Date__c is not null and('Account.Account.ARCH_MedProspect__c' == \"false\" or 'Account.Account.ARCH_MedProspect__c' is null) and 'ActivityReportParticipant.User.Name' is not null and 'Account.Account.Name' is not null and AQB__ReportStatus__c != \"Final\";\nq1 = foreach q1 generate 'Account.Account.Name', AQB__Subject__c, Days_Until_Due, AQB__Date__c, coalesce(AQB__Type__c,\"-\") as Type, 'Months_Until_Due' as 'Time Until Due', \"Activity Report\" as 'Record Type';\n\n\nq3 = group q1 by all;\nq3 = foreach q3 generate count(q3) as Count;\nq3 = limit q3 10000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true