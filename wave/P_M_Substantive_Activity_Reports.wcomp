,"query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":["Name"],"limit":2000,"orders":[{"name":"Name","filters":[],"ascending":true},{"name":"Account.Account.Name","filters":[],"ascending":true},{"name":"AQB__Purpose__c","filters":[],"ascending":true},{"name":"AQB__Subject__c","filters":[],"ascending":true},{"name":"ActivityReportParticipant.MedOfficerTeam","filters":[],"ascending":true},{"name":"AQB__Date__c_Year","filters":[],"ascending":true},{"name":"AQB__Date__c_Month","filters":[],"ascending":true},{"name":"AQB__Date__c_Day","filters":[],"ascending":true},{"name":"Id","filters":[],"ascending":true},{"name":"Account.Account.Id","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{"Activity_Report_Info":{"filters":[["AQB__Date__c",[["fiscal_year",0],["fiscal_year",0]],"between"],["AQB__ReportStatus__c",["Final"],"in"],["AQB__EssentialMove__c",["true"],"in"],["ActivityReportParticipant.User.Department",["Medical Advancement"],"in"],["ActivityReportParticipant.MedOfficerTeam",["Med Alumni","Med CFR","Momentum/EVC/VC","Med/Surg","Neuro","Siteman"],"in"]]}},"sources":[{"columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["Name","Account.Account.Name","AQB__Purpose__c","AQB__Subject__c","ActivityReportParticipant.MedOfficerTeam","AQB__Date__c_Year","AQB__Date__c_Month","AQB__Date__c_Day","Id","Account.Account.Id"],"joins":[],"name":"Activity_Report_Info"}]},"receiveFacetSource":{"mode":"include","steps":["Med_Adv_Substantive__2"]},"selectMode":"single","sortable":true,"type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","Name","Account.Account.Name","AQB__Purpose__c","AQB__Subject__c","ActivityReportParticipant.MedOfficerTeam","AQB__Date__c_Year~~~AQB__Date__c_Month~~~AQB__Date__c_Day"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Med_Adv_Substantive__2":{"broadcastFacet":true,"groups":[],"label":"Med Adv Substantive ARs Summary Table","numbers":[],"query":"q1 = load \"Activity_Report_Info\";\nq2 = load \"UA_Performance_Med_Team_Goals\";\nq1 = filter q1 by date('AQB__Date__c_Year', 'AQB__Date__c_Month', 'AQB__Date__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by 'AQB__ReportStatus__c' == \"Final\";\nq1 = filter q1 by 'AQB__EssentialMove__c' == \"true\";\nq1 = filter q1 by ('RecordType.Name' != \"Corporate Engagement\" || 'RecordType.Name' is null);\nq1 = filter q1 by 'ActivityReportParticipant.MedOfficerTeam' in [\"Med Alumni\",\"Community Fundraising\",\"Med CFR\",\"Momentum/EVC/VC\",\"Med/Surg\",\"Neuro\",\"Siteman\"];\nq1 = filter q1 by 'ActivityReportParticipant.User.Department' == \"Medical Advancement\";\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"[[parameter_1]]\";\nq2 = filter q2 by 'Goal' == \"# of Substantive Activity Reports\";\nq = cogroup q1 by 'ActivityReportParticipant.MedOfficerTeam' full, q2 by 'Med_Team';\nq = foreach q generate coalesce(q1.'ActivityReportParticipant.MedOfficerTeam', q2.'Med_Team') as 'ActivityReportParticipant.MedOfficerTeam', count(q1) as 'A', sum(q2.'Amount') as 'B';\nq = foreach q generate 'ActivityReportParticipant.MedOfficerTeam', 'A', 'B', A/B as 'C';\nq = group q by rollup('ActivityReportParticipant.MedOfficerTeam');\nq = foreach q generate q.'ActivityReportParticipant.MedOfficerTeam' as 'ActivityReportParticipant.MedOfficerTeam', sum(q.'A') as 'Substantive ARs', sum(q.'B') as 'Goal', sum(q.'A') / sum(q.'B') as '% to Goal', grouping(q.'ActivityReportParticipant.MedOfficerTeam') as 'grouping_ActivityReportParticipant.MedOfficerTeam';\ns = filter q by 'grouping_ActivityReportParticipant.MedOfficerTeam' == 1;\nq = filter q by 'grouping_ActivityReportParticipant.MedOfficerTeam' == 0;\nq = order q by 'ActivityReportParticipant.MedOfficerTeam' asc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Territories_Activiti_4":{"broadcastFacet":false,"datasets":[{"name":"Activity_Report_Info"}],"isGlobal":false,"label":"Territories Activity Report Visits by Month Detail Table","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":["Name"],"limit":2000,"orders":[{"name":"Name","filters":[],"ascending":true},{"name":"Id","filters":[],"ascending":true},{"name":"AQB__Purpose__c","filters":[],"ascending":true},{"name":"Account.Account.Name","filters":[],"ascending":true},{"name":"Account.Account.ARCH_Territory__c","filters":[],"ascending":true},{"name":"ActivityReportParticipant.AssignedTo","filters":[