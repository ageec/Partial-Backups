[[parameter_2]]\"];\nq = filter q by 'AQB__ReportStatus__c' == \"Final\";\n--q1 = filter q1 by 'AQB__EssentialMove__c' == \"true\";\nq = filter q by AQB__Purpose__c == \"Stewardship\";\nq = filter q by ('AccountInfo.Account.PrimaryContact.ARCH_CFY_Recognition_Credit__c' > 0 || 'AccountInfo.Account.PrimaryContact.ARCH_PFY_Recognition_Credit__c' > 0);\nq = foreach q generate q.'ActivityReportParticipant.GiftOfficerDivision' as 'ActivityReportParticipant.GiftOfficerDivision', q.'ActivityReportParticipant.User.Name' as 'ActivityReportParticipant.User.Name', 'Account.Name', 'AQB__Subject__c' as 'Activity Report Subject', 'AQB__Date__c' as 'Activity Report Date', 'AccountInfo.Account.PrimaryContact.ARCH_CFY_Recognition_Credit__c' as 'Primary Contact CFY Recognition Credit', 'AccountInfo.Account.PrimaryContact.ARCH_PFY_Recognition_Credit__c' as 'Primary Contact PFY Recognition Credit',\n    (case \n        when (q.'AccountInfo.Account.PrimaryContact.ARCH_PFY_Recognition_Credit__c' == 0 || 'AccountInfo.Account.PrimaryContact.ARCH_PFY_Recognition_Credit__c' is null) then 1\n        else q.'AccountInfo.Account.PrimaryContact.ARCH_CFY_Recognition_Credit__c'/q.'AccountInfo.Account.PrimaryContact.ARCH_PFY_Recognition_Credit__c' \n        end) as '% Growth Overall',\n    q.'Account.Id' as 'Account.Id',  'Id' as 'Activity Report Id';\nq = order q by ('ActivityReportParticipant.GiftOfficerDivision' asc, 'ActivityReportParticipant.User.Name' asc,  'Account.Name' asc, 'Activity Report Date' desc);\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#0