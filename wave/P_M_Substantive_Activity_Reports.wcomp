ue,"type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","B","C"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":false,"verticalPadding":8},"type":"table"}},"PST_Officer_Stewards_1":{"broadcastFacet":true,"groups":[],"label":"PST Officer Donors Engaged through Stewardship Efforts Totals","numbers":[],"query":"q = load \"ActivityReportDetail\";\n--q2 = load \"UA_Performance_Med_Team_Goals\";\nq = filter q by date('AQB__Date__c_Year', 'AQB__Date__c_Month', 'AQB__Date__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq = filter q by 'AQB__ReportStatus__c' == \"Final\";\n--q1 = filter q1 by 'AQB__EssentialMove__c' == \"true\";\nq = filter q by AQB__Purpose__c == \"Stewardship\";\nq = filter q by ('AccountInfo.Account.PrimaryContact.ARCH_CFY_Recognition_Credit__c' > 0 || 'AccountInfo.Account.PrimaryContact.ARCH_PFY_Recognition_Credit__c' > 0);\nq = group q by ('ActivityReportParticipant.GiftOfficerDivision', 'ActivityReportParticipant.User.Name', 'Account.Id');\nq = foreach q generate q.'ActivityReportParticipant.GiftOfficerDivision' as 'ActivityReportParticipant.GiftOfficerDivision', q.'ActivityReportParticipant.User.Name' as 'ActivityReportParticipant.User.Name', q.'Account.Id' as 'Account.Id', count(q) as '# of ARs Completed', avg('AccountInfo.Account.PrimaryContact.ARCH_CFY_Recognition_Credit__c') as 'Primary Contact CFY Recognition Credit', avg('AccountInfo.Account.PrimaryContact.ARCH_PFY_Recognition_Credit__c') as 'Primary Contact PFY Recognition Credit';\n\n--count # of accounts with increased cfy giving over pfy\nq1 = filter q by 'Primary Contact CFY Recognition Credit' > 'Primary Contact PFY Recognition Credit';\nq1 = group q1 by ('ActivityReportParticipant.GiftOfficerDivision', 'ActivityReportParticipant.User.Name');\nq1 = foreach q1 generate q1.'ActivityReportParticipant.GiftOfficerDivision', q1.'ActivityReportParticipant.User.Name', count(q) as 'Increased Giving over PFY (Count)';\n\n--join q and q1 streams\nq2 = cogroup q by ('ActivityReportParticipant.GiftOfficerDivision', 'ActivityReportParticipant.User.Name') left, q1 by ('ActivityReportParticipant.GiftOfficerDivision', 'ActivityReportParticipant.User.Name');\nq2 = foreach q2 generate q.'ActivityReportParticipant.GiftOfficerDivision' as 'ActivityReportParticipant.GiftOfficerDivision', q.'ActivityReportParticipant.User.Name' as 'ActivityReportParticipant.User.Name', \n    count(q) as '# of Donors who have AR Stewardship', \n    sum(q.'Primary Contact CFY Recognition Credit') as 'CFY Recognition Credit', \n    sum(q.'Primary Contact PFY Recognition Credit') as 'PFY Recognition Credit', \n    (case \n        when sum(q.'Primary Contact PFY Recognition Credit') == 0 then 1\n        else (sum(q.'Primary Contact CFY Recognition Credit')/sum(q.'Primary Contact PFY Recognition Credit')) \n        end) as '% Growth Overall',\n    sum(q1.'Increased Giving over PFY (Count)') as 'Increased Giving over PFY (Count)';\n\n--rollup totals\nq2 = group q2 by rollup('ActivityReportParticipant.GiftOfficerDivision', 'ActivityReportParticipant.User.Name');\nq2 = foreach q2 generate 'ActivityReportParticipant.GiftOfficerDivision', 'ActivityReportParticipant.User.Name', \n    sum('# of Donors who have AR Stewardship') as '# of Donors who have AR Stewardship', \n    sum('CFY Recognition Credit') as 'CFY Recognition Credit', \n    sum('PFY Recognition Credit') as 'PFY Recognition Credit',\n    (case\n        when sum('PFY Recognition Credit') == 0 then 1\n        else sum('CFY Recognition Credit')/sum('PFY Recognition Credit') \n        end) as '% Growth Overall', \n    sum('Increased Giving over PFY (Count)') as 'Increased Giving over PFY (Count)',\n    grouping(q2.'ActivityReportParticipant.GiftOfficerDivision') as 'grouping_GiftOfficerDivision', grouping(q2.'ActivityReportParticipant.User.Name') as 'grouping_Gift Officer Name';\n\n --get totals row\ns = filter q2 by 'grouping_GiftOfficerDivision' == 1 and 'grouping_Gift Officer Name' == 1;\n--get detail rows\nq2 = filter q2 by 'grouping_GiftOfficerDivision' == 0 and 'grouping_Gift Officer Name' == 0;\n\nq2 = order q2 by ('ActivityReportParticipant.GiftOfficerDivision' asc, 'ActivityReportParticipant.User.Name'  asc);\nq2 = limit q2 2000;\n--append totals row to top of details row\nq2 = union q2, s;\nq2 = limit q2 2001;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Med_Adv_Substantive__3":{"broadcastFacet":false,"datasets":[{"name":"Activity_Report_Info"}],"isGlobal":false,"label":"Med Adv Substantive 