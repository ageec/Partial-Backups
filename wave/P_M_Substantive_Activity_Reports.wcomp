tive Activity Reports') as '# Substantive Activity Reports', sum(q.'Goal') as 'Goal', sum(q.'# Substantive Activity Reports') / sum(q.'Goal') as '% to Goal', grouping(q.'ActivityReportParticipant.GiftOfficerTeam') as 'grouping_ActivityReportParticipant.GiftOfficerTeam', grouping(q.'ActivityReportParticipant.User.Name') as 'grouping_ActivityReportParticipant.User.Name';\ns = filter q by 'grouping_ActivityReportParticipant.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_ActivityReportParticipant.GiftOfficerTeam' == 0 and 'grouping_ActivityReportParticipant.User.Name' == 0;\nq = order q by ('ActivityReportParticipant.GiftOfficerTeam' asc, 'ActivityReportParticipant.User.Name' asc);\nq = limit q 10000;\nq = union q, s;\nq = limit q 10001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"PrG_ADM_Momentum_Sub_2":{"broadcastFacet":false,"datasets":[{"name":"Activity_Report_Info"}],"isGlobal":false,"label":"PrG ADM/Momentum Substantive ARs Details Table","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":["Name"],"limit":2000,"orders":[{"name":"Name","filters":[],"ascending":true},{"name":"Account.Account.Name","filters":[],"ascending