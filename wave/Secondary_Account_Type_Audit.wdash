"Open\", \"Pending Completion\"] and ARCH_Record_Type_Developer_Name__c == \"Institutional\";\nq2 = group q2 by AQB__ContactId__c;\nq2 = foreach q2 generate AQB__ContactId__c;\n\n\nq = load \"Advanced_Contact_Search\";\n--get contacts without alumni-credits earned secondary contact type but they do have Closed, Institutional, Not Non-Degree education records but do not have institutional complete, in progress, matriculated, finished, open, or completion education records\nq = join q by ('Contact.Id') semi, q1 by AQB__ContactId__c;\nq = join q by ('Contact.Id') anti, q2 by AQB__ContactId__c;\nq = filter q by ('Contact.AQB__SecondaryType__c' not in [\"Alumni-Credits Earned\"] || 'Contact.AQB__SecondaryType__c' is null);\nq = foreach q generate q.'Contact.ARCH_Contact_ID__c' as 'Contact.ARCH_Contact_ID__c', q.'Contact.Name' as 'Contact Name', q.'Contact.AQB__Type__c' as 'Contact Type', q.'Secondary_Contact_Types' as 'Secondary Contact Types', q.'Contact.AQB__Deceased__c' as 'Deceased?', q.'Contact_Recipe.AQB__CAECategory__c' as 'VSE Category', q.'Contact_Recipe.AQB__VSEAlumniDegreeCategory__c' as 'VSE Alumni Degree Category', q.'Education.RollupStatusDegreeLevelGraduationMonthandYearProgramName' as 'Rollup Student Status/Cert Status/Degree Level/Grad Month and Year/Program Name', q.'Account.ARCH_Account_ID__c' as 'Account.ARCH_Account_ID__c', q.'Account.Name' as 'Account.Name', q.'Account.ARCH_PrimaryGiftOfficerName__c' as 'Primary Gift Officer Name', q.'Account.ARCH_Total_Gifts_and_Pledges_all_types__c' as 'Account.ARCH_Total_Gifts_and_Pledges_all_types__c', q.'Contact.ARCH_Metro_Area__c' as 'Contact.ARCH_Metro_Area__c', q.'Contact_Recipe.CreatedDate' as 'Contact Created Date', q.'Contact_Recipe.Created.Name' as 'Contact Created By', q.'Contact_Recipe.AQC_Source__c' as 'Source of Contact Record',q.'Contact.Id' as 'Contact ID', q.'Account.Id' as 'Account ID';\nq = limit q 10000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"rgb(242, 246, 250)","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f4f6f9","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfFrozenColumns":0,"numberOfLines":1,"oddRowColor":"#ffffff","showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"AS_Cert_holder_no_ed_2":{"broadcastFacet":true,"groups":[],"label":"AS-Cert holder no edu records","numbers":[],"query":"--Get Complete/Finished Institutional Certificate, Not Non-Degree education records\nq1 = load \"Education\";\nq1 = filter q1 by AQB__StudentStatus__c in [\"Complete\", \"Finished\"] and ARCH_Record_Type_Developer_Name__c == \"Institutional Certificate\" and (ARCH_Program_of_Study_Type__c != \"Non-Degree Program\" || ARCH_Program_of_Study_Type__c  is null);\nq1 = group q1 by AQB__ContactId__c;\nq1 = foreach q1 generate AQB__ContactId__c;\n\nq = load \"Advanced_Contact_Search\";\nq = filter q by not ('Contact.AQB__SecondaryType__c' == \"Alumni-Certificate Holder\")|| 'Contact.AQB__SecondaryType__c' is null;\n--get contacts who don't have alumni-certificate holder secondary contact type but do have Complete/Finished Institutional Certificate, Not Non-Degree education records\nq = join q by ('Contact.Id') semi, q1 by AQB__ContactId__c;\nq = foreach q generate q.'Contact.ARCH_Contact_ID__c' as 'Contact.ARCH_Contact_ID__c', q.'Contact.Name' as 'Contact Name', q.'Contact.AQB__Type__c' as 'Contact Type', q.'Secondary_Contact_Types' as 'Secondary Contact Types', q.'Contact.AQB_