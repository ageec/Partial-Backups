_c == \"Undergraduate\" and (ARCH_Program_of_Study_Type__c != \"Non-Degree Program\" || ARCH_Program_of_Study_Type__c  is null);\nq1 = group q1 by AQB__ContactId__c;\nq1 = foreach q1 generate AQB__ContactId__c;\n\nq = load \"Advanced_Contact_Search\";\nq = filter q by 'Contact.AQB__SecondaryType__c' == \"Student-Undergraduate School\";\n--find Student-Undergraduate School secondary contact types without \"In Progress\", \"Matriculated\", \"Open\", \"Pending Completion\", Undergraduate Institutional, Not Non-Degree education records\nq = join q by ('Contact.Id') anti, q1 by AQB__ContactId__c;\nq = foreach q generate q.'Contact.ARCH_Contact_ID__c' as 'Contact.ARCH_Contact_ID__c', q.'Contact.Name' as 'Contact Name', q.'Contact.AQB__Type__c' as 'Contact Type', q.'Secondary_Contact_Types' as 'Secondary Contact Types', q.'Contact.AQB__Deceased__c' as 'Deceased?', q.'Contact_Recipe.AQB__CAECategory__c' as 'VSE Category', q.'Contact_Recipe.AQB__VSEAlumniDegreeCategory__c' as 'VSE Alumni Degree Category', q.'Education.RollupStatusDegreeLevelGraduationMonthandYearProgramName' as 'Rollup Student Status/Cert Status/Degree Level/Grad Month and Year/Program Name', q.'Account.ARCH_Account_ID__c' as 'Account.ARCH_Account_ID__c', q.'Account.Name' as 'Account.Name', q.'Account.ARCH_PrimaryGiftOfficerName__c' as 'Primary Gift Officer Name', q.'Account.ARCH_Total_Gifts_and_Pledges_all_types__c' as 'Account.ARCH_Total_Gifts_and_Pledges_all_types__c', q.'Contact.ARCH_Metro_Area__c' as 'Contact.ARCH_Metro_Area__c', q.'Contact_Recipe.CreatedDate' as 'Contact Created Date', q.'Contact_Recipe.Created.Name' as 'Contact Created By', q.'Contact_Recipe.AQC_Source__c' as 'Source of Contact Record',q.'Contact.Id' as 'Contact ID', q.'Account.Id' as 'Account ID';\nq = limit q 10000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee"