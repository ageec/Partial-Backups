ransaction.Name');\nq = foreach q generate q.'DonorID' as 'DonorID', q.'Transaction.Name' as 'Transaction.Name', avg(q.'Transaction.AQB__Amount__c') as 'Cash Received';\nq = group q by 'DonorID';\nq = foreach q generate q.'DonorID' as 'DonorID', sum(q.'Cash Received') as 'Cash Received';\nq = filter q by 'Cash Received' != 0;\nq = foreach q generate 'DonorID', 'Cash Received', case when 'Cash Received' > 5000000 then \"01 - $5,000,000+\" when 'Cash Received' > 1000000 then \"02 - $1,000,000+\" when 'Cash Received' > 100000 then \"03 - $100,000 to $999,999\" else \"04 - $99,999 and Under\" end as 'Gift Band';\nq = group q by 'Gift Band';\nq = foreach q generate q.'Gift Band' as 'Gift Band', unique(q.'DonorID') as 'Donor Count';\nq = order q by 'Gift Band' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"top-center","inside":false},"axisMode":"sync","totalSumMode":"absolute","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":["Donor Count"],"showNullValues":true,"customizeLegend":true,"showPercentage":false,"showDimensions":true,"showMeasures":true,"dimensions":["Gift Band"]}}},"visualizationType":"stackvbar","title":{"fontSize":18,"subtitleFontSize":11,"label":"Donor Count","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"split":["Gift Band"],"trellis":[],"dimensionAxis":[],"plots":["Donor Count"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"sh