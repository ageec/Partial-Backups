ctionAmountWithBequests';\nq = group q by 'Id';\nq = foreach q generate q.'Id' as 'Id', sum(q.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests';\nq = foreach q generate 'Id', 'NewProductionAmountWithBequests', case when 'NewProductionAmountWithBequests' > 5000000 then \"01 - $5,000,000+\" when 'NewProductionAmountWithBequests' > 1000000 then \"02 - $1,000,000+\" when 'NewProductionAmountWithBequests' > 100000 then \"03 - $100,000 to $999,999\" else \"04 - $99,999 and Under\" end as 'Gift Band';\nq = group q by rollup('Gift Band');\nq = foreach q generate q.'Gift Band' as 'Gift Band', sum(q.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests', grouping(q.'Gift Band') as 'grouping_Gift Band';\ns = filter q by 'grouping_Gift Band' == 1;\nq = filter q by 'grouping_Gift Band' == 0;\nq = order q by 'Gift Band' asc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"oddRowColor":"#ffffff","showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"New_Production_With__3":{"broadcastFacet":true,"datasets":[{"name":"GiftAndPledgeTransactionsExtension"}],"isGlobal":false,"label":"New Production With Bequests Medical Advancement","query":{"aggregateFilters":[],"columnGroups":[],"columnTot