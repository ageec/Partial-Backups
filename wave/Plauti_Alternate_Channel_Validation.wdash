es":{"color":"#ba0c2f","size":"28px"},"insert":"Alternate Channel Validation"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_5":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px"},"insert":"Plauti international address validation is a feature within the Plauti platform that allows users to verify and standardize addresses from various countries around the world by parsing, cleansing, and formating addresses to ensure proper data entry and delivery accuracy. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_4":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px","color":"#020821"},"insert":"Initium Instant Address service allows users to automatically update domestic (US) addresses in their database with the latest information from the USPS. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_7":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px"},"insert":"Plauti's email validation is a feature within the Plauti platform that analyzes, validates, and formats email addresses. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_6":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px"},"insert":"Plauti's phone validation is a feature within the Plauti platform that analyzes, validates, and formats phone numbers. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"filterpanel_16":{"parameters":{"filterItemOptions":{"propertyColor":"#020821","valueColor":"