"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"All_5_Year_Gift_Band_2":{"broadcastFacet":false,"groups":[],"label":"All 5 Year Gift Band Metrics","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by 'Transaction.AQB__Type__c' in {{coalesce(cell(Gift_Band_Dimension__1.selection, 0, \"FILTER\"), \"all\").asString()}};\nq = filter q by date('{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Year', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Month', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Day') in [\"4 fiscal_years ago\"..\"current fiscal_year\"];\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq_C = filter q by date('{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Year', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Month', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq_Q = filter q by date('{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Year', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Month', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nq_R = filter q by date('{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Year', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Month', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"];\nq_S = filter q by date('{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Year', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Month', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"];\nq_T = filter q by date('{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Year', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Month', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"];\nq_D = filter q by date('{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Year', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Month', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq_U = filter q by date('{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Year', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Month', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nq_V = filter q by date('{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Year', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Month', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"];\nq_W = filter q by date('{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Year', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Month', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"];\nq_X = filter q by date('{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Year', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Month', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"];\nq_C = group q_C by ('Transaction.Name', 'AccountID', '{{cell(Gift_Band_Dimension__1.selection, 0, \"FY\").asString()}}_Year_Fiscal');\nq_C = foreach q_C generate q_C.'Transaction.Name' as 'Transaction.Name', q_C.'AccountID' as 'AccountID', q_C.'{{cell(Gift_