"},{"formula":"coalesce(AD,0)-coalesce(AH,0)","name":"AL"},{"formula":"coalesce(AE,0)-coalesce(AI,0)","name":"AM"},{"formula":"coalesce(AF,0)-coalesce(AJ,0)","name":"AN"},{"formula":"coalesce(Y,0)+coalesce(BB,0)+coalesce(AO,0)+coalesce(CH,0)","name":"AW"},{"formula":"coalesce(Z,0)+coalesce(BC,0)+coalesce(AQ,0)+coalesce(CI,0)","name":"AX"},{"formula":"coalesce(AA,0)+coalesce(BD,0)+coalesce(AP,0)+coalesce(CJ,0)","name":"AY"},{"formula":"coalesce(AB,0)+coalesce(CQ,0)+coalesce(AR,0)+coalesce(CK,0)","name":"AZ"},{"formula":"coalesce(BB,0)+coalesce(AO,0)+coalesce(CH,0)+coalesce(CM,0)","name":"BE"},{"formula":"coalesce(BC,0)+coalesce(AQ,0)+coalesce(CI,0)+coalesce(CN,0)","name":"BF"},{"formula":"coalesce(BD,0)+coalesce(AP,0)+coalesce(CJ,0)+coalesce(CO,0)","name":"BG"},{"formula":"coalesce(CQ,0)+coalesce(AR,0)+coalesce(CK,0)+coalesce(CP,0)","name":"BH"},{"formula":"F - AK","name":"BI"},{"formula":"AK- AL","name":"BJ"},{"formula":"AL - AM","name":"BK"},{"formula":"AM - AN","name":"BL"},{"formula":"BI / AK","name":"BM"},{"formula":"BJ / AL","name":"BN"},{"formula":"BK / AM","name":"BO"},{"formula":"BL / AN","name":"BP"},{"formula":"I - AW","name":"BQ"},{"formula":"AW - AX","name":"BR"},{"formula":"AX - AY","name":"BS"},{"formula":"AY-AZ","name":"BT"},{"formula":"BQ / AW","name":"BU"},{"formula":"BR / AX","name":"BV"},{"formula":"BS / AY","name":"BW"},{"formula":"BT /AZ","name":"BX"},{"formula":"K - BE","name":"BY"},{"formula":"BE - BF","name":"BZ"},{"formula":"BF - BG","name":"CA"},{"formula":"BG-BH","name":"CB"},{"formula":"BY / BE","name":"CC"},{"formula":"BZ / BF","name":"CD"},{"formula":"CA / BG","name":"CE"},{"formula":"CB / BH","name":"CF"}],"filters":[],"groups":[],"joins":[]}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#FFFFFF","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#FFFFFF","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"All_5_Year_Account_T_6":{"broadcastFacet":false,"groups":[],"label":"All 5 Year Gift Type Metrics","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"current fiscal_year\"];\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq_C = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq_Q = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nq_R = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"];\nq_S = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"];\nq_T = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"];\nq_D = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq_U = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nq_V = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"];\nq_W = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"];\nq_X = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"];\nq_C = group q_C by ('Transaction.Name', 'Record_Type.Name', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_C = foreach q_C generate q_C.'Transaction.Name' as 'Transaction.Name', q_C.'Record_Type.Name' as 'Record_Type.Name', q_C.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_C.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_Q = group q_Q by ('Transaction.Name', 'Record_Type.Name', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_Q = foreach q_Q generate q_Q.'Transaction.Name' as 'Transaction.Name', q_Q.'Record_Type.Name' as 'Record_Type.Name', q_Q.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_Q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_R = group q_R by ('Transaction.Name', 'Record_Type.Name', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_R = foreach q_R generate q_R.'Transaction.Name' as 'Transaction.Name', q_R.'Record_Type.Name' as 'Record_Type.Name', q_R.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_R.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_S = group q_S by ('Transaction.Name', 'Record_Type.Name', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_S = foreach q_S generate q_S.'Transaction.Name' as 'Transaction.Name', q_S.'Record_Type.Name' as 'Record_Type.Name', q_S.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_S.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_T = group q_T by ('Transaction.Name', 'Record_Type.Name', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_T = foreach q_T generate q_T.'Transaction.Name' as 'Transaction.Name', q_T.'Record_Type.Name' as 'Record_Type.Name', q_T.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_T.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\n-- Added SAQL Start - ARCHRPTS-1490/1492\nq_D = group q_D by ('DonorID', 'Record_Type.Name', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_D = foreach q_D generate q_D.'DonorID' as 'DonorID', q_D.'Record_Type.Name' as 'Record_Type.Name', q_D.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_D.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_D = filter q_D by 'Transaction.AQB__Amount__c' != 0;\nq_U = group q_U by ('DonorID', 'Record_Type.Name', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_U = foreach q_U generate q_U.'DonorID' as 'DonorID', q_U.'Record_Type.Name' as 'Record_Type.Name', q_U.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_U.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_U = filter q_U by 'Transaction.AQB__Amount__c' != 0;\nq_V = group q_V by ('DonorID', 'Record_Type.Name', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_V = foreach q_V generate q_V.'DonorID' as 'DonorID', q_V.'Record_Type.Name' as 'Record_Type.Name', q_V.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_V.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_V = filter q_V by 'Transaction.AQB__Amount__c' != 0;\nq_W = group q_W by ('DonorID', 'Record_Type.Name', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_W = foreach q_W generate q_W.'DonorID' as 'DonorID', q_W.'Record_Type.Name' as 'Record_Type.Name', q_W.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_W.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_W = filter q_W by 'Transaction.AQB__Amount__c' != 0;\nq_X = group q_X by ('DonorID', 'Record_Type.Name', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_X = foreach q_X generate q_X.'DonorID' as 'DonorID', q_X.'Record_Type.Name' as 'Record_Type.Name', q_X.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_X.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_X = filter q_X by 'Transaction.AQB__Amount__c' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1492\nq = cogroup q by 'Record_Type.Name' full, q_C by 'Record_Type.Name' full, q_Q by 'Record_Type.Name' full, q_R by 'Record_Type.Name' full, q_S by 'Record_Type.Name' full, q_T by 'Record_Type.Name' full, q_D by 'Record_Type.Name' full, q_U by 'Record_Type.Name' full, q_V by 'Record_Type.Name' full, q_W by 'Record_Type.Name' full, q_X by 'Record_Type.Name';\nq = foreach q generate coalesce(q.'Record_Type.Name', q_C.'Record_Type.Name', q_Q.'Record_Type.Name', q_R.'Record_Type.Name', q_S.'Record_Type.Name', q_T.'Record_Type.Name', q_D.'Record_Type.Name', q_U.'Record_Type.Name', q_V.'Record_Type.Name', q_W.'Record_Type.Name', q_X.'Record_Type.Name') as 'Record_Type.Name', number_to_string(max(q.'Current_Fiscal_Year'),\"####\") as 'BE', number_to_string(max(q.'Current_Fiscal_Year')-1,\"####\") as 'BF', number_to_string(max(q.'Current_Fiscal_Year')-2,\"####\") as 'BG', number_to_string(max(q.'Current_Fiscal_Year')-3,\"####\") as 'BH', number_to_string(max(q.'Current_Fiscal_Year')-4,\"####\") as 'BI', sum(q_C.'Transaction.AQB__Amount__c') as 'C', sum(q_Q.'Transaction.AQB__Amount__c') as 'Q', sum(q_R.'Transaction.AQB__Amount__c') as 'R', sum(q_S.'Transaction.AQB__Amount__c') as 'S', sum(q_T.'Transaction.AQB__Amount__c') as 'T', unique(q_D.'DonorID') as 'D', unique(q_U.'DonorID') as 'U', unique(q_V.'DonorID') as 'V', unique(q_W.'DonorID') as 'W', unique(q_X.'DonorID') as 'X';\nq = group q by 'Record_Type.Name';\nq = foreach q generate 'Record_Type.Name', first(BE) as '00-YR', first(BF) as '01-YR', first(BG) as '02-YR', first(BH) as '03-YR', first(BI) as '04-YR', first(C) as '00-DA-DNU', first(Q) as '01-DA-DNU', first(R) as '02-DA-DNU', first(S) as '03-DA-DNU', first(T) as '04-DA-DNU', first(D) as '00-DC-DNU', first(U) as '01-DC-DNU', first(V) as '02-DC-DNU', first(W) as '03-DC-DNU', first(X) as '04-DC-DNU', coalesce(sum(C),0) as '00-DA', coalesce(sum(D),0) as '00-DC', coalesce(sum(Q),0) as '01-DA', coalesce(sum(R),0) as '02-DA', coalesce(sum(S),0) as '03-DA', coalesce(sum(T),0) as '04-DA', coalesce(sum(U),0) as '01-DC', coalesce(sum(V),0) as '02-DC', coalesce(sum(W),0) as '03-DC', coalesce(sum(X),0) as '04-DC', (coalesce(sum(C),0))-(coalesce(sum(Q),0)) as '00-DA-UC', (coalesce(sum(Q),0)) - (coalesce(sum(R),0)) as '01-DA-UC', (coalesce(sum(R),0))-(coalesce(sum(S),0)) as '02-DA-UC', (coalesce(sum(S),0))-(coalesce(sum(T),0)) as '03-DA-UC', ((coalesce(sum(C),0))-(coalesce(sum(Q),0))) / coalesce(sum(Q),1) as '00-DA-PC', ((coalesce(sum(Q),0)) - (coalesce(sum(R),0))) / coalesce(sum(R),1) as '01-DA-PC', ((coalesce(sum(R),0))-(coalesce(sum(S),0))) / coalesce(sum(S),1) as '02-DA-PC', ((coalesce(sum(S),0))-(coalesce(sum(T),0))) / coalesce(sum(T),1) as '03-DA-PC', (coalesce(sum(D),0))-(coalesce(sum(U),0)) as '00-DC-UC', (coalesce(sum(U),0))-(coalesce(sum(V),0)) as '01-DC-UC', (coalesce(sum(V),0))-(coalesce(sum(W),0)) as '02-DC-UC', (coalesce(sum(W),0))-(coalesce(sum(X),0)) as '03-DC-UC', ((coalesce(sum(D),0))-(coalesce(sum(U),0))) / coalesce(sum(U),1) as '00-DC-PC', ((coalesce(sum(U),0))-(coalesce(sum(V),0))) / coalesce(sum(V),1) as '01-DC-PC', ((coalesce(sum(V),0))-(coalesce(sum(W),0))) / coalesce(sum(W),1) as '02-DC-PC', ((coalesce(sum(W),0))-(coalesce(sum(X),0))) / coalesce(sum(X),1) as '03-DC-PC', (coalesce(sum(C),0))/sum((coalesce(sum(C),0))) over ([..] partition by all) as '00-DA-PG', (coalesce(sum(Q),0))/sum((coalesce(sum(Q),0))) over ([..] partition by all) as '01-DA-PG', (coalesce(sum(R),0))/sum((coalesce(sum(R),0))) over ([..] partition by all) as '02-DA-PG', (coalesce(sum(S),0))/sum((coalesce(sum(S),0))) over ([..] partition by all) as '03-DA-PG', (coalesce(sum(T),0))/sum((coalesce(sum(T),0))) over ([..] partition by all) as '04-DA-PG';\nq = limit q 2000;","receiveFacetSource":{"mode":"include","steps":["FiscalYearToggle_5","Transaction_Date_Ran_9"]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#FFFFFF","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#FFFFFF","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"All_5_Year_Account_T_3":{"broadcastFacet":false,"groups":[],"label":"All 5 Year Cash Received Metrics","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by ('Record_Type.Name' != \"Soft Credit\" || 'Record_Type.Name' is null);\nq = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"current fiscal_year\"];\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq_C = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq_Q = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nq_R = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"];\nq_S = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"];\nq_T = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"];\nq_C = group q_C by ('Transaction.Name', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_C = foreach q_C generate q_C.'Transaction.Name' as 'Transaction.Name', q_C.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_C.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_Q = group q_Q by ('Transaction.Name', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_Q = foreach q_Q generate q_Q.'Transaction.Name' as 'Transaction.Name', q_Q.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_Q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_R = group q_R by ('Transaction.Name', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_R = foreach q_R generate q_R.'Transaction.Name' as 'Transaction.Name', q_R.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_R.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_S = group q_S by ('Transaction.Name', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_S = foreach q_S generate q_S.'Transaction.Name' as 'Transaction.Name', q_S.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_S.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_T = group q_T by ('Transaction.Name', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_T = foreach q_T generate q_T.'Transaction.Name' as 'Transaction.Name', q_T.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_T.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq = cogroup q by all full, q_C by all full, q_Q by all full, q_R by all full, q_S by all full, q_T by all;\nq = foreach q generate number_to_string(max(q.'Current_Fiscal_Year'),\"####\") as 'BE', number_to_string(max(q.'Current_Fiscal_Year')-1,\"####\") as 'BF', number_to_string(max(q.'Current_Fiscal_Year')-2,\"####\") as 'BG', number_to_string(max(q.'Current_Fiscal_Year')-3,\"####\") as 'BH', number_to_string(max(q.'Current_Fiscal_Year')-4,\"####\") as 'BI', sum(q_C.'Transaction.AQB__Amount__c') as 'C', sum(q_Q.'Transaction.AQB__Amount__c') as 'Q', sum(q_R.'Transaction.AQB__Amount__c') as 'R', sum(q_S.'Transaction.AQB__Amount__c') as 'S', sum(q_T.'Transaction.AQB__Amount__c') as 'T';\nq = group q by all;\nq = foreach q generate first(BE) as '00-YR', first(BF) as '01-YR', first(BG) as '02-YR', first(BH) as '03-YR', first(BI) as '04-YR', first(C) as '00-DA-DNU', first(Q) as '01-DA-DNU', first(R) as '02-DA-DNU', first(S) as '03-DA-DNU', first(T) as '04-DA-DNU', coalesce(sum(C),0) as '00-DA', coalesce(sum(Q),0) as '01-DA', coalesce(sum(R),0) as '02-DA', coalesce(sum(S),0) as '03-DA', coalesce(sum(T),0) as '04-DA', (coalesce(sum(C),0))-(coalesce(sum(Q),0)) as '00-DA-UC', (coalesce(sum(Q),0)) - (coalesce(sum(R),0)) as '01-DA-UC', (coalesce(sum(R),0))-(coalesce(sum(S),0)) as '02-DA-UC', (coalesce(sum(S),0))-(coalesce(sum(T),0)) as '03-DA-UC', ((coalesce(sum(C),0))-(coalesce(sum(Q),0))) / coalesce(sum(Q),1) as '00-DA-PC', ((coalesce(su