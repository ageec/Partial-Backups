,"numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"current fiscal_year\"];\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq_C = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq_Q = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nq_R = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"];\nq_S = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"];\nq_T = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"];\nq_D = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq_U = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nq_V = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"];\nq_W = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"];\nq_X = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"];\nq_C = group q_C by ('Transaction.Name', 'Transaction.ARCH_Classification__c', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_C = foreach q_C generate q_C.'Transaction.Name' as 'Transaction.Name', q_C.'Transaction.ARCH_Classification__c' as 'Transaction.ARCH_Classification__c', q_C.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_C.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_Q = group q_Q by ('Transaction.Name', 'Transaction.ARCH_Classification__c', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_Q = foreach q_Q generate q_Q.'Transaction.Name' as 'Transaction.Name', q_Q.'Transaction.ARCH_Classification__c' as 'Transaction.ARCH_Classification__c', q_Q.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_Q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_R = group q_R by ('Transaction.Name', 'Transaction.ARCH_Classification__c', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_R = foreach q_R generate q_R.'Transaction.Name' as 'Transaction.Name', q_R.'Transaction.ARCH_Classification__c' as 'Transaction.ARCH_Classification__c', q_R.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_R.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_S = group q_S by ('Transaction.Name', 'Transaction.ARCH_Classification__c', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_S = foreach q_S generate q_S.'Transaction.Name' as 'Transaction.Name', q_S.'Transaction.ARCH_Classification__c' as 'Transaction.ARCH_Classification__c', q_S.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_S.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_T = group q_T by ('Transaction.Name', 'Transaction.ARCH_Classification__c', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_T = foreach q_T generate q_T.'Transaction.Name' as 'Transaction.Name', q_T.'Transaction.ARCH_Classification__c' as 'Transaction.ARCH_Classification__c', q_T.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_T.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\n-- Added SAQL Start - ARCHRPTS-1490/1492\nq_D = group q_D by ('DonorID', 'Transaction.ARCH_Classification__c', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_D = foreach q_D generate q_D.'DonorID' as 'DonorID', q_D.'Transaction.ARCH_Classification__c' as 'Transaction.ARCH_Classification__c', q_D.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_D.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_D = filter q_D by 'Transaction.AQB__Amount__c' != 0;\nq_U = group q_U by ('DonorID', 'Transaction.ARCH_Classification__c', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_U = foreach q_U generate q_U.'DonorID' as 'DonorID', q_U.'Transaction.ARCH_Classification__c' as 'Transaction.ARCH_Classification__c', q_U.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_U.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_U = filter q_U by 'Transaction.AQB__Amount__c' != 0;\nq_V = group q_V by ('DonorID', 'Transaction.ARCH_Classification__c', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_V = foreach q_V generate q_V.'DonorID' as 'DonorID', q_V.'Transaction.ARCH_Classification__c' as 'Transaction.ARCH_Classification__c', q_V.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_V.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_V = filter q_V by 'Transaction.AQB__Amount__c' != 0;\nq_W = group q_W by ('DonorID', 'Transaction.ARCH_Classification__c', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_W = foreach q_W generate q_W.'DonorID' as 'DonorID', q_W.'Transaction.ARCH_Classification__c' as 'Transaction.ARCH_Classification__c', q_W.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_W.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_W = filter q_W by 'Transaction.AQB__Amount__c' != 0;\nq_X = group q_X by ('DonorID', 'Transaction.ARCH_Classification__c', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_X = foreach q_X generate q_X.'DonorID' as 'DonorID', q_X.'Transaction.ARCH_Classification__c' as 'Transaction.ARCH_Classification__c', q_X.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_X.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_X = filter q_X by 'Transaction.AQB__Amount__c' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1492\nq = cogroup q by 'Transaction.ARCH_Classification__c' full, q_C by 'Transaction.ARCH_Classification__c' full, q_Q by 'Transaction.ARCH_Classification__c' full, q_R by 'Transaction.ARCH_Classification__c' full, q_S by 'Transaction.ARCH_Classification__c' full, q_T by 'Transaction.ARCH_Classification__c' full, q_D by 'Transaction.ARCH_Classification__c' full, q_U by 'Transaction.ARCH_Classification__c' full, q_V by 'Transaction.ARCH_Classification__c' full, q_W by 'Transaction.ARCH_Classification__c' full, q_X by 'Transaction.ARCH_Classification__c';\nq = foreach q generate coalesce(q.'Transaction.ARCH_Classification__c', q_C.'Transaction.ARCH_Classification__c', q_Q.'Transaction.ARCH_Classification__c', q_R.'Transaction.ARCH_Classification__c', q_S.'Transaction.ARCH_Classification__c', q_T.'Transaction.ARCH_Classification__c', q_D.'Transaction.ARCH_Classification__c', q_U.'Transaction.ARCH_Classification__c', q_V.'Transaction.ARCH_Classification__c', q_W.'Transaction.ARCH_Classification__c', q_X.'Transaction.ARCH_Classification__c') as 'Transaction.ARCH_Classification__c', number_to_string(max(q.'Current_Fiscal_Year'),\"####\") as 'BE', num