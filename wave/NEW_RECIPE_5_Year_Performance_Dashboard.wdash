' == \"true\";\nq_J = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"] && 'Is_Transaction_Month' == \"true\" && 'FiscalYearToDate' == \"true\";\nq_K = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"] && 'Is_Transaction_Month' == \"true\" && 'FiscalYearToDate' == \"true\";\nq_L = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"] && 'Is_Transaction_Month' == \"true\" && 'FiscalYearToDate' == \"true\";\nq_C = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"] && 'FiscalYearToDate' == \"true\";\nq_BO = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq_BP = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nq_BQ = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"];\nq_BR = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"];\nq_BS = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"];\nq_Q = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"] && 'FiscalYearToDate' == \"true\";\nq_R = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"] && 'FiscalYearToDate' == \"true\";\nq_S = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"] && 'FiscalYearToDate' == \"true\";\nq_T = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"] && 'FiscalYearToDate' == \"true\";\nq_B = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"] && 'Is_Transaction_Month' == \"true\" && 'FiscalYearToDate' == \"true\";\nq_M = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"] && 'Is_Transaction_Month' == \"true\" && 'FiscalYearToDate' == \"true\";\nq_N = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"] && 'Is_Transaction_Month' == \"true\" && 'FiscalYearToDate' == \"true\";\nq_O = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"] && 'Is_Transaction_Month' == \"true\" && 'FiscalYearToDate' == \"true\";\nq_P = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"] && 'Is_Transaction_Month' == \"