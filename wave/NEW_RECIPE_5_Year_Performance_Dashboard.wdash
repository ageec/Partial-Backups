] && 'FiscalYearToDate' == \"true\";\nq_A = group q_A by 'Transaction.Name';\nq_A = foreach q_A generate q_A.'Transaction.Name' as 'Transaction.Name', avg(q_A.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_I = group q_I by 'Transaction.Name';\nq_I = foreach q_I generate q_I.'Transaction.Name' as 'Transaction.Name', avg(q_I.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_J = group q_J by 'Transaction.Name';\nq_J = foreach q_J generate q_J.'Transaction.Name' as 'Transaction.Name', avg(q_J.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_K = group q_K by 'Transaction.Name';\nq_K = foreach q_K generate q_K.'Transaction.Name' as 'Transaction.Name', avg(q_K.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_L = group q_L by 'Transaction.Name';\nq_L = foreach q_L generate q_L.'Transaction.Name' as 'Transaction.Name', avg(q_L.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_C = group q_C by 'Transaction.Name';\nq_C = foreach q_C generate q_C.'Transaction.Name' as 'Transaction.Name', avg(q_C.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_BO = group q_BO by 'Transaction.Name';\nq_BO = foreach q_BO generate q_BO.'Transaction.Name' as 'Transaction.Name', avg(q_BO.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_BP = group q_BP by 'Transaction.Name';\nq_BP = foreach q_BP generate q_BP.'Transaction.Name' as 'Transaction.Name', avg(q_BP.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_BQ = group q_BQ by 'Transaction.Name';\nq_BQ = foreach q_BQ generate q_BQ.'Transaction.Name' as 'Transaction.Name', avg(q_BQ.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_BR = group q_BR by 'Transaction.Name';\nq_BR = foreach q_BR generate q_BR.'Transaction.Name' as 'Transaction.Name', avg(q_BR.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_BS = group q_BS by 'Transaction.Name';\nq_BS = foreach q_BS generate q_BS.'Transaction.Name' as 'Transaction.Name', avg(q_BS.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_Q = group q_Q by 'Transaction.Name';\nq_Q = foreach q_Q generate q_Q.'Transaction.Name' as 'Transaction.Name', avg(q_Q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_R = group q_R by 'Transaction.Name';\nq_R = foreach q_R generate q_R.'Transaction.Name' as 'Transaction.Name', avg(q_R.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_S = group q_S by 'Transaction.Name';\nq_S = foreach q_S generate q_S.'Transaction.Name' as 'Transaction.Name', avg(q_S.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_T = group q_T by 'Transaction.Name';\nq_T = foreach q_T generate q_T.'Transaction.Name' as 'Transaction.Name', avg(q_T.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\n-- Added SAQL Start - ARCHRPTS-1490/1493\nq_B = group q_B by 'DonorID';\nq_B = foreach q_B generate q_B.'DonorID' as 'DonorID', sum(q_B.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_B = filter q_B by 'Transaction.AQB__Amount__c' != 0;\nq_M = group q_M by 'DonorID';\nq_M = foreach q_M generate q_M.'DonorID' as 'DonorID', sum(q_M.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_M = filter q_M by 'Transaction.AQB__Amount__c' != 0;\nq_N = group q_N by 'DonorID';\nq_N = foreach q_N generate q_N.'DonorID' as 'DonorID', sum(q_N.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_N = filter q_N by 'Transaction.AQB__Amount__c' != 0;\nq_O = group q_O by 'DonorID';\nq_O = foreach q_O generate q_O.'DonorID' as 'DonorID', sum(q_O.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_O = filter q_O by 'Transaction.AQB__Amount__c' != 0;\nq_P = group q_P by 'DonorID';\nq_P = foreach q_P generate q_P.'DonorID' as 'DonorID', sum(q_P.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_P = filter q_P by 'Transaction.AQB__Amount__c' != 0;\nq_D = group q_D by 'DonorID';\nq_D = foreach q_D generate q_D.'DonorID' as 'DonorID', sum(q_D.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_D = filter q_D by 'Transaction.AQB__Amount__c' != 0;\nq_BJ = group q_BJ by 'DonorID';\nq_BJ = foreach q_BJ generate q_BJ.'DonorID' as 'DonorID', sum(q_BJ.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_BJ = filter q_BJ by 'Transaction.AQB__Amount__c' != 0;\nq_BK = group q_BK by 'DonorID';\nq_BK = foreach q_BK generate q_BK.'DonorID' as 'DonorID', sum(q_BK.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_BK = filter q_BK by 'Transaction.AQB__Amount__c' != 0;\nq_BL = group q_BL by 'DonorID';\nq_BL = foreach q_BL generate q_BL.'DonorID' as 'DonorID', sum(q_BL.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_BL = filter q_BL by 'Transaction.AQB__Amount__c' != 0;\nq_BM = group q_BM by 'DonorID';\nq_BM = foreach q_BM generate q_BM.'DonorID' as 'DonorID', sum(q_BM.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_BM = filter q_BM by 'Transaction.AQB__Amount__c' != 0;\nq_BN = group q_BN by 'DonorID';\nq_BN = foreach q_BN generate q_BN.'DonorID' as 'DonorID', sum(q_BN.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_BN = filter q_BN by 'Transaction.AQB__Amount__c' != 0;\nq_U = group q_U by 'DonorID';\nq_U = foreach q_U generate q_U.'DonorID' as 'DonorID', sum(q_U.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_U = filter q_U by 'Transaction.AQB__Amount__c' != 0;\nq_V = group q_V by 'DonorID';\nq_V = foreach q_V generate q_V.'DonorID' as 'DonorID', sum(q_V.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_V = filter q_V by 'Transaction.AQB__Amount__c' != 0;\nq_W = group q_W by 'DonorID';\nq_W = foreach q_W generate q_W.'DonorID' as 'DonorID', sum(q_W.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_W = filter q_W by 'Transaction.AQB__Amount__c' != 0;\nq_X = group q_X by 'DonorID';\nq_X = foreach q_X generate q_X.'DonorID' as 'DonorID', sum(q_X.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_X = filter q_X by 'Transaction.AQB__Amount__c' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1493\nq = cogroup q by all full, q_A by all full, q_I by all full, q_J by all full, q_K by all full, q_L by all full, q_C by all full, q_BO by all full, q_BP by all full, q_BQ by all full, q_BR by all full, q_BS by all full, q_Q by all full, q_R by all full, q_S by all full, q_T by all full, q_B by all full, q_M by all full, q_N by all full, q_O by all full, q_P by all full, q_D by all full, q_BJ by all full, q_BK by all full, q_BL by all full, q_BM by all full, q_BN by all full, q_U by all full, q_V by all full, q_W by all full, q_X by all;\nq = foreach q generate number_to_string(max(q.'Current_Fiscal_Year'),\"####\") as 'BE', number_to_string(max(q.'Current_Fiscal_Year')-1,\"####\") as 'BF', number_to_string(max(q.'Current_Fiscal_Year')-2,\"####\") as 'BG', number_to_string(max(q.'Current_Fiscal_Year')-3,\"####\") as 'BH', number_to_string(max(q.'Current_Fiscal_Year')-4,\"####\") as 'BI', sum(q_A.'Transaction.AQB__Amount__c') as 'A', sum(q_I.'Transaction.AQB__Amount__c') as 'I', sum(q_J.'Transaction.AQB__Amount__c') as 'J', sum(q_K.'Transaction.AQB__Amount__c') as 'K', sum(q_L.'Transaction.AQB__Amount__c') as 'L', sum(q_C.'Transaction.AQB__Amount__c') as 'C', sum(q_BO.'Transaction.AQB__Amount__c') as 'BO', sum(q_BP.'Transaction.AQB__Amount__c') as 'BP', sum(q_BQ.'Transaction.AQB__Amount__c') as 'BQ', sum(q_BR.'Transaction.AQB__Amount__c') as 'BR', sum(q_BS.'Transaction.AQB__Amount__c') as 'BS', sum(q_Q.'Transaction.AQB__Amount__c') as 'Q', sum(q_R.'Transaction.AQB__Amount__c') as 'R', sum(q_S.'Transaction.AQB__Amount__c') as 'S', sum(q_T.'Transaction.AQB__Amount__c') as 'T', unique(q_B.'DonorID') as 'B', unique(q_M.'DonorID') as 'M', unique(q_N.'DonorID') as 'N', unique(q_O.'DonorID') as 'O', unique(q_P.'DonorID') as 'P', unique(q_D.'DonorID') as 'D', unique(q_BJ.'DonorID') as 'BJ', unique(q_BK.'DonorID') as 'BK', unique(q_BL.'DonorID') as 'BL', unique(q_BM.'DonorID') as 'BM', unique(q_BN.'DonorID') as 'BN', unique(q_U.'DonorID') as 'U', unique(q_V.'DonorID') as 'V', unique(q_W.'DonorID') as 'W', unique(q_X.'DonorID') as 'X';\nq = foreach q generate 'BE' as '00-YR', 'BF' as '01-YR', 'BG' as '02-YR', 'BH' as '03-YR', 'BI' as '04-YR', 'A' as '00-MTD-DA-DNU', 'I' as '01-MTD-DA-DNU', 'J' as '02-MTD-DA-DNU', 'K' as '03-MTD-DA-DNU', 'L' as '04-MTD-DA-DNU', 'C' as '00-YTD-DA-DNU', 'BO' as '00-YOY-DA-DNU', 'BP' as '01-YOY-DA-DNU', 'BQ' as '02-YOY-DA-DNU', 'BR' as '03-YOY-DA-DNU', 'BS' as '04-YOY-DA-DNU', 'Q' as '01-YTD-DA-DNU', 'R' as '02-YTD-DA-DNU', 'S' as '03-YTD-DA-DNU', 'T' as '04-YTD-DA-DNU', 'B' as '00-MTD-DC-DNU', 'M' as '01-MTD-DC-DNU', 'N' as '02-MTD-DC-DNU', 'O' as '03-MTD-DC-DNU', 'P' as '04-MTD-DC-DNU', 'D' as '00-YTD-DC-DNU', 'BJ' as '00-YOY-DC-DNU', 'BK' as '01-YOY-DC-DNU', 'BL' as '02-YOY-DC-DNU', 'BM' as '03-YOY-DC-DNU', 'BN' as '04-YOY-DC-DNU', 'U' as '01-YTD-DC-DNU', 'V' as '02-YTD-DC-DNU', 'W' as '03-YTD-DC-DNU', 'X' as '04-YTD-DC-DNU', coalesce(A,0) as '00-MTD-DA', coalesce(B,0) as '00-MTD-DC', coalesce(C,0) as '00-YTD-DA', coalesce(D,0) as '00-YTD-DC', coalesce(I,0) as '01-MTD-DA', coalesce(J,0) as '02-MTD-DA', coalesce(K,0) as '03-MTD-DA', coalesce(L,0) as '04-MTD-DA', coalesce(M,0) as '01-MTD-DC', coalesce(N,0) as '02-MTD-DC', coalesce(O,0) as '03-MTD-DC', coalesce(P,0) as '04-MTD-DC', coalesce(Q,0) as '01-YTD-DA', coalesce(R,0) as '02-YTD-DA', coalesce(S,0) as '03-YTD-DA', coalesce(T,0) as '04-YTD-DA', coalesce(U,0) as '01-YTD-DC', coalesce(V,0) as '02-YTD-DC', coalesce(W,0) as '03-YTD-DC', coalesce(X,0) as '04-YTD-DC', (coalesce(C,0))-(coalesce(Q,0)) as '00-YTD-DA-UC', (coalesce(Q,0)) - (coalesce(R,0)) as '01-YTD-DA-UC', (coalesce(R,0))-(coalesce(S,0)) as '02-YTD-DA-UC', (coalesce(S,0))-(coalesce(T,0)) as '03-YTD-DA-UC', ((coalesce(C,0))-(coalesce(Q,0))) / coalesce(Q,1) as '00-YTD-DA-PC', ((coalesce(Q,0)) - (coalesce(R,0))) / coalesce(R,1) as '01-YTD-DA-PC', ((coalesce(R,0))-(coalesce(S,0))) / coalesce(S,1) as '02-YTD-DA-PC', ((coalesce(S,0))-(coalesce(T,0))) / coalesce(T,1) as '03-YTD-DA-PC', (coalesce(D,0))-(coalesce(U,0)) as '00-YTD-DC-UC', (coalesce(U,0))-(coalesce(V,0)) as '01-YTD-DC-UC', (coalesce(V,0))-(coalesce(W,0)) as '02-YTD-DC-UC', (coalesce(W,0))-(coalesce(X,0)) as '03-YTD-DC-UC', ((coalesce(D,0))-(coalesce(U,0))) / coalesce(U,1) as '00-YTD-DC-PC', ((coalesce(U,0))-(coalesce(V,0))) / coalesce(V,1) as '01-YTD-DC-PC', ((coalesce(V,0))-(coalesce(W,0))) / coalesce(W,1) as '02-YTD-DC-PC', ((coalesce(W,0))-(coalesce(X,0))) / coalesce(X,1) as '03-YTD-DC-PC', coalesce(BO,0) as '00-YOY-DA', coalesce(BP,0) as '01-YOY-DA', coalesce(BQ,0) as '02-YOY-DA', coalesce(BR,0) as '03-YOY-DA', coalesce(BS,0) as '04-YOY-DA', coalesce(BJ,0) as '00-YOY-DC', coalesce(BK,0) as '01-YOY-DC', coalesce(BL,0) as '02-YOY-DC', coalesce(BM,0) as '03-YOY-DC', coalesce(BN,0) as '04-YOY-DC', (coalesce(BO,0))-(coalesce(BP,0)) as '00-YOY-DA-UC', (coalesce(BP,0))-(coalesce(BQ,0)) as '01-YOY-DA-UC', (coalesce(BQ,0))-(coalesce(BR,0)) as '02-YOY-DA-UC', (coalesce(BR,0))-(coalesce(BS,0)) as '03-YOY-DA-UC', ((coalesce(BO,0))-(coalesce(BP,0)))/(coalesce(BP,0)) as '00-YOY-DA-PC', ((coalesce(BP,0))-(coalesce(BQ,0)))/(coalesce(BQ,0)) as '01-YOY-DA-PC', ((coalesce(BQ,0))-(coalesce(BR,0)))/(coalesce(BR,0)) as '02-YOY-DA-PC', ((coalesce(BR,0))-(coalesce(BS,0)))/(coalesce(BS,0)) as '03-YOY-DA-PC', (coalesce(BJ,0))-(coalesce(BK,0)) as '00-YOY-DC-UC', (coalesce(BK,0))-(coalesce(BL,0)) as '01-YOY-DC-UC', (coalesce(BL,0))-(coalesce(BM,0)) as '02-YOY-DC-UC', (coalesce(BM,0))-(coalesce(BN,0)) as '03-YOY-DC-UC', ((coalesce(BJ,0))-(coalesce(BK,0)))/(coalesce(BK,0)) as '00-YOY-DC-PC', ((coalesce(BK,0))-(coalesce(BL,0)))/(coalesce(BL,0)) as '01-YOY-DC-PC', ((coalesce(BL,0))-(coalesce(BM,0)))/(coalesce(BM,0)) as '02-YOY-DC-PC', ((coalesce(BM,0))-(coalesce(BN,0)))/(coalesce(BN,0)) as '03-YOY-DC-PC', (coalesce(A,0))-(coalesce(I,0)) as '00-MTD-DA-UC', (coalesce(I,0))-(coalesce(J,0)) as '01-MTD-DA-UC', (coalesce(J,0))-(coalesce(K,0)) as '02-MTD-DA-UC', (coalesce(K,0))-(coalesce(L,0)) as '03-MTD-DA-UC', ((coalesce(A,0))-(coalesce(I,0)))/(coalesce(I,0)) as '00-MTD-DA-PC', ((coalesce(I,0))-(coalesce(J,0)))/(coalesce(J,0)) as '01-MTD-DA-PC', ((coalesce(J,0))-(coalesce(K,0)))/(coalesce(K,0)) as '02-MTD-DA-PC', ((coalesce(K,0))-(coalesce(L,0)))/(coalesce(L,0)) as '03-MTD-DA-PC', (coalesce(B,0))-(coalesce(M,0)) as '00-MTD-DC-UC', (coalesce(M,0))-(coalesce(N,0)) as '01-MTD-DC-UC', (coalesce(N,0))-(coalesce(O,0)) as '02-MTD-DC-UC', (coalesce(O,0))-(coalesce(P,0)) as '03-MTD-DC-UC', ((coalesce(B,0))-(coalesce(M,0)))/(coalesce(M,0)) as '00-MTD-DC-PC', ((coalesce(M,0))-(coalesce(N,0)))/(coalesce(N,0)) as '01-MTD-DC-PC', ((coalesce(N,0))-(coalesce(O,0)))/(coalesce(O,0)) as '02-MTD-DC-PC', ((coalesce(O,0))-(coalesce(P,0)))/(coalesce(P,0)) as '03-MTD-DC-PC';\nq = limit q 2000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#FFFFFF","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#FFFFFF","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Gift_Band_1":{"broadcastFacet":true,"groups":[],"label":"Annual Fund Gift Band","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by date('{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year', '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Month', '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Day') in [\"4 fiscal_years ago\"..\"current fiscal_year\"];\nq = filter q by 'Transaction.AQB__Type__c' in {{coalesce(cell(CR_NP_Dimension__1.selection, 0, \"FILTER\"), \"all\").asString()}};\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\n--Gift Band\nq_A = group q by ('Transaction.Name', 'AccountID', '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal');\nq_A = foreach q_A generate q_A.'Transaction.Name' as 'Transaction.Name', q_A.'AccountID' as 'AccountID', q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal' as '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal', avg(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') as '{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}';\nq_A = group q_A by ('AccountID', '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal');\nq_A = foreach q_A generate q_A.'AccountID' as 'AccountID', q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal' as 'Fiscal Year', sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') as 'Amount', case when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 5000000 then \"01 - $5M+\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 1000000 then \"02 - $1M - $4,999,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 500000 then \"03 - $500,000 - $999,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 250000 then \"04 - $250,000 - $499,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 100000 then \"05 - $100,000 - $249,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 50000 then \"06 - $50,000 - $99,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 25000 then \"07 - $25,000 - $49,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 10000 then \"08 - $10,000 - $24,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 5000 then \"09 - $5,000 - $9,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 2500 then \"10 - $2,500 - $4,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 1000 then \"11 - $1,000 - $2,499\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 500 then \"12 - $500 - $999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 250 then \"13 - $250 - $499\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 100 then \"14 - $100 - $249\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 0 then \"15 - $0 - $99\" end as 'Group';\n-- Added SAQL Start - ARCHRPTS-1490/1492\nq_A = filter q_A by 'Amount' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1492\nq_A = filter q_A by 'Group' is not null;\nq_A = group q_A by ('Group', 'Fiscal Year');\nq_A = foreach q_A generate q_A.'Group' as 'Group', q_A.'Fiscal Year' as 'Fiscal Year', unique(q_A.'AccountID') as 'Donor Count', sum(q_A.'Amount') as 'Amount';\nq_A = order q_A by ('Group' asc, 'Fiscal Year' desc);\n--Account Type/Contact Type\nq_B = group q by ('Transaction.Name', 'AccountType', '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal');\nq_B = foreach q_B generate q_B.'Transaction.Name' as 'Transaction.Name', q_B.'AccountType' as 'AccountType', q_B.'{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal' as '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal', avg(q_B.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') as '{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}';\nq_C = group q by ('DonorID', 'AccountType', 'ContactType', '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal');\nq_C = foreach q_C generate q_C.'DonorID' as 'DonorID', coalesce(q_C.'ContactType', q_C.'AccountType') as 'AccountType', q_C.'{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal' as '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal', unique(q_C.'DonorID') as 'DonorCount', sum(q_C.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') as 'Amount';\n-- Added SAQL Start - ARCHRPTS-1490/1492\nq_C = filter q_C by 'Amount' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1492\nq_C = cogroup q_C by ('{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal', 'AccountType') full, q_B by ('{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal', 'AccountType');\nq_C = foreach q_C generate coalesce(q_B.'AccountType', q_C.'AccountType') as 'Group', coalesce(q_B.'{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal', q_C.'{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal') as 'Fiscal Year', sum(q_C.'DonorCount') as 'Donor Count', sum(q_B.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') as 'Amount';\n--Everything else\nq_D = group q by ('Transaction.Name', '{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}', '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal');\nq_D = foreach q_D generate q_D.'Transaction.Name' as 'Transaction.Name', q_D.'{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}' as '{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}', q_D.'{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal' as '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal', avg(q_D.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') as '{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}';\n-- Added SAQL Start - ARCHRPTS-1490/1492\nq_E = group q by ('DonorID', '{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}', '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal');\nq_E = foreach q_E generate q_E.'DonorID' as 'DonorID', q_E.'{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}' as '{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}', q_E.'{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal' as '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal', sum(q_E.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') as 'Amount';\nq_E = filter q_E by 'Amount' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1492\nq = cogroup q_E by ('{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal', '{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}') full, q_D by ('{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal', '{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}');\nq = foreach q generate coalesce(q_D.'{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}', q_E.'{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}') as 'Group', coalesce(q_D.'{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal', q_E.'{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal') as 'Fiscal Year', unique(q_E.'DonorID') as 'Donor Count',  sum(q_D.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') as 'Amount';\nq = order q by ('Group' asc, 'Fiscal Year' desc);\nq = limit {{cell(Dynamic_Dimension_Bi_1.selection, 0, \"LIMIT\").asString()}} 25000;","receiveFacetSource":{"mode":"include","steps":["Transaction_Date_Ran_4","Dynamic_Dimension_Bi_1"]},"selectMode":"multi","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"