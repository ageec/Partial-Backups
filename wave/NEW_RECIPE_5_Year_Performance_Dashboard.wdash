RCHCreditedFiscalYearDate_Year_Fiscal');\nq_C = foreach q_C generate q_C.'Transaction.Name' as 'Transaction.Name', q_C.'AccountType' as 'AccountType', q_C.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_C.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_Q = group q_Q by ('Transaction.Name', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_Q = foreach q_Q generate q_Q.'Transaction.Name' as 'Transaction.Name', q_Q.'AccountType' as 'AccountType', q_Q.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_Q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_R = group q_R by ('Transaction.Name', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_R = foreach q_R generate q_R.'Transaction.Name' as 'Transaction.Name', q_R.'AccountType' as 'AccountType', q_R.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_R.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_S = group q_S by ('Transaction.Name', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_S = foreach q_S generate q_S.'Transaction.Name' as 'Transaction.Name', q_S.'AccountType' as 'AccountType', q_S.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_S.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_T = group q_T by ('Transaction.Name', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_T = foreach q_T generate q_T.'Transaction.Name' as 'Transaction.Name', q_T.'AccountType' as 'AccountType', q_T.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_T.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\n-- Added SAQL Start - ARCHRPTS-1490/1492\nq_D = group q_D by ('DonorID', 'ContactType', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_D = foreach q_D generate q_D.'DonorID' as 'DonorID', coale