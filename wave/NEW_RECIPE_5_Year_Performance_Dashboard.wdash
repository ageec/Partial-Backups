sc, 'ARCHCreditedFiscalYearDate_Year_Fiscal' desc);\n--q = limit q 2000;\n-- Added SAQL Start - ARCHRPTS-1490/1492\nq = group q by ('ARCHCreditedFiscalYearDate_Year_Fiscal', 'DonorID', 'Campaign_Appeal.Type');\nq = foreach q generate q.'DonorID' as 'DonorID', q.'Campaign_Appeal.Type' as 'Campaign_Appeal.Type', q.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', unique(q.'DonorID') as 'A', sum('Transaction.AQB__Amount__c') as 'B';\nq = filter q by 'B' != 0;\nq = group q by ('ARCHCreditedFiscalYearDate_Year_Fiscal', 'Campaign_Appeal.Type');\nq = foreach q generate q.'Campaign_Appeal.Type' as 'Campaign_Appeal.Type', q.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q.'A') as 'Donor Count';\nq = order q by ('Campaign_Appeal.Type', 'ARCHCreditedFiscalYearDate_Year_Fiscal' desc);\nq = limit q 2000;\n-- Added SAQL End - ARCHRPTS-1490/1492","receiveFacetSource":{"mode":"include","steps":["FiscalYearToggle_2","Transaction_Date_Ran_5"]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":true,"showHeader":false,"show":true,"customSize":"auto","position":"bottom-center","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"Donor Count by Appeal Channel","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"