, 'ARCHCreditedFiscalYearDate_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"];\nq_J = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"];\nq_K = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq_L = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nq_M = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"];\nq_N = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"];\nq_O = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"];\nq_P = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq_Q = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nq_R = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"];\nq_S = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"];\nq_T = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"];\nq_A = group q_A by 'Transaction.Name';\nq_A = foreach q_A generate q_A.'Transaction.Name' as 'Transaction.Name', avg(q_A.'NewProductionCashAmount') as 'NewProductionCashAmount';\nq_G = group q_G by 'Transaction.Name';\nq_G = foreach q_G generate q_G.'Transaction.Name' as 'Transaction.Name', avg(q_G.'NewProductionCashAmount') as 'NewProductionCashAmount';\nq_H = group q_H by 'Transaction.Name';\nq_H = foreach q_H generate q_H.'Transaction.Name' as 'Transaction.Name', avg(q_H.'NewProductionCashAmount') as 'NewProductionCashAmount';\nq_I = group q_I by 'Transaction.Name';\nq_I = foreach q_I generate q_I.'Transaction.Name' as 'Transaction.Name', avg(q_I.'NewProductionCashAmount') as 'NewProductionCashAmount';\nq_J = group q_J by 'Transaction.Name';\nq_J = foreach q_J generate q_J.'Transaction.Name' as 'Transaction.Name', avg(q_J.'NewProductionCashAmount') as 'NewProductionCashAmount';\nq_K = group q_K by 'Transaction.Name';\nq_K = foreach q_K generate q_K.'Transaction.Name' as 'Transaction.Name', avg(q_K.'NewProductionAmountWithoutBequests') as 'NewProductionAmountWithoutBequests';\nq_L = group q_L by 'Transaction.Name';\nq_L = foreach q_L generate q_L.'Transaction.Name' as 'Transaction.Name', avg(q_L.'NewProductionAmountWithoutBequests') as 'NewProductionAmountWithoutBequests';\nq_M = group q_M by 'Transaction.Name';\nq_M = foreach q_M generate q_M.'Transaction.Name' as 'Transaction.Name', avg(q_M.'NewProductionAmountWithoutBequests') as 'NewProductionAmountWithoutBequests';\nq_N = group q_N by 'Transaction.Name';\nq_N = foreach q_N generate q_N.'Transaction.Name' as 'Transaction.Name', avg(q_N.'NewProductionAmountWithoutBequests') as 'NewProductionAmountWithoutBequests';\nq_O = group q_O by 'Transaction.Name';\nq_O = foreach q_O generate q_O.'Transaction.Name' as 'Transaction.Name', avg(q_O.'NewProductionAmountWithoutBequests') as 'NewProductionAmountWithoutBequests';\nq_P = group q_P by 'Transaction.Name';\nq_P = foreach q_P generate q_P.'Transaction.Name' as 'Transaction.Name', avg(q_P.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests';\nq_Q = group q_Q by 'Transaction.Name';\nq_Q = foreach q_Q generate q_Q.'Transaction.Name' as 'Transaction.Name', avg(q_Q.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests';\nq_R = group q_R by 'Transaction.Name';\nq_R = foreach q_R generate q_R.'Transaction.Name' as 'Transaction.Name', avg(q_R.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests';\nq_S = group q_S by 'Transaction.Name';\nq_S = foreach q_S generate q_S.'Transaction.Name' as 'Transaction.Name', avg(q_S.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests';\nq_T = group q_T by 'Transaction.Name';\nq_T = foreach q_T generate q_T.'Transaction.Name' as 'Transaction.Name', avg(q_T.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests';\nq = cogroup q by all full, q_A by all full, q_G by all full, q_H by all full, q_I by all full, q_J by all full, q_K by all full, q_L by all full, q_M by all full, q_N by all full, q_O by all full, q_P by all full, q_Q by all full, q_R by all full, q_S by all full, q_T by all;\nq = foreach q generate number_to_string(max(q.'Current_Fiscal_Year'), \"####\") as 'B', number_to_string(max(q.'Current_Fiscal_Year')-1, \"####\") as 'C', number_to_string(max(q.'Current_Fiscal_Year')-2, \"####\") as 'D', number_to_string(max(q.'Current_Fiscal_Year')-3, \"####\") as 'E', number_to_string(max(q.'Current_Fiscal_Year')-4, \"####\") as 'F', sum(q_A.'NewProductionCashAmount') as 'A', sum(q_G.'NewProductionCashAmount') as 'G', sum(q_H.'NewProductionCashAmount') as 'H', sum(q_I.'NewProductionCashAmount') as 'I', sum(q_J.'NewProductionCashAmount') as 'J', sum(q_K.'NewProductionAmountWithoutBequests') as 'K', sum(q_L.'NewProductionAmountWithoutBequests') as 'L', sum(q_M.'NewProductionAmountWithoutBequests') as 'M', sum(q_N.'NewProductionAmountWithoutBequests') as 'N', sum(q_O.'NewProductionAmountWithoutBequests') as 'O', sum(q_P.'NewProductionAmountWithBequests') as 'P', sum(q_Q.'NewProductionAmountWithBequests') as 'Q', sum(q_R.'NewProductionAmountWithBequests') as 'R', sum(q_S.'NewProductionAmountWithBequests') as 'S', sum(q_T.'NewProductionAmountWithBequests') as 'T';\nq = foreach q generate 'B' as '00-YEAR', 'C' as '01-YEAR', 'D' as '02-YEAR', 'E' as '03-YEAR', 'F' as '04-YEAR', 'A' as '00-CASH', 'G' as '01-CASH', 'H' as '02-CASH', 'I' as '03-CASH', 'J' as '04-CASH', 'K' as '00-WO BEQ', 'L' as '01-WO BEQ', 'M' as '02-WO BEQ', 'N' as '03-WO BEQ', 'O' as '04-WO BEQ', 'P' as '00-W BEQ', 'Q' as '01-W BEQ', 'R' as '02-W BEQ', 'S' as '03-W BEQ', 'T' as '04-W BEQ', A-G as '00-CASH-UC', G-H as '01-CASH-UC', H-I as '02-CASH-UC', I-J as '03-CASH-UC', (A-G)/A as '00-CASH-PC', (G-H)/G as '01-CASH-PC', (H-I)/H as '02-CASH-PC', (I-J)/I as '03-CASH-PC', K-L as '00-WO BEQ-UC', L-M as '01-WO BEQ-UC', M-N as '02-WO BEQ-UC', N-O as '03-WO BEQ-UC', (K-L)/K as '00-WO BEQ-PC', (L-M)/L as '01-WO BEQ-PC', (M-N)/M as '02-WO BEQ-PC', (N-O)/N as '03-WO BEQ-PC', P-Q as '00-W BEQ-UC', Q-R as '01-W BEQ-UC', R-S as '02-W BEQ-UC', S-T as '03-W BEQ-UC', (P-Q)/P as '00-W BEQ-PC', (Q-R)/Q as '01-W BEQ-PC', (R-S)/R as '02-W BEQ-PC', (S-T)/S as '03-W BEQ-PC';\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#FFFFFF","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#FFFFFF","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"showActionMenu":true,"totals":true,"verti