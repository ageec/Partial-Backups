nd'\"}","{\"Display\":\"Designation Primary Purpose Type\",\"API\":\", 'COA.AQC_PrimaryPurposeType__c'\",\"APILabel\":\", q.'COA.AQC_PrimaryPurposeType__c' as 'Designation Primary Purpose Type'\"}","{\"Display\":\"Designation Primary Purpose\",\"API\":\", 'COA.AQC_Primary_Purpose__c'\",\"APILabel\":\", q.'COA.AQC_Primary_Purpose__c' as 'Designation Primary Purpose'\"}","{\"Display\":\"Designation Alternate Purpose\",\"API\":\", 'COA.AQC_Alternate_Purpose__c'\",\"APILabel\":\", q.'COA.AQC_Alternate_Purpose__c' as 'Designation Alternate Purpose'\"}","{\"Display\":\"Designation School/Unit\",\"API\":\", 'COA.AQB__SchoolUnit__c'\",\"APILabel\":\", q.'COA.AQB__SchoolUnit__c' as 'Designation School/Unit'\"}","{\"Display\":\"Designation Department\",\"API\":\", 'COA.AQB__Department__c'\",\"APILabel\":\", q.'COA.AQB__Department__c' as 'Designation Department'\"}","{\"Display\":\"Designation Division\",\"API\":\", 'COA.ARCH_Division__c'\",\"APILabel\":\", q.'COA.ARCH_Division__c' as 'Designation Division'\"}","{\"Display\":\"FFR Owner ID\",\"API\":\", 'COA.ARCH_Workday_FFR_Owner_ID__c'\",\"APILabel\":\", q.'COA.ARCH_Workday_FFR_Owner_ID__c' as 'FFR Owner ID'\"}","{\"Display\":\"FFR Owner Name\",\"API\":\", 'COA.ARCH_Workday_FFR_Owner__c'\",\"APILabel\":\", q.'COA.ARCH_Workday_FFR_Owner__c' as 'FFR Owner Name'\"}","{\"Display\":\"Related to Cancer\",\"API\":\", 'COA.ARCH_RelatedtoCancer__c'\",\"APILabel\":\", q.'COA.ARCH_RelatedtoCancer__c' as 'Related to Cancer'\"}"]},"NP_FY_Detail_Table_1":{"broadcastFacet":true,"groups":[],"label":"NP FY Detail Table","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by date('NewProductionARCHCreditedFiscalYearDate_Year', 'NewProductionARCHCreditedFiscalYearDate_Month', 'NewProductionARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"current day\"];\nq = filter q by 'Contact.Position' == 1;\nq = filter q by 'SoftCreditTransaction.Contact.ContactRowNumber' <= 1;\ns = group q by all;\ns = foreach s generate sum(q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c_total', sum(q.'NewProductionCashAmount') as 'NewProductionCashAmount_total', sum(q.'NewProductionAmountWithoutBequests') as 'NewProductionAmountWithoutBequests_total', sum(q.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests_total';\nq = foreach q generate 'NewProductionARCHCreditedFiscalYearDate_Year_Fiscal', q.'ARCHAccountID' as 'ARCHAccountID', q.'AccountName' as 'AccountName', q.'Transaction.Name' as 'Transaction.Name', q.'Transaction.AQB__Amount__c' as 'Transaction.AQB__Amount__c', q.'NewProductionCashAmount' as 'NewProductionCashAmount', q.'NewProductionAmountWithoutBequests' as 'NewProductionAmountWithoutBequests', q.'NewProductionAmountWithBequests' as 'NewProductionAmountWithBequests', q.'Transaction.AQB__Type__c' as 'Transaction.AQB__Type__c', q.'Name' as 'Name', q.'Record_Type.Name' as 'Record_Type.Name', q.'ARCHCreditedFiscalYearDate' as 'ARCHCreditedFiscalYearDate', q.'COA.Name' as 'COA.Name', q.'COA.ARCH_Primary_Reporting_Value__c' as 'COA.ARCH_Primary_Reporting_Value__c'{{coalesce(join(column(New_Production_Detai_2.selection, [\"APILabel\"]),''),'').asString()}}, q.'COA.Id' as 'COA.Id', q.'Transaction.Id' as 'Transaction.Id', q.'Id' as 'Id', q.'AccountID' as 'AccountID';\nq = order q by ('NewProductionARCHCreditedFiscalYearDate_Year_Fiscal' desc, 'ARCHAccountID');\nq = limit q 300000;\nq = union q, s;\nq = limit q 300001;","receiveFacetSource":{"mode":"include","steps":["NP_FY_Detail_Toggle_1","NP_FY_Summary_Table_1"]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","showActionMenu":true,"showRowIndexColumn":true,"totals":true,"verticalPadding":8},"type":"table"}}},"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#747474","borderEdges":[],"borderRadius":0,"borderWidth":1,"tooltipStyle":{"backgroundColor":"#16325c","labelColor":"#9faab5","valueColor":"#ffffff"}},"widgets":{"link_18":{"parameters":{"destinationLink":{"tooltipMode":"default","url":"https://gowustl.sharepoint.com/:v:/r/sites/UA_ARCH/Shared%20Documents/Data%20Resources/5%20Year%20Standardization%20Updates.mp4"},"destinationType":"url","fontSize":14,"includeState":false,"text":"Overview Video","textAlignment":"left","textColor":"#0070D2"},"type":"link"},"link_19":{"parameters":{"destinationLink":{"tooltipMode":"default","url":"https://washu.lightning.force.com/lightning/r/Knowledge__kav/ka0PH0000000USjYAM/view"},"destinationType":"url","fontSize":14,"includeState":false,"text":"Knowledge Article","textAlignment":"left","textColor":"#0070D2"},"type":"link"},"text_18":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ffffff","size":"16px"},"insert":"Total Cash Received"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"link_16":{"parameters":{"destinationLink":{"tooltipMode":"default","url":"https://washu.lightning.force.com/lightning/r/Knowledge__kav/ka0PH0000000USjYAM/view"},"destinationType":"url","fontSize":14,"includeState":false,"text":"Knowledge Article","textAlignment":"left","textColor":"#0070D2"},"type":"link"},"text_17":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px"},"insert":"*The August 2024 $335M commitment and payments from BJC Healthcare are "},{"attributes":{"size":"14px","underline":true,"bold":true},"insert":"excluded"},{"attributes":{"size":"14px"},"insert":" from the 5 Year Performance Dashboard."},{"attributes":{"align":"left"},"insert":"\n"},{"attributes":{"size":"14px","color":"#020821"},"insert":"This tab shows tabular data with 5 fiscal years of new business giving amount and donor counts by Cash Received, New Production with Bequest and without Bequest. Cash Received is the total outright gifts plus all commitment payments (pledges, planned gifts, grants). New Production Cash Total is all outright gifts, including Life Income Gifts, in the fiscal year plus all commitment payments (pledges, planned gifts, grants) on commitments made the same fiscal year. New Production Total (Excluding Bequests), includes pledge commitments made in the fiscal year in addition to all gifts included in the New Production Cash Total. New Production (Including Bequests), includes bequest commitments in addition to all gifts included in the New Production (Excluding Bequests). "},{"attributes":{"size":"14px"},"insert":"Questions? Submit a case or reach out to "},{"attributes":{"size":"14px","color":"#1868db","underline":true},"insert":"askarch@wustl.edu"},{"attributes":{"size":"14px"},"insert":"."},{"attributes":{"align":"left"},"insert":"\n\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"link_17":{"parameters":{"destinationLink":{"tooltipMode":"default","url":"https://gowustl.sharepoint.com/:b:/r/sites/UA_ARCH/Shared%20Documents/Reference%20Guides/5%20Year%20Performance%20Reference%20Guide%20v2.pdf"},"destinationType":"url","fontSize":14,"includeState":false,"text":"Reference Guide","textAlignment":"left","textColor":"#0070D2"},"type":"link"},"container_14":{"parameters":{"alignmentX":"left","alignmentY":"top","fit":"original","interactions":[]},"type":"container"},"link_14":{"parameters":{"destinationLink":{"tooltipMode":"default","url":"https://gowustl.sharepoint.com/:b:/r/sites/UA_ARCH/Shared%20Documents/Reference%20Guides/5%20Year%20Performance%20Reference%20Guide%20v2.pdf"},"destinationType":"url","fontSize":14,"includeState":false,"text":"Reference Guide","textAlignment":"left","textColor":"#0070D2"},"type":"link"},"container_13":{"parameters":{"alignmentX":"left","alignmentY":"top","fit":"original","interactions":[]},"type":"container"},"text_19":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ba0c2f","size":"16px"},"insert":"Annual Fund Cash Received"},{"attributes":{"align":"center"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"link_15":{"parameters":{"destinationLink":{"tooltipMode":"default","url":"https://gowustl.sharepoint.com/:v:/r/sites/UA_ARCH/Shared%20Documents/Data%20Resources/5%20Year%20Standardization%20Updates.mp4"},"destinationType":"url","fontSize":14,"includeState":false,"text":"Overview Video","textAlignment":"left","textColor":"#0070D2"},"type":"link"},"link_12":{"parameters":{"destinationLink":{"tooltipMode":"default","url":"https://gowustl.sharepoint.com/:v:/r/sites/UA_ARCH/Shared%20Documents/Data%20Resources/5%20Year%20Standardization%20Updates.mp4"},"destinationType":"url","fontSize":14,"includeState":false,"text":"Overview Video","textAlignment":"left","textColor":"#0070D2"},"type":"link"},"text_13":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px"},"insert":"*The August 2024 $335M commitment and payments from BJC Healthcare are "},{"attributes":{"size":"14px","underline":true,"bold":true},"insert":"excluded"},{"attributes":{"size":"14px"},"insert":" from the 5 Year Performance Dashboard."},{"attributes":{"align":"left"},"insert":"\n"},{"attributes":{"size":"14px"},"insert":"This tab shows donor counts and Cash Received by Donor Type with percentage changes compared to previous FYs. The amounts in Donor Type follow the Account Type for a donor, while the donor counts follow Contact Type for Household Accounts. Questions? Submit a case or reach out to "},{"attributes":{"size":"14px","color":"#1868db","underline":true},"insert":"askarch@wustl.edu"},{"attributes":{"size":"14px"},"insert":"."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"link_13":{"parameters":{"destinationLink":{"tooltipMode":"default","url":"https://washu.lightning.force.com/lightning/r/Knowledge__kav/ka0PH0000000USjYAM/view"},"destinationType":"url","fontSize":14,"includeState":false,"text":"Knowledge Article","textAlignment":"left","textColor":"#0070D2"},"type":"link"},"text_16":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px"},"insert":"*The August 2024 $335M commitment and payments from BJC Healthcare are "},{"attributes":{"size":"14px","underline":true,"bold":true},"insert":"excluded"},{"attributes":{"size":"14px"},"insert":" from the 5 Year Performance Dashboard."},{"attributes":{"align":"left"},"insert":"\n"},{"attributes":{"color":"#020821","size":"14px"},"insert":"This tab shows visualizations and tabular data with 5 fiscal years of giving amount (outright gifts and commitments payments) and donor counts segmented by Primary Purpose Types with changes/percentages in the amount and counts compared to previous FYs. Primary Purpose Types align with Workday Finance values and can be Facilities, Fellowship, Non-Scholarship Student Aid, Professorships, Research, Scholarships or Other. "},{"attributes":{"align":"left"},"insert":"\n"},{"attributes":{"size":"14px"},"insert":"Questions? Submit a case or reach out to "},{"attributes":{"color":"#1868db","size":"14px","underline":true},"insert":"askarch@wustl.edu"},{"attributes":{"size":"14px"},"insert":"."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"link_10":{"parameters":{"destinationLink":{"tooltipMode":"default","url":"https://washu.lightning.force.com/lightning/r/Knowledge__kav/ka0PH0000000USjYAM/view"},"destinationType":"url","fontSize":14,"includeState":false,"text":"Knowledge Arti