in":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"CFY_Cash_Received_5":{"broadcastFacet":false,"groups":[],"label":"CFY Cash Received","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by 'AnnualFund' == \"true\";\nq = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq = group q by 'Transaction.Name';\nq = foreach q generate q.'Transaction.Name' as 'Transaction.Name', avg(q.'Transaction.AQB__Amount__c') as 'Annual Fund Cash Received';\nq = group q by all;\nq = foreach q generate sum(q.'Annual Fund Cash Received') as 'Annual Fund Cash Received';\nq = limit q 1;","receiveFacetSource":{"mode":"include","steps":["Transaction_Date_Ran_3"]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#FFFFFF","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#FFFFFF","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Band_Detail_Table_1":{"broadcastFacet":false,"groups":[],"label":"Annual Fund Gift Band Detail Table","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by date('{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year', '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Month', '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Day') in [\"4 fiscal_years ago\"..\"current fiscal_year\"];\n-- Added SAQL Start - ARCHRPTS-1591\n--q = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq = filter q by 'Transaction.AQB__Type__c' in {{coalesce(cell(CR_NP_Dimension__1.selection, 0, \"FILTER\"), \"all\").asString()}};\n-- Added SAQL End - ARCHRPTS-1591\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq_A = group q by ('Transaction.Name', 'ARCHAccountID', 'AccountName', 'AccountID', 'PC.ARCH_Sort_Name__c', 'PrimaryGiftOfficerName', '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal');\nq_A = foreach q_A generate q_A.'Transaction.Name' as 'Transaction.Name', q_A.'ARCHAccountID' as 'ARCHAccountID', q_A.'AccountName' as 'AccountName', q_A.'AccountID' as 'AccountID', q_A.'PC.ARCH_Sort_Name__c' as 'PC.ARCH_Sort_Name__c', q_A.'PrimaryGiftOfficerName' as 'PrimaryGiftOfficerName', q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal' as '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal', avg(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') as '{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}';\nq_A = group q_A by ('ARCHAccountID', 'AccountName', 'AccountID', 'PC.ARCH_Sort_Name__c', 'PrimaryGiftOfficerName', '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal');\nq_A = foreach q_A generate q_A.'ARCHAccountID' as 'ARCHAccountID', q_A.'AccountName' as 'AccountName', q_A.'AccountID' as 'AccountID', q_A.'PC.ARCH_Sort_Name__c' as 'PC.ARCH_Sort_Name__c', q_A.'PrimaryGiftOfficerName' as 'PrimaryGiftOfficerName', q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal' as 'Fiscal Year', sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') as 'Amount', case when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 5000000 then \"01 - $5M+\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 1000000 then \"02 - $1M - $4,999,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 500000 then \"03 - $500,000 - $999,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 250000 then \"04 - $250,000 - $499,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 100000 then \"05 - $100,000 - $249,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 50000 then \"06 - $50,000 - $99,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 25000 then \"07 - $25,000 - $49,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 10000 then \"08 - $10,000 - $24,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 5000 then \"09 - $5,000 - $9,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 2500 then \"10 - $2,500 - $4,999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 1000 then \"11 - $1,000 - $2,499\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 500 then \"12 - $500 - $999\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 250 then \"13 - $250 - $499\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 100 then \"14 - $100 - $249\" when sum(q_A.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') >= 0 then \"15 - $0 - $99\" end as 'Group';\n-- Added SAQL Start - ARCHRPTS-1490/1493\nq_A = filter q_A by 'Amount' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1493\nq_A = filter q_A by 'Group' is not null;\nq_A = order q_A by ('PC.ARCH_Sort_Name__c' asc, 'Fiscal Year' desc);\nq_B = group q by ('Transaction.Name', '{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}', 'ARCHAccountID', 'AccountName', 'AccountID', 'PC.ARCH_Sort_Name__c', 'PrimaryGiftOfficerName', '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal');\nq_B = foreach q_B generate q_B.'Transaction.Name' as 'Transaction.Name', q_B.'{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}' as '{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}', q_B.'ARCHAccountID' as 'ARCHAccountID', q_B.'AccountName' as 'AccountName', q_B.'AccountID' as 'AccountID', q_B.'PC.ARCH_Sort_Name__c' as 'PC.ARCH_Sort_Name__c', q_B.'PrimaryGiftOfficerName' as 'PrimaryGiftOfficerName', q_B.'{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal' as '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal', avg(q_B.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') as '{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}';\nq = group q_B by ('{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}', 'ARCHAccountID', 'AccountName', 'AccountID', 'PC.ARCH_Sort_Name__c',  'PrimaryGiftOfficerName', '{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal');\nq = foreach q generate q_B.'ARCHAccountID' as 'ARCHAccountID', q_B.'AccountName' as 'AccountName', q_B.'AccountID' as 'AccountID', q_B.'PC.ARCH_Sort_Name__c' as 'PC.ARCH_Sort_Name__c', q_B.'PrimaryGiftOfficerName' as 'PrimaryGiftOfficerName', q_B.'{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}' as 'Group', q_B.'{{cell(CR_NP_Dimension__1.selection, 0, \"DATE\").asString()}}_Year_Fiscal' as 'Fiscal Year', sum(q_B.'{{cell(CR_NP_Dimension__1.selection, 0, \"API\").asString()}}') as 'Amount';\n-- Added SAQL Start - ARCHRPTS-1490/1493\nq = filter q by 'Amount' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1493\nq = order q by ('PC.ARCH_Sort_Name__c' asc, 'Fiscal Year' desc);\n{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"LIMIT2\").asString()}} = filter {{cell(Dynamic_Dimension_Bi_1.selection, 0, \"LIMIT2\").asString()}} by 'Group' in {{coalesce(column(Gift_Band_1.selection, [\"Group\"]), \"all\").asString()}};\n{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"LIMIT2\").asString()}} = filter {{cell(Dynamic_Dimension_Bi_1.selection, 0, \"LIMIT2\").asString()}} by 'Fiscal Year' in {{coalesce(column(Gift_Band_1.selection, [\"Fiscal Year\"]), \"all\").asString()}};\n{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"LIMIT2\").asString()}} = limit {{cell(Dynamic_Dimension_Bi_1.selection, 0, \"LIMIT2\").asString()}} 200000;","receiveFacetSource":{"mode":"include","steps":["Transaction_Date_Ran_4","Dynamic_Dimension_Bi_1","Gift_Band_1"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"lens_2_2":{"broadcastFacet":false,"groups":[],"label":"lens_2","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq = filter