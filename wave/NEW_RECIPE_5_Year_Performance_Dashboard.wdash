l_year\"..\"current fiscal_year\"];\nq_Q = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nq_R = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"];\nq_S = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"];\nq_T = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"];\nq_D = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq_U = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nq_V = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"];\nq_W = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"];\nq_X = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"];\nq_C = group q_C by ('Transaction.Name', 'Campaign_Appeal.Type', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_C = foreach q_C generate q_C.'Transaction.Name' as 'Transaction.Name', q_C.'Campaign_Appeal.Type' as 'Campaign_Appeal.Type', q_C.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_C.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_Q = group q_Q by ('Transaction.Name', 'Campaign_Appeal.Type', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_Q = foreach q_Q generate q_Q.'Transaction.Name' as 'Transaction.Name', q_Q.'Campaign_Appeal.Type' as 'Campaign_Appeal.Type', q_Q.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_Q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_R = group q_R by ('Transaction.Name', 'Campaign_Appeal.Type', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_R = foreach q_R generate q_R.'Transaction.Name' as 'Transaction.Name', q_R.'Campaign_Appeal.Type' as 'Campaign_Appeal.Type', q_R.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_R.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_S = group q_S by ('Transaction.Name', 'Campaign_Appeal.Type', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_S = foreach q_S generate q_S.'Transaction.Name' as 'Transaction.Name', q_S.'Campaign_Appeal.Type' as 'Campaign_Appeal.Type', q_S.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_S.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_T = group q_T by ('Transaction.Name', 'Campaign_Appeal.Type', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_T = foreach q_T generate q_T.'Transaction.Name' as 'Transaction.Name', q_T.'Campaign_Appeal.Type' as 'Campaign_Appeal.Type', q_T.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_T.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\n-- Added SAQL Start - ARCHRPTS-1490/1492\nq_D = group q_D by ('DonorID', 'Campaign_Appeal.Type', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_D = foreach q_D generate q_D.'DonorID' as 'DonorID', q_D.'Campaign_Appeal.Type' as 'Campaign_Appeal.Type', q_D.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_D.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_D = filter q_D by 'Transaction.AQB__Amount__c' != 0;\nq_U = group q_U by ('DonorID', 'Campaign_Appeal.Type', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_U = foreach q_U generate q_U.'DonorID' as 'DonorID', q_U.'Campaign_Appeal.Type' as 'Campaign_Appeal.Type', q_U.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_U.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_U = filter q_U by 'Transaction.AQB__Amount__c' != 0;\nq_V = group q_V by ('DonorID', 'Campaign_Appeal.Type', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_V = foreach q_V generate q_V.'DonorID' as 'DonorID', q_V.'Campaign_Appeal.Type' as 'Campaign_Appeal.Type', q_V.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_V.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_V = filter q_V by 'Transaction.AQB__Amount__c' != 0;\nq_W = group q_W by ('DonorID', 'Campaign_Appeal.Type', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_W = foreach q_W generate q_W.'DonorID' as 'DonorID', q_W.'Campaign_Appeal.Type' as 'Campaign_Appeal.Type', q_W.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_W.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_W = filter q_W by 'Transaction.AQB__Amount__c' != 0;\nq_X = group q_X by ('DonorID', 'Campaign_Appeal.Type', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_X = foreach q_X generate q_X.'DonorID' as 'DonorID', q_X.'Campaign_Appeal.Type' as 'Campaign_Appeal.Type', q_X.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_X.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_X = filter q_X by 'Transaction.AQB__Amount__c' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1492\nq = cogroup q by 'Campaign_Appeal.Type' full, q_C by 'Campaign_Appeal.Type' full, q_Q by 'Campaign_Appeal.Type' full, q_R by 'Campaign_Appeal.Type' full, q_S by 'Campaign_Appeal.Type' full, q_T by 'Campaign_Appeal.Type' full, q_D by 'Campaign_Appeal.Type' full, q_U by 'Campaign_Appeal.Type' full, q_V by 'Campaign_Appeal.Type' full, q_W by 'Campaign_Appeal.Type' full, q_X by 'Campaign_Appeal.Type';\nq = foreach q generate coalesce(q.'Campaign_Appeal.Type', q_C.'Campaign_Appeal.Type', q_Q.'Campaign_Appeal.Type', q_R.'Campaign_Appeal.Type', q_S.'Campaign_Appeal.Type', q_T.'Campaign_Appeal.Type', q_D.'Campaign_Appeal.Type', q_U.'Campaign_Appeal.Type', q_V.'Campaign_Appeal.Type', q_W.'Campaign_Appeal.Type', q_X.'Campaign_Appeal.Type') as 'Campaign_Appeal.Type', number_to_string(max(q.'Current_Fiscal_Year'),\"####\") as 'BE', number_to_string(max(q.'Current_Fiscal_Year')-1,\"####\") as 'BF', number_to_string(max(q.'Current_Fiscal_Year')-2,\"####\") as 'BG', number_to_string(max(q.'Current_Fiscal_Year')-3,\"####\") as 'BH', number_to_string(max(q.'Current_Fiscal_Year')-4,\"####\") as 'BI', sum(q_C.'Transaction.AQB__Amount__c') as 'C', sum(q_Q.'Transaction.AQB__Amount__c') as 'Q', sum(q_R.'Transaction.AQB__Amount__c') as 'R', sum(q_S.'Transaction.AQB__Amount__c') as 'S', sum(q_T.'Transaction.AQB__Amount__c') as 'T', unique(q_D.'DonorID') as 'D', unique(q_U.'DonorID') as 'U', unique(q_V.'DonorID') as 'V', unique(q_W.'DonorID') as 'W', unique(q_X.'DonorID') as 'X';\nq = group q by 'Campaign_Appeal.Type';\nq = foreach q generate 'Campaign_Appeal.Type', first(BE) as '00-YR', first(BF) as '01-YR', first(BG) as '02-YR', first(BH) as '03-YR', first(BI) as '04-YR', first(C) as '00-DA-DNU', first(Q) as '01-DA-DNU', first(R) as '02-DA-DNU', first(S) as '03-DA-DNU', first(T) as '04-DA-DNU', first(D) as '00-DC-DNU', first(U) as '01-DC-DNU', first(V) as '02-DC-DNU', first(W) as '03-DC-DNU', first(X) as '04-DC-DNU', coalesce(sum(C),0) as '00-DA', coalesce(sum(D),0) as '00-DC', coalesce(sum(Q),0) as '01-DA', coalesce(sum(R),0) as '02-DA', coalesce(sum(S),0) as '03-DA', coalesce(sum(T),0) as '04-DA', coalesce(sum(U),