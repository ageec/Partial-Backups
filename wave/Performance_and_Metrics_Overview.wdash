Date_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nq1_A = group q1_A by ('DonorID');\nq1_A = foreach q1_A generate q1_A.'DonorID' as 'DonorID', unique(q1_A.'DonorID') as 'A', sum(q1_A.'Transaction.AQB__Amount__c') as 'B';\nq1_A = filter q1_A by 'B' != 0;\n--q1_B = group q1_B by ('DonorID');\n--q1_B = foreach q1_B generate q1_A.'DonorID' as 'DonorID', unique(q1_B.'DonorID') as 'A', sum(q1_B.'Transaction.AQB__Amount__c') as 'B';\n--q1_B = filter q1_B by 'B' != 0;\n--q1 = cogroup q1_A by all full, q1_B by all;\nq1 = group q1_A by all;\nq1 = foreach q1 generate sum(q1.'A') as 'A'; --, unique(q1_B.'DonorID') as 'B';\nq = cogroup q1 by all full, q2 by all;\nq = foreach q generate first(q1.'A') as 'A', sum(q2.'Amount') as 'C'; --first(q1.'B') as 'B',\nq = foreach q generate 'A' as 'Donor Count', 'C' as 'Goal', coalesce(A,0)/(C) as '% to Goal'; --'B',  C as 'D',\nq = limit q 2000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"New_Production_With__8":{"broadcastFacet":true,"datasets":[{"name":"GiftAndPledgeTransactionsExtension"},{"name":"UA_Performance_Overview_Goals"}],"isGlobal":false,"label":"New Production With Bequests Overview Table","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"