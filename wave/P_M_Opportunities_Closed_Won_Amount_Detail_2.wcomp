roups":["ARCHAccountID","AccountName","Transaction.ARCH_Tax_Gift_Date1__c_Year","Transaction.ARCH_Tax_Gift_Date1__c_Month","Transaction.ARCH_Tax_Gift_Date1__c_Day","Transaction.AQC_Date_Processed__c_Year","Transaction.AQC_Date_Processed__c_Month","Transaction.AQC_Date_Processed__c_Day","Name","Record_Type.Name","Account_Interest_Types_List","Account.Name","AccountID","Id"],"joins":[],"name":"GiftAndPledgeTransactionsExtension"}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","ARCHAccountID","AccountName","Transaction.ARCH_Tax_Gift_Date1__c_Year~~~Transaction.ARCH_Tax_Gift_Date1__c_Month~~~Transaction.ARCH_Tax_Gift_Date1__c_Day","Transaction.AQC_Date_Processed__c_Year~~~Transaction.AQC_Date_Processed__c_Month~~~Transaction.AQC_Date_Processed__c_Day","Name","Record_Type.Name","Account_Interest_Types_List","Account.Name"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":175,"minColumnWidth":40,"mode":"variable","numberOfFrozenColumns":8,"numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"GO___Closed_Won_by_O_1":{"broadcastFacet":false,"groups":[],"label":"GO $ Closed/Won by OTM Summary Table","numbers":[],"query":"q1 = load \"OpportunityDetail\";\nq2 = load \"User_Goal_Info\";\nq1 = filter q1 by 'StageName' in [\"Closed Won\", \"Closed/Won\"];\nq1 = filter q1 by date('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by ('OppRecordType.Name' != \"Grateful Patients\" || 'OppRecordType.Name' is null);\nq2 = filter q2 by date('AQB__LastGoalIntervalDate__c_Year', 'AQB__LastGoalIntervalDate__c_Month', 'AQB__LastGoalIntervalDate__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq2 = filter q2 by 'GiftOfficerTeam' in [\"Med Alumni\", \"Med CFR\", \"Siteman\", \"Med/Surg\", \"Neuro\"];\nq3 = filter q2 by 'AQB__Classification__c' == \"Number of Opportunities Closed/Won\";\nq2 = filter q2 by 'AQB__Classification__c' == \"Opportunity Amount Closed/Won\";\nq = cogroup q1 by ('OpportunityTeamMember.GiftOfficerTeam', 'OpportunityTeamMember.Name') full, q2 by ('GiftOfficerTeam', 'User.Name') full, q3 by ('GiftOfficerTeam', 'User.Name');\nq = foreach q generate coalesce(q1.'OpportunityTeamMember.GiftOfficerTeam', q2.'GiftOfficerTeam') as 'OpportunityTeamMember.GiftOfficerTeam', coalesce(q1.'OpportunityTeamMember.Name', q2.'User.Name') as 'OpportunityTeamMember.Name', sum(q1.'Amount') as 'A', sum(q2.'AQB__GoalCurrencyAmount__c') as 'B', count(q1) as 'C', sum(q3.'AQB__GoalCount__c') as 'D';\nq = foreach q generate 'OpportunityTeamMember.GiftOfficerTeam', 'OpportunityTeamMember.Name', 'A' as '$ - Closed/Won Amount', 'B' as '$ - Goal', coalesce(A,0)/B as '$ - % to Goal', 'C' as '# - Closed/Won Count', 'D' as '# - Goal', coalesce(C,0)/D as '# - % to Goal';\nq = group q by rollup('OpportunityTeamMember.GiftOfficerTeam', 'OpportunityTeamMember.Name');\nq = foreach q generate q.'OpportunityTeamMember.GiftOfficerTeam' as 'OpportunityTeamMember.GiftOfficerTeam', q.'OpportunityTeamMember.Name' as 'OpportunityTeamMember.Name', sum(q.'$ - Closed/Won Amount') as '$ - Closed/Won Amount', sum(q.'$ - Goal') as '$ - Goal', sum(q.'$ - Closed/Won Amount') / sum(q.'$ - Goal') as '$ - % to Goal', sum('# - Closed/Won Count') as '# - Closed/Won Count', sum(q.'# - Goal') as '# - Goal', sum(q.'# - Closed/Won Count') / sum(q.'# - Goal') as '# - % to Goal', grouping(q.'OpportunityTeamMember.GiftOfficerTeam') as 'grouping_OpportunityTeamMember.GiftOfficerTeam', grouping(q.'OpportunityTeamMember.Name') as 'grouping_OpportunityTeamMember.Name';\ns = filter q by 'grouping_OpportunityTeamMember.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_OpportunityTeamMember.GiftOfficerTeam' == 0 and 'grouping_OpportunityTeamMember.Name' == 0;\nq = order q by ('OpportunityTeamMember.GiftOfficerTeam' asc, 'OpportunityTeamMember.Name' asc);\nq = limit q 10000;\nq = union q, s;\nq = limit q 10001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}}},"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#747474","borderEdges":[],"borderRadius":0,"borderWidth":1,"tooltipStyle":{"backgroundColor":"#16325c","labelColor":"#9faab5","valueColor":"#ffffff"}},"widgets":{"link_3":{"parameters":{"destinationLink":{"name":"be8cf36a-4319-44d1-9e09-c92a47a08386"},"destinationType":"page","fontSize":16,"includeState":false,"text":"$/# Opportunities Closed/Won by All Opportunity Team Roles (Click for Details)","textAlignment":"left","textColor":"#020821"},"type":"link"},"link_4":{"parameters":{"destinationLink":{"name":"fe620