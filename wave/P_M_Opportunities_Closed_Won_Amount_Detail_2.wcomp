6448b4","navigationHidden":false,"widgets":[{"colspan":25,"column":0,"name":"link_5","row":0,"rowspan":3,"widgetStyle":{"borderEdges":[]}},{"colspan":50,"column":0,"name":"table_7","row":3,"rowspan":30,"widgetStyle":{"borderEdges":[]}}]},{"label":"PrG New Production Principal Partner Detail","name":"81d923be-b59a-415b-b27e-9502a0c03da8","navigationHidden":false,"widgets":[{"colspan":25,"column":0,"name":"link_6","row":0,"rowspan":3,"widgetStyle":{"borderEdges":[]}},{"colspan":50,"column":0,"name":"table_8","row":3,"rowspan":30,"widgetStyle":{"borderEdges":[]}}]}],"rowHeight":"fine","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#F2F6FA","cellSpacingX":0,"cellSpacingY":0,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"parameters":[{"defaultValue":"0","description":"","label":"Fiscal Years Passed","name":"parameter_1"},{"defaultValue":"current fiscal_year","description":"","label":"Fiscal Year","name":"parameter_2"}],"steps":{"New_Production_Princ_1":{"broadcastFacet":true,"groups":[],"label":"New Production Principal Partner","numbers":[],"query":"q1 = load \"GiftAndPledgeTransactionsExtension\";\nq2 = load \"P_M_PrG_Goals\";\nq2 = filter q2 by 'Goal' == \"New Production Principal Partner\";\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"[[parameter_1]]\";\nq1 = filter q1 by 'NewProductionARCHCreditedFiscalYearsPassed' == \"[[parameter_1]]\";\nq1 = filter q1 by 'AccountInterestTypes' in [\"PrG - PP\", \"PrG - A\", \"PrG - P\", \"PrG - PM\"];\n-- ARCHRPTS-1270 - Start\n-- q1 = filter q1 by 'COA.ARCH_Primary_Reporting_Value__c' not in [\"School of Medicine\"];\nq1 = filter q1 by ('COA.ARCH_Primary_Reporting_Value__c' != \"School of Medicine\" || 'COA.ARCH_Primary_Reporting_Value__c' is null);\n-- ARCHRPTS-1270 - End\nq1 = group q1 by 'Transaction.Name';\nq1 = foreach q1 generate 'Transaction.Name' as 'Transaction.Name', avg(q1.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests';\nq = cogroup 