ber.GiftOfficerTeam","filters":[],"ascending":true},{"name":"Component.ARCH_School_Unit__c","filters":[],"ascending":true},{"name":"Component.ARCH_Cancer__c","filters":[],"ascending":true},{"name":"CloseDate_Year","filters":[],"ascending":true},{"name":"CloseDate_Month","filters":[],"ascending":true},{"name":"CloseDate_Day","filters":[],"ascending":true},{"name":"Account.Id","filters":[],"ascending":true},{"name":"Id","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{"User_Goal_Info":{"filters":[["AQB__Classification__c",["Opportunity Amount Closed/Won"],"in"],["GiftOfficerTeam",["Med Alumni","Med CFR","Siteman"],"in"],["LastGoalIntervalFiscalYear",["[[parameter_1]]"],"in"]]},"OpportunityDetail":{"filters":[["StageName",["Closed Won","Closed/Won"],"in"],["Opportunity.CloseDateFiscalYear",["[[parameter_1]]"],"in"],["OppRecordType.Name",["Grateful Patients"],"not in"]]}},"sources":[{"columns":[{"field":["sum","Amount"],"name":"A"}],"filters":[],"groups":["Name","Account.Name","Account.AQC_Account_ARCH_ID__c","OpportunityTeamMember.Name","OpportunityTeamMember.TeamMemberRole","OpportunityTeamMember.GiftOfficerTeam","Component.ARCH_School_Unit__c","Component.ARCH_Cancer__c","CloseDate_Year","CloseDate_Month","CloseDate_Day","Account.Id","Id"],"joins":[],"name":"OpportunityDetail"}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","Name","Account.Name","Account.AQC_Account_ARCH_ID__c","OpportunityTeamMember.Name","OpportunityTeamMember.TeamMemberRole","OpportunityTeamMember.GiftOfficerTeam","Component.ARCH_School_Unit__c","Component.ARCH_Cancer__c","CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfFrozenColumns":0,"numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Med_GO___Closed_Won__1":{"broadcastFacet":false,"groups":[],"label":"Med GO $ Closed/Won by OTM Summary Table","numbers":[],"query":"q1 = load \"OpportunityDetail\";\nq2 = load \"User_Goal_Info\";\nq1 = filter q1 by 'StageName' in [\"Closed Won\", \"Closed/Won\"];\nq1 = filter q1 by date('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by ('OppRecordType.Name' != \"Grateful Patients\" || 'OppRecordType.Name' is null);\nq2 = filter q2 by 'AQB__Classification__c' == \"Opportunity Amount Closed/Won\";\nq2 = filter q2 by 'GiftOfficerTeam' in [\"Med Alumni\", \"Med/Surg\", \"Neuro\", \"Med CFR\", \"Siteman\", \"Momentum/EVC/VC\", \"Other UA\"];\nq2 = filter q2 by date('AQB__LastGoalIntervalDate__c_Year', 'AQB__LastGoalIntervalDate__c_Month', 'AQB__LastGoalIntervalDate__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq = cogroup q1 by ('OpportunityTeamMember.GiftOfficerTeam', 'OpportunityTeamMember.Name') full, q2 by ('GiftOfficerTeam', 'User.Name');\nq = foreach q generate coalesce(q1.'OpportunityTeamMember.GiftOfficerTeam', q2.'GiftOfficerTeam') as 'OpportunityTeamMember.GiftOfficerTeam', coalesce(q1.'OpportunityTeamMember.Name', q2.'User.Name') as 'OpportunityTeamMember.Name', sum(q1.'Amount') as 'A', sum(q2.'AQB__GoalCurrencyAmount__c') as 'B';\nq = foreach q generate 'OpportunityTeamMember.GiftOfficerTeam', 'OpportunityTeamMember.Name', 'A' as '$ Closed/Won', 'B' as 'Goal', A/B as '% to Goal';\nq = group q by rollup('OpportunityTeamMember.GiftOfficerTeam', 'OpportunityTeamMember.Name');\nq = foreach q generate q.'OpportunityTeamMember.GiftOfficerTeam' as 'OpportunityTeamMember.GiftOfficerTeam', q.'OpportunityTeamMember.Name' as 'OpportunityTeamMember.Name', sum(q.'$ Closed/Won') as '$ Closed/Won', sum(q.'Goal') as 'Goal', sum(q.'$ Closed/Won') / sum(q.'Goal') as '% to Goal', grouping(q.'OpportunityTeamMember.GiftOfficerTeam') as 'grouping_OpportunityTeamMember.GiftOfficerTeam', grouping(q.'OpportunityTeamMember.Name') as 'grouping_OpportunityTeamMember.Name';\ns = filter q by 'grouping_OpportunityTeamMember.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_OpportunityTeamMember.GiftOfficerTeam' == 0 and 'grouping_OpportunityTeamMember.Name' == 0;\nq = order q by ('OpportunityTeamMember.GiftOfficerTeam' asc, 'OpportunityTeamMember.Name' asc);\nq = limit q 10000;\nq = union q, s;\nq = limit q 10001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"verticalPadding":8},"type":"table"}},"Med_Adv___Closed_Won_3":{"broadcastFacet":false,"datasets":[{"name":"Opportunity_Info"}],"isGlobal":false,"label":"Med Adv $ Closed/Won OTM Detail Table","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":["Account.AQC_Account_ARCH_ID__c"],"limit":2000,"orders":[{"name":"Account.AQC_Account_ARCH_ID__c","filters":[],"ascending":true},{"name":"Opportunity.Name","filters":[],"ascending":true},