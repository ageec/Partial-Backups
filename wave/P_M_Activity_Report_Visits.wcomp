ount.Account.ARCH_Territory__c', 'Account.TerritorySort') full, q2 by ('Territory', 'Territory_Sort');\nq = foreach q generate coalesce(q1.'Account.Account.ARCH_Territory__c', q2.'Territory') as 'Account.Account.ARCH_Territory__c', coalesce(q1.'Account.TerritorySort', q2.'Territory_Sort') as 'Account.TerritorySort', first(q1.'A') as 'A', first(q1.'G') as 'G', sum(q2.'Amount') as 'B';\nq = foreach q generate 'Account.Account.ARCH_Territory__c', 'Account.TerritorySort', 'A' as '# Activity Report Visits', 'G' as '# Activity Report Visits (Virtual)', 'B' as 'Goal', coalesce(A,0)/B as '% to Goal';\nq = order q by ('Account.Account.ARCH_Territory__c' asc, 'Account.TerritorySort' asc);\nq = group q by rollup('Account.Account.ARCH_Territory__c', 'Account.TerritorySort');\nq = foreach q generate q.'Account.Account.ARCH_Territory__c' as 'Account.Account.ARCH_Territory__c', q.'Account.TerritorySort' as 'Account.TerritorySort', sum(q.'# Activity Report Visits') as '# Activity Report Visits', sum(q.'# Activity Report Visits (Virtual)') as '# Activity Report Visits (Virtual)', sum(q.'Goal') as 'Goal', sum(q.'# Activity Report Visits') / sum(q.'Goal') as '% to Goal', grouping(q.'Account.Account.ARCH_Territory__c') as 'grouping_Account.Account.ARCH_Territory__c', grouping(q.'Account.TerritorySort') as 'grouping_Account.TerritorySort';\ns = filter q by 'grouping_Account.Account.ARCH_Territory__c' == 1;\nq = filter q by 'grouping_Account.Account.ARCH_Territory__c' == 0 and 'grouping_Account.TerritorySort' == 0;\nq = order q by 'Account.TerritorySort' asc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[]