umns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["Name","Account.Account.Name","AQB__Purpose__c","AQB__Subject__c","Account.Account.ARCH_Territory__c","ActivityReportParticipant.AssignedTo","ActivityReportParticipant.Participant","AQB__Date__c_Year","AQB__Date__c_Month","AQB__Date__c_Day","Id","Account.Account.Id"],"joins":[],"name":"Activity_Report_Info"}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","Name","Account.Account.Name","AQB__Purpose__c","AQB__Subject__c","Account.Account.ARCH_Territory__c","ActivityReportParticipant.AssignedTo","ActivityReportParticipant.Participant","AQB__Date__c_Year~~~AQB__Date__c_Month~~~AQB__Date__c_Day"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfFrozenColumns":8,"numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"GO___AR_Visits_by_Us_4":{"broadcastFacet":false,"groups":[],"label":"PSO # AR Visits by Dean Detail Table","numbers":[],"query":"q = load \"ActivityReportDetail\";\nq = filter q by 'ARFiscalYearsPassed' == \"0\";\nq = filter q by 'AQB__Type__c' == \"Visit\";\nq = filter q by 'AQB__ReportStatus__c' == \"Final\";\nq = filter q by ('RecordType.Name' != \"Corporate Engagement\" || 'RecordType.Name' is null);\nq = filter q by 'ActivityReportParticipant.User.Name' matches \"- Dean\";\nq = filter q by date('AQB__Date__c_Year', 'AQB__Date__c_Month', 'AQB__Date__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq = group q by rollup('Name', 'Account.Name', 'AQB__Purpose__c', 'AQB__Subject__c', 'ActivityReportParticipant.GiftOfficerNameRole', 'AQB__Date__c', 'Id', 'Account.Id');\nq = foreach q generate q.'Name' as 'Name', q.'Account.Name' as 'Account.Name', q.'AQB__Purpose__c' as 'AQB__Purpose__c', q.'AQB__Subject__c' as 'AQB__Subject__c', q.'ActivityReportParticipant.GiftOfficerNameRole' as 'ActivityReportParticipant.GiftOfficerNameRole', q.'AQB__Date__c' as 'AQB__Date__c', q.'Id' as 'Id', q.'Account.Id' as 'Account.Id', count(q) as 'Count', grouping(q.'Name') as 'grouping_Name', grouping(q.'Account.Name') as 'grouping_Account.Name', grouping(q.'AQB__Purpose__c') as 'grouping_AQB__Purpose__c', grouping(q.'AQB__Subject__c') as 'grouping_AQB__Subject__c', grouping(q.'ActivityReportParticipant.GiftOfficerNameRole') as 'grouping_ActivityReportParticipant.GiftOfficerNameRole', grouping(q.'AQB__Date__c') as 'grouping_AQB__Date__c', grouping(q.'Id') as 'grouping_Id', grouping(q.'Account.Id') as 'grouping_Account.Id';\ns = filter q by 'grouping_Name' == 1;\nq = filter q by 'grouping_Name' == 0 and 'grouping_Account.Name' == 0 and 'grouping_AQB__Purpose__c' == 0 and 'grouping_AQB__Subject__c' == 0  and 'grouping_ActivityReportParticipant.GiftOfficerNameRole' == 0 and 'grouping_AQB__Date__c'  == 0 and 'grouping_Id' == 0 and 'grouping_Account.Id' == 0;\nq = order q by ('ActivityReportParticipant.GiftOfficerNameRole' asc, 'AQB__Date__c' desc, 'Name' asc, 'Account.Name' asc, 'AQB__Purpose__c' asc, 'AQB__Subject__c' asc,  'Id' asc, 'Account.Id' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWi