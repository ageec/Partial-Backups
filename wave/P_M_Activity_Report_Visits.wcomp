tivityReportDetail\";\nq2 = load \"User_Goal_Info\";\nq1 = filter q1 by date('AQB__Date__c_Year', 'AQB__Date__c_Month', 'AQB__Date__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by 'AQB__Type__c' == \"Visit\";\nq1 = filter q1 by 'ActivityReportParticipant.User.Name' matches(\"- Dean\");\nq1 = filter q1 by 'AQB__ReportStatus__c' == \"Final\";\nq1 = filter q1 by ('RecordType.Name' != \"Corporate Engagement\" || 'RecordType.Name' is null);\nq2 = filter q2 by 'AQB__Classification__c' == \"Number of Visits\";\nq2 = filter q2 by 'User.Name' matches (\"- Dean\");\nq2 = filter q2 by date('AQB__LastGoalIntervalDate__c_Year', 'AQB__LastGoalIntervalDate__c_Month', 'AQB__LastGoalIntervalDate__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq = cogroup q1 by ('ActivityReportParticipant.User.Name') full, q2 by ('User.Name');\nq = foreach q generate coalesce(q1.'ActivityReportParticipant.User.Name', q2.'User.Name') as 'ActivityReportParticipant.User.Name', count(q1) as 'A', sum(q2.'AQB__GoalCount__c') as 'B';\nq = foreach q generate 'ActivityReportParticipant.User.Name', 'A' as 'Activity Report Visits', 'B' as 'Goal', A/B as '% to Goal';\nq = group q by rollup('ActivityReportParticipant.User.Name');\nq = foreach q generate q.'ActivityReportParticipant.User.Name' as 'ActivityReportParticipant.User.Name', sum(q.'Activity Report Visits') as 'Activity Report Visits', sum(q.'Goal') as 'Goal', sum(q.'Activity Report Visits') / sum(q.'Goal') as '% to Goal', grouping(q.'ActivityReportParticipant.User.Name') as 'grouping_ActivityReportParticipant.User.Name';\ns = filter q by 'grouping_ActivityReportParticipant.User.Name' == 1;\nq = filter q by 'grouping_ActivityReportParticipant.User.Name' == 0;\nq = order q by ('ActivityReportParticipant.User.Name' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":t