tail\";\nq2 = load \"User_Goal_Info\";\nq1 = filter q1 by date('AQB__Date__c_Year', 'AQB__Date__c_Month', 'AQB__Date__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by 'AQB__Type__c' == \"Visit\";\nq1 = filter q1 by 'AQB__ReportStatus__c' == \"Final\";\nq1 = filter q1 by ('RecordType.Name' != \"Corporate Engagement\" || 'RecordType.Name' is null);\nq2 = filter q2 by 'AQB__Classification__c' == \"Number of Visits\";\nq2 = filter q2 by date('AQB__LastGoalIntervalDate__c_Year', 'AQB__LastGoalIntervalDate__c_Month', 'AQB__LastGoalIntervalDate__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq = cogroup q1 by ('ActivityReportParticipant.GiftOfficerTeam', 'ActivityReportParticipant.User.Name') full, q2 by ('GiftOfficerTeam', 'User.Name');\nq = foreach q generate coalesce(q1.'ActivityReportParticipant.GiftOfficerTeam', q2.'GiftOfficerTeam') as 'ActivityReportParticipant.GiftOfficerTeam', coalesce(q1.'ActivityReportParticipant.User.Name', q2.'User.Name') as 'ActivityReportParticipant.User.Name', count(q1) as 'A', sum(q2.'AQB__GoalCount__c') as 'B';\nq = foreach q generate 'ActivityReportParticipant.GiftOfficerTeam', 'ActivityReportParticipant.User.Name', 'A' as 'Activity Report Visits', 'B' as 'Goal', A/B as '% to Goal';\nq = group q by rollup('ActivityReportParticipant.GiftOfficerTeam', 'ActivityReportParticipant.User.Name');\nq = foreach q generate q.'ActivityReportParticipant.GiftOfficerTeam' as 'ActivityReportParticipant.GiftOfficerTeam', q.'ActivityReportParticipant.User.Name' as 'ActivityReportParticipant.User.Name', sum(q.'Activity Report Visits') as 'Activity Report Visits', sum(q.'Goal') as 'Goal', sum(q.'Activity Report Visits') / sum(q.'Goal') as '% to Goal', grouping(q.'ActivityReportParticipant.GiftOfficerTeam') as 'grouping_ActivityReportParticipant.GiftOfficerTeam', grouping(q.'ActivityReportParticipant.User.Name') as 'grouping_ActivityReportParticipant.User.Name';\ns = filter q by 'grouping_ActivityReportParticipant.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_ActivityReportParticipant.GiftOfficerTeam' == 0 and 'grouping_ActivityReportParticipant.User.Name' == 0;\nq = order q by ('ActivityReportParticipant.GiftOfficerTeam' asc, 'ActivityReportParticipant.User.Name' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":255,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"GO___AR_Visits_by_Us_2":{"broadcastFacet":false,"datasets":[{"name":"ActivityReportDetail"}],"isGlobal":false,"label":"GO # AR Visits by User Participant Detail Table","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":["Name"],"limit":2000,"orders":[{"name":"Name","filters":[],"ascending":true},{"name":"Account.Name","filters":[],"ascending":true},{"name":"AQB__Purpose__c","filters":[],"ascending":true},{"name":"AQB__Subject__c","filters":[],"ascending":true},{"name":"ActivityReportParticipant.GiftOfficerTeam","filters":[],"ascending":true},{"name":"ActivityReportParticipant.GiftOfficerNameRole","filters":[],"ascending":true},{"name":"AQB__Date__c_Year","filters":[],"ascending":true},{"name":"AQB__Date__c_Month","filters":[],"ascending":true},{"name":"AQB__Date__c_Day","filter