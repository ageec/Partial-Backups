_2":{"broadcastFacet":true,"datasets":[{"name":"Activity_Report_Info"}],"isGlobal":false,"label":"PrG Bespoke Day Opps Detail","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[{"name":"Name","filters":[],"ascending":true},{"name":"Id","filters":[],"ascending":true},{"name":"Account.Account.Name","filters":[],"ascending":true},{"name":"Account.Account.Id","filters":[],"ascending":true},{"name":"Opportunity.Name","filters":[],"ascending":true},{"name":"Opportunity.Id","filters":[],"ascending":true},{"name":"AQB__Purpose__c","filters":[],"ascending":true},{"name":"AQB__Subject__c","filters":[],"ascending":true},{"name":"Opportunity.ARCH_Event_Name__c","filters":[],"ascending":true},{"name":"AQB__Date__c_Year","filters":[],"ascending":true},{"name":"AQB__Date__c_Month","filters":[],"ascending":true},{"name":"AQB__Date__c_Day","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{"P_M_PrG_Goals":{"filters":[["Goal",["Bespoke Day Opps"],"in"]]},"Activity_Report_Info":{"filters":[["AQB__Date__c",[["fiscal_year",0],["fiscal_year",0]],"between"],["Opportunity.OpportunityEvent.AQB__Event_Type__c",["Bespoke Day"],"in"]]}},"sources":[{"columns":[{"field":["sum","Account.Account.AQB__OpenOpps__c"],"name":"A"}],"filters":[],"groups":["Name","Id","Account.Account.Name","Account.Account.Id","Opportunity.Name","Opportunity.Id","AQB__Purpose__c","AQB__Subject__c","Opportunity.ARCH_Event_Name__c","AQB__Date__c_Year","AQB__Date__c_Month","AQB__Date__c_Day"],"joins":[],"name":"Activity_Report_Info"}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","Name","Account.Account.Name","AQB__Purpose__c","AQB__Subject__c","Opportunity.Name","Opportunity.ARCH_Event_Name__c","AQB__Date__c_Year~~~AQB__Date__c_Month~~~AQB__Date__c_Day"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfFrozenColumns":0,"numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Territories___Closed_1":{"broadcastFacet":false,"groups":[],"label":"Territories # Closed/Won Summary Table","numbers":[],"query":"q1 = load \"Opportunity_Info\";\nq2 = load \"Territory_Goals\";\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"[[parameter_1]]\";\nq2 = filter q2 by 'Goal' == \"Total # of Opps Closed/Won\";\nq1 = filter q1 by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq = cogroup q1 by ('Opportunity.ARCH_Territory__c', 'Opportunity.TerritorySort') full, q2 by ('Territory', 'Territory_Sort');\nq = foreach q generate coalesce(q1.'Opportunity.ARCH_Territory__c', q2.'Territory') as 'Opportunity.ARCH_Territory__c', coalesce(q1.'Opportunity.TerritorySort', q2.'Territory_Sort') as 'Opportunity.TerritorySort', count(q1) as '# Opps Closed/Won', sum(q2.'Amount') as 'Goal', coalesce(count(q1),0)/sum(q2.'Amount') as '% to Goal';\nq = group q by rollup('Opportunity.ARCH_Territory__c', 'Opportunity.TerritorySort');\nq = foreach q generate 'Opportunity.ARCH_Territory__c' as 'Opportunity.ARCH_Territory__c', 'Opportunity.TerritorySort' as 'Opportunity.TerritorySort', sum('# Opps Closed/Won') as '# Opps Closed/Won', sum('Goal') as 'Goal', sum('% to Goal') as '% to Goal', grouping(q.'Opportunity.ARCH_Territory__c') as 'grouping_Opportunity.ARCH_Territory__c', grouping(q.'Opportunity.TerritorySort') as 'grouping_Opportunity.TerritorySort';\ns = filter q by 'grouping_Opportunity.ARCH_Territory__c' == 1 and 'grouping_Opportunity.TerritorySort' == 1;\nq = filter q by 'grouping_Opportunity.ARCH_Territory__c' == 0 and 'grouping_Opportunity.TerritorySort' == 0;\nq = order q by 'Opportunity.TerritorySort' asc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"DV___Closed_Won_Summ_1":{"broadcastFacet":false,"groups":[],"label":"DV Closed/Won Conversion % of Opps by Opportunity Owner Summary Table","numbers":[],"query":"--load all closed opps for selected fiscal year\nq1 = load \"Opportunity_Info\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\", \"Closed - Funded No Value\", \"Closed - Not Asked\", \"Closed - NPR Funded\", \"Closed/Invalid\", \"Closed/Lost\", \"Closed/Won - No Value\"];\nq1 = filter q1 by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq1 = foreach q1 generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical',  'Opportunity.Amount', 'Opportunity.AQC_Ask_Amount__c', 'Opportunity.Id',\n    (case\n        when 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] then 1\n        else 0\n    end) as '# - Closed/Won Count',\n    (case\n        when 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] then 'Opportunity.Amount'\n        else 0\n    end) as '$ - Closed/Won Amount'; \n\nq = group q1 by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical');\nq = foreach q generate q1.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q1.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', sum(q1.'Opportunity.AQC_Ask_Amount__c') as 'A', count(q1) as 'B', sum('$ - Closed/Won Amount') as '$ - Closed/Won Amount', sum('# - Closed/Won Count') as '# - Closed/Won Count';\nq = foreach q generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'A' as '$ - Closed Ask Amount', 'B' as '# - Closed Count', '$ - Closed/Won Amount', '# - Closed/Won Count';\n\nq = group q by rollup('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical');\nq = foreach q generate q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam',  q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', \nsum(q.'$ - Closed/Won Amount') as '$ - Closed/Won Amount',  \nsum(q.'$ - Closed Ask Amount') as '$ - Closed Ask Amount', \nsum(q.'$ - Closed/Won Amount')/sum(q.'$ - Closed Ask Amount') as '$ - Closed/Won Conversion %', \n0.5 * sum(q.'$ - Closed Ask Amount') as '$ - Closed/Won Goal (50%)', \nsum(q.'$ - Closed/Won Amount')/(0.5 * sum(q.'$ - Closed Ask Amount'))as '% to Goal $ Closed/Won Amount', \nsum('# - Closed/Won Count') as '# - Closed/Won Count', \nsum('# - Closed Count') as '# - Closed Count', \nsum('# - Closed/Won Count')/sum('# - Closed Count') as '# - Closed/Won Conversion %', \n0.5 * sum('# - Closed Count') as '# - Closed/Won Goal (50%)',\nsum('# - Closed/Won Count')/(0.5 * sum('# - Closed Count')) as '% to Goal # Closed/Won Count', \ngrouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name', grouping(q.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical';\ns = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0 and 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 0;\nq = order q by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' asc, 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],