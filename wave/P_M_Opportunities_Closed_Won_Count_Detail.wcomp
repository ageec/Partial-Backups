OpportunityTeamMember.GiftOfficerDivision","CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfFrozenColumns":7,"numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Med_Adv___Closed_Won_3":{"broadcastFacet":false,"datasets":[{"name":"Opportunity_Info"}],"isGlobal":false,"label":"Med Adv # Closed/Won Summary Table 2","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[],"rowTotals":[],"sourceFilters":{"Opportunity_Info":{"booleanFilterLogic":"1 AND 2 AND 3 AND 4","filters":[["Opportunity.StageName",["Closed Won","Closed/Won"],"in"],["Opportunity.CloseDateFiscalYearsPassed",["[[parameter_1]]"],"in"],["Opportunity.OppRecordType.Name",["Grateful Patients"],"not in"],["Opportunity.OpportunityTeamMember.MedOfficerTeam",["Med Alumni","Community Fundraising","Med CFR","Momentum/EVC/VC","Med/Surg","Neuro","Siteman"],"in"]]}},"sources":[{"columns":[{"field":["count","*"],"name":"B"}],"filters":[],"groups":["all"],"joins":[],"name":"Opportunity_Info"}]},"receiveFacetSource":{"mode":"include","steps":["Med_Adv___Closed_Won_2"]},"selectMode":"single","sortable":true,"type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["B"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"rgb(9, 26, 62)","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":false,"verticalPadding":8},"type":"table"}},"Med_Adv___Closed_Won_2":{"broadcastFacet":true,"groups":[],"label":"Med Adv # Closed/Won Summary Table","numbers":[],"query":"q1 = load \"Opportunity_Info\";\nq2 = load \"UA_Performance_Med_Goals\";\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"[[parameter_1]]\";\nq2 = filter q2 by 'Goal' == \"# of Opportunities Closed/Won\"; -- and 'Gift_Band' in [\"01 - $1,000,000+\",\"02 - $100,000 to $999,999\"];\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] and date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"] and ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null) and 'Opportunity.OpportunityTeamMember.MedOfficerTeam' in [\"Med Alumni\", \"Community Fundraising\", \"Med CFR\", \"Momentum/EVC/VC\", \"Med/Surg\", \"Neuro\", \"Siteman\"]; -- and 'Opportunity.ClosedWonMedGiftBand' in [\"01 - $1,000,000+\",\"02 - $100,000 to $999,999\"];\nq = cogroup q1 by 'Opportunity.ClosedWonMedGiftBand' full, q2 by 'Gift_Band';\nq = foreach q generate coalesce(q1.'Opportunity.ClosedWonMedGiftBand', q2.'Gift_Band') as 'Opportunity.ClosedWonMedGiftBand', count(q1) as 'A', sum(q2.'Amount') as 'B';\nq = foreach q generate 'Opportunity.ClosedWonMedGiftBand', 'A' as '# Opps Closed/Won', 'B' as 'Goal', coalesce(A,0)/B as '% to Goal';\nt = foreach q generate 'Opportunity.ClosedWonMedGiftBand', '# Opps Closed/Won' as '# Opps Closed/Won', 'Goal' as 'Goal', '% to Goal' as '% to Goal';\nq = filter q by 'Opportunity.ClosedWonMedGiftBand' in [\"01 - $1,000,000+\",\"02 - $100,000 to $999,999\"];\nq = group q by rollup('Opportunity.ClosedWonMedGiftBand');\nq = foreach q generate q.'Opportunity.ClosedWonMedGiftBand' as 'Opportunity.ClosedWonMedGiftBand', sum(q.'# Opps Closed/Won') as '# Opps Closed/Won', sum(q.'Goal') as 'Goal', sum(q.'# Opps Closed/Won') / sum(q.'Goal') as '% to Goal', grouping(q.'Opportunity.ClosedWonMedGiftBand') as 'grouping_Opportunity.ClosedWonMedGiftBand';\ns = filter q by 'grouping_Opportunity.ClosedWonMedGiftBand' == 1;\nq = filter q by 'grouping_Opportunity.ClosedWonMedGiftBand' == 0;\nq = order q by 'Opportunity.ClosedWonMedGiftBand' asc;\nq = limit q 2000;\nq = union t, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Med_Adv___Closed_Won_1":{"broadcastFacet":false,"datasets":[{"name":"Opportunity_Info"}],"isGlobal":false,"label":"Med Adv # Closed/Won Detail Table","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":["Opportunity.Name"],"limit":2000,"orders":[{"name":"Opportunity.Name","filters":[],"ascending":true},{"name":"Opportunity.Id","filters":[],"ascending":true},{"name":"Account.Name","filters":[],"ascending":true},{"name":"Account.Id","filters":[],"ascending":true},{"name":"Opportunity.OpportunityOwner.MedOfficerTeam","filters":[],"ascendin