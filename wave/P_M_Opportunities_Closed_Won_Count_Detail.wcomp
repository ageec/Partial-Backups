tical', 'Opportunity.OppRecordType.Name', 'Opportunity.Name', 'Opportunity.OpportunityOwner.User.ARCH_Primary_Fundraising_Lane__c', 'Opportunity.Amount', 'Opportunity.AQC_Ask_Amount__c', 'Opportunity.CloseDate', 'Opportunity.Id', 'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', 'Account.Name', 'Account.Id', \n    (case\n        when 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] then 1\n        else 0\n    end) as '# - Closed/Won Count',\n    (case\n        when 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"] then 'Opportunity.Amount'\n        else 0\n    end) as '$ - Closed/Won Amount'; \n\nq = group q1 by rollup('Opportunity.Name', 'Opportunity.Id', 'Account.AQC_Account_ARCH_ID__c', 'Account.Name', 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OppRecordType.Name', 'Account.Id', 'Opportunity.OpportunityOwner.Name', 'Opportunity.OpportunityOwner.User.ARCH_Primary_Fundraising_Lane__c', 'Opportunity.CloseDate');\nq = foreach q generate q.'Opportunity.Name' as 'Opportunity.Name', q.'Opportunity.Id' as 'Opportunity.Id', q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'Account.Name' as 'Account.Name', q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q.'Opportunity.ClosedWonGiftBandDevelopmentVertical' as 'Opportunity.ClosedWonGiftBandDevelopmentVertical', q.'Account.Id' as 'Account.Id', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', 'Opportunity.OpportunityOwner.User.ARCH_Primary_Fundraising_Lane__c', q.'Opportunity.CloseDate' as 'Opportunity.CloseDate', sum(q.'Opportunity.AQC_Ask_Amount__c') as '$ - Closed Ask Amount', \nsum(q.'$ - Closed/Won Amount') as '$ - Closed/Won Amount', \nsum(q.'$ - Closed/Won Amount')/sum(q.'Opportunity.AQC_Ask_Amount__c') as '$ - Closed/Won Conversion %', \n0.5 * sum(q.'Opportunity.AQC_Ask_Amount__c') as '$ - Closed/Won Goal 