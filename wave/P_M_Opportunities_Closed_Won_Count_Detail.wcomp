]]\"];\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq1 = filter q1 by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq = cogroup q1 by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name') full, q2 by ('GiftOfficerTeam', 'User.Name');\nq = foreach q generate coalesce(q1.'Opportunity.OpportunityOwner.GiftOfficerTeam', q2.'GiftOfficerTeam') as 'Opportunity.OpportunityOwner.GiftOfficerTeam', coalesce(q1.'Opportunity.OpportunityOwner.Name', q2.'User.Name') as 'Opportunity.OpportunityOwner.Name', count(q1) as 'A', sum(q2.'AQB__GoalCount__c') as 'B';\nq = foreach q generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'A' as 'Closed/Won Count', 'B' as 'Goal', coalesce(A,0)/B as '% to Goal';\nq = group q by rollup('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name');\nq = foreach q generate q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', sum(q.'Closed/Won Count') as 'Closed/Won Count', sum(q.'Goal') as 'Goal', sum(q.'Closed/Won Count') / sum(q.'Goal') as '% to Goal', grouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name';\ns = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0;\nq = order q by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' as