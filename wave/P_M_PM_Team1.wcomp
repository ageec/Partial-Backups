{"dataSourceLinksInfo":{"enableAutomaticLinking":true,"excludeRelationships":[],"links":[]},"filters":[],"gridLayouts":[{"name":"Default","numColumns":50,"pages":[{"label":"Account Strategy Summary Table","name":"f3b7a1d6-fb2a-443b-a893-2cda118af2a0","navigationHidden":false,"widgets":[{"colspan":50,"column":0,"name":"table_7","row":3,"rowspan":30,"widgetStyle":{"borderEdges":[]}},{"colspan":25,"column":0,"name":"link_5","row":0,"rowspan":3,"widgetStyle":{"borderEdges":[]}}]},{"label":"Account Strategy Detail Table","name":"ce659cfe-ef3f-4d04-ab0a-a7cf321449dd","navigationHidden":false,"widgets":[{"colspan":25,"column":0,"name":"link_7","row":0,"rowspan":3,"widgetStyle":{"borderEdges":[]}},{"colspan":50,"column":0,"name":"table_8","row":3,"rowspan":30,"widgetStyle":{"borderEdges":[]}}]}],"rowHeight":"fine","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#F2F6FA","cellSpacingX":0,"cellSpacingY":0,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"parameters":[{"defaultValue":"0","description":"","label":"Fiscal Years Passed","name":"parameter_1"},{"defaultValue":"current fiscal_year","description":"","label":"Fiscal Year","name":"parameter_2"}],"steps":{"Account_Strategy_Sum_1":{"broadcastFacet":true,"groups":[],"label":"$1M+ Prospect Qualified Summary Table","numbers":[],"query":"--Get active PM Team records with identification, qualification, or prospect status with account capacity >= 1000000\nq = load \"PMTeam\";\nq = filter q by 'AQB__Active__c' == \"true\" and 'Account.ARCH_Capacity_Conversion__c' >= 1000000 \n    and ('Account.AQB__ProspectStatus__c' in [\"Identification\", \"Qualification\"] or ('Account.AQB__ProspectStatus__c' == \"Prospect\"\n          and  date('Account.AQB__ProspectStatusDate__c_Year', 'Account.AQB__ProspectStatusDate__c_Month', 'Account.AQB__ProspectStatusDate__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"])\n            );\nq = foreach q generate 'User.GiftOfficerTeam', 'User.Name', Id, 'AccountInfo.Account.Id', 'Account.AQB__ProspectStatus__c', 'Account.AQB__ProspectStatusDate__c', 'Prospect_Date_Fiscal_Years_Passed',\n    (case \n        when 'Account.AQB__ProspectStatus__c' == \"Prospect\" \n        then 1\n        else 0\n        end) as '# $1M+ Prospects Qualified';\n\n--calculate how many prospect have been qualified this fiscal year against how many there were to qualify\nq1 = group q by rollup('User.GiftOfficerTeam', 'User.Name');\nq1 = foreach q1 generate 'User.GiftOfficerTeam' as 'User.GiftOfficerTeam', 'User.Name' as 'User.Name', \n    count(q) as '# $1M+ Total Prospects', \n    sum('# $1M+ Prospects Qualified') as '# $1M+ Prospects Qualified', \n    sum('# $1M+ Prospects Qualified')/count(q) as '% $1M+ Prospects Qualified', \n    64 as Goal,\n    sum('# $1M+ Prospects Qualified')/64 as '% to Goal', \n    grouping('User.GiftOfficerTeam') as 'grouping_User.GiftOfficerTeam', \n    grouping('User.Name') as 'grouping_User.Name';\ns = filter q1 by 'grouping_User.GiftOfficerTeam' == 1 and 'grouping_User.Name' == 1;\n\nq1 = filter q1 by 'grouping_User.GiftOfficerTeam' == 0 and 'grouping_User.Name' == 0;\nq1 = group q1 by ('User.GiftOfficerTeam', 'User.Name');\nq1 = foreach q1 generate 'User.GiftOfficerTeam', 'User.Name', sum('# $1M+ Total Prospects') as '# $1M+ Total Prospects', sum('# $1M+ Prospects Qualified') as '# $1M+ Prospects Qualified',sum('% $1M+ Prospects Qualified') as '% $1M+ Prospects Qualified', 0 as Goal, 0 as '% to Goal';\nq1 = order q1 by ('User.GiftOfficerTeam' asc, 'User.Name'  asc);\nq1 = limit q1 2000;\nq1 = union q1, s;\nq1 = limit q1 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"GO_Qualification_Out_2":{"broadcastFacet":false,"datasets":[{"name":"ActivityReportDetail"}],"isGlobal":false,"label":"GO Qualification Outreaches by Participant Detail Table","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":["Name"],"limit":2000,"orders":[{"name":"Name","filters":[],"ascending":true},{"name":"Account.Name","filters":[],"ascending":true},{"name":"AQB__Purpose__c","filters":[],"ascending":true},{"name":"AQB__Subject__c","filters":[],"ascending":true},{"name":"ActivityReportParticipant.GiftOfficerTeam","filters":[],"ascending":true},{"name":"ActivityReportParticipant.GiftOfficerNameRole","filters":[],"ascending":true},{"name":"AQB__Date__c_Year","filters":[],"ascending":true},{"name":"AQB__Date__c_Month","filters":[],"ascending":true},{"name":"AQB__Date__c_Day","filters":[],"ascending":true},{"name":"Id","filters":[],"ascending":true},{"name":"Account.Id","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{"ActivityReportDetail":{"filters":[["ARFiscalYearsPassed",["[[parameter_1]]"],"in"],["AQB__ReportStatus__c",["Final"],"in"],["AQB__Purpose__c",["Qualification"],"in"],["RecordType.Name",["Corporate Engagement"],"not in"]]}},"sources":[{"columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["Name","Account.Name","AQB__Purpose__c","AQB__Subject__c","ActivityReportParticipant.GiftOfficerTeam","ActivityReportParticipant.GiftOfficerNameRole","AQB__Date__c_Year","AQB__Date__c_Month","AQB__Date__c_Day","Id","Account.Id"],"joins":[],"name":"ActivityReportDetail"}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","Name","Account.Name","AQB__Purpose__c","AQB__Subject__c","ActivityReportParticipant.GiftOfficerTeam","ActivityReportParticipant.GiftOfficerNameRole","AQB__Date__c_Year~~~AQB__Date__c_Month~~~AQB__Date__c_Day"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfFrozenColumns":7,"numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"GO_Qualification_Out_1":{"broadcastFacet":false,"groups":[],"label":"Account Strategy Summary Table","numbers":[],"query":"q = load \"PMTeam\";\nq = filter q by AQB__Active__c == \"true\" and !('User.Name' matches \"- Dean\");\nq = group q by rollup('User.GiftOfficerDivision', 'User.Name');\nq = foreach q generate 'User.GiftOfficerDivision' as 'User.GiftOfficerDivision', 'User.Name' as 'Gift Officer Name', \n    count(q) as '# of Accounts', \n    sum('Account_Active_Strategy_Plan_Count') as '# of Accounts with Strategies', \n    sum('Account_Inactive_Strategy_Plan_Count') as '# of Accounts without Strategies',\n    0.85*count(q) as 'Goal (85% of Accounts)', \n    sum('Account_Active_Strategy_Plan_Count')/(.85*count(q)) as '% to Goal', \n    grouping(q.'User.GiftOfficerDivision') as 'grouping_User.GiftOfficerDivision', grouping(q.'User.Name') as 'grouping_User.Name';\ns = filter q by 'grouping_User.GiftOfficerDivision' == 1 and 'grouping_User.Name' == 1;\nq = filter q by 'grouping_User.GiftOfficerDivision' == 0 and 'grouping_User.Name' == 0;\nq = order q by ('User.GiftOfficerDivision' asc, 'Gift Officer Name'  asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Territories_Qualific_1":{"broadcastFacet":false,"datasets":[{"name":"Activity_Report_Info"}],"isGlobal":false,"label":"Territories Qualification Outreaches Detail Table","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":["Name"],"limit":2000,"orders":[{"name":"Name","filters":[],"ascending":true},{"name":"AQB__Purpose__c","filters":[],"ascending":true},{"name":"Account.Account.Name","filters":[],"ascending":true},{"name":"AQB__Subject__c","filters":[],"ascending":true},{"name":"Account.Account.ARCH_Territory__c","filters":[],"ascending":true},{"name":"Id","filters":[],"ascending":true},{"name":"Account.Account.Id","filters":[],"ascending":true},{"name":"AQB__Date__c_Year","filters":[],"ascending":true},{"name":"AQB__Date__c_Month","filters":[],"ascending":true},{"name":"AQB__Date__c_Day","filters":[],"ascending":true},{"name":"ActivityReportParticipant.Assigned