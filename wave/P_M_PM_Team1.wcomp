ozenColumns":7,"numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"PrG_PAH_Substantive__1":{"broadcastFacet":false,"datasets":[{"name":"Activity_Report_Info"}],"isGlobal":false,"label":"PrG PAH Substantive ARs Summary Table","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[],"rowTotals":[],"sourceFilters":{"Activity_Report_Info":{"filters":[["ARFiscalYearsPassed",["[[parameter_1]]"],"in"],["AQB__ReportStatus__c",["Final"],"in"],["AQB__EssentialMove__c",["true"],"in"],["RecordType.Name",["Corporate Engagement"],"not in"],["ActivityReportParticipant.User.Name",["Pam Henson"],"in"]]},"Territory_Goals":{"filters":[["Goal",["Total # of Qualifications"],"in"]]}},"sources":[{"columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["all"],"joins":[],"name":"Activity_Report_Info"},{"columns":[{"formula":"null","name":"B"},{"formula":"null","name":"C"}],"filters":[],"groups":[],"joins":[]}]},"receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","sortable":true,"type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","B","C"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":false,"verticalPadding":8},"type":"table"}},"Med_Adv_Qualificatio_2":{"broadcastFacet":true,"groups":[],"label":"Med Adv Qualification Outreaches Summary Table","numbers":[],"query":"q1 = load \"Activity_Report_Info\";\nq2 = load \"UA_Performance_Med_Team_Goals\";\nq1 = filter q1 by date('AQB__Date__c_Year', 'AQB__Date__c_Month', 'AQB__Date__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by 'AQB__Purpose__c' == \"Qualification\";\nq1 = filter q1 by 'AQB__ReportStatus__c' == \"Final\";\nq1 = filter q1 by ('RecordType.Name' != \"Corporate Engagement\" || 'RecordType.Name' is null);\nq1 = filter q1 by 'ActivityReportParticipant.User.Department' == \"Medical Advancement\";\nq1 = filter q1 by 'ActivityReportParticipant.MedOfficerTeam' in [\"Med Alumni\", \"Community Fundraising\", \"Med CFR\", \"Momentum/EVC/VC\", \"Med/Surg\", \"Neuro\", \"Siteman\"];\nq2 = filter q2 by 'Goal' == \"# of Qualifications\";\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"[[parameter_1]]\";\nq = cogroup q1 by 'ActivityReportParticipant.MedOfficerTeam' full, q2 by 'Med_Team';\nq = foreach q generate coalesce(q1.'ActivityReportParticipant.MedOfficerTeam', q2.'Med_Team') as 'ActivityReportParticipant.MedOfficerTeam', count(q1) as 'A', sum(q2.'Amount') as 'B';\nq = foreach q generate 'ActivityReportParticipant.MedOfficerTeam', 'A', 'B', A/B as 'C';\nq = group q by rollup('ActivityReportParticipant.MedOfficerTeam');\nq = foreach q generate q.'ActivityReportParticipant.MedOfficerTeam' as 'ActivityReportParticipant.MedOfficerTeam', sum(q.'A') as 'Qualification Outreaches', sum(q.'B') as 'Goal', sum(q.'A') / sum(q.'B') as '% to Goal', grouping(q.'ActivityReportParticipant.MedOfficerTeam') as 'grouping_ActivityReportParticipant.MedOfficerTeam';\ns = filter q by 'grouping_ActivityReportParticipant.MedOfficerTeam' == 1;\nq = filter q by 'grouping_ActivityReportParticipant.MedOfficerTeam' == 0;\nq = order q by 'ActivityReportParticipant.MedOfficerTeam' asc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Med_Adv_Qualificatio_1":{"broadcastFacet":false,"datasets":[{"name":"Activity_Report_Info"}],"isGlobal":false,"label":"Med Adv Qualification Outreaches Detail Table","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":["Name"],"limit":2000,"orders":[{"name":"Name","filters":[],"ascending":true},{"name":"Account.Account.Name","filters":[],"ascending":true},{"name":"AQB__Purpose__c","filters":[],"ascending":true},{"name":"AQB__Subject__c","filters":[],"ascending":true},{"name":"ActivityReportParticipant.MedOfficerTeam","filters":[],"ascending":true},{"name":"AQB__Date__c_Year","filters":[],"ascending":true},{"name":"AQB__Date__c_Month","filters":[],"ascending":true},{"name":"AQB__Date__c_Day","filters":[],"ascending":true},{"name":"Id","filters":[],"ascending":true},{"name":"Account.Account.Id","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{"Activity_Report_Info":{"filters":[["AQB__Date__c",[["fiscal_year",0],["fiscal_year",0]],"between"],["AQB__Purpose__c",["Qualification"],"in"],["AQB__ReportStatus__c",["Final"],"in"],["ActivityReportParticipant.User.Department",["Medical Advancement"],"in"],["ActivityReportParticipant.MedOfficerTeam",["Med Alumni","Med CFR","Momentum/EVC/VC","Med/Surg","Neuro","Siteman"],"in"]]}},"sources":[{"columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["Name","Account.Account.Name","AQB__Purpose__c","AQB__Subject__c","ActivityReportParticipant.MedOfficerTeam","AQB__Date__c_Year","AQB__Date__c_Month","AQB__Date__c_Day","Id","Account.Account.Id"],"joins":[],"name":"Activity_Report_Info"}]},"receiveFacetSource":{"mode":"include","steps":["Med_Adv_Qualificatio_2"]},"selectMode":"single","sortable":true,"type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","Name","Account.Account.Name","AQB__Purpose__c","AQB__Subject__c","ActivityReportParticipant.MedOfficerTeam","AQB__Date__c_Year~~~AQB__Date__c_Month~~~AQB__Date__c_Day"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"_1M__Prospect_Qualif_1":{"broadcastFacet":false,"groups":[],"label":"$1M+ Prospect Qualified Detail Table","numbers":[],"query":"--Get active PM Team records with identification, qualification, or prospect status with account capacity >= 1000000\nq = load \"PMTeam\";\nq = filter q by 'AQB__Active__c' == \"true\" and 'Account.ARCH_Capacity_Conversion__c' >= 1000000 \n    and ('Account.AQB__ProspectStatus__c' in [\"Identification\", \"Qualification\"] or ('Account.AQB__ProspectStatus__c' == \"Prospect\"\n           and  date('Account.AQB__ProspectStatusDate__c_Year', 'Account.AQB__ProspectStatusDate__c_Month', 'Account.AQB__ProspectStatusDate__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"])\n            );\nq = group q by ('User.GiftOfficerTeam', 'User.Name',AQB__Role__c, 'AccountInfo.Account.Name', 'Account.AQB__ProspectStatus__c', 'Account.AQB__ProspectStatusDate__c', 'Account.AQB__Capacity__c',  Id, 'AccountInfo.Account.Id');\nq = foreach q generate 'User.GiftOfficerTeam', 'User.Name' as 'User.Name',  AQB__Role__c, 'AccountInfo.Account.Name', 'Account.AQB__ProspectStatus__c', 'Account.AQB__ProspectStatusDate__c' as 'Prospect Status Date', 'Account.AQB__Capacity__c', sum('Account.ARCH_Capacity_Conversion__c') as 'Account.ARCH_Capacity_Conversion__c',  Id as 'PM Team Id', 'AccountInfo.Account.Id' as 'Account Id';\nq = order q by ('User.GiftOfficerTeam', 'User.Name', 'Account.AQB__ProspectStatus__c', 'Prospect Status Date');\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["User.GiftOfficerTeam","User.Name","AQB__Role__c","AccountInfo.Account.Name","Account.AQB__ProspectStatus__c","Prospect Status Date","Account.AQB__Capacity__c","Account.ARCH_Capacity_Conversion__c"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"lens_1":{"broadcastFacet":true,"groups":[],"label":"Account Strategy Detail Table","numbers":[],"query":"q = load \"PMTeam\";\nq = filter q by AQB__Active__c == \"true\" and !('User.Name' matches \"- Dean\");\nq = foreach q generate 'User.GiftOfficerDivision' as 'User.GiftOfficerDivision', 'User.Name' as 'Gift Officer Name', 'AQB__Role__c' as 'AQB__Role__c', 'AccountInfo.Account.Name' as 'AccountInfo.Account.Name', \n    (case    \n        when Account_Active_Strategy_Plan_Count == 1 then \"Yes\"\n        else \"No\"\n    end) as 'Strategy on Account',\n    'Account.ActiveStrategyPlan.ActiveStrategyPlan', 'AccountInfo.Account.Id', 'Account.ARCH_Notes_and_Comments__c' as 'Active Strategy Plan Id';\nq = order q by ('User.GiftOfficerDivision' asc, 'Gift Officer Name'  asc, 'AccountInfo.Account.Name' asc);\nq = limit q 25000;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f4f6f9","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"Med_Adv_Qualificatio_4":{"broadcastFacet":false,"datasets":[{"name":"ActivityReportDetail"}],"isGlobal":false,"label":"Med Adv Qualification Outreaches Detail Table 2","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":["Name"],"limit":2000,"orders":[{"name":"Name","filters":[],"ascending":true},{"name":"Account.Name","filters":[],"ascending":true},{"name":"AQB__Purpose__c","filters":[],"ascending":true},{"name":"AQB__Subject__c","filters":[],"ascending":true},{"na