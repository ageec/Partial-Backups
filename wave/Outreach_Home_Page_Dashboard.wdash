Color":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"RecentGifts_1":{"broadcastFacet":true,"groups":[],"label":"RecentGifts","numbers":[],"query":"--get active PMTeam records\nq1 = load \"PMTeam\";\nq1 = filter q1 by AQB__Active__c == \"true\";\nq1 = filter q1 by 'User.Id' == \"{{cell(lens_1.result, 0, \"Id\").asString()}}\";\n\n--join active PMTeam records to transactions\nq = load \"Gifts_and_Pledge_Transactions\";\nq = filter q by 'Contact.Position' == 1;\nq = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"90 days ago\"..\"current day\"];\nq = join q by ('Account.Id') semi, q1 by ('AccountInfo.Account.Id'); \nq = group q by ('Account.Name',  'Name', 'Record_Type.Name', 'Transaction.Name', 'Transaction.AQB__Type__c', 'COA.Name', 'Transaction.ARCH_CreditedFiscalYearDate__c', 'Id', 'Transaction.Id',  'Account.Id', 'COA.Id');\nq = foreach q generate q.'Account.Name' as 'Account Name',  q.'Name' as 'Gift/Pledge Number', q.'Record_Type.Name' as 'Gift/Pledge Type', q.'Transaction.Name' as 'Transaction Number', q.'Transaction.AQB__Type__c' as 'Transaction Type', q.'COA.Name' as 'Designation', q.'Transaction.ARCH_CreditedFiscalYearDate__c' as 'ARCH Credited Fiscal Year Date', 'Id' as 'Id', 'Transaction.Id' as 'Transaction.Id', 'Account.Id' as 'Account.Id', q.'COA.Id' as 'COA.Id', sum(q.'Transaction.AQB__Amount__c') as 'A';\nq = order q by ('Account Name' asc, 'Gift/Pledge Number' asc, 'Gift/Pledge Type' asc, 'Transaction Type' asc, 'Designation' asc, 'ARCH Credited Fiscal Year Date' asc);\nq = limit q 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","