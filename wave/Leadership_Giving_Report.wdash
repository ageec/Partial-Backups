"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Leadership_Giving_Report_500k_to_1_Million":{"broadcastFacet":true,"groups":[],"label":"Leadership Giving Report 500k - 1 Million","numbers":[],"query":"q = load \"Advanced_Contact_Search\";\nq = filter q by 'Grain' == \"University\";\nq = filter q by 'Danforth_Leadership.Danforth_Leadership_Level' == \"Life Eliot Society Benefactor\";\nq = filter q by 'Account.Record_Type.Name' == \"Household\";\nq = filter q by 'Contact.AQB__IsPrimaryContact__c' == \"Yes\";\nq = filter q by 'Contact.AQB__Deceased__c' == \"false\";\nq = foreach q generate q.'Account.ARCH_Account_ID__c' as 'ARCH Account ID', q.'Contact.ARCH_Sort_Name__c' as 'Primary Contact Sort Name', q.'Account.Name' as 'Account Name', 'Contact.Name' as 'Primary Contact Name', \ncase \n    when 'Contact_Recipe.SecondaryContact.AQB__Deceased__c' == \"true\"\n    then \"-\"\n    else 'Contact_Recipe.SecondaryContact.Name'\nend as 'Secondary Contact Name',\nq.'Danforth_Leadership.SUM_Amount' as 'Lifetime Leadership Amount', q.'Danforth_Leadership.Threshold' as 'Leadership Giving Threshold', q.'Danforth_Leadership.Danforth_Leadership_Date' as 'Leadership Giving Threshold Date', q.'Relationship_Manager.User.Name' as 'Relationship Manager', q.'Account.ARCH_PrimaryGiftOfficerName__c' as 'Primary Gift Officer', q.'Account.AQB__Greeting__c' as 'Account Greeting', q.'Contact.AQB__Greeting__c' as 'Primary Contact Greeting', \nq.'Spouse.Contact.AQB__Greeting__c' as 'Secondary Contact Greeting', 'Contact_Recipe.Contact_Email.AQB__Email__c' as 'Primary Contact Preferred Email', q.'Contact_Recipe.Spouse_Email.AQB__Email__c' as 'Secondary Contact Preferred Email', q.'Account.AQB__MailingName__c' as 'Account Mailing Name Line One', 'Account.AQB__MailingNameLineTwo__c' as 'Account Mailing Name Line Two', q.'Account.BillingStreet' as 'Billing Street', q.'Account.BillingCity' as 'Billing City', q.'Account.BillingState' as 'Billing State', q.'Account.BillingPostalCode' as 'Billing Zip/Postal Code', q.'Account.ARCH_Territory__c' as 'Territory', q.'Account.ARCH_Target_Market__c' as 'Target Market', q.'Account.ARCH_Metro_Area__c' as 'Metro Area', q.'Contact.Institutional_Suffix' as 'Primary Contact Institutional Suffix', q.'Spouse.Contact.AQB__InstitutionalSuffix__c' as 'Secondary Contact Institutional Suffix',  q.'Account.Type' as 'Account Type', q.'Secondary_Account_Types' as 'Secondary Account Types', date_to_string(toDate('Gift.Last_Date_sec_epoch'), \"yyyy-MM-dd\") as 'Most Recent Gift/Pledge Date', q.'Designation.Last_Designation' as 'Most Recent Gift/Pledge Designation', q.'Gift.Last_Amount' as 'Most Recent Gift/Pledge Amount', date_to_string(toDate('Account.AQB__FirstGiftPledgeDate__c_sec_epoch'), \"yyyy-MM-dd\") as 'First Gift/Pledge Date', q.'Designation.First_Designation' as 'First Gift/Pledge Designation', q.'Gift.First_Amount' as 'First Gift/Pledge Amount', date_to_string(toDate('Gift.Largest_Date_sec_epoch'),\"yyyy-MM-dd\") as 'Largest Gift/Pledge Date', q.'Designation.Largest_Designation' as 'Largest Gift/Pledge Designation', q.'Gift.Largest_Amount' as 'Largest Gift/Pledge Amount', date_to_string(toDate('Date.Largest_Unit_Last_Gift_Date_sec_epoch'),\"yyyy-MM-dd\") as 'Largest School/Unit Last Gift Date', q.'Largest_Unit.COA.AQB__SchoolUnit__c' as 'Largest School/Unit Name', date_to_string(toDate('Activity_Report.Last_Activity_Report_Date_sec_epoch'),\"yyyy-MM-dd\") as 'Last Activity Report Date', date_to_string(toDate('Last_Substantive_Activity_Report.Activity_Report.AQB__Date__c_sec_epoch'),\"yyyy-MM-dd\") as 'Last Substantive Activity Date', q.'FY00_Loyalty.AQB__Count__c' as 'CFY Consecutive Years', q.'Count.Gift_Records' as 'Number of Gift Records', q.'AccountInterests.AllAccountInterestTypesList' as 'All Account Interest Types', q.'Account.Id' as 'Account ID', q.'Contact.Id' as 'Contact ID',\ncase\n    when 'Contact_Recipe.SecondaryContact.AQB__Deceased__c' == \"true\"\n    then \"-\"\n    else q.'Contact_Recipe.SecondaryContact.Id' \n    end as 'Secondary Contact ID';\nq = order q by 'Primary Contact Sort Name' asc;\nq = limit q 10000;","receiveFacetSource":{"mode":"include","steps":["Danforth_Leadership__11","Account_Name_3","Account_Name_3_1"]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"rgb(225, 229, 238)","borderWidth":1,"cell":{"backgroundColor":"rgb(242, 246, 250)","fontColor":"rgb(22, 50, 92)","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"rgb(242, 246, 250)","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"rgb(169, 183, 199)","innerMinorBorderColor":"rgb(225, 229, 238)","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"rgb(255, 255, 255)","showActionMenu":true,"totals":true,"verticalPadding":4},"type":"table"}},"Danforth_Leadership__10":{"broadcastFacet":true,"datasets":[{"name":"Advanced_Contact_Search"}],"isGlobal":false,"label":"Danforth_Leadership__10","query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[[\"Danforth_Leadership.FiveMillionLeadershipDate_Year\",\"Danforth_Leadership.FiveMillionLeadershipDate_Month\",\"Danforth_Leadership.FiveMillionLeadershipDate_Day\"]]}","version":-1.0},"receiveFacetSource":{"mode":"include","steps":["Danforth_Leadership__7","Danforth_Leadership__9","Account_Name_3_3","Account_Name_3_4"]},"selectMode":"multi","type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high"