editedFiscalYearsPassed == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}\";\nq = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq = group q by ('DonorID', 'COA.ARCH_Primary_Reporting_Value__c', SchoolUnitToggle);\nq = foreach q generate q.'DonorID' as 'DonorID', q.'COA.ARCH_Primary_Reporting_Value__c' as 'COA.ARCH_Primary_Reporting_Value__c', sum(q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c', SchoolUnitToggle;\nq = filter q by 'Transaction.AQB__Amount__c' != 0;\nq1 = load \"UAPerformancePhilanthropicStrategyGoalsRecipeOutput\";\nq1 = filter q1 by Goal == \"# of Donors\";\nq1 = filter q1 by Fiscal_Years_Passed == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}\";\nq2 = cogroup q by 'SchoolUnitToggle' full, q1 by 'School';\nq2 = foreach q2 generate first(q.'COA.ARCH_Primary_Reporting_Value__c') as 'COA.ARCH_Primary_Reporting_Value__c', first(q1.School) as School, sum(q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c', unique(q.'DonorID') as 'DonorID', sum(q1.'Amount') as 'Goal', coalesce(unique(q.'DonorID'),0)/coalesce(sum(q1.'Amount'),0) as '% to Goal';\nq2 = foreach q2 generate coalesce('COA.ARCH_Primary_Reporting_Value__c', School) as 'COA.ARCH_Primary_Reporting_Value__c', sum('Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c', sum('DonorID') as 'DonorID', sum('Goal') as 'Goal', sum('% to Goal') as '% to Goal';\nq2 = group q2 by rollup('COA.ARCH_Primary_Reporting_Value__c');\nq2 = foreach q2 generate q2.'COA.ARCH_Primary_Reporting_Value__c' as 'COA.ARCH_Primary_Reporting_Value__c', sum(q2.'DonorID') as '# - Donor Count',\ncoalesce(sum(q2.'Goal'),0) as 'Goal', sum(q2.'% to Goal') as '% to Goal', grouping('COA.ARCH_Primary_Reporting_Value__c') as 'grouping_Primary Reporting Value';\ns = filter q2 by 'grouping_Primary Reporting Value' ==1;\nq2 = filter q2 by 'grouping_Primary Reporting Value' ==0;\nq2 = order q2 by 'COA.ARCH_Primary_Reporting_Value__c' asc;\nq2 = limit q2 2000;\nq2 = union q2, s;\nq2 = limit q2 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"CFY_Donor_Count_Medi_3":{"broadcastFacet":true,"datasets":[{"name":"GiftAndPledgeTransactionsExtension"}],"isGlobal":false,"label":"CFY Donor Count Medical Advancement","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[],"rowTotals":[],"sourceFilters":{"GiftAndPledgeTransactionsExtension":{"filters":[["COA.ARCH_Primary_Reporting_Value__c",["School of Medicine (excluding Siteman)","Siteman Cancer Center","School of Medicine"],"in"],["Transaction.AQB__Type__c",["Grant Payment","Payment"],"in"],["Transaction.ARCH_Non_Philanthropic__c",["false"],"in"],["ARCHCreditedFiscalYearsPassed",["{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}"],"in"]]},"Territory_Goals":{"filters":[["Goal",["Cash Received"],"in"]]}},"sources":[{"columns":[{"field":["unique","DonorID"],"name":"A"}],"filters":[],"groups":["all"],"joins":[],"name":"GiftAndPledgeTransactionsExtension"},{"columns":[{"formula":"null