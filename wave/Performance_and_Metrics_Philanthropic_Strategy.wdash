ters":[],"groups":[],"joins":[]}]},"receiveFacetSource":{"mode":"include","steps":["School_Unit_Toggle_1"]},"selectMode":"single","sortable":true,"type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","B","C"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Cash_Received_Medica_1":{"broadcastFacet":true,"groups":[],"label":"Cash Received Number","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by SchoolUnitToggle is not null;\nq = filter q by 'Contact.Position' == 1;\nq = filter q by 'SoftCreditTransaction.Contact.ContactRowNumber' <= 1;\nq = filter q by 'SoftCreditTransaction.SoftCreditRowNumber' <= 1;\nq = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq = filter q by ('Name' != \"015672867\" || 'Name' is null);\nq = filter q by ARCHCreditedFiscalYearsPassed == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}\";\n\n--load goals\nq1 = load \"UAPerformancePhilanthropicStrategyGoalsRecipeOutput\";\nq1 = filter q1 by Goal == \"$ of Cash\";\nq1 = filter q1 by Fiscal_Years_Passed == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}\";\n\n--join goals to results and calculate % to goal\nq2 = cogroup q by SchoolUnitToggle full, q1 by School;\nq2 = foreach q2 generate sum(q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c', sum(q1.'Amount') as 'Goal';\nq2 = group q2 by all;\nq2 = foreach q2 generate sum('Transaction.AQB__Amount__c') as '$ - Cash Received', sum('Goal') as 'Goal', coalesce(sum('Transaction.AQB__Amount__c'),0)/coalesce(sum('Goal'),0) as '% to Goal';\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"New_Production_With__6":{"broadcastFacet":true,"groups":[],"label":"Cash Received Table","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by SchoolUnitToggle is not null;\nq = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"] and 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\nq = filter q by ('Name' != \"015672867\" || 'Name' is null);\nq = group q by ('Id', 'Transaction.Name', 'COA.ARCH_Primary_Reporting_Value__c', SchoolUnitToggle);\nq = foreach q generate q.'Id' as 'Id', q.'Transaction.Name' as 'Transaction.Name', q.'COA.ARCH_Primary_Reporting_Value__c' as 'COA.ARCH_Primary_Reporting_Value__c', avg(q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c', SchoolUnitToggle;\n\nq1 = load \"UAPerformancePhilanthropicStrategyGoalsRecipeOutput\";\nq1 = filter q1 by Goal == \"$ of Cash\";\nq1 = filter q1 by Fiscal_Years_Passed == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}\";\n\nq2 = cogroup q by 'SchoolUnitToggle' full, q1 by 'School';\nq2 = foreach q2 generate first(q.'COA.ARCH_Primary_Reporting_Value__c') as 'COA.ARCH_Primary_Reporting_Value__c', first(q1.School) as School,\nsum(q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c', \nsum(q1.'Amount') as 'Goal', \ncoalesce(sum(q.'Transaction.AQB__Amount__c'),0)/coalesce(sum(q1.'Amount'),0) as '% to Goal';\n\nq2 = foreach q2 generate coalesce('COA.ARCH_Primary_Reporting_Value__c', School) as 'COA.ARCH_Primary_Reporting_Value__c', \nsum('Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c', \nsum('Goal') as 'Goal', \nsum('% to Goal') as '% to Goal';\n\nq2 = group q2 by rollup('COA.ARCH_Primary_Reporting_Value__c');\nq2 = foreach q2 generate q2.'COA.ARCH_Primary_Reporting_Value__c' as 'COA.ARCH_Primary_Reporting_Value__c', \nsum(q2.'Transaction.AQB__Amount__c') as '$ - Cash Received',\ncoalesce(sum(q2.'Goal'),0) as 'Goal', \nsum(q2.'% to Goal') as '% to Goal',\ngrouping('COA.ARCH_Primary_Reporting_Value__c') as 'grouping_Primary Reporting Value';\n\ns = filter q2 by 'grouping_Primary Reporting Value' ==1;\n\nq2 = filter q2 by 'grouping_Primary Reporting Value' ==0;\nq2 = order q2 by 'COA.ARCH_Primary_Reporting_Value__c' asc;\nq2 = limit q2 2000;\nq2 = union q2, s;\nq2 = limit q2 2001;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"New_Production_With__4":{"broadcastFacet":true,"groups":[],"label":"New Production With Bequests Table","numbers":[],"query":"\nq = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by SchoolUnitToggle is not null;\nq = filter q by date('NewProductionARCHCreditedFiscalYearDate_Year', 'NewProductionARCHCreditedFiscalYearDate_Month', 'NewProductionARCHCreditedFiscalYearDate_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\nq = filter q by ('Name' != \"015672867\" || 'Name' is null);\nq = group q by ('Id', 'Transaction.Name', 'COA.ARCH_Primary_Reporting_Value__c', 'SchoolUnitToggle');\nq = foreach q generate q.'Id' as 'Id', q.'Transaction.Name' as 'Transaction.Name', q.'COA.ARCH_Primary_Reporting_Value__c' as 'COA.ARCH_Primary_Reporting_Value__c', 'SchoolUnitToggle', avg(q.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests';\n\nq1 = load \"UAPerformancePhilanthropicStrategyGoalsRecipeOutput\";\nq1 = filter q1 by Goal == \"$ of New Production + Bequests\";\nq1 = filter q1 by Fiscal_Years_Passed == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}\";\n\nq2 = cogroup q by 'SchoolUnitToggle' full, q1 by 'School';\nq2 = foreach q2 generate first(q.'COA.ARCH_Primary_Reporting_Value__c') as 'COA.ARCH_Primary_Reporting_Value__c', first(q1.School) as School,\nsum(q.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests', \nsum(q1.'Amount') as 'Goal', \ncoalesce(sum(q.'NewProductionAmountWithBequests'),0)/coalesce(sum(q1.'Amount'),0) as '% to Goal';\n\nq2 = foreach q2 generate coalesce('COA.ARCH_Primary_Reporting_Value__c', School) as 'COA.ARCH_Primary_Reporting_Value__c', \nsum('NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests', \nsum('Goal') as 'Goal', \nsum('% to Goal') as '% to Goal';\n\nq2 = group q2 by rollup('COA.ARCH_Primary_Reporting_Value__c');\nq2 = foreach q2 generate q2.'COA.ARCH_Primary_Reporting_Value__c' as 'COA.ARCH_Primary_Reporting_Value__c', \nsum(q2.'NewProductionAmountWithBequests') as '$ - Amount',\ncoalesce(sum(q2.'Goal'),0) as 'Goal', \nsum(q2.'% to Goal') as '% to Goal',\ngrouping('COA.ARCH_Primary_Reporting_Value__c') as 'grouping_Primary Reporting Value';\n\ns = filter q2 by 'grouping_Primary Reporting Value' ==1;\n\nq2 = filter q2 by 'grouping_Primary Reporting Value' ==0;\nq2 = order q2 by 'COA.ARCH_Primary_Reporting_Value__c' asc;\nq2 = limit q2 2000;\nq2 = union q2, s;\nq2 = limit q2 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"oddRowColor":"#f