:[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"School_Unit_Toggle_1":{"broadcastFacet":true,"datasets":[{"name":"Opportunity_Info"},{"name":"GiftAndPledgeTransactionsExtension"}],"isGlobal":false,"label":"School/Unit Toggle","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[{"name":"Opportunity.Component.SchoolUnitToggle","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{"OpportunityDetail":{"filters":[["Opportunity.CloseDate",[["fiscal_year",0],["fiscal_year",0]],"between"]]}},"sources":[{"cogroupType":"full","columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["Opportunity.Component.SchoolUnitToggle"],"joins":[],"name":"Opportunity_Info"},{"columns":[{"formula":"\"#D9D9D6\"","name":"B"},{"formula":"\"#020821\"","name":"C"},{"formula":"\"#D7D2CB\"","name":"D"}],"filters":[],"groups":["SchoolUnitToggle"],"joins":[],"name":"GiftAndPledgeTransactionsExtension"}]},"receiveFacetSource":{"mode":"exclude","steps":[]},"selectMode":"multi","sortable":true,"start":"[]","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","B","C","D","Opportunity.Component.SchoolUnitToggle"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"New_Production_With__1":{"broadcastFacet":true,"groups":[],"label":"$ - New Production With Bequests Number","numbers":[],"query":"--load gift/pledge\nq = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by SchoolUnitToggle is not null;\nq = filter q by 'Contact.Position' == 1;\nq = filter q by 'SoftCreditTransaction.Contact.ContactRowNumber' <= 1;\nq = filter q by 'SoftCreditTransaction.SoftCreditRowNumber' <= 1;\nq = filter q by ('Name' != \"015672867\" || 'Name' is null);\nq = filter q by NewProductionARCHCreditedFiscalYearsPassed == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}\";\n\n--load goals\nq1 = load \"UAPerformancePhilanthropicStrategyGoalsRecipeOutput\";\nq1 = filter q1 by Goal == \"$ of New Production + Bequests\";\nq1 = filter q1 by Fiscal_Years_Passed == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}\";\n\n--join goals to results and calculate % to goal\nq2 = cogroup q by SchoolUnitToggle full, q1 by School;\nq2 = foreach q2 generate sum(q.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests', first(q.'COA.ARCH_Primary_Reporting_Value__c') as 'COA.ARCH_Primary_Reporting_Value__c', sum(q1.'Amount') as 'Goal';\nq2 = group q2 by all;\nq2 = foreach q2 generate sum('NewProductionAmountWithBequests') as '$ - NewProductionAmountWithBequests', sum('Goal') as 'Goal', coalesce(sum('NewProductionAmountWithBequests'),0)/coalesce(sum('Goal'),0) as '% to Goal';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},