_A by 'AccountType';\nq = foreach q generate q.'AccountType' as 'AccountType', sum(q_A.'ComprehensiveCampaignAmount') as 'B';\nq = group q by 'AccountType';\nq = foreach q generate 'AccountType', first(B) as 'Campaign Amount', sum(B)/sum(sum(B)) over ([..] partition by all) as 'Account Type Percentage';\ns = group q by 'AccountType';\ns = foreach s generate sum(sum('Campaign Amount')) over([..] partition by all) as 'Campaign Amount_total', sum(sum('Account Type Percentage')) over([..] partition by all) as 'Account Type Percentage_total';\ns = limit s 1;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#54698d","borderWidth":1,"cell":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12,"textWrap":true},"columnProperties":{},"columnSubtotals":true,"columns":["Account Type Percentage","Campaign Amount","Campaign Amount_total","Account Type Percentage_total","AccountType"],"customBulkActions":[],"header":{"backgroundColor":"#335779","fontColor":"#ffffff","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#54698d","interactions":[],"mode":"fittocontainer","numberOfLines":1,"pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":4},"type":"table"}},"Account_Type_Filter_1":{"broadcastFacet":true,"datasets":[{"name":"GiftAndPledgeTransactionsExtension"}],"isGlobal":false,"label":"Account Type Filter","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[{"name":"AccountType","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{},"sources":[{"columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["AccountType"],"joins":[],"name":"GiftAndPledgeTransactionsExtension"},{"columns":[{"formula":