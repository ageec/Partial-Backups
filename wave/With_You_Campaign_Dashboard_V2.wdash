action.ARCH_Classification__c', sum(q.'ComprehensiveCampaignAmount') as 'Campaign Amount', grouping(q.'CampaignPurpose') as 'grouping_CampaignPurpose', grouping(q.'Transaction.ARCH_Classification__c') as 'grouping_Transaction.ARCH_Classification__c';\ns = filter q by 'grouping_CampaignPurpose' == 1;\nq = filter q by 'grouping_CampaignPurpose' == 0 and 'grouping_Transaction.ARCH_Classification__c' == 0;\nq = order q by 'CampaignPurpose' desc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":false},"columnProperties":{},"columnSubtotals":true,"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Giving_Total_by_Camp_2":{"broadcastFacet":true,"groups":[],"label":"Giving Total by Campaign Type Table","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by 'ComprehensiveCampaignAmount' != 0;\nq = group q by ('Transaction.Name','CampaignType');\nq = foreach q generate q.'Transaction.Name' as 'Transaction.Name', q.'CampaignType' as 'CampaignType', avg(q.'ComprehensiveCampaignAmount') as 'ComprehensiveCampaignAmount';\nq = group q by 'CampaignType';\nq = foreach q generate q.'CampaignType' as 'CampaignType', sum(q.'ComprehensiveCampaignAmount') as 'B';\nq = group q by 'CampaignType';\nq = foreach q generate 'CampaignType', first(B) as 'Campaign Amount', sum(B)/sum(sum(B)) over ([..] partition by all) as 'Campaign Contribution Type Percentage';\nq = order q by 'CampaignType' asc;\ns = group q by 'CampaignType';\ns = foreach s generate sum(sum('Campaign Amount')) over([..] partition by all) as 'Campaign Amount_total', sum(sum('Campaign Contribution Type Percentage')) over([..] partition by all) as 'Campaign Contribution Type Percentage_total';\ns = limit s 1;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"rgb(84, 105, 141)","borderWidth":1,"cell":{"backgroundColor":"rgb(22, 50, 92)","fontColor":"#ffffff","fontSize":12,"textWrap":false},"columnProperties":{},"columnSubtotals":true,"columns":["Campaign Contribution Type Percentage","Campaign Amount","Campaign Amount_total","Campaign Contribution Type Percentage_total","CampaignType"],"customBulkActions":[],"header":{"backgroundColor":"#335779","fontColor":"#ffffff","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#54698d","interactions":[],"mode":"fittocontainer","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Opportunity_Gift_Ban_1":{"broadcastFacet":false,"groups":[],"label":"Opportunity Gift Band Detail","numbers":[],"query":"q = load \"Opportunity_Info\";\nq = filter q by ('Opportunity.StageName' not in [\"Closed - Funded No Value\", \"Closed - NPR Funded\", \"Closed - Not Asked\", \"Closed Deceased\", \"Closed Won\", \"Closed/Invalid\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\"] || 'Opportunity.StageName' is null);\nq = filter q by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [dateRange([2019,1,1], [2030,12,31])];\nq = filter q by 'Opportunity.MakeWay' in [\"true\",\"{{coalesce(cell(MakeWayCampaign_1.selection, 0, \"MakeWayCampaign\"), \"false\").asString()}}\"];\nq = group q by ('Account.AQC_Account_ARCH_ID__c', 'Account.Name', 'Opportunity.Name', 'Opportunity.Id', 'Account.Id');\nq = foreach q generate q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'Account.Name' as 'Account.Name', q.'Opportunity.Name' as 'Opportunity.Name', q.'Opportunity.Id' as 'Opportunity.Id', q.'Account.Id' as 'Account.Id', sum(q.'Opportunity.AQC_Ask_Amount__c') as 'Opportunity.AQC_Ask_Amount__c', case when sum(q.'Opportunity.AQC_Ask_Amount__c') >= 100000000 then \"01 - $100,000,000+\" when sum(q.'Opportunity.AQC_Ask_Amount__c') >= 50000000 then \"02 - $50,000,000 to $99,999,999\" when sum(q.'Opportunity.AQC_Ask_Amount__c') >= 25000000 then \"03 - $25,000,000 to $49,999,999\" when sum(q.'Opportunity.AQC_Ask_Amount__c') >= 10000000 then \"04 - $10,000,000 to $24,999,999\" when sum(q.'Opportunity.AQC_Ask_Amount__c') >= 5000000 then \"05 - $5,000,000 to $9,999,999\" when sum(q.'Opportunity.AQC_Ask_Amount__c') >= 1000000 then \"06 - $1,000,000 to $4,999,999\" when sum(q.'Opportunity.AQC_Ask_Amount__c') >= 500000 then \"07 - $500,000 to $999,999\" when sum(q.'Opportunity.AQC_Ask_Amount__c') >= 250000 then \"08 - $250,000 to $499,999\" when sum(q.'Opportunity.AQC_Ask_Amount__c') >= 100000 then \"09 - $100,000 to $249,999\" when sum(q.'Opportunity.AQC_Ask_Amount__c') >= 50000 then \"10 - $50,000 to $99,999\" when sum(q.'Opportunity.AQC_Ask_Amount__c') >= 25000 then \"11 - $25,000 to $49,999\" else \"12 - $1 to $24,999\" end as 'Campaign Gift Band';\nq = group q by rollup('Campaign Gift Band', 'Account.AQC_Account_ARCH_ID__c', 'Account.Name', 'Opportunity.Name', 'Opportunity.Id', 'Account.Id');\nq = foreach q generate q.'Campaign Gift Band' as 'Campaign Gift Band', q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'Account.Name' as 'Account.Name', q.'Opportunity.Name' as 'Opportunity.Name', q.'Opportunity.Id' as 'Opportunity.Id', q.'Account.Id' as 'Account.Id', sum(q.'Opportunity.AQC_Ask_Amount__c') as 'A', grouping(q.'Campaign Gift Band') as 'grouping_Campaign Gift Band', grouping(q.'Account.AQC_Account_ARCH_ID__c') as 'grouping_Account.AQC_Account_ARCH_ID__c', grouping(q.'Account.Name') as 'grouping_Account.Name', grouping(q.'Opportunity.Name') as 'grouping_Opportunity.Name', grouping(q.'Opportunity.Id') as 'grouping_Opportunity.Id', grouping(q.'Account.Id') as 'grouping_Account.Id';\ns = filter q by 'grouping_Campaign Gift Band' == 1;\nq = filter q by 'grouping_Campaign Gift Band' == 0 and 'grouping_Account.AQC_Account_ARCH_ID__c' == 0 and 'grouping_Account.Name' == 0 and 'grouping_Opportunity.Name' == 0 and 'grouping_Opportunity.Id' == 0 and 'grouping_Account.Id' == 0;\nq = order q by ('Campaign Gift Band' asc, 'Account.AQC_Account_ARCH_ID__c' asc, 'Account.Name' asc, 'Opportunity.Name' asc, 'Opportunity.Id' asc, 'Account.Id' asc);\nq = limit q 2000;\nq = union q, s;\nq = filter q by 'Campaign Gift Band' in [\"{{coalesce(cell(lens_5.selection, 0, \"Campaign Gift Band\"), \"\").asString()}}\"];\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":false},"columnProperties":{},"columns":["Campaign Gift Band","Account.AQC_Account_ARCH_ID__c","Account.Name","Opportunity.Name","A"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fitt