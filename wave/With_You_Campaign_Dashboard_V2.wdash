teMonth', avg(q_A.'ComprehensiveCampaignAmount') as 'ComprehensiveCampaignAmount';\nq = group q by ('Credited_Fiscal_Year_Date_MMDDYYYY_Year_Fiscal', 'Credited_Fiscal_Year_Date_MMDDYYYY_Month_Fiscal', 'CreditedFYDateMonth'), q_A by ('Credited_Fiscal_Year_Date_MMDDYYYY_Year_Fiscal', 'Credited_Fiscal_Year_Date_MMDDYYYY_Month_Fiscal', 'CreditedFYDateMonth');\nq = foreach q generate q.'Credited_Fiscal_Year_Date_MMDDYYYY_Year_Fiscal' as 'Credited_Fiscal_Year_Date_MMDDYYYY_Year_Fiscal', q.'Credited_Fiscal_Year_Date_MMDDYYYY_Month_Fiscal' as 'Credited_Fiscal_Year_Date_MMDDYYYY_Month_Fiscal', q.'CreditedFYDateMonth' as 'CreditedFYDateMonth', sum(q_A.'ComprehensiveCampaignAmount') as 'A';\nq = group q by ('Credited_Fiscal_Year_Date_MMDDYYYY_Year_Fiscal', 'Credited_Fiscal_Year_Date_MMDDYYYY_Month_Fiscal', 'CreditedFYDateMonth');\nq = foreach q generate 'Credited_Fiscal_Year_Date_MMDDYYYY_Year_Fiscal', 'Credited_Fiscal_Year_Date_MMDDYYYY_Month_Fiscal', 'CreditedFYDateMonth', first(A) as 'Campaign Amount', sum(sum(A)) over ([..0] partition by all order by ('Credited_Fiscal_Year_Date_MMDDYYYY_Year_Fiscal','Credited_Fiscal_Year_Date_MMDDYYYY_Month_Fiscal','CreditedFYDateMonth')) as 'Running Total';\nq = order q by ('Credited_Fiscal_Year_Date_MMDDYYYY_Year_Fiscal' asc, 'Credited_Fiscal_Year_Date_MMDDYYYY_Month_Fiscal' asc, 'CreditedFYDateMonth' asc);\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":false,"customSize":"auto","position":"bottom-center","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"vbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"binValues":false,"columnMap":{"trellis":[],"dimensionAxis":["Credited_Fiscal_Year_Date_MMDDYYYY_Year_Fiscal","CreditedFYDateMonth"],"plots":["Running Total"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":false,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Gift_Table_Detail_1":{"broadcastFacet":false,"groups":[],"label":"Gift Table Detail","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by 'ComprehensiveCampaignAmount' != 0;\nq_A = group q by ('Transaction.Name', 'ARCHAccountID', 'AccountName', 'AccountID');\nq_A = foreach q_A generate q_A.'Transaction.Name' as 'Transaction.Name', q_A.'ARCHAccountID' as 'ARCHAccountID', q_A.'AccountName' as 'AccountName',  q_A.'AccountID' as 'AccountID', avg(q_A.'ComprehensiveCampaignAmount') as 'ComprehensiveCampaignAmount';\nq_A = group q_A by ('ARCHAccountID', 'AccountName', 'AccountID');\nq_A = foreach q_A generate q_A.'ARCHAccountID' as 'ARCHAccountID', q_A.'AccountName' as 'AccountName',  q_A.'AccountID' as 'AccountID', sum(q_A.'ComprehensiveCampaignAmount') as 'ComprehensiveCampaignAmount', case when sum(q_A.'ComprehensiveCampaignAmount') >= 100000000 then \"01 - $100,000,000+\" when sum(q_A.'ComprehensiveCampaignAmount') >= 50000000 then \"02 - $50,000,000 to $99,999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 25000000 then \"03 - $25,000,000 to $49,999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 10000000 then \"04 - $10,000,000 to $24,999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 5000000 then \"05 - $5,000,000 to $9,999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 1000000 then \"06 - $1,000,000 to $4,999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 500000 then \"07 - $500,000 to $999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 250000 then \"08 - $250,000 to $499,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 100000 then \"09 - $100,000 to $249,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 50000 then \"10 - $50,000 to $99,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 25000 then \"11 - $25,000 to $49,999\" else \"12 - $1 to $24,999\" end as 'Campaign Gift Band';\nq = group q_A by ('Campaign Gift Band', 'ARCHAccountID', 'AccountName', 'AccountID');\nq = foreach q generate q.'Campaign Gift Band' as 'Campaign Gift Band', q.'ARCHAccountID' as 'ARCHAccountID', q.'AccountName' as 'AccountName', q.'AccountID' as 'AccountID', sum(q_A.'ComprehensiveCampaignAmount') as 'ComprehensiveCampaignAmount';\nq = group q by rollup('Campaign Gift Band', 'ARCHAccountID', 'AccountName', 'AccountID');\nq = foreach q generate q.'Campaign Gift Band' as 'Campaign Gift Band', q.'ARCHAccountID' as 'ARCHAccountID', q.'AccountName' as 'AccountName', q.'AccountID' as 'AccountID', sum(q.'ComprehensiveCampaignAmount') as 'Campaign Amount', grouping(q.'Campaign Gift Band') as 'grouping_Campaign Gift Band', grouping(q.'ARCHAccountID') as 'grouping_ARCHAccountID', grouping(q.'AccountName') as 'grouping_AccountName', grouping(q.'AccountID') as 'grouping_AccountID';\ns = filter q by 'grouping_Campaign Gift Band' == 1;\nq = filter q by 'grouping_Campaign Gift Band' == 0 and 'grouping_ARCHAccountID' == 0 and 'grouping_AccountName' == 0 and 'grouping_AccountID' == 0;\nq = order q by 'Campaign Gift Band' asc;\nq = limit q 50000;\nq = union q, s;\nq = filter q by 'Campaign Gift Band' in [\"{{coalesce(cell(lens_5.selection, 0, \"Campaign Gift Band\"), \"\").asString()}}\"];\nq = limit q 50001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":false},"collapsible":false,"columnProperties":{},"columns":["Campaign Gift Band","ARCHAccountID","AccountName","Campaign Amount"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":12},"type":"table"}},"Gift_Band_Chart_1":{"broadcastFacet":false,"groups":[],"label":"Gift Band Chart","numbers":[],"query":"q1 = load \"GiftAndPledgeTransactionsExtension\";\nq2 = load \"CampaignGoals\";\nq2 = filter q2 by 'Gift_Band' is not null;\nq2_C = filter q2 by 'Make_Way' == \"{{coalesce(cell(MakeWayCampaign_1.selection, 0, \"MakeWayCampaign\"), \"false\").asString()}}\";\nq2_B = filter q2 by 'Make_Way' == \"{{coalesce(cell(MakeWayCampaign_1.selection, 0, \"MakeWayCampaign\"), \"false\").asString()}}\";\nq2 = cogroup q2_C by 'Gift_Band' full, q2_B by 'Gift_Band';\nq2 = foreach q2 generate coalesce(q2_C.'Gift_Band', q2_B.'Gift_Band') as 'Gift_Band', max(q2_C.'Target_Gifts') as 'C', max(q2_B.'Total_Donors_Needed') as 'B';\nq_A = group q1 by ('Transaction.Name', 'AccountID');\nq_A = foreach q_A generate q_A.'Transaction.Name' as 'Transaction.Name', q_A.'AccountID' as 'AccountID', avg(q_A.'ComprehensiveCampaignAmount') as 'ComprehensiveCampaignAmount';\nq_A = group q_A by ('AccountID');\nq_A = foreach q_A generate q_A.'AccountID' as 'AccountID', sum(q_A.'ComprehensiveCampaignAmount') as 'ComprehensiveCampaignAmount', case when sum(q_A.'ComprehensiveCampaignAmount') >= 100000000 then \"01 - $100,000,000+\" when sum(q_A.'ComprehensiveCampaignAmount') >= 50000000 then \"02 - $50,000,000 to $99,999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 25000000 then \"03 - $25,000,000 to $49,999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 10000000 then \"04 - $10,000,000 to $24,999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 5000000 then \"05 - $5,000,000 to $9,999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 1000000 then \"06 - $1,000,000 to $4,999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 500000 then \"07 - $500,000 to $999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 250000 then \"08 - $250,000 to $499,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 100000 then \"09 - $100,000 to $249,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 50000 then \"10 - $50,000 to $99,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 25000 then \"11 - $25,000 to $49,999\" else \"12 - $1 to $24,999\" end as 'GiftBand';\nq = cogroup q2 by 'Gift_Band' full, q_A by 'GiftBand';\nq = foreach q generate coalesce(q_A.'GiftBand', q2.'Gift_Band') as 'Campaign Gift Band', first(q2.'C') as 'C', coalesce(sum(q_A.'ComprehensiveCampaignAmount'),0) as 'D';\nq = group q by 'Campaign Gift Band';\nq = foreach q generate 'Campaign Gift Band', first('C') as 'C', first('D') as 'D';\nq = foreach q generate 'Campaign Gift Band', 'C' as 'Target Gifts', 'D' as 'Total Giving to Date', case when coalesce(C,0)-coalesce(D,0) < 0 then 0 else coalesce(C,0)-coalesce(D,0) end as 'Gifts Still Needed';\nq = order q by 'Campaign Gift Band' asc;\nq = limit q 2000;","receiveFacetSou