'Primary_Reporting_Value_Group');\nq_A = foreach q_A generate q_A.'Transaction.Name' as 'Transaction.Name', q_A.'Primary_Reporting_Value_Group' as 'Primary_Reporting_Value_Group', avg(q_A.'ComprehensiveCampaignAmount') as 'ComprehensiveCampaignAmount';\nq = group q by 'Primary_Reporting_Value_Group', q_A by 'Primary_Reporting_Value_Group';\nq = foreach q generate q.'Primary_Reporting_Value_Group' as 'Primary_Reporting_Value_Group', sum(q_A.'ComprehensiveCampaignAmount') as 'B';\nq = group q by 'Primary_Reporting_Value_Group';\nq = foreach q generate 'Primary_Reporting_Value_Group', first(B) as 'Campaign Amount', sum(B)/sum(sum(B)) over ([..] partition by all) as 'Percentage';\ns = group q by 'Primary_Reporting_Value_Group';\ns = foreach s generate sum(sum('Campaign Amount')) over([..] partition by all) as 'Campaign Amount_total', sum(sum('Percentage')) over([..] partition by all) as 'Percentage_total';\ns = limit s 1;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_4":{"broadcastFacet":true,"datasets":[{"name":"Opportunity_Info"}],"isGlobal":false,"label":"Expected Opportunity Amount by Fiscal Year and Fiscal Month","query":{"aggregateFilters