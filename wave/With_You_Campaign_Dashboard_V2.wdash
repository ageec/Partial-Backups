s":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by 'ComprehensiveCampaignAmount' != 0;\nq = filter q by 'Public_Health_Priority' == \"Public Health\";\nq_A = group q by ('Transaction.Name','AccountType');\nq_A = foreach q_A generate q_A.'Transaction.Name' as 'Transaction.Name', q_A.'AccountType' as 'AccountType', avg(q_A.'ComprehensiveCampaignAmount') as 'ComprehensiveCampaignAmount';\nq = group q by 'AccountType', q_A by 'AccountType';\nq = foreach q generate q.'AccountType' as 'AccountType', sum(q_A.'ComprehensiveCampaignAmount') as 'B';\nq = group q by 'AccountType';\nq = foreach q generate 'AccountType', first(B) as 'Campaign Amount';\ns = group q by 'AccountType';\ns = foreach s generate sum(sum('Campaign Amount')) over([..] partition by all) as 'Campaign Amount_total';\ns = limit s 1;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"totals":false,"verticalPadding":8},"type":"table"}},"Monthly_Total_Princi_1":{"broadcastFacet":true,"datasets":[{"name":"GiftAndPledgeTransactionsExtension"}],"isGlobal":false,"label":"Major/Principal Gifts ($100,000+) vs. Annual/Leadership Gifts ($1 to $99,999) by","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"lim