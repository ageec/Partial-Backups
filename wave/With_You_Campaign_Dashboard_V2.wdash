by rollup('CampaignType', 'Transaction.ARCH_Classification__c');\nq = foreach q generate q.'CampaignType' as 'CampaignType', q.'Transaction.ARCH_Classification__c' as 'Transaction.ARCH_Classification__c', sum(q.'ComprehensiveCampaignAmount') as 'Campaign Amount', grouping(q.'CampaignType') as 'grouping_CampaignType', grouping(q.'Transaction.ARCH_Classification__c') as 'grouping_Transaction.ARCH_Classification__c';\ns = filter q by 'grouping_CampaignType' == 1;\nq = filter q by 'grouping_CampaignType' == 0;\nq = order q by ('CampaignType' asc, 'Transaction.ARCH_Classification__c' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":false},"columnProperties":{},"columnSubtotals":true,"columns":["Campaign Amount","CampaignType","Transaction.ARCH_Classification__c"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Total_By_Type_2":{"broadcastFacet":true,"groups":[],"label":"Giving Total by Campaign Type Donut Chart","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by 'ComprehensiveCampaignAmount' != 0;\nq = group q by ('Transaction.Name','CampaignType');\nq = foreach q generate q.'Transaction.Name' as 'Transaction.Name', q.'CampaignType' as 'CampaignType', avg(q.'ComprehensiveCampaignAmount') as 'ComprehensiveCampaignAmount';\nq = group q by 'CampaignType';\nq = foreach q generate q.'CampaignType' as 'CampaignType', sum(q.'ComprehensiveCampaignAmount') as 'Campaign Amount';\nq = order q by 'Campaign Amount' desc;\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","centerText":"","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"top-center","inside":false},"showMeasureTitle":false,"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"pie","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"inner":60,"columnMap":{"trellis":[],"dimension":["CampaignType"],"plots":["Campaign Amount"]},"showActionMenu":true,"centerValueType":"number","measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Gift_Band_Total_1":{"broadcastFacet":false,"groups":[],"label":"Gift Band Total","numbers":[],"query":"q1 = load \"GiftAndPledgeTransactionsExtension\";\nq2 = load \"CampaignGoals\";\nq3 = load \"Opportunity_Info\";\nq1 = filter q1 by 'ComprehensiveCampaignAmount' != 0;\nq2 = filter q2 by 'Gift_Band' is not null;\nq3 = filter q3 by ('Opportunity.StageName' not in [\"Closed - Funded No Value\", \"Closed - Funded Unsolicited\", \"Closed - NPR Funded\", \"Closed - Not Asked\", \"Closed Won\", \"Closed/Invalid\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\"] || 'Opportunity.StageName' is null);\nq3 = filter q3 by date('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day') in [dateRange([2019,1,1], [2030,12,31])];\nq3 = filter q3 by 'Opportunity.MakeWay' in [\"true\",\"{{coalesce(cell(MakeWayCampaign_1.selection, 0, \"MakeWayCampaign\"), \"false\").asString()}}\"];\nq2_C = filter q2 by 'Make_Way' == \"{{coalesce(cell(MakeWayCampaign_1.selection, 0, \"MakeWayCampaign\"), \"false\").asString()}}\";\nq2_B = filter q2 by 'Make_Way' == \"{{coalesce(cell(MakeWayCampaign_1.selection, 0, \"MakeWayCampaign\"), \"false\").asString()}}\";\nq2 = cogroup q2_C by 'Gift_Band' full, q2_B by 'Gift_Band';\nq2 = foreach q2 generate coalesce(q2_C.'Gift_Band', q2_B.'Gift_Band') as 'Gift_Band', max(q2_C.'Target_Gifts') as 'C', max(q2_B.'Total_Donors_Needed') as 'B';\nq_A = group q1 by ('Transaction.Name', 'AccountID');\nq_A = foreach q_A generate q_A.'Transaction.Name' as 'Transaction.Name', q_A.'AccountID' as 'AccountID', avg(q_A.'ComprehensiveCampaignAmount') as 'ComprehensiveCampaignAmount';\nq_A = group q_A by ('AccountID');\nq_A = foreach q_A generate q_A.'AccountID' as 'AccountID', sum(q_A.'ComprehensiveCampaignAmount') as 'ComprehensiveCampaignAmount', case when sum(q_A.'ComprehensiveCampaignAmount') >= 100000000 then \"01 - $100,000,000+\" when sum(q_A.'ComprehensiveCampaignAmount') >= 50000000 then \"02 - $50,000,000 to $99,999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 25000000 then \"03 - $25,000,000 to $49,999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 10000000 then \"04 - $10,000,000 to $24,999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 5000000 then \"05 - $5,000,000 to $9,999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 1000000 then \"06 - $1,000,000 to $4,999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 500000 then \"07 - $500,000 to $999,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 250000 then \"08 - $250,000 to $499,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 100000 then \"09 - $100,000 to $249,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 50000 then \"10 - $50,000 to $99,999\" when sum(q_A.'ComprehensiveCampaignAmount') >= 25000 then \"11 - $25,000 to $49,999\" else \"12 - $1 to $24,999\" end as 'GiftBand';\nq_A = filter q_A by 'ComprehensiveCampaignAmount' != 0;\nq3 = group q3 by ('Opportunity.Id');\nq3 = foreach q3 generate q3.'Opportunity.Id' as 'Opportunity.Id', sum(q3.'Opportunity.AQC_Ask_Amount__c') as 'Opportunity.AQC_Ask_Amount__c', case when sum(q3.'Opportunity.AQC_Ask_Amount__c') >= 100000000 then \"01 - $100,000,000+\" when sum(q3.'Opportunity.AQC_Ask_Amount__c') >= 50000000 then \"02 - $50,000,000 to $99,999,999\" when sum(q3.'Opportunity.AQC_Ask_Amount__c') >= 25000000 then \"03 - $25,000,000 to $49,999,999\" when sum(q3.'Opportunity.AQC_Ask_Amount__c') >= 10000000 then \"04 - $10,000,000 to $24,999,999\" when sum(q3.'Opportunity.AQC_Ask_Amount__c') >= 5000000 then \"05 - $5,000,000 to $9,999,999\" when sum(q3.'Opportunity.AQC_Ask_Amount__c') >= 1000000 then \"06 - $1,000,000 to $4,999,999\" when sum(q3.'Opportunity.AQC_Ask_Amount__c') >= 500000 then \"07 - $500,000 to $999,999\" when sum(q3.'Opportunity.AQC_Ask_Amount__c') >= 250000 then \"08 - $250,000 to $499,999\" when sum(q3.'Opportunity.AQC_Ask_Amount__c') >= 100000 then \"09 - $100,000 to $249,999\" when sum(q3.'Opportunity.AQC_Ask_Amount__c') >= 50000 then \"10 - $50,000 to $99,999\" when sum(q3.'Opportunity.AQC_Ask_Amount__c') >= 25000 then \"11 - $25,000 to $49,999\" else \"12 - $1 to $24,999\" end as 'GiftBand';\nq = cogroup q_A by 'GiftBand' full, q2 by 'Gift_Band' full, q3 by 'GiftBand';\nq = foreach q generate coalesce(q_A.'GiftBand', q2.'Gift_Band', q3.'GiftBand') as 'GiftBand', coalesce(unique(q_A.'AccountID'),0) as 'A', first(q2.'B') as 'B', first(q2.'C') as 'C', coalesce(sum(q_A.'ComprehensiveCampaignAmount'),0) as 'D', unique(q3.'Opportunity.Id') as 'H', sum(q3.'Opportunity.AQC_Ask_Amount__c') as 'I';\nq = group q by 'GiftBand';\nq = foreach q generate 'GiftBand', first('A') as 'A', first('B') as 'B', first('C') as 'C', first('D') as 'D', first('H') as 'H', first('I') as 'I', sum(sum('D')) over ([..0] partition by all order by ('GiftBand') asc) as 'J', sum(sum('A')) over ([..0] partition by all order by ('GiftBand')) as 'K';\nq = foreach q generate 'GiftBand' as 'Campaign Gift Band', 'B' as 'Total Donors Needed', 'A' as 'Donors to Date', 'K' as 'Running Total Donors', case when coalesce(B,0)-coalesce(A,0) < 0 then 0 else coalesce(B,0)-coalesce(A,0) end as 'Donors Still Needed', 'C' as 'Target Gifts', 'D' as 'Total Giving to Date', 'J' as 'Running Total', case when coalesce(C,0)-coalesce(D,0) < 0 then 0 else coalesce(C,0)-coalesce(D,0) end as 'Gifts Still Needed', coalesce(D/C,0) as 'Percent to Goal', 'H' as 'Open Opportunities', 'I' as 'Ask Amount';\nq = order q by 'Campaign Gift Band' asc;\ns = group q by all;\ns = foreach s generate \"Total\" as 'Campaign Gift Band', sum(sum(s.'Donors to Date')) over([..] partition by all) as 'Donors to Date', sum(sum(s.'Total Donors Needed')) over([..] partition by all) as 'Total Donors Needed', sum(sum(s.'Target Gifts')) over([..] partition by all) as 'Target Gifts', sum(sum(s.'Total Giving to Date')) over([..] partition by all) as 'Total Giving to Date', sum(sum(s.'Percent to Goal')) over([..] partition by all) as 'Percent to Goal', sum(sum(s.'Donors Still Needed')) over([..] partition by all) as 'Donors Still Needed', sum(sum(s.'Gifts Still Needed')) over([..] partition by all) as 'Gifts Still Needed', sum(sum(s.'Open Opportunities')) over([..] partition by all) as 'Open Opportunities', sum(sum(s.'Ask Amount')) over([..] partition by all) as 'Ask Amount', max(s.'Running Total') as 'Running Total';\ns = limit s 1;","receiveFacetSource":{"mode":"exclude","steps":["lens_5"]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Campaign_Purpose_Don_2":{"broadcastFacet":true,"groups":[],"label":"Giving Total by Campaign Purpose Donut Charts","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by 'ComprehensiveCampaignAmount' != 0;\nq = filter q by 'MakeWayCampaign' == \"true\";\nq = group q by ('Transaction.Name','Transaction.ARCH_Classification__c', 'CampaignPurpose');\nq = foreach q generate q.'Transaction.Name' as 'Transaction.Name', q.'Transaction.ARCH_Classification__c' as 'Transaction.ARCH_Classification__c', q.'CampaignPurpose' as 'CampaignPurpose', avg(q.'ComprehensiveCampaignAmount') as 'ComprehensiveCampaignAmount';\nq = group q by ('Transaction.ARCH_Classification__c', 'CampaignPurpose');\nq = foreach q generate q.'Transaction.ARCH_Classification__c' as 'Transaction.ARCH_Classification__c', q.'CampaignPurpose' as 'CampaignPurpose', sum(q.'ComprehensiveCampaignAmount') as 'Campaign Amount';\nq = order q by 'CampaignPurpose' desc;\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","centerText":"","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"top-center","inside":false},"showMeasureTitle":false,"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"pie","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":true,"showGridLines":false,"size":[100,100],"enable":true,"type":"xy","chartsPerLine":4},"inner":60,"columnMap":{"trellis":["CampaignPurpose"],"dimension":["Transaction.ARCH_Classification__c"],"plots":["Campaign Amount"]},"showActionMenu":true,"centerValueType":"number","measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Total_Campaign_and_N_5":{"broadcastFacet":false,"groups":[],"label":"Total Campaign and Next Progress Numbers","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\