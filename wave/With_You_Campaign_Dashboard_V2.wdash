\"Closed/Won\", \"Closed/Won - No Value\"] || 'Opportunity.StageName' is null);\nq_B = filter q by 'Opportunity.StageName' in [\"Closed Won\", \"Closed/Won\"];\nq = cogroup q_A by ('Account.AQC_Account_ARCH_ID__c', 'Account.Name', 'Account.AQB__Capacity__c', 'Account.Id', 'Opportunity.DesignationCategory1', 'Opportunity.DesignationCategory2') full, q_B by ('Account.AQC_Account_ARCH_ID__c', 'Account.Name', 'Account.AQB__Capacity__c', 'Account.Id', 'Opportunity.DesignationCategory1', 'Opportunity.DesignationCategory2');\nq = foreach q generate coalesce(q_A.'Account.AQC_Account_ARCH_ID__c', q_B.'Account.AQC_Account_ARCH_ID__c') as 'Account.AQC_Account_ARCH_ID__c', coalesce(q_A.'Account.Name', q_B.'Account.Name') as 'Account.Name', coalesce(q_A.'Account.AQB__Capacity__c', q_B.'Account.AQB__Capacity__c') as 'Account.AQB__Capacity__c', coalesce(q_A.'Account.Id', q_B.'Account.Id') as 'Account.Id', coalesce(q_A.'Opportunity.DesignationCategory1', q_B.'Opportunity.DesignationCategory1') as 'Opportunity.DesignationCategory1', coalesce(q_A.'Opportunity.DesignationCategory2', q_B.'Opportunity.DesignationCategory2') as 'Opportunity.DesignationCategory2', sum(q_A.'Opportunity.AQC_Ask_Amount__c') as 'A', sum(q_B.'Opportunity.Amount') as 'B';\nq = foreach q generate 'Account.AQC_Account_ARCH_ID__c', 'Account.Name', 'Account.AQB__Capacity__c', 'Account.Id', 'Opportunity.DesignationCategory1', 'Opportunity.DesignationCategory2', 'A' as 'Total Ask Amount', 'B' as 'Total Closed/Won Amount', case when coalesce(A,0)-coalesce(B,0) < 0 then 0 else coalesce(A,0)-coalesce(B,0) end as 'Remaining Open';\nq = group q by rollup('Account.AQC_Account_ARCH_ID__c', 'Account.Name', 'Account.AQB__Capacity__c', 'Account.Id', 'Opportunity.DesignationCategory1', 'Opportunity.DesignationCategory2');\nq = foreach q generate q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'Account.Name' as 'Account.Name', q.'Account.AQB__Capacity__c' as 'Account.AQB__Capacity__c', q.'Account.Id' as