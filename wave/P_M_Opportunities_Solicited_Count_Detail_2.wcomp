"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"GO___Solicited_by_OT_1":{"broadcastFacet":false,"groups":[],"label":"GO # Solicited by OTM Summary Table","numbers":[],"query":"q1 = load \"OpportunityDetail\";\nq2 = load \"User_Goal_Info\";\nq1 = filter q1 by 'StageName' in [\"Closed - Funded No Value\", \"Closed Won\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\", \"Negotiation/Review\", \"Proposal Submittal\", \"Solicitation\", \"Solicitation (PG)\"];\nq1 = filter q1 by date('AQC_Date_Asked__c_Year', 'AQC_Date_Asked__c_Month', 'AQC_Date_Asked__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by ('OppRecordType.Name' != \"Grateful Patients\" || 'OppRecordType.Name' is null);\nq2 = filter q2 by 'AQB__Classification__c' == \"Number of Opportunities Solicited\";\nq2 = filter q2 by 'GiftOfficerTeam' in [\"Med Alumni\", \"Med/Surg\", \"Neuro\", \"Med CFR\", \"Siteman\", \"Momentum/EVC/VC\", \"Other UA\"];\nq2 = filter q2 by date('AQB__LastGoalIntervalDate__c_Year', 'AQB__LastGoalIntervalDate__c_Month', 'AQB__LastGoalIntervalDate__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq = cogroup q1 by ('OpportunityTeamMember.GiftOfficerTeam', 'OpportunityTeamMember.Name') full, q2 by ('GiftOfficerTeam', 'User.Name');\nq = foreach q generate coalesce(q1.'OpportunityTeamMember.GiftOfficerTeam', q2.'GiftOfficerTeam') as 'OpportunityTeamMember.GiftOfficerTeam', coalesce(q1.'OpportunityTeamMember.Name', q2.'User.Name') as 'OpportunityTeamMember.Name', count(q1) as 'A', sum(q2.'AQB__GoalCount__c') as 'B';\nq = foreach q generate 'OpportunityTeamMember.GiftOfficerTeam', 'OpportunityTeamMember.Name', 'A' as '# Solicited', 'B' as 'Goal', A/B as '% to Goal';\nq = group q by rollup('OpportunityTeamMember.GiftOfficerTeam', 'OpportunityTeamMember.Name');\nq = foreach q generate q.'OpportunityTeamMember.GiftOfficerTeam' as 'OpportunityTeamMember.GiftOfficerTeam', q.'OpportunityTeamMember.Name' as 'OpportunityTeamMember.Name', sum(q.'# Solicited') as '# Solicited', sum(q.'Goal') as 'Goal', sum(q.'# Solicited') / sum(q.'Goal') as '% to Goal', grouping(q.'OpportunityTeamMember.GiftOfficerTeam') as 'grouping_OpportunityTeamMember.GiftOfficerTeam', grouping(q.'OpportunityTeamMember.Name') as 'grouping_OpportunityTeamMember.Name';\ns = filter q by 'grouping_OpportunityTeamMember.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_OpportunityTeamMember.GiftOfficerTeam' == 0 and 'grouping_OpportunityTeamMember.Name' == 0;\nq = order q by ('OpportunityTeamMember.GiftOfficerTeam' asc, 'OpportunityTeamMember.Name' asc);\nq = limit q 10000;\nq = union q, s;\nq = limit q 10001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"PrG_New_Principal_Pa_1":{"broadcastFacet":false,"datasets":[{"name":"Account_Info"},{"name":"P_M_PrG_Goals"}],"isGlobal":false,"label":"PrG New Principal Partner Prospects Summary Table","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[],"rowTotals":[],"sourceFilters":{"P_M_PrG_Goals":{"filters":[["Goal",["New Principal Partner Prospects"],"in"],["Fiscal_Years_Passed",["[[parameter_1]]