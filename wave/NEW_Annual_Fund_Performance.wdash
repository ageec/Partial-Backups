 date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq_U = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nq_V = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"];\nq_W = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"];\nq_X = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"];\nq_C = group q_C by ('Transaction.Name', 'CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_C = foreach q_C generate q_C.'Transaction.Name' as 'Transaction.Name', q_C.'CreditedFYDateMonth' as 'CreditedFYDateMonth', q_C.'ARCHCreditedFiscalYearDate_Month_Fiscal' as 'ARCHCreditedFiscalYearDate_Month_Fiscal', q_C.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_C.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_Q = group q_Q by ('Transaction.Name', 'CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_Q = foreach q_Q generate q_Q.'Transaction.Name' as 'Transaction.Name', q_Q.'CreditedFYDateMonth' as 'CreditedFYDateMonth', q_Q.'ARCHCreditedFiscalYearDate_Month_Fiscal' as 'ARCHCreditedFiscalYearDate_Month_Fiscal', q_Q.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_Q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_R = group q_R by ('Transaction.Name', 'Credited