_Fiscal', sum(q_D.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_D = filter q_D by 'Transaction.AQB__Amount__c' != 0;\nq_U = group q_U by ('DonorID', 'CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_U = foreach q_U generate q_U.'DonorID' as 'DonorID', q_U.'CreditedFYDateMonth' as 'CreditedFYDateMonth', q_U.'ARCHCreditedFiscalYearDate_Month_Fiscal' as 'ARCHCreditedFiscalYearDate_Month_Fiscal', q_U.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_U.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_U = filter q_U by 'Transaction.AQB__Amount__c' != 0;\nq_V = group q_V by ('DonorID', 'CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_V = foreach q_V generate q_V.'DonorID' as 'DonorID', q_V.'CreditedFYDateMonth' as 'CreditedFYDateMonth', q_V.'ARCHCreditedFiscalYearDate_Month_Fiscal' as 'ARCHCreditedFiscalYearDate_Month_Fiscal', q_V.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_V.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_V = filter q_V by 'Transaction.AQB__Amount__c' != 0;\nq_W = group q_W by ('DonorID', 'CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_W = foreach q_W generate q_W.'DonorID' as 'DonorID', q_W.'CreditedFYDateMonth' as 'CreditedFYDateMonth', q_W.'ARCHCreditedFiscalYearDate_Month_Fiscal' as 'ARCHCreditedFiscalYearDate_Month_Fiscal', q_W.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_W.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_W = filter q_W by 'Transaction.AQB__Amount__c' != 0;\nq_X = group q_X by ('DonorID', 'CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_X = foreach q_X generate q_X.'DonorID' as 'DonorID', q_X.'CreditedFYDateMonth' as 'CreditedFYDateMonth', q_X.'ARCHCreditedFiscalYearDate_Month_Fiscal' as 'ARCHCreditedFiscalYearDate_Month_Fiscal', q_X.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_X.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_X = filter q_X by 'Transaction.AQB__Amount__c' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1493\nq = cogroup q by ('CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal') full, q_C by ('CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal') full, q_Q by ('CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal') full, q_R by ('CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal') full, q_S by ('CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal') full, q_T by ('CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal') full, q_D by ('CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal') full, q_U by ('CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal') full, q_V by ('CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal') full, q_W by ('CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal') full, q_X by ('CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal');\nq = foreach q generate coalesce(q.'CreditedFYDateMonth', q_C.'CreditedFYDateMonth', q_Q.'CreditedFYDateMonth', q_R.'CreditedFYDateMonth', q_S.'CreditedFYDateMonth', q_T.'CreditedFYDateMonth', q_D.'CreditedFYDateMonth', q_U.'CreditedFYDateMonth', q_V.'CreditedFYDateMonth', q_W.'CreditedFYDateMonth', q_X.'CreditedFYDateMonth') as 'CreditedFYDateMonth', coalesce(q.'ARCHCreditedFiscalYearDate_Month_Fiscal', q_C.'ARCHCreditedFiscalYearDate_Month_Fiscal', q_Q.'ARCHCreditedFiscalYearDate_Month_Fiscal',q_R.'ARCHCreditedFiscalYearDate_Month_Fiscal', q_S.'ARCHCreditedFiscalYearDate_Month_Fiscal',q_T.'ARCHCreditedFiscalYearDate_Month_Fiscal', q_D.'ARCHCreditedFiscalYearDate_Month_Fiscal', q_U.'ARCHCreditedFiscalYearDate_Month_Fiscal', q_V.'ARCHCreditedFiscalYearDate_Month_Fiscal', q_W.'ARCHCreditedFiscalYearDate_Month_Fiscal', q_X.'ARCHCreditedFiscalYearDate_Month_Fiscal') as 'ARCHCreditedFiscalYearDate_Month_Fiscal', number_to_string(max(q.'Current_Fiscal_Year'),\"####\") as 'BE', number_to_string(max(q.'Current_Fiscal_Year')-1,\"####\") as 'BF', number_to_string(max(q.'Current_Fiscal_Year')-2,\"####\") as 'BG', number_to_string(max(q.'Current_Fiscal_Year')-3,\"####\") as 'BH', number_to_string(max(q.'Current_Fiscal_Year')-4,\"####\") as 'BI', sum(q_C.'Transaction.AQB__Amount__c') as 'C', sum(q_Q.'Transaction.AQB__Amount__c') as 'Q', sum(q_R.'Transaction.AQB__Amount__c') as 'R', sum(q_S.'Transaction.AQB__Amount__c') as 'S', sum(q_T.'Transaction.AQB__Amount__c') as 'T', unique(q_D.'DonorID') as 'D', unique(q_U.'DonorID') as 'U', unique(q_V.'DonorID') as 'V', unique(q_W.'DonorID') as 'W', unique(q_X.'DonorID') as 'X';\nq = group q by ('CreditedFYDateMonth','ARCHCreditedFiscalYearDate_Month_Fiscal');\nq = foreach q generate 'CreditedFYDateMonth', 'ARCHCreditedFiscalYearDate_Month_Fiscal', first(BE) as '00-YR', first(BF) as '01-YR', first(BG) as '02-YR', first(BH) as '03-YR', first(BI) as '04-YR', first(C) as '00-DA-DNU', first(Q) as '01-DA-DNU', first(R) as '02-DA-DNU', first(S) as '03-DA-DNU', first(T) as '04-DA-DNU', first(D) as '00-DC-DNU', first(U) as '01-DC-DNU', first(V) as '02-DC-DNU', first(W) as '03-DC-DNU', first(X) as '04-DC-DNU', coalesce(sum(C),0) as '00-DA', coalesce(sum(D),0) as '00-DC', coalesce(sum(Q),0) as '01-DA', coalesce(sum(R),0) as '02-DA', coalesce(sum(S),0) as '03-DA', coalesce(sum(T),0) as '04-DA', coalesce(sum(U),0) as '01-DC', coalesce(sum(V),0) as '02-DC', coalesce(sum(W),0) as '03-DC', coalesce(sum(X),0) as '04-DC', (coalesce(sum(C),0))-(coalesce(sum(Q),0)) as '00-DA-UC', (coalesce(sum(Q),0)) - (coalesce(sum(R),0)) as '01-DA-UC', (coalesce(sum(R),0))-(coalesce(sum(S),0)) as '02-DA-UC', (coalesce(sum(S),0))-(coalesce(sum(T),0)) as '03-DA-UC', ((coalesce(sum(C),0))-(coalesce(sum(Q),0))) / coalesce(sum(Q),1) as '00-DA-PC', ((coalesce(sum(Q),0)) - (coalesce(sum(R),0))) / coalesce(sum(R),1) as '01-DA-PC', ((coalesce(sum(R),0))-(coalesce(sum(S),0))) / coalesce(sum(S),1) as '02-DA-PC', ((coalesce(sum(S),0))-(coalesce(sum(T),0))) / coalesce(sum(T),1) as '03-DA-PC', (coalesce(sum(D),0))-(coalesce(sum(U),0)) as '00-DC-UC', (coalesce(sum(U),0))-(coalesce(sum(V),0)) as '01-DC-UC', (coalesce(sum(V),0))-(coalesce(sum(W),0)) as '02-DC-UC', (coalesce(sum(W),0))-(coalesce(sum(X),0)) as '03-DC-UC', ((coalesce(sum(D),0))-(coalesce(sum(U),0))) / coalesce(sum(U),1) as '00-DC-PC', ((coalesce(sum(U),0))-(coalesce(sum(V),0))) / coalesce(sum(V),1) as '01-DC-PC', ((coalesce(sum(V),0))-(coalesce(sum(W),0))) / coalesce(sum(W),1) as '02-DC-PC', ((coalesce(sum(W),0))-(coalesce(sum(X),0))) / coalesce(sum(X),1) as '03-DC-PC', (coalesce(sum(C),0))/sum((coalesce(sum(C),0))) over ([..] partition by all) as '00-DA-PG', (coalesce(sum(Q),0))/sum((coalesce(sum(Q),0))) over ([..] partition by all) as '01-DA-PG', (coalesce(sum(R),0))/sum((coalesce(sum(R),0))) over ([..] partition by all) as '02-DA-PG', (coalesce(sum(S),0))/sum((coalesce(sum(S),0))) over ([..] partition by all) as '03-DA-PG', (coalesce(sum(T),0))/sum((coalesce(sum(T),0))) over ([..] partition by all) as '04-DA-PG';\nq = order q by 'ARCHCreditedFiscalYearDate_Month_Fiscal' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"include","steps":["Annual_Fund_Transact_6"]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBor