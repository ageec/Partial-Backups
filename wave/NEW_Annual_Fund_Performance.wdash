ctionsExtension"}],"isGlobal":false,"label":"Annual Fund Transaction Date Range Toggle - Primary Reporting Value","query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"CreditedFYDateRangeMultivalue\"],\"filters\":[[\"CreditedFYDateRangeMultivalue\",[],\"isnotnull\"],[\"ARCHCreditedFiscalYearDate\",[[[\"fiscal_year\",-4],[\"fiscal_year\",0]]],\">=<=\"]],\"order\":[[\"count\",{\"ascending\":true}]]}","version":-1.0},"receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"singlerequired","sortable":true,"start":"[\"YOY\"]","type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":["CreditedFYDateRangeMultivalue"],"plots":["count"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Transaction_Date_Ran_1":{"broadcastFacet":true,"datasets":[{"name":"GiftAndPledgeTransactionsExtension"}],"isGlobal":false,"label":"Annual Fund Transaction Date Range Toggle","query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"CreditedFYDateRangeMultivalue\"],\"filters\":[[\"CreditedFYDateRangeMultivalue\",[],\"isnotnull\"],[\"ARCHCreditedFiscalYearDate\",[[[\"fiscal_year\",-4],[\"fiscal_year\",0]]],\">=<=\"]],\"order\":[[\"count\",{\"ascending\":true}]]}","version":-1.0},"receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"singlerequired","sortable":true,"start":"[\"YTD\"]","type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":["CreditedFYDateRangeMultivalue"],"plots":["count"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_8":{"broadcastFacet":true,"groups":[],"label":"Annual Fund Gift Band","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"current fiscal_year\"];\nq = filter q by 'AnnualFund' == \"true\";\nq = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\n--Gift Band\nq_A = group q by ('Transaction.Name', 'AccountID', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_A = foreach q_A generate q_A.'Transaction.Name' as 'Transaction.Name', q_A.'AccountID' as 'AccountID', q_A.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_A.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_A = group q_A by ('AccountID', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_A = foreach q_A generate q_A.'AccountID' as 'AccountID', q_A.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'Fiscal Year', sum(q_A.'Transaction.AQB__Amount__c') as 'Cash Received', case when sum(q_A.'Transaction.AQB__Amount__c') >= 5000000 then \"01 - $5M+\" when sum(q_A.'Transaction.AQB__Amount__c') >= 1000000 then \"02 - $1M - $4,999,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 500000 then \"03 - $500,000 - $999,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 250000 then \"04 - $250,000 - $499,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 100000 then \"05 - $100,000 - $249,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 50000 then \"06 - $50,000 - $99,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 25000 then \"07 - $25,000 - $49,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 10000 then \"08 - $10,000 - $24,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 5000 then \"09 - $5,000 - $9,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 2500 then \"10 - $2,500 - $4,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 1000 then \"11 - $1,000 - $2,499\" when sum(q_A.'Transaction.AQB__Amount__c') >= 500 then \"12 - $500 - $999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 250 then \"13 - $250 - $499\" when sum(q_A.'Transaction.AQB__Amount__c') >= 100 then \"14 - $100 - $249\" when sum(q_A.'Transaction.AQB__Amount__c') >= 0 then \"15 - $0 - $99\" end as 'Group';\n-- Added SAQL Start - ARCHRPTS-1490/1493\nq_A = filter q_A by 'Cash Received' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1493\nq_A = filter q_A by 'Group' is not null;\nq_A = group q_A by ('Group', 'Fiscal Year');\nq_A = foreach q_A generate q_A.'Group' as 'Group', q_A.'Fiscal Year' as 'Fiscal Year', unique(q_A.'AccountID') as 'Donor Count', sum(q_A.'Cash Received') as 'Cash Received';\nq_A = order q_A by ('Group' asc, 'Fiscal Year' desc);\n--Account Type/Contact Type\nq_B = group q by ('Transaction.Name', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_B = foreach q_B generate q_B.'Transaction.Name' as 'Transaction.Name', q_B.'AccountType' as 'AccountType', q_B.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_B.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_C = group q by ('DonorID', 'AccountType', 'ContactType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_C = foreach q_C generate q_C.'DonorID' as 'DonorID', coalesce(q_C.'ContactType', q_C.'AccountType') as 'AccountType', q_C.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', unique(q_C.'DonorID') as 'DonorCount', sum(q_C.'Transaction.AQB__Amount__c') as 'Cash Received';\n-- Added SAQL Start - ARCHRPTS-1490/1493\nq_C = filter q_C by 'Cash Received' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1493\nq_C = cogroup q_C by ('ARCHCreditedFiscalYearDate_Year_Fiscal', 'AccountType') full, q_B by ('ARCHCreditedFiscalYearDate_Year_Fiscal', 'AccountType');\nq_C = foreach q_C generate coalesce(q_B.'AccountType', q_C.'AccountType') as 'Group', coalesce(q_B.'ARCHCreditedFiscalYearDate_Year_Fiscal', q_C.'ARCHCreditedFiscalYearDate_Year_Fiscal') as 'Fiscal Year', sum(q_C.'DonorCount') as 'Donor Count', sum(q_B.'Transaction.AQB__Amount__c') as 'Cash Received';\n--Everything else\nq_D = group q by ('Transaction.Name', '{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_D = foreach q_D generate q_D.'Transaction.Name' as 'Transaction.Name', q_D.'{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}' as '{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}', q_D.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_D.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\n-- Added SAQL Start - ARCHRPTS-1490/1492\nq_E = group q by ('DonorID', '{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_E = foreach q_E generate q_E.'DonorID' as 'DonorID', q_E.'{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}' as '{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}', q_E.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q_E.'Transaction.AQB__Amount__c') as 'Amount';\nq_E = filter q_E by 'Amount' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1492\nq = cogroup q_E by ('ARCHCreditedFiscalYearDate_Year_Fiscal', '{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}') full, q_D by ('ARCHCreditedFiscalYearDate_Year_Fiscal', '{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}');\nq = foreach q generate coalesce(q_D.'{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}', q_E.'{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}') as 'Group', coalesce(q_D.'ARCHCreditedFiscalYearDate_Year_Fiscal', q_E.'ARCHCreditedFiscalYearDate_Year_Fiscal') as 'Fiscal Year', unique(q_E.'DonorID') as 'Donor Count',  sum(q_D.'Transaction.AQB__Amount__c') as 'Cash Received';\nq = order q by ('Group' asc, 'Fiscal Year' desc);\nq = limit {{cell(Dynamic_Dimension_Bi_1.selection, 0, \"LIMIT\").asString()}} 25000;","receiveFacetSource":{"mode":"include","steps":["Annual_Fund_Transact_1","Dynamic_Dimension_Bi_1"]},"selectMode":"multi","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"lens_3":{"broadcastFacet":false,"groups":[],"label":"Annual Fund Donor Category Bar Chart","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"current fiscal_year\"];\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq = filter q by 'AnnualFund' == \"true\";\nq = group q by ('Transaction.Name', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq = foreach q generate q.'Transaction.Name' as 'Transaction.Name', q.'AccountType' as 'AccountType', q.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q.'Transaction.AQB__Amount__c') as 'B';\nq = group q by ('AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq = foreach q generate q.'AccountType' as 'AccountType', q.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q.'B') as 'Cash Received';\nq = order q by ('AccountType' asc, 'ARCHCreditedFiscalYearDate_Year_Fiscal' desc);\nq = limit q 2000;","receiveFacetSource":{"mode":"include","steps":["Annual_Fund_Fiscal_Y_2","Annual_Fund_Transact_4"]},"selectMode":"none","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":true,"showHeader":false,"show":true,"customSize":"auto","position":"bottom-center","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"Giving by Donor Category","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"binValues":false,"columnMap":{"trellis":[],"dimensionAxis":["AccountType","ARCHCreditedFiscalYearDate_Year_Fiscal"],"plots":["Cash Received"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"Donor Category > Fiscal Year","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Contact_and_Account__1":{"broadcastFacet":true,"groups":[],"label":"Annual Fund Contact and Account Past 5 Fiscal Years","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by 'Is_Transaction_FYTD' == \"true\";\nq = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"current fiscal_year\"];\nq = filter q by 'AnnualFund' == \"true\";\nq = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq = group q by ('Transaction.Name', 'ContactSortName', 'ContactID', 'AccountName', 'AccountID', 'PrimaryGiftOfficerName', 'PrimaryGiftOfficerID', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq = foreach q generate q.'Transaction.Name' as 'Transaction.Name', q.'ContactSortName' as 'ContactSortName', q.'ContactID' as 'ContactID', q.'AccountName' as 'AccountName', q.'AccountID' as 'AccountID', q.'PrimaryGiftOfficerName' as 'PrimaryGiftOfficerName', q.'PrimaryGiftOfficerID' as 'PrimaryGiftOfficerID', q.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq = group q by ('ContactSortName', 'ContactID', 'AccountName', 'AccountID', 'PrimaryGiftOfficerName', 'PrimaryGiftOfficerID', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq = foreach q generate q.'ContactSortName' as 'ContactSortName', q.'ContactID' as 'ContactID', q.'AccountName' as 'AccountName', q.'AccountID' as 'AccountID', q.'PrimaryGiftOfficerName' as 'PrimaryGiftOfficerName', q.'PrimaryGiftOfficerID' as 'PrimaryGiftOfficerID', q.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'Fiscal Year', sum(q.'Transaction.AQB__Amount__c') as 'Cash Received';\np = group q by 'Fiscal Year';\np = foreach p generate q.'Fiscal Year' as 'Fiscal Year', sum(q.'Cash Received') as 'Cash Received', 0 as 'grouping_Fiscal Year';\np = limit p 25000;\nq = limit q 100000;\nq = union q, p;\nq = order q by ('ContactSortName' asc, 'AccountName' asc, 'Fiscal Year' desc);\nq = limit q 125000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["ContactSortName","AccountName","PrimaryGiftOfficerName","Fiscal Year","Cash Received"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"Annual_Fund_Transact_2":{"broadcastFacet":true,"datasets":[{"name":"GiftAndPledgeTransactionsExtension"}],"isGlobal":false,"label":"Annual Fund Transaction Date Range Toggle - Appeal Channel","query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"CreditedFYDateRangeMultivalue\"],\"filters\":[[\"CreditedFYDateRangeMultivalue\",[],\"isnotnull\"],[\"ARCHCreditedFiscalYearDate\",[[[\"fiscal_year\",-4],[\"fiscal_year\",0]]],\">=<=\"]],\"order\":[[\"count\",{\"ascending\":true}]]}","version":-1.0},"receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"singlerequired","sortable":true,"start":"[\"YOY\"]","type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":["CreditedFYDateRangeMultivalue"],"plots":["count"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_1":{"broadcastFacet":false,"groups":[],"label":"lens_1","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by 'DonorStatus' in [\"Acquired\", \"Reactivated\", \"Retained\"];\nq_A = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"] && 'AnnualFund' == \"true\" && 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"] && 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\n-- Added SAQL Start - ARCHRPTS-1490/1493\nq = group q_A by ('DonorID', 'PC.ARCH_Sort_Name__c', 'AccountName', 'AccountID', 'PrimaryGiftOfficerName', 'PrimaryGiftOfficerID', 'ContactName', 'ContactID', 'DonorStatus');\nq = foreach q generate q.'DonorID' as 'DonorID',q.'PC.ARCH_Sort_Name__c' as 'PC.ARCH_Sort_Name__c', q.'AccountName' as 'AccountName', q.'AccountID' as 'AccountID', q.'PrimaryGiftOfficerName' as 'PrimaryGiftOfficerName',  q.'PrimaryGiftOfficerID' as 'PrimaryGiftOfficerID', q.'DonorStatus' as 'DonorStatus', q.'ContactName' as 'ContactName', q.'ContactID' as 'ContactID', sum(q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq = filter q by 'Transaction.AQB__Amount__c' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1493\nq = group q by ('PC.ARCH_Sort_Name__c', 'AccountName', 'AccountID', 'PrimaryGiftOfficerName', 'PrimaryGiftOfficerID', 'ContactName', 'ContactID', 'DonorStatus');\nq = foreach q generate q.'PC.ARCH_Sort_Name__c' as 'PC.ARCH_Sort_Name__c', q.'AccountName' as 'AccountName', q.'AccountID' as 'AccountID', q.'PrimaryGiftOfficerName' as 'PrimaryGiftOfficerName',  q.'PrimaryGiftOfficerID' as 'PrimaryGiftOfficerID', q.'DonorStatus' as 'DonorStatus', q.'ContactName' as 'ContactName', q.'ContactID' as 'ContactID';\nq = order q by ('PC.ARCH_Sort_Name__c' asc);\nq = limit q 100000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Annual_Fund_Transact_1":{"broadcastFacet":true,"datasets":[{"name":"GiftAndPledgeTransactionsExtension"}],"isGlobal":false,"label":"Annual Fund Transaction Date Range Toggle - Performance Details","query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"CreditedFYDateRangeMultivalue\"],\"filters\":[[\"CreditedFYDateRangeMultivalue\",[],\"isnotnull\"],[\"ARCHCreditedFiscalYearDate\",[[[\"fiscal_year\",-4],[\"fiscal_year\",0]]],\">=<=\"]],\"order\":[[\"count\",{\"ascending\":true}]]}","version":-1.0},"receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"singlerequired","sortable":true,"start":"[\"YOY\"]","type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":["CreditedFYDateRangeMultivalue"],"plots":["count"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_2":{"broadcastFacet":false,"groups":[],"label":"lens_2","numbers":[],"query":"q1 = load \"GiftAndPledgeTransactionsExtension\";\nq2 = load \"Annual_Fund_School_Goals\";\nq1 = filter q1 by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq1 = filter q1 by 'AnnualFund' == \"true\";\nq1 = filter q1 by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq1 = filter q1 by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq_A = group q1 by ('Transaction.Name','AnnualFundSchool');\nq_A = foreach q_A generate q_A.'Transaction.Name' as 'Transaction.Name', q_A.'AnnualFundSchool' as 'AnnualFundSchool', avg(q_A.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\n-- Added SAQL Start - ARCHRPTS-1490/1493\nq1 = group q1 by ('DonorID','AnnualFundSchool');\nq1 = foreach q1 generate q1.'DonorID' as 'DonorID', q1.'AnnualFundSchool' as 'AnnualFundSchool', sum(q1.'Transaction.AQB__Amount__c') as 'Amount';\nq1 = filter q1 by 'Amount' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1493\nq = cogroup q1 by 'AnnualFundSchool' full, q2 by 'Annual_Fund_School', q_A by 'AnnualFundSchool';\nq = foreach q generate coalesce(q1.'AnnualFundSchool', q2.'Annual_Fund_School', q_A.'AnnualFundSchool') as 'AnnualFundSchool', unique(q1.'DonorID') as 'A', sum(q_A.'Transaction.AQB__Amount__c') as 'C', sum(q2.'Donor_Goal') as 'B', sum(q2.'Dollar_Goal') as 'D';\nq = foreach q generate 'AnnualFundSchool', 'A' as 'Donor Count', 'B' as 'Donor Goal (#)', A/B as '% to Goal (#)', 'C' as 'Cash Received', 'D' as 'Donor Goal ($)', C/D as '% to Goal ($)';\nq = order q by 'AnnualFundSchool' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"include","steps":["Annual_Fund_Transact_7"]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#C6D3E1","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#FFFFFF","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"All_5_Year_Gift_Band_1":{"broadcastFacet":false,"groups":[],"label":"Annual Fund All 5 Year Account Type Metrics","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"current fiscal_year\"];\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq = filter q by 'AnnualFund' == \"true\";\nq_C = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq_Q = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nq_R = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"];\nq_S = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"];\nq_T = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"];\nq_D = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq_U = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nq_V = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"2 fiscal_years ago\"..\"2 fiscal_years ago\"];\nq_W = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"3 fiscal_years ago\"..\"3 fiscal_years ago\"];\nq_X = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"4 fiscal_years ago\"];\nq_C = group q_C by ('Transaction.Name', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_C = foreach q_C generate q_C.'Transaction.Name' as 'Transaction.Name', q_C.'AccountType' as 'AccountType', q_C.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_C.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_Q = group q_Q by ('Transaction.Name', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_Q = foreach q_Q generate q_Q.'Transaction.Name' as 'Transaction.Name', q_Q.'AccountType' as 'AccountType', q_Q.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_Q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_R = group q_R by ('Transaction.Name', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_R = foreach q_R generate q_R.'Transaction.Name' as 'Transaction.Name', q_R.'AccountType' as 'AccountType', q_R.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_R.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_S = group q_S by ('Transaction.Name', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_S = foreach q_S generate q_S.'Transaction.Name' as 'Transaction.Name', q_S.'AccountType' as 'AccountType', q_S.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_S.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_T = group q_T by ('Transaction.Name', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_T = foreach q_T generate q_T.'Transaction.Name' as 'Transaction.Name', q_T.'AccountType' as 'AccountType', q_T.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_T.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\n-- Added SAQL Start - ARCHRPTS-1490/1492\nq_D = group q_D by ('DonorID', 'ContactType', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_D = foreach q_D generate q_D.'DonorID' as 'DonorID', coalesce(q_D.'ContactType', q_D.'AccountType') as 'ContactType', q_D.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', unique(q_D.'DonorID') as 'DonorCount', sum(q_D.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_D = filter q_D by 'Transaction.AQB__Amount__c' != 0;\nq_U = group q_U by ('DonorID', 'ContactType', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_U = foreach q_U generate q_U.'DonorID' as 'DonorID', coalesce(q_U.'ContactType', q_U.'AccountType') as 'ContactType', q_U.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', unique(q_U.'DonorID') as 'DonorCount', sum(q_U.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_U = filter q_U by 'Transaction.AQB__Amount__c' != 0;\nq_V = group q_V by ('DonorID', 'ContactType', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_V = foreach q_V generate q_V.'DonorID' as 'DonorID', coalesce(q_V.'ContactType', q_V.'AccountType') as 'ContactType', q_V.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', unique(q_V.'DonorID') as 'DonorCount', sum(q_V.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_V = filter q_V by 'Transaction.AQB__Amount__c' != 0;\nq_W = group q_W by ('DonorID', 'ContactType', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_W = foreach q_W generate q_W.'DonorID' as 'DonorID', coalesce(q_W.'ContactType', q_W.'AccountType') as 'ContactType', q_W.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', unique(q_W.'DonorID') as 'DonorCount', sum(q_W.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_W = filter q_W by 'Transaction.AQB__Amount__c' != 0;\nq_X = group q_X by ('DonorID', 'ContactType', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_X = foreach q_X generate q_X.'DonorID' as 'DonorID', coalesce(q_X.'ContactType', q_X.'AccountType') as 'ContactType', q_X.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', unique(q_X.'DonorID') as 'DonorCount', sum(q_X.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_X = filter q_X by 'Transaction.AQB__Amount__c' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1492\nq = cogroup q by 'ContactType' full, q_C by 'AccountType' full, q_Q by 'AccountType' full, q_R by 'AccountType' full, q_S by 'AccountType' full, q_T by 'AccountType' full, q_D by 'ContactType' full, q_U by 'ContactType' full, q_V by 'ContactType' full, q_W by 'ContactType' full, q_X by 'ContactType';\nq = foreach q generate coalesce(q.'ContactType', q_C.'AccountType', q_Q.'AccountType', q_R.'AccountType', q_S.'AccountType', q_T.'AccountType', q_D.'ContactType', q_U.'ContactType', q_V.'ContactType', q_W.'ContactType', q_X.'ContactType') as 'ContactType', number_to_string(max(q.'Current_Fiscal_Year'),\"####\") as 'BE', number_to_string(max(q.'Current_Fiscal_Year')-1,\"####\") as 'BF', number_to_string(max(q.'Current_Fiscal_Year')-2,\"####\") as 'BG', number_to_string(max(q.'Current_Fiscal_Year')-3,\"####\") as 'BH', number_to_string(max(q.'Current_Fiscal_Year')-4,\"####\") as 'BI', sum(q_C.'Transaction.AQB__Amount__c') as 'C', sum(q_Q.'Transaction.AQB__Amount__c') as 'Q', sum(q_R.'Transaction.AQB__Amount__c') as 'R', sum(q_S.'Transaction.AQB__Amount__c') as 'S', sum(q_T.'Transaction.AQB__Amount__c') as 'T', sum(q_D.'DonorCount') as 'D', sum(q_U.'DonorCount') as 'U', sum(q_V.'DonorCount') as 'V', sum(q_W.'DonorCount') as 'W', sum(q_X.'DonorCount') as 'X';\nq = group q by 'ContactType';\nq = foreach q generate 'ContactType', first(BE) as '00-YR', first(BF) as '01-YR', first(BG) as '02-YR', first(BH) as '03-YR', first(BI) as '04-YR', first(C) as '00-DA-DNU', first(Q) as '01-DA-DNU', first(R) as '02-DA-DNU', first(S) as '03-DA-DNU', first(T) as '04-DA-DNU', first(D) as '00-DC-DNU', first(U) as '01-DC-DNU', first(V) as '02-DC-DNU', first(W) as '03-DC-DNU', first(X) as '04-DC-DNU', coalesce(sum(C),0) as '00-DA', coalesce(sum(D),0) as '00-DC', coalesce(sum(Q),0) as '01-DA', coalesce(sum(R),0) as '02-DA', coalesce(sum(S),0) as '03-DA', coalesce(sum(T),0) as '04-DA', coalesce(sum(U),0) as '01-DC', coalesce(sum(V),0) as '02-DC', coalesce(sum(W),0) as '03-DC', coalesce(sum(X),0) as '04-DC', (coalesce(sum(C),0))-(coalesce(sum(Q),0)) as '00-DA-UC', (coalesce(sum(Q),0)) - (coalesce(sum(R),0)) as '01-DA-UC', (coalesce(sum(R),0))-(coalesce(sum(S),0)) as '02-DA-UC', (coalesce(sum(S),0))-(coalesce(sum(T),0)) as '03-DA-UC', ((coalesce(sum(C),0))-(coalesce(sum(Q),0))) / coalesce(sum(Q),1) as '00-DA-PC', ((coalesce(sum(Q),0)) - (coalesce(sum(R),0))) / coalesce(sum(R),1) as '01-DA-PC', ((coalesce(sum(R),0))-(coalesce(sum(S),0))) / coalesce(sum(S),1) as '02-DA-PC', ((coalesce(sum(S),0))-(coalesce(sum(T),0))) / coalesce(sum(T),1) as '03-DA-PC', (coalesce(sum(D),0))-(coalesce(sum(U),0)) as '00-DC-UC', (coalesce(sum(U),0))-(coalesce(sum(V),0)) as '01-DC-UC', (coalesce(sum(V),0))-(coalesce(sum(W),0)) as '02-DC-UC', (coalesce(sum(W),0))-(coalesce(sum(X),0)) as '03-DC-UC', ((coalesce(sum(D),0))-(coalesce(sum(U),0))) / coalesce(sum(U),1) as '00-DC-PC', ((coalesce(sum(U),0))-(coalesce(sum(V),0))) / coalesce(sum(V),1) as '01-DC-PC', ((coalesce(sum(V),0))-(coalesce(sum(W),0))) / coalesce(sum(W),1) as '02-DC-PC', ((coalesce(sum(W),0))-(coalesce(sum(X),0))) / coalesce(sum(X),1) as '03-DC-PC', (coalesce(sum(C),0))/sum((coalesce(sum(C),0))) over ([..] partition by all) as '00-DA-PG', (coalesce(sum(Q),0))/sum((coalesce(sum(Q),0))) over ([..] partition by all) as '01-DA-PG', (coalesce(sum(R),0))/sum((coalesce(sum(R),0))) over ([..] partition by all) as '02-DA-PG', (coalesce(sum(S),0))/sum((coalesce(sum(S),0))) over ([..] partition by all) as '03-DA-PG', (coalesce(sum(T),0))/sum((coalesce(sum(T),0))) over ([..] partition by all) as '04-DA-PG';\nq = limit q 2000;","receiveFacetSource":{"mode":"include","steps":["Annual_Fund_Fiscal_Y_2","Annual_Fund_Transact_4"]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}}},"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#747474","borderEdges":[],"borderRadius":0,"borderWidth":1,"tooltipStyle":{"backgroundColor":"#16325c","labelColor":"#9faab5","valueColor":"#ffffff"}},"widgets":{"text_18":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#020821","size":"16px"},"insert":"This tab shows tabular data with 5 fiscal years of giving amount by Contact/Account. "},{"attributes":{"align":"left"},"insert":"\n"},{"attributes":{"color":"#020821","size":"16px"},"insert":"Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_17":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#020821","size":"16px","underline":true},"insert":"Note"},{"attributes":{"color":"#020821","size":"16px"},"insert":": The ADIS 361 Report included some Planned Gifts designated to Annual Funds. The donor count on the 361 also counted 'extra' donors due to soft credits. And the 361 Report was a snapshot in time vs. the Annual Fund Performance Dashboard which accounts for gifts adjustments and report on real-time results. Therefore, this report will not align exactly with the 361 Report."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_19":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ba0c2f","size":"20px"},"insert":"Annual Fund School Goals (CFY)"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"text_14":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px"},"insert":"This tab shows donor counts and Cash Received by Gift Band with percentage changes compared to previous FYs. Q"},{"attributes":{"color":"#020821","size":"14px"},"insert":"uestions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_13":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px"},"insert":"This tab shows donor counts and Cash Received by Donor Type with percentage changes compared to previous FYs. The amounts in Donor Type follow the Account Type for a donor, while the donor counts follow Contact Type for Household Accounts. "},{"attributes":{"color":"#020821","size":"14px"},"insert":"Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"filterpanel_20":{"parameters":{"filterItemOptions":{"propertyColor":"#020821","valueColor":"#BA0C2F"},"filters":[{"dataset":{"name":"GiftAndPledgeTransactionsExtension"},"field":"COA.Name"}],"showAllFilters":false},"type":"filterpanel"},"text_16":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px"},"insert":"This tab shows all CFY donors with their Donor Status. Donor Status is a field on the Account Object for Household Accounts and has the values of Acquired, Lybunt, Non-Donor, Past-Donor, Reactivated, Retained, and Sybunt. Lybunt, Non-Donor, Past-Donor and Sybunt will not show in the table since they are not values a CFY donor would have. "},{"attributes":{"size":"14px","color":"#020821"},"insert":"Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"filterpanel_21":{"parameters":{"filterItemOptions":{"propertyColor":"#020821","valueColor":"#BA0C2F"},"filters":[{"dataset":{"name":"GiftAndPledgeTransactionsExtension"},"field":"Campaign_Appeal.AQB__StartDate__c"}],"showAllFilters":false},"type":"filterpanel"},"text_15":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px"},"insert":"The Performance Summary charts below provide donor counts and giving amounts by Donor Type, Gift Band, Month, Primary Reporting Value and Appeal Channel. The Account detail can be found in the Performance Summary Detail Table below. To filter down to specific groups and years, click on one or more amounts in the Cash Received column in the Performance Summary table. The amounts in Donor Type follow Account Type for a donor, while the donor counts follow Contact Type for Household Accounts. "},{"attributes":{"size":"14px","color":"#020821"},"insert":"Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"filterpanel_22":{"parameters":{"filterItemOptions":{"propertyColor":"#020821","valueColor":"#BA0C2F"},"filters":[{"dataset":{"name":"GiftAndPledgeTransactionsExtension"},"field":"Campaign_Appeal.ARCH_Fundraising_Campaign_Name__c"}],"showAllFilters":false},"type":"filterpanel"},"text_10":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ba0c2f","size":"20px"},"insert":"Performance Summary Detail"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"text_11":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px"},"insert":"This tab shows donor counts and Cash Received by Month with percentage changes compared to previous FYs."},{"attributes":{"color":"#020821","size":"14px"},"insert":" Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"container_1":{"parameters":{"alignmentX":"left","alignmentY":"top","fit":"original","interactions":[]},"type":"container"},"container_2":{"parameters":{"alignmentX":"left","alignmentY":"top","fit":"original","interactions":[]},"type":"container"},"chart_9":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label"