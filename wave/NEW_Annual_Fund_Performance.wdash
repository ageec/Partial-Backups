"totals":true,"verticalPadding":8},"type":"table"}},"Annual_Fund_School_G_1":{"broadcastFacet":true,"groups":[],"label":"Annual Fund School Goals","numbers":[],"query":"q1 = load \"GiftAndPledgeTransactionsExtension\";\nq2 = load \"Annual_Fund_School_Goals\";\nq1 = filter q1 by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq1 = filter q1 by 'AnnualFund' == \"true\";\nq1 = filter q1 by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq1 = filter q1 by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq_A = group q1 by ('Transaction.Name','AnnualFundSchool');\nq_A = foreach q_A generate q_A.'Transaction.Name' as 'Transaction.Name', q_A.'AnnualFundSchool' as 'AnnualFundSchool', avg(q_A.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq = cogroup q1 by 'AnnualFundSchool' full, q2 by 'Annual_Fund_School', q_A by 'AnnualFundSchool';\nq = foreach q generate coalesce(q1.'AnnualFundSchool', q2.'Annual_Fund_School', q_A.'AnnualFundSchool') as 'AnnualFundSchool', unique(q1.'DonorID') as 'A', sum(q_A.'Transaction.AQB__Amount__c') as 'C', sum(q2.'Donor_Goal') as 'B', sum(q2.'Dollar_Goal') as 'D';\nq = foreach q generate 'AnnualFundSchool', 'A' as 'Donor Count', 'B' as 'Donor Goal (#)', A/B as '% to Goal (#)', 'C' as 'Cash Received', 'D' as 'Donor Goal ($)', C/D as '% to Goal ($)';\nq = order q by 'AnnualFundSchool' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Donor_Status_1":{"broadcastFacet":false,"groups":[],"label":"CFY Donor Status","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by 'DonorStatus' in [\"Acquired\", \"Reactivated\", \"Retained\"];\nq = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq = filter q by 'AnnualFund' == \"true\";\n-- Added SAQL Start - ARCHRPTS-1490/1493\nq = group q by ('DonorID', 'DonorStatus');\nq = foreach q generate q.'DonorID' as 'DonorID', q.'DonorStatus' as 'DonorStatus', sum(q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq = filter q by 'Transaction.AQB__Amount__c' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1493\nq = group q by rollup('DonorStatus');\nq = foreach q generate q.'DonorStatus' as 'DonorStatus', unique(q.'DonorID') as 'Donor Count', grouping(q.'DonorStatus') as 'grouping_DonorStatus';\ns = filter q by 'grouping_DonorStatus' == 1;\nq = filter q by 'grouping_DonorStatus' == 0;\nq = order q by 'DonorStatus' asc;\nq = limit q 25000;\nq = union q, s;\nq = limit q 25001;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{}