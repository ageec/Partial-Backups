tSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":["ARCHCreditedFiscalYearDate_Year_Fiscal"],"plots":["A"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Dynamic_Dimension_Bi_1":{"broadcastFacet":true,"columns":{"API":{"type":"string"},"LIMIT":{"type":"string"},"BAND":{"type":"string"},"LIMIT2":{"type":"string"}},"label":"Dynamic Dimension Bindings","selectMode":"singlerequired","start":"{\"BAND\":[\"Donor Type\"]}","type":"staticflex","values":["{\"BAND\":\"Donor Type\",\"API\":\"AccountType\",\"LIMIT\":\"q_C\",\"LIMIT2\":\"q\"}","{\"BAND\":\"Gift Band\",\"API\":\"COA.ARCH_Primary_Reporting_Value__c\",\"LIMIT\":\"q_A\",\"LIMIT2\":\"q_A\"}","{\"BAND\":\"Monthly\",\"API\":\"CreditedFiscalYearMonthSort\",\"LIMIT\":\"q\",\"LIMIT2\":\"q\"}","{\"BAND\":\"Primary Reporting Value\",\"API\":\"COA.ARCH_Primary_Reporting_Value__c\",\"LIMIT\":\"q\",\"LIMIT2\":\"q\"}","{\"BAND\":\"Appeal Channel\",\"API\":\"Campaign_Appeal.Type\",\"LIMIT\":\"q\",\"LIMIT2\":\"q\"}"]},"Dynamic_Dimension_Bi_3":{"broadcastFacet":true,"columns":{"API":{"type":"string"},"LIMIT":{"type":"string"},"BAND":{"type":"string"}},"label":"Dynamic Dimension Bindings","selectMode":"singlerequired","start":"{\"BAND\":[\"Donor Category\"]}","type":"staticflex","values":["{\"BAND\":\"Primary Reporting Value\",\"API\":\"COA.ARCH_Primary_Reporting_Value__c\",\"LIMIT\":\"q\"}","{\"BAND\":\"Gift Band\",\"API\":\"COA.ARCH_Primary_Reporting_Value__c\",\"LIMIT\":\"q_A\"}","{\"BAND\":\"Donor Category\",\"API\":\"ContactType\",\"LIMIT\":\"q\"}","{\"BAND\":\"Monthly\",\"API\":\"CreditedFYDateMonth\",\"LIMIT\":\"q\"}"]},"GiftBandTable_1":{"broadcastFacet":false,"groups":[],"label":"Annual Fund Gift Band Detail Table","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"current fiscal_year\"];\nq = filter q by 'AnnualFund' == \"true\";\nq = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq_A = group q by ('Transaction.Name', 'ARCHAccountID', 'AccountName', 'AccountID', 'PC.ARCH_Sort_Name__c', 'PrimaryGiftOfficerName', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_A = foreach q_A generate q_A.'Transaction.Name' as 'Transaction.Name', q_A.'ARCHAccountID' as 'ARCHAccountID', q_A.'AccountName' as 'AccountName', q_A.'AccountID' as 'AccountID', q_A.'PC.ARCH_Sort_Name__c' as 'PC.ARCH_Sort_Name__c', q_A.'PrimaryGiftOfficerName' as 'PrimaryGiftOfficerName', q_A.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_A.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_A = group q_A by ('ARCHAccountID', 'AccountName', 'AccountID', 'PC.ARCH_Sort_Name__c', 'PrimaryGiftOfficerName', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_A = foreach q_A generate q_A.'ARCHAccountID' as 'ARCHAccountID', q_A.'AccountName' as 'AccountName', q_A.'AccountID' as 'AccountID', q_A.'PC.ARCH_Sort_Name__c' as 'PC.ARCH_Sort_Name__c', q_A.'PrimaryGiftOfficerName' as 'PrimaryGiftOfficerName', q_A.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'Fiscal Year', sum(q_A.'Transaction.AQB__Amount__c') as 'Cash Received', case when sum(q_A.'Transaction.AQB__Amount__c') >= 5000000 then \"01 - $5M+\" when sum(q_A.'Transaction.AQB__Amount__c') >= 1000000 then \"02 - $1M - $4,999,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 500000 then \"03 - $500,000 - $999,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 250000 then \"04 - $250,000 - $499,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 100000 then \"05 - $100,000 - $249,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 50000 then \"06 - $50,000 - $99,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 25000 then \"07 - $25,000 - $49,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 10000 then \"08 - $10,000 - $24,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 5000 then \"09 - $5,000 - $9,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 2500 then \"10 - $2,500 - $4,999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 1000 then \"11 - $1,000 - $2,499\" when sum(q_A.'Transaction.AQB__Amount__c') >= 500 then \"12 - $500 - $999\" when sum(q_A.'Transaction.AQB__Amount__c') >= 250 then \"13 - $250 - $499\" when sum(q_A.'Transaction.AQB__Amount__c') >= 100 then \"14 - $100 - $249\" when sum(q_A.'Transaction.AQB__Amount__c') >= 0 then \"15 - $0 - $99\" end as 'Group';\n-- Added SAQL Start - ARCHRPTS-1490/1493\nq_A = filter q_A by 'Cash Received' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1493\nq_A = filter q_A by 'Group' is not null;\n--q_A = order q_A by ('PC.ARCH_Sort_Name__c' asc, 'Fiscal Year' desc);\nq_B = group q by ('Transaction.Name', '{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}', 'ARCHAccountID', 'AccountName', 'AccountID', 'PC.ARCH_Sort_Name__c', 'PrimaryGiftOfficerName', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_B = foreach q_B generate q_B.'Transaction.Name' as 'Transaction.Name', q_B.'{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}' as '{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}', q_B.'ARCHAccountID' as 'ARCHAccountID', q_B.'AccountName' as 'AccountName', q_B.'AccountID' as 'AccountID', q_B.'PC.ARCH_Sort_Name__c' as 'PC.ARCH_Sort_Name__c', q_B.'PrimaryGiftOfficerName' as 'PrimaryGiftOfficerName', q_B.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_B.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq = group q_B by ('{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}', 'ARCHAccountID', 'AccountName', 'AccountID', 'PC.ARCH_Sort_Name__c',  'PrimaryGiftOfficerName', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq = foreach q generate q_B.'ARCHAccountID' as 'ARCHAccountID', q_B.'AccountName' as 'AccountName', q_B.'AccountID' as 'AccountID', q_B.'PC.ARCH_Sort_Name__c' as 'PC.ARCH_Sort_Name__c', q_B.'PrimaryGiftOfficerName' as 'PrimaryGiftOfficerName', q_B.'{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"API\").asString()}}' as 'Group', q_B.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'Fiscal Year', sum(q_B.'Transaction.AQB__Amount__c') as 'Cash Received';\n-- Added SAQL Start - ARCHRPTS-1490/1493\nq = filter q by 'Cash Received' != 0;\n-- Added SAQL End - ARCHRPTS-1490/1493\n--q = order q by ('PC.ARCH_Sort_Name__c' asc, 'Fiscal Year' desc);\n{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"LIMIT2\").asString()}} = filter {{cell(Dynamic_Dimension_Bi_1.selection, 0, \"LIMIT2\").asString()}} by 'Group' in {{coalesce(column(lens_8.selection, [\"Group\"]), \"all\").asString()}};\n{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"LIMIT2\").asString()}} = filter {{cell(Dynamic_Dimension_Bi_1.selection, 0, \"LIMIT2\").asString()}} by 'Fiscal Year' in {{coalesce(column(lens_8.selection, [\"Fiscal Year\"]), \"all\").asString()}};\n{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"LIMIT2\").asString()}} = order {{cell(Dynamic_Dimension_Bi_1.selection, 0, \"LIMIT2\").asString()}} by ('PC.ARCH_Sort_Name__c' asc, 'Fiscal Year' desc);\n{{cell(Dynamic_Dimension_Bi_1.selection, 0, \"LIMIT2\").asString()}} = limit {{cell(Dynamic_Dimension_Bi_1.selection, 0, \"LIMIT2\").asString()}} 100000;","receiveFace