arDate_Day');\nq = foreach q generate q.'Transaction.Name' as 'Transaction.Name', q.'ARCHCreditedFiscalYearDate_Year' as 'ARCHCreditedFiscalYearDate_Year', q.'ARCHCreditedFiscalYearDate_Month' as 'ARCHCreditedFiscalYearDate_Month', q.'ARCHCreditedFiscalYearDate_Day' as 'ARCHCreditedFiscalYearDate_Day', avg(q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq_A = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq_B = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nq = cogroup q_A by all full, q_B by all;\nq = foreach q generate sum(q_A.'Transaction.AQB__Amount__c') as 'MTD Amount', sum(q_B.'Transaction.AQB__Amount__c') as 'PMTD Amount';\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"bottom-center","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"vbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"Amount","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":[],"plots":["MTD Amount","PMTD Amount"]},