r_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q.'B') as 'Cash Received';\nq = order q by ('Campaign_Appeal.Type' asc, 'ARCHCreditedFiscalYearDate_Year_Fiscal' desc);\nq = limit q 2000;","receiveFacetSource":{"mode":"include","steps":["Annual_Fund_Transact_2","Annual_Fund_Fiscal_Y_1"]},"selectMode":"none","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":true,"showHeader":false,"show":true,"customSize":"auto","position":"bottom-center","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":["Cash Received"],"showNullValues":true,"customizeLegend":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":["Campaign_Appeal.Type"]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"Giving by Appeal Channel","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"binValues":false,"columnMap":{"trellis":[],"dimensionAxis":["Campaign_Appeal.Type","ARCHCreditedFiscalYearDate_Year_Fiscal"],"plots":["Cash Received"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"Appeal Channel > Fiscal Year","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}}