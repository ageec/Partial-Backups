scalYearDate_Year_Fiscal' desc);\n--q = limit q 2000;\n-- Added SAQL Start - ARCHRPTS-1490/1493\nq = group q by ('DonorID', 'ContactType', 'AccountType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq = foreach q generate q.'DonorID' as 'DonorID', coalesce(q.'ContactType', q.'AccountType') as 'ContactType', q.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', unique(q.'DonorID') as 'A', sum('Transaction.AQB__Amount__c') as 'B';\nq = filter q by 'B' != 0;\nq = group q by ('ContactType', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq = foreach q generate q.'ContactType' as 'ContactType', q.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', sum(q.'A') as 'Donor Count';\nq = order q by ('ContactType' asc, 'ARCHCreditedFiscalYearDate_Year_Fiscal' desc);\nq = limit q 2000;\n-- Added SAQL End - ARCHRPTS-1490/1493","receiveFacetSource":{"mode":"include","steps":["Annual_Fund_Fiscal_Y_2","Annual_Fund_Transact_4"]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":true,"showHeader":false,"show":true,"customSize":"auto","position":"bottom-center","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"Donor Count by Donor Type","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"sh