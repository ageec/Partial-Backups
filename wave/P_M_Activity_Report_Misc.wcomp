,{"defaultValue":"current fiscal_year","description":"","label":"Fiscal Year","name":"parameter_2"}],"steps":{"Med_Adv_Substantive__1":{"broadcastFacet":true,"groups":[],"label":"PST Officer Stewardship Activity Reports Completed ","numbers":[],"query":"q = load \"ActivityReportDetail\";\n--q2 = load \"UA_Performance_Med_Team_Goals\";\nq = filter q by date('AQB__Date__c_Year', 'AQB__Date__c_Month', 'AQB__Date__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq = filter q by 'AQB__ReportStatus__c' == \"Final\";\n--q1 = filter q1 by 'AQB__EssentialMove__c' == \"true\";\nq = filter q by AQB__Purpose__c == \"Stewardship\";\n--q1 = filter q1 by ('RecordType.Name' != \"Corporate Engagement\" || 'RecordType.Name' is null);\n--q2 = filter q2 by date('Date_Year', 'Date_Month', 'Date_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\n--q2 = filter q2 by 'Goal' == \"# of Substantive Activity Reports\";\n--q = cogroup q1 by 'ActivityReportParticipant.MedOfficerTeam' full, q2 by 'Med_Team';\n--q = foreach q generate coalesce(q1.'ActivityReportParticipant.MedOfficerTeam', q2.'Med_Team') as 'ActivityReportParticipant.MedOfficerTeam', count(q1) as 'A', sum(q2.'Amount') as 'B';\n--q = foreach q generate 'ActivityReportParticipant.MedOfficerTeam', 'A', 'B', A/B as 'C';\nq = group q by rollup('ActivityReportParticipant.GiftOfficerDivision', 'ActivityReportParticipant.User.Name');\nq = foreach q generate q.'ActivityReportParticipant.GiftOfficerDivision' as 'ActivityReportParticipant.GiftOfficerDivision', q.'ActivityReportParticipant.User.Name' as 'ActivityReportParticipant.User.Name', count(q) as '# of ARs Completed',\n    --sum(q.'A') as 'Substantive ARs', sum(q.'B') as 'Goal', sum(q.'A') / sum(q.'B') as '% to Goal', \n    grouping(q.'ActivityReportParticipant.GiftOfficerDivision') as 'grouping_ActivityReportParticipant.GiftOfficerDivision', grouping(q.'ActivityReportParticipant.User.Name') as 'grouping_ActivityReportParticipant.User.Name';\ns = filter q by 'grouping_ActivityReportParticipant.GiftOfficerDivision' == 1 and 'grouping_ActivityReportParticipant.User.Name' == 1;\nq = filter q by 'grouping_ActivityReportParticipant.GiftOfficerDivision' == 0 and 'grouping_ActivityReportParticipant.User.Name' == 0;\nq = order q by ('ActivityReportParticipant.GiftOfficerDivision' asc, 'ActivityReportParticipant.User.Name' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{"# of ARs Completed":{"tooltip":{"mode":"custom","text":"Activity Reports where Purpose = \"Stewardship\", Report Status = \"Final\", and Date in the current fiscal year. "}}},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"GO_AR_Visits_by_Mont_1":{"broadcastFacet":false,"datasets":[{"name":"ActivityReportDetail"}],"isGlobal":false,"label":"GO AR Visits by Month Summary Table","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":["ActivityReportParticipant.GiftOfficerTeam"],"limit":2000,"orders":[{"name":"ActivityReportParticipant.GiftOfficerTeam","filters":[],"ascending":true},{"name":"AQB__Date__c_Month_Fiscal","filters":[],"ascending":true},{"name":"Month","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":