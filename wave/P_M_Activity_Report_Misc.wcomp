r q1 by 'AQB__EssentialMove__c' == \"true\";\nq = foreach q generate q.'ActivityReportParticipant.GiftOfficerDivision' as 'ActivityReportParticipant.GiftOfficerDivision', q.'ActivityReportParticipant.User.Name' as 'ActivityReportParticipant.User.Name', q.'AQB__Subject__c' as 'Subject of Activity Report', q.'AQB__Date__c' as 'Date of Activity Report', q.'Account.Name' as 'Account Name on AR', q.'OpportunityInfo.Name' as 'Opp Name (if applicable)', 'Id' as 'Activity Report Id', 'Account.Id' as 'Account Id', 'AQB__Opportunity__c' as 'Opportunity Id';\nq = order q by ('ActivityReportParticipant.GiftOfficerDivision' asc, 'ActivityReportParticipant.User.Name' asc, 'Date of Activity Report' desc, 'Account Name on AR' asc);\nq = limit q 10000;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{"Subject of Activity Report":{"tooltip":{"mode":"custom","text":"Activity Reports where Purpose = \"Stewardship\", Report Status = \"Final\", and Date in the current fiscal year. "}},"Date of Activity Report":{"tooltip":{"mode":"custom","text":"Activity Reports where Purpose = \"Stewardship\", Report Status = \"Final\", and Date in the current fiscal year. "}}},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}