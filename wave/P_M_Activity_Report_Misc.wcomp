ProductionARCHCreditedFiscalYearsPassed' == \"[[parameter_1]]\";\nq1 = filter q1 by 'PrimaryGiftOfficerName' == \"MOMENTUM\";\nq1 = group q1 by 'Transaction.Name';\nq1 = foreach q1 generate 'Transaction.Name' as 'Transaction.Name', avg(q1.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests';\nq = cogroup q1 by all full, q2 by all;\nq = foreach q generate sum(q1.'NewProductionAmountWithBequests') as 'A', sum(q2.'Amount') as 'B';\nq = foreach q generate 'A' as 'Momentum New Production', 'B' as 'Goal', A/B as '% to Goal';\nq = limit q 2000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Med_Adv_Faculty_Visi_5":{"broadcastFacet":true,"datasets":[{"name":"Activity_Report_Info"}],"isGlobal":false,"label":"Med Adv Faculty Visits Detail Table 2","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":["Name"],"limit":2000,"orders":[{"name":"Name","filters":[],"ascending":true},{"name":"Id","filters":[],"ascending":true},{"name":"Account.Account.Name","filters":[],"ascending":true},{"name":"Account.Account.Id","filters":[],"ascending":true},{"name":"AQB__Purpose__c","filters":[],"ascending":true},{"name":"AQB__Subject__c","filters":[]