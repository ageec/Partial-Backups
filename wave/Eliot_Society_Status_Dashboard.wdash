},"label":"Eliot Status Field Picker","selectMode":"multi","start":"{\"Display\":[]}","type":"staticflex","values":["{\"Display\":\"Mailing Name Line One\",\"Object Field\":\"AQB__MailingName__c\",\"API\":\",'AQB__MailingName__c'\"}","{\"Display\":\"Mailing Name Line Two\",\"Object Field\":\"AQB__MailingNameLineTwo__c\",\"API\":\",'AQB__MailingNameLineTwo__c'\"}","{\"Display\":\"Account Greeting\",\"Object Field\":\"AQB__Greeting__c\",\"API\":\",'AQB__Greeting__c'\"}","{\"Display\":\"Mailing Street\",\"Object Field\":\"Contact.MailingStreet\",\"API\":\",'Contact.MailingStreet'\"}","{\"Display\":\"Mailing City\",\"Object Field\":\"Contact.MailingCity\",\"API\":\",'Contact.MailingCity'\"}","{\"Display\":\"Mailing State/Province\",\"Object Field\":\"Contact.MailingState\",\"API\":\",'Contact.MailingState'\"}","{\"Display\":\"Mailing Zip/Postal Code\",\"Object Field\":\"Contact.MailingPostalCode\",\"API\":\",'Contact.MailingPostalCode'\"}","{\"Display\":\"Email\",\"Object Field\":\"Contact.Email\",\"API\":\",'Contact.Email'\"}"]},"Eliot_Count_by_Year__1":{"broadcastFacet":true,"groups":[],"label":"Eliot Count by Year and Status Chart","numbers":[],"query":"--load Eliot goals\na = load \"Eliot_Society_Goals\";\na = foreach a generate a.'Grouping' as 'Grouping', a.'Club_Level' as 'Club_Level', a.'Eliot_Count_Goal' as 'Goal', a.'Fiscal_Year' as 'Fiscal_Year';\n\n--load ELiot Summary\nb = load \"Eliot_Summary\";\n\n--group Eliot Summary by toggle selected grouping\nc = group b by ('{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', 'AQB__DisplayYear__c');\nc = foreach c generate c.'{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}' as '{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', c.'AQB__DisplayYear__c' as 'AQB__DisplayYear__c', count(b) as Count;\n\n--left join Eliot goals to Eliot results\nd = cogroup c by ('AQB__DisplayYear__c', '{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}') left, a by ('Fiscal_Year','Club_Level');\nd = foreach d generate c.'AQB__DisplayYear__c' as 'Year', c.'{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}' as '{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', first(c.Count) as Count, first(a.Goal) as Goal;\nd = order d by ('Year' desc, '{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}' asc);\n\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","legend":{"descOrder":true,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","totalSumMode":"absolute","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"stackvbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"normalize":false,"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Eliot_Count_by_Year__3":{"broadcastFacet":true,"groups":[],"label":"Eliot Count by Year and Status Chart","numbers":[],"query":"--load Eliot goals\na = load \"Eliot_Society_Goals\";\na = foreach a generate a.'Grouping' as 'Grouping', a.'Club_Level' as 'Club_Level', a.'Eliot_Count_Goal' as 'Goal', a.'Fiscal_Year' as 'Fiscal_Year';\n\n--load ELiot Summary\nb = load \"Eliot_Summary\";\n\n--group Eliot Summary by toggle selected grouping\nc = group b by ('{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', 'AQB__DisplayYear__c');\nc = foreach c generate c.'{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}' as '{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', c.'AQB__DisplayYear__c' as 'AQB__DisplayYear__c', count(b) as Count;\n\n--left join Eliot goals to Eliot results\nd = cogroup c by ('AQB__DisplayYear__c', '{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}') left, a by ('Fiscal_Year','Club_Level');\nd = foreach d generate c.'AQB__DisplayYear__c' as 'Year', c.'{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}' as '{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', first(c.Count) as Count, first(a.Goal) as Goal;\nd = order d by ('Year' desc, '{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}' asc);\n\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":true,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"binValues":false,"columnMap":{"trellis":[],"dimensionAxis":["Year","Giving_Level_Sort"],"plots":["Count","Goal"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Eliot_Summary_Table_1":{"broadcastFacet":true,"groups":[],"label":"Eliot Summary Table","numbers":[],"query":"a = load \"Eliot_Summary\";\n\n--subquery to get just the current fiscal year\nq_B = filter a by ('Id' is not null);\nq_B = foreach q_B generate '{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', 'AQB__DisplayYear__c', Id, 'Current_Fiscal_Year_Boolean', 'AQB__Year__c', 'Current_Fiscal_Year';\nq_B = filter q_B by 'AQB__Year__c' == 'Current_Fiscal_Year';\n--join subquery to get a column with jus the current year's result count\nq = cogroup a by ('{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', 'AQB__DisplayYear__c') full, q_B by ('{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', 'AQB__DisplayYear__c');\nq = foreach q generate coalesce(a.'{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', q_B.'{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}') as 'Group', coalesce(a.'AQB__DisplayYear__c', q_B.'AQB__DisplayYear__c') as 'Year', max(a.'{{cell(Eliot_Grouping_1.selection, 0, \"GoalAPI\").asString()}}') as 'Goal', count(a) as 'A', count(q_B) as 'B';\n \n--calculate % to goal for current year as a window function\nq = group q by ('Group', 'Goal', 'Year');\nq = foreach q generate coalesce(q.'Group',\"No Value\") as 'Group', q.'Year', q.'Goal', sum('A') as 'Result Count',\n    max(sum('B')) over([..] partition by q.'Group') as 'Current Count', number_to_string(max(sum('B')) over([..] partition by q.'Group')/'Goal' ,\"#.0%\") as '% to Goal';    \n\n--group by goal and % to goal\nq1 = group q by ('Group', 'Goal', '% to Goal', 'Current Count', 'Year');\nq1 = foreach q1 generate q1.Group,  q1.'Goal', q1.'% to Goal', q1.'Current Count', q1.'Year', sum('Result Count') as 'Result Count', \n\"\" as 'Background Color';\n\n\n--totals row for table display\nq1_B = group q1 by 'Year';\nq1_B = foreach q1_B generate \"z-Total\" as 'Group', sum('Goal') as 'Goal', number_to_string(sum('Current Count')/sum('Goal'),\"#.0%\") as '% to Goal', sum('Current Count') as 'Current Count', 'Year', sum('Result Count') as 'Result Count';\n\nq1_C = group q1_B by ('Group', 'Current Count', 'Year'); \nq1_C = foreach q1_C generate 'Group', max(sum('Goal')) over([..] partition by 'Group') as 'Goal', first('% to Goal') as '% to Goal', 'Current Count', 'Year', sum('Result Count') as 'Result Count', \"#D9D9D6\" as 'Background Color';\n\nq1_D = group q1_C by ('Group', 'Goal', '% to Goal', 'Current Count', 'Year'); \nq1_D = foreach q1_D generate 'Group', 'Goal', '% to Goal', 'Current Count', 'Year', sum('Result Count') as 'Result Count', \"#D9D9D6\" as 'Background Color';\n\n\n--add totals row to top of table display\nq2 = union q1, q1_C;\nq2 = group q2 by ('Group', 'Goal', '% to Goal', 'Year');\nq2 = foreach q2 generate 'Group', 'Goal', '% to Goal', 'Year', sum('Result Count') as 'Result Count', first('Background Color') as 'Background Color';\nq2 = order q2 by ('Group' asc, 'Year' desc);\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"rgb(0, 0, 0)","fontSize":12,"textWrap":true},"columnProperties":{},"columnTotals":true,"columns":["Group","Goal","% to Goal","Year","Result Count"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"rgb(0, 0, 0)","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":true,"rowTotals":false,"showActionMenu":true,"verticalPadding":8},"type":"table"}},"RenewalDateRangeMult_2":{"broadcastFacet":true,"datasets":[{"name":"Eliot_Summary"}],"isGlobal":false,"label":"RenewalDateRangeMult_1","query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"EliotStatus\"],\"order\":[[\"EliotStatus\",{\"ascending\":true}]]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","sortable":true,"start":"[\"New\",\"Reactivated\",\"Renewed\",\"Upgrade\",\"Downgrade\"]","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":["EliotStatus"],"plots":["count"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_5":{"broadcastFacet":true,"groups":[],"label":"lens_5","numbers":[],"query":"a = load \"Eliot_Summary\";\n\n--subquery to get just the current fiscal year index 1\nq_B1 = filter a by ('Id' is not null || EliotStatus in [\"Unrenewed\", \"Lapsed\"]);\nq_B1 = foreach q_B1 generate '{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', '{{cell(Eliot_Grouping_1.selection, 0, \"GoalAPI\").asString()}}', 'AQB__DisplayYear__c', Id, 'Current_Fiscal_Year_Boolean', 'AQB__Year__c', 'Current_Fiscal_Year', 1 as index, number_to_string(Current_Fiscal_Year,\"####\") as 'YearIndex';\nq_B1 = filter q_B1 by 'AQB__Year__c' == 'Current_Fiscal_Year';\n\n--subquery to get just the current fiscal year index 2\nq_B2 = filter a by ('Id' is not null || EliotStatus in [\"Unrenewed\", \"Lapsed\"]);\nq_B2 = foreach q_B2 generate '{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', '{{cell(Eliot_Grouping_1.selection, 0, \"GoalAPI\").asString()}}', 'AQB__DisplayYear__c', Id, 'Current_Fiscal_Year_Boolean', 'AQB__Year__c', 'Current_Fiscal_Year', 2 as index, number_to_string(Current_Fiscal_Year-1,\"####\") as 'YearIndex';\nq_B2 = filter q_B2 by 'AQB__Year__c' == 'Current_Fiscal_Year';\n\n--subquery to get just the current fiscal year index 3\nq_B3 = filter a by ('Id' is not null || EliotStatus in [\"Unrenewed\", \"Lapsed\"]);\nq_B3 = foreach q_B3 generate '{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', '{{cell(Eliot_Grouping_1.selection, 0, \"GoalAPI\").asString()}}', 'AQB__DisplayYear__c', Id, 'Current_Fiscal_Year_Boolean', 'AQB__Year__c', 'Current_Fiscal_Year', 3 as index, number_to_string(Current_Fiscal_Year-2,\"####\") as 'YearIndex';\nq_B3 = filter q_B3 by 'AQB__Year__c' == 'Current_Fiscal_Year';\n\n--union the group indexes to preserve 3 rows for each group to match the 3 fiscal years tracked in this dashboard to handle groups with years that have no data\nq_B4 = union q_B1, q_B2, q_B3;\n\n--group current fiscal year results by index\nq_B5 = group q_B4 by ('{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', '{{cell(Eliot_Grouping_1.selection, 0, \"GoalAPI\").asString()}}', 'AQB__DisplayYear__c', 'index', 'YearIndex');\nq_B5 = foreach q_B5 generate q_B5.'{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', '{{cell(Eliot_Grouping_1.selection, 0, \"GoalAPI\").asString()}}' as 'Goal', q_B5.'AQB__DisplayYear__c', count(q_B5) as 'Current Result Count', 'index', 'YearIndex';\n\n--get display year row number partitioned by group\nq_A = group a by ('{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', 'AQB__DisplayYear__c');\nq_A = foreach q_A generate '{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', row_number() over ([..] partition by '{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}' order by 'AQB__DisplayYear__c') as DisplayYearRowNumberByGroup, 'AQB__DisplayYear__c', count(a) as 'Result Count';\n\n--join subquery to get a column with just the current year's result count\nq = cogroup q_B5 by ('{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', 'YearIndex') left, q_A by ('{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}',  'AQB__DisplayYear__c');\nq = foreach q generate coalesce(q_B5.'{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}', q_A.'{{cell(Eliot_Grouping_1.selection, 0, \"API\").asString()}}') as 'Group', coalesce(q_B5.'YearIndex', q_A.'AQB__DisplayYear__c') as 'Year', coalesce(max(q_B5.'Goal'),0) as 'Goal', coalesce(sum(q_A.'Result Count'),0) as 'Result Count', sum(q_B5.'Current Result Count') as 'Current Result Count';\n\n--calculate % to goal for current year as a window function\nq = group q by ('Group', 'Goal', 'Year');\nq = foreach q generate coalesce(q.'Group',\"No Value\") as 'Group', q.'Year', q.'Goal', sum('Result Count') as 'Result Count', sum('Current Result Count') as 'Current Result Count', number_to_string(sum('Current Result Count')/'Goal',\"#.0%\") as '% to Goal';\n\n--group by goal and % to goal\nq1 = group q by ('Group', 'Goal', '% to Goal', 'Current Result Count', 'Year');\nq1 = foreach q1 generate q1.Group,  q1.'Goal', q1.'% to Goal', q1.'Current Result Count', q1.'Year', sum('Result Count') as 'Result Count', \n\"\" as 'Background Color';\n\n\n--totals row for table display\nq1_B = group q1 by 'Year';\nq1_B = foreach q1_B generate \"z-Total\" as 'Group', sum('Goal') as 'Goal', number_to_string(sum('Current Result Count')/sum('Goal'),\"#.0%\") as '% to Goal', sum('Current Result Count') as 'Current Result Count', 'Year', sum('Result Count') as 'Result Count';\n\nq1_C = group q1_B by ('Group', 'Current Result Count', 'Year'); \nq1_C = foreach q1_C generate 'Group', max(sum('Goal')) over([..] partition by 'Group') as 'Goal', first('% to Goal') as '% to Goal', 'Current Result Count', 'Year', sum('Result Count') as 'Result Count', \"#D9D9D6\" as 'Background Color';\n\nq1_D = group q1_C by ('Group', 'Goal', '% to Goal', 'Current Result Count', 'Year'); \nq1_D = foreach q1_D generate 'Group', 'Goal', '% to Goal', 'Current Result Count', 'Year', sum('Result Count') as 'Result Count', \"#D9D9D6\" as 'Background Color';\n\n\n--add totals row to top of table display\nq2 = union q1, q1_C;\nq2 = group q2 by ('Group', 'Goal', '% to Goal', 'Year');\nq2 = foreach q2 generate 'Group', 'Goal', '% to Goal', 'Year', sum('Result Count') as 'Result Count', first('Background Color') as 'Background Color';\nq2 = order q2 by ('Group' asc, 'Year' desc);\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"si