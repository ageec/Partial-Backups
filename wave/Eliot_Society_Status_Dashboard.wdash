tent":{"richTextContent":[{"attributes":{"size":"14px","color":"#020821"},"insert":"This page provides an acknowledgements view of Eliot Society members who are new, renewed, or reactivated in the current fiscal year. Summaries are generated at the Account level and are calculated based on Gift Recognition Credit for Annual Fund gifts. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_4":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px","color":"#020821"},"insert":"This page provides a detail view of Eliot Society membership within the last 3 fiscal years (current fiscal year + previous 2 fiscal years). Summaries are generated at the Account level and are calculated based on Gift Recognition Credit for Annual Fund gifts. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_7":{"parameters":{"content":{"richTextContent":[{"attributes":{"underline":true,"bold":true},"insert":"Eliot Status Definitions"},{"attributes":{},"insert":"\n\n"},{"attributes":{"underline":true},"insert":"Downgrade:"},{"attributes":{},"insert":" The Account is a current fiscal year Eliot Society member, and the Eliot Society level of the current fiscal year is lower than the Eliot Society level from the previous fiscal year.\n\n"},{"attributes":{"underline":true},"insert":"Lapsed:"},{"attributes":{},"insert":" The Account is not a current fiscal year Eliot Society member, was not a member of the Eliot Society in the previous fiscal year but was a member of the Eliot Society in one of the 3 years prior to the previous fiscal year.\n\n"},{"attributes":{"underline":true},"insert":"New:"},{"attributes":{},"insert":" The Account is a member of the Eliot Society in the current fiscal year and has never been a member of the Eliot Society in any previous fiscal years. \n\n"},{"attributes":{"underline":true},"insert":"Pledged Not Paid:"},{"attributes":{},"insert":" The Account is a current fiscal year Eliot Society member based on a pledge for which full payment has not been made. These summary record has a Summary Date but not a Renewal Date. These Accounts are "},{"attributes":{"underline":true,"bold":true},"insert":"not"},{"attributes":{},"insert":" inlcuded in YOY, YTD, or MTD. \n\n"},{"attributes":{"underline":true},"insert":"Reactivated:"},{"attributes":{},"insert":" The Account is a current fiscal year Eliot Society member, was not a member of the Eliot Society the previous fiscal year and was a member of the Eliot Society at some point prior to the previous fiscal year.\n\n"},{"attributes":{"underline":true},"insert":"Renewed:"},{"attributes":{},"insert":" The Account was a member of the Eliot Society in the previous fiscal year and has renewed its Eliot Society membership for the current fiscal year at the same level as the previous fiscal year. \n\n"},{"attributes":{"underline":true},"insert":"Unrenewed:"},{"attributes":{},"insert":" The Account is not a current fiscal year Eliot Society member, but was a member of the Eliot Society in the previous fiscal year.\n\n"},{"attributes":{"underline":true},"insert":"Upgrade:"},{"attributes":{},"insert":" The Account is a current fiscal year Eliot Society member, and the Eliot Society level of the current fiscal year is higher than the Eliot Society level from the previous fiscal year. "},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"chart_2":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":true,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"co