1.0}],"layouts":[],"steps":{"WHDLS_Engagement_1":{"broadcastFacet":true,"groups":[],"label":"WHDLS Engagement","numbers":[],"query":"q1 = load \"Activity_Report_Info\";\nq2 = load \"Account_Info\";\nq2 = filter q2 by 'Account.CFYInterestAccounts.CFYAccountInterestTypes' in [\"WHDLS - Tier 1\", \"WHDLS - Tier 2\", \"WHDLS - Tier 3\"];\nq1 = filter q1 by 'Account.Account.CFYInterestAccounts.CFYAccountInterestTypes' in [\"WHDLS - Tier 1\", \"WHDLS - Tier 2\", \"WHDLS - Tier 3\"];\nq1 = filter q1 by 'ARFiscalYearsPassed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), \"0\").asString()}}\";\nq1 = filter q1 by ('RecordType.Name' != \"Corporate Engagement\" || 'RecordType.Name' is null);\nq1 = group q1 by ('Account.Account.Id');\nq1 = foreach q1 generate q1.'Account.Account.Id' as 'Account.Account.Id', unique(q1.'Id') as 'ARs';\nq1 = filter q1 by 'ARs' >= 7;\nq = cogroup q1 by 'Account.Account.Id' right, q2 by 'Account.Id';\nq = foreach q generate unique(q1.'Account.Account.Id') as 'ARs', unique(q2.'Account.Id') as 'WHDLS Accounts';\nq = group q by all;\nq = foreach q generate sum(q.'ARs') as 'ARs', sum(q.'WHDLS Accounts') as 'WHDLS Accounts', sum(q.'ARs') / sum(q.'WHDLS Accounts') as 'WHDLS Enegagement Rate', 1 as 'Goal', (sum(q.'ARs') / sum(q.'WHDLS Accounts')) / 1 as '% to Goal';\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines