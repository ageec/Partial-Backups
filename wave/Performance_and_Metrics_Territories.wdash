e\"];\nq1 = cogroup q1_C by ('ARCH_Territory__c', 'TerritorySort') full, q1_A by ('ARCH_Territory__c', 'TerritorySort');\nq1 = foreach q1 generate coalesce(q1_C.'ARCH_Territory__c', q1_A.'ARCH_Territory__c') as 'ARCH_Territory__c', coalesce(q1_C.'TerritorySort', q1_A.'TerritorySort') as 'TerritorySort', count(q1_C) as 'C', count(q1_A) as 'A';\nq = cogroup q1 by ('ARCH_Territory__c', 'TerritorySort') full, q2 by ('Territory', 'Territory_Sort');\nq = foreach q generate coalesce(q1.'ARCH_Territory__c', q2.'Territory') as 'ARCH_Territory__c', coalesce(q1.'TerritorySort', q2.'Territory_Sort') as 'TerritorySort', first(q1.'C') as 'C', first(q1.'A') as 'A', sum(q2.'Amount') as 'B';\nq = foreach q generate 'ARCH_Territory__c', 'TerritorySort', 'C' as 'PFY Eliots', 'A' as 'CFY Eliots', 'B' as 'Goal Amount', B * C as 'Goal', coalesce(A,0)/(B * C) as '% to Goal';\nq = group q by rollup('ARCH_Territory__c', 'TerritorySort');\nq = foreach q generate q.'ARCH_Territory__c' as 'ARCH_Territory__c', q.'TerritorySort' as 'TerritorySort', sum(q.'CFY Eliots') as 'CFY Eliots', sum(q.'Goal') as 'Goal', sum(q.'CFY Eliots') / sum(q.'Goal') as '% to Goal', grouping(q.'ARCH_Territory__c') as 'grouping_ARCH_Territory__c', grouping(q.'TerritorySort') as 'grouping_TerritorySort';\ns = filter q by 'grouping_ARCH_Territory__c' == 1;\nq = filter q by 'grouping_ARCH_Territory__c' == 0 and 'grouping_TerritorySort' == 0;\nq = order q by 'TerritorySort' asc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"include","steps":["Territory_Toggle_1"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214