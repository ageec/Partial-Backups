ilters":false,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","B","C","D","E"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Fiscal_Year_1":{"broadcastFacet":true,"datasets":[{"name":"FiscalYearSettings"}],"isGlobal":false,"label":"Fiscal Year","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[{"name":"Display","filters":[],"ascending":false},{"name":"Fiscal_Years_Passed","filters":[],"ascending":true},{"name":"Fiscal_Year","filters":[],"ascending":true},{"name":"PFY_Passed","filters":[],"ascending":true},{"name":"Eliot_Status","filters":[],"ascending":true},{"name":"Eliot_Year","filters":[],"ascending":true},{"name":"PFY_Count","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{"FiscalYearSettings":{"filters":[["StartDate",[["fiscal_year",-1],["day",0]],"between"]]}},"sources":[{"columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["Display","Fiscal_Years_Passed","Fiscal_Year","PFY_Passed","Eliot_Status","Eliot_Year","PFY_Count"],"joins":[],"name":"FiscalYearSettings"}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"singlerequired","sortable":true,"type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","Display","Fiscal_Years_Passed","Fiscal_Year","PFY_Passed","Eliot_Status","Eliot_Year","PFY_Count"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfFrozenColumns":0,"numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Clone_of_Planned_Giv_1":{"broadcastFacet":true,"groups":[],"label":"Planned Giving Summary Table","numbers":[],"query":"q1 = load \"GiftAndPledgeTransactionsExtension\";\nq2 = load \"Territory_Goals\";\nq1 = filter q1 by date('NewProductionARCHCreditedFiscalYearDate_Year', 'NewProductionARCHCreditedFiscalYearDate_Month', 'NewProductionARCHCreditedFiscalYearDate_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\nq1 = filter q1 by 'Record_Type.Name' == \"Planned Gift\";\nq1 = filter q1 by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq1 = filter q1 by ('Name' != \"015672867\" || 'Name' is null);\nq2 = filter q2 by 'Goal' == \"Planned Giving\";\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), \"0\").asString()}}\";\nq1 = group q1 by ('Transaction.Name', 'DonorTerritory', 'DonorTerritorySort');\nq1 = foreach q1 generate q1.'Transaction.Name' as 'Transaction.Name', q1.'DonorTerritory' as 'DonorTerritory', q1.'DonorTerritorySort' as 'DonorTerritorySort', avg(q1.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests';\nq = cogroup q1 by ('DonorTerritory', 'DonorTerritorySort') full, q2 by ('Territory', 'Territory_Sort');\nq = foreach q generate coalesce(q1.'DonorTerritory', q2.'Territory') as 'DonorTerritory', coalesce(q1.'DonorTerritorySort', q2.'Territory_Sort') as 'DonorTerritorySort', sum(q1.'NewProductionAmountWithBequests') as 'New Production w/ Bequests', sum(q2.'Amount') as 'Goal', sum(q1.'NewProductionAmountWithBequests') / sum(q2.'Amount') as '% to Goal';\nq = group q by rollup('DonorTerritory', 'DonorTerritorySort');\nq = foreach q generate q.'DonorTerritory' as 'DonorTerritory', q.'DonorTerritorySort' as 'DonorTerritorySort', sum(q.'New Production w/ Bequests') as 'New Production w/ Bequests', sum(q.'Goal') as 'Goal', sum(q.'New Production w/ Bequests') / sum(q.'Goal') as '% to Goal', grouping(q.'DonorTerritory') as 'grouping_DonorTerritory', grouping(q.'DonorTerritorySort') as 'grouping_DonorTerritorySort';\ns = filter q by 'grouping_DonorTerritory' == 1;\nq = filter q by 'grouping_DonorTerritory' == 0 and 'grouping_DonorTerritorySort' == 0;\nq = order q by 'DonorTerritorySort' asc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"include","steps":["Territory_Toggle_1"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Total___Closed_Won_S_6":{"broadcastFacet":true,"datasets":[{"name