n [\"Account Campaign Appeal\", \"Contact Campaign Appeal\"];\nq2 = filter q2 by 'Goal' == \"Direct Marketing\";\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), \"0\").asString()}}\";\nq1 = group q1 by ('Transaction.Name', 'DonorTerritory', 'DonorTerritorySort');\nq1 = foreach q1 generate q1.'Transaction.Name' as 'Transaction.Name', q1.'DonorTerritory' as 'DonorTerritory', q1.'DonorTerritorySort' as 'DonorTerritorySort', avg(q1.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq = cogroup q1 by ('DonorTerritory', 'DonorTerritorySort') full, q2 by ('Territory', 'Territory_Sort');\nq = foreach q generate coalesce(q1.'DonorTerritory', q2.'Territory') as 'DonorTerritory', coalesce(q1.'DonorTerritorySort', q2.'Territory_Sort') as 'DonorTerritorySort', sum(q1.'Transaction.AQB__Amount__c') as 'Direct Marketing', sum(q2.'Amount') as 'Goal', sum(q1.'Transaction.AQB__Amount__c') / sum(q2.'Amount') as '% to Goal';\nq = group q by rollup('DonorTerritory', 'DonorTerritorySort');\nq = foreach q generate q.'DonorTerritory' as 'DonorTerritory', q.'DonorTerritorySort' as 'DonorTerritorySort', sum(q.'Direct Marketing') as 'Direct Marketing', sum(q.'Goal') as 'Goal', sum(q.'Direct Marketing') / sum(q.'Goal') as '% to Goal', grouping(q.'DonorTerritory') as 'grouping_DonorTerritory', grouping(q.'DonorTerritorySort') as 'grouping_DonorTerritorySort';\ns = filter q by 'grouping_DonorTerritory' == 1;\nq = filter q by 'grouping_DonorTerritory' == 0 and 'grouping_DonorTerritorySort' == 0;\nq = order q by 'DonorTerritorySort' asc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"include","steps":["Territory_Toggle_1"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12