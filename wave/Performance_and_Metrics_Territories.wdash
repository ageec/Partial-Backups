0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\nq = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq = filter q by 'AnnualFund' == \"true\";\nq = group q by ('Transaction.Name','DonorTerritory', 'DonorTerritorySort');\nq = foreach q generate q.'Transaction.Name' as 'Transaction.Name', q.'DonorTerritory' as 'DonorTerritory', q.'DonorTerritorySort' as 'DonorTerritorySort', avg(q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq = group q by ('DonorTerritory', 'DonorTerritorySort');\nq = foreach q generate q.'DonorTerritory' as 'DonorTerritory', q.'DonorTerritorySort' as 'DonorTerritorySort', sum(q.'Transaction.AQB__Amount__c') as 'Cash Received';\nq = group q by rollup('DonorTerritory', 'DonorTerritorySort');\nq = foreach q generate q.'DonorTerritory' as 'DonorTerritory', q.'DonorTerritorySort' as 'DonorTerritorySort', sum(q.'Cash Received') as 'Cash Received', grouping(q.'DonorTerritory') as 'grouping_DonorTerritory', grouping(q.'DonorTerritorySort') as 'grouping_DonorTerritorySort';\ns = filter q by 'grouping_DonorTerritory' == 1;\nq = filter q by 'grouping_DonorTerritory' == 0 and 'grouping_DonorTerritorySort' == 0;\nq = order q by 'DonorTerritorySort' asc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"include","steps":["Territory_Toggle_1"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["DonorTerritory","Cash Received"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 21