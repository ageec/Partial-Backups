q1_A.'DonorTerritorySort') as 'DonorTerritorySort', sum(q1_G.'A') as 'G', sum(q1_A.'A') as 'A'; -- unique(q1_G.'DonorID') as 'G', unique(q1_A.'DonorID') as 'A';\nq = cogroup q1 by ('DonorTerritory', 'DonorTerritorySort') full, q2 by ('Territory', 'Territory_Sort');\nq = foreach q generate coalesce(q1.'DonorTerritory', q2.'Territory') as 'DonorTerritory', coalesce(q1.'DonorTerritorySort', q2.'Territory_Sort') as 'DonorTerritorySort', first(q1.'G') as 'G', first(q1.'A') as 'A', sum(q2.'Amount') as 'B';\nq = foreach q generate 'DonorTerritory', 'DonorTerritorySort', 'G' as 'CFY Donor Count', 'A' as 'PFY Donor Count', 'B' as 'Goal Amount', A * B as 'Goal', coalesce(G,0)/(A * B) as '% to Goal';\nq = order q by 'DonorTerritorySort' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"include","steps":["Territory_Toggle_1"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","stack":false,"compactDecimalDigitsOnLine":-1,"showPoints":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"top-center","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":["CFY Donor Count","PFY Donor Count","Goal Amount","Goal","% to Goal"],"showNullValues":true,"customizeLegend":true,"showPercentage":false,"showDimensions":true,"showMeasures":true,"dimensions":["DonorTerritory"]}}},"visualizationType":"combo","missingValue":"connect","title":{"fontSize":18,"subtitleFontSize":11,"label":"Annual Fund Donor Count (5% Increase YoY)","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"plots":{"A":{"mark":"bar"},"Goal":{"mark":"dot"},"D":{"mark":"dot"}},"columnMap":{"trellis":[],"dimensionAxis":["DonorTerritory"],"plots":["CFY Donor Count","Goal"]},"showActionMenu":true,"measureAxis2":{"sqrtSc