}}},"visualizationType":"stackvbar","title":{"fontSize":18,"subtitleFontSize":11,"label":"New or Renewed Eliots","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"split":["{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Eliot_Status\"), \"CFY_Eliot_Status\").asString()}}"],"trellis":[],"dimensionAxis":["ARCH_Territory__c"],"plots":["A"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"normalize":false,"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Alumni_Donor_Partici_1":{"broadcastFacet":true,"groups":[],"label":"Alumni Donor Participation Summary Table","numbers":[],"query":"q1 = load \"GiftAndPledgeTransactionsExtension\";\nq2 = load \"Territory_Goals\";\nq1 = filter q1 by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq1 = filter q1 by 'ContactType' in [\"Alumni-Graduate\", \"Alumni-Other\", \"Alumni-Undergraduate\"];\nq1 = filter q1 by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq2 = filter q2 by 'Goal' == \"Alumni Participation\";\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), \"0\").asString()}}\";\nq1_G = filter q1 by 'ARCHCreditedFiscalYearsPassed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), \"0\").asString()}}\";\nq1_A = filter q1 by 'ARCHCreditedFiscalYearsPassed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"PFY_Passed\"), \"1\").asString()}}\";\nq1_G = group q1_G by ('DonorTerritory', 'DonorTerritorySort', 'DonorID');\nq1_G = foreach q1_G generate q1_G.'DonorTerritory' as 'DonorTerritory', q1_G.'DonorTerritorySort' as 'DonorTerritorySort', q1_G.'DonorID' as 'DonorID', unique(q1_G.'DonorID') as 'A', sum(q1_G.'Transaction.AQB__Amount__c') as 'B';\nq1_G = filter q1_G by 'B' != 0;\nq1_A = group q1_A by ('DonorTerritory', 'DonorTerritorySort', 'DonorID');\nq1_A = foreach q1_A generate q1_A.'DonorTerritory' as 'DonorTerritory', q1_A.'DonorTerritorySort' as 'DonorTerritorySort', q1_A.'DonorID' as 'DonorID', unique(q1_A.'DonorID') as 'A', sum(q1_A.'Transaction.AQB__Amount__c') as 'B';\nq1_A = filter q1_A by 'B' != 0;\nq1 = cogroup q1_G by ('DonorTerritory', 'DonorTerritorySort') full, q1_A by ('DonorTerritory', 'DonorTerritorySort');\nq1 = foreach q1 generate coalesce(q1_G.'DonorTerritory', q1_A.'DonorTerritory') as 'DonorTerritory', coalesce(q1_G.'DonorTerritorySort', q1_A.'DonorTerritorySort') as 'DonorTerritorySort', sum(q1_G.'A') as 'G', sum(q1_A.'A') as 'A'; -- unique(q1_G.'DonorID') as 'G', unique(q1_A.'DonorID') as 'A';\nq = cogroup q1 by ('DonorTerritory', 'DonorTerritorySort') full, q2 by ('Territory', 'Territory_Sort');\nq = foreach q generate coalesce(q1.'DonorTerritory', q2.'Territory') as 'DonorTerritory', coalesce(q1.'DonorTerritorySort', q2.'Territory_Sort') as 'DonorTerritorySort', first(q1.'G') as 'G', first(q1.'A') as 'A', sum(q2.'Amount') as 'B';\nq = foreach q generate 'DonorTerritory', 'DonorTerritorySort', 'G' as 'CFY Donor Count', 'A' as 'PFY Donor Count', 'B' as 'Goal Amount', A * B as 'Goal', coalesce(G,0)/(A * B) as '% to Goal';\nq = group q by rollup('DonorTerritory', 'DonorTerritorySort');\nq = foreach q generate q.'DonorTerritory' as 'DonorTerritory', q.'DonorTerritorySort' as 'DonorTerritorySort', sum(q.'CFY Donor Count') as 'CFY Donor Count', sum(q.'Goal') as 'Goal', sum(q.'CFY Donor Count') / sum(q.'Goal') as '% to Goal', grouping(q.'DonorTerritory') as 'grouping_DonorTerritory', grouping(q.'DonorTerritorySort') as 'grouping_DonorTerritorySort';\ns = filter q by 'grouping_DonorTerritory' == 1;\nq = filter q by 'grouping_DonorTerritory' == 0 and 'grouping_DonorTerritorySort' == 0;\nq = order q by 'DonorTerritorySort' asc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"include","steps":["Territory_Toggle_1"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"oddRowColor":"#ffffff","showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"CFY_Activity_Qualifi_1":{"broadcastFacet":true,"datasets":[{"name":"Activity_Report_Info"}],"isGlobal":false,"label":"CFY Activity Qualification Outreaches","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[],"rowTotals":[],"sourceFilters":{"Activity_Report_Info":{"filters":[["AQB__Purpose__c",["Qualification"],"in"],["AQB__ReportStatus__c",["Final"],"in"],["RecordType.Name",["Corporate Engagement"],"not in"],["ARFiscalYearsPassed",["{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}"],"in"]]},"Territory_Goals":{"filters":[["Goal",["Total # of Qualifications"],"in"]]}},"sources":[{"columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["all"],"joins":[],"name":"Activity_Report_Info"},{"columns":[{"formula":"null","name":"B"},{"formula":"coalesce(A,0)/coalesce(B,0)","n