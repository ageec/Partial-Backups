rders":[],"rowTotals":[],"sourceFilters":{"Territory_Goals":{"filters":[["Goal",["Total # of Opps Closed/Won"],"in"],["Fiscal_Years_Passed",["{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}"],"in"]]},"Opportunity_Info":{"filters":[["Opportunity.CloseDateFiscalYearsPassed",["{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}"],"in"]]}},"sources":[{"cogroupType":"full","columns":[{"field":["count","*"],"name":"A"}],"filters":[["Opportunity.StageName",["Closed Won","Closed/Won"],"in"],["Opportunity.OppRecordType.Name",["Grateful Patients"],"not in"]],"groups":["all"],"joins":[],"name":"Opportunity_Info"},{"columns":[{"field":["sum","Amount"],"name":"B"}],"filters":[],"groups":["all"],"joins":[],"name":"Territory_Goals"},{"columns":[{"formula":"A/B","name":"C"}],"filters":[],"groups":[],"joins":[]}]},"receiveFacetSource":{"mode":"include","steps":["Territory_Toggle_1"]},"selectMode":"single","sortable":true,"type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","B","C"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Annual_Fund_Received_1":{"broadcastFacet":true,"groups":[],"label":"Annual Fund Received","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"..\"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq = filter q by 'AnnualFund' == \"true\";\nq = group q by 'Transaction.Name';\nq = foreach q generate q.'Transaction.Name' as 'Transaction.Name', avg(q.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq = group q by all;\nq = foreach q generate sum(q.'Transaction.AQB__Amount__c') as 'A';\nq = foreach q generate 'A' as 'Annual Fund Received', null as 'B', coalesce(A,0)/coalesce(null,0) as '% to Goal';\nq = limit q 2000;","receiveFacetSource":{"mode":"include","steps":["Territory_Toggle_1"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"CFY_Total_Opportunit_1":{"broadcastFacet":true,"datasets":[{"name":"Opportunity_Info"},{"name":"Territory_Goals"}],"isGlobal":false,"label":"CFY Total Opportunity Solicited Amount","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[],"rowTotals":[],"sourceFilters":{"Territory_Goals":{"filters":[["Goal",["Total $ of Opps Solicited"],"in"],["Fiscal_Years_Passed",["{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}"],"in"]]},"Opportunity_Info":{"filters":[["Opportunity.StageName",["Closed - Funded No Value","Closed Won","Closed/Lost","Closed/Won","Closed/Won - No Value","Negotiation/Review","Proposal Submittal","Solicitation","Solicitation (PG)"],"in"],["Opportunity.OppRecordType.Name",["Grateful Patients"],"not in"],["Opportunity.DateAskedFiscalYearsPassed",["{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}"],"in"]]}},"sources":[{"cogroupType":"full","columns":[{"field":["sum","Opportunity.AQC_Ask_Amount__c"],"name":"A"}],"filters":[],"groups":["all"],"joins":[],"name":"Opportunity_Info"},{"columns":[{"field":["sum","Amount"],"name":"B"}],"filters":[],"groups":["all"],"joins":[],"name":"Territory_Goals"},{"columns":[{"formula":"coalesce(coalesce(A,0)/coalesce(B,0),0)","name":"C"}],"filters":[],"groups":[],"joins":[]}]},"receiveFacetSource":{"mode":"include","steps":["Territory_Toggle_1"]},"selectMode":"single","sortable":true,"type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["A","B","C"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Increase_of_Alumni_P_3":{"broadcastFacet":true,"groups":[],"label":"Increase of Alumni Participation Territory","numbers":[],"query":"q1 = load \"GiftAndPledgeTransactionsExtension\";\nq2 = load \"Territory_Goals\";\nq1 = filter q1 by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq1 = filter q1 by 'ContactType' in [\"Alumni-Graduate\", \"Alumni-Other\", \"Alumni-Undergraduate\"];\nq1 = filter q1 by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq2 = filter q2 by 'Goal' == \"Alumni Participation\";\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}\";\nq1_A = filter q1 by 'ARCHCreditedFiscalYearsPassed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}\";\nq1_B = filter q1 by 'ARCHCreditedFiscalYearsPassed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"PFY_Passed\"), 1).asString()}}\";\nq1_A = group q1_A by ('DonorID');\nq1_A = foreach q1_A generate q1_A.'DonorID' as 'DonorID', unique(q1_A.'DonorID') as 'A', sum(q1_A.'Transaction.AQB__Amount__c') as 'B';\nq1_A = filter q1_A by 'B' != 0;\nq1_B = group q1_B by ('DonorID');\nq1_B = foreach q1_B generate q1_B.'DonorID' as 'DonorID', unique(q1_B.'DonorID') as 'A', sum(q1_B.'Transaction.AQB__Amount__c') as 'B';\nq1_B = filter q1_B by 'B' != 0;\nq1 = cogroup q1_A by all full, q1_B by all;\nq1 = foreach q1 generate sum(q1_A.'A') as 'A', sum(q1_B.'A') as 'B'; -- unique(q1_A.'DonorID') as 'A', unique(q1_B.'DonorID') as 'B';\nq = cogroup q1 by all full, q2 by all;\nq = foreach q generate first(q1.'A') as 'A', first(q1.'B') as 'B', avg(q2.'Amount') as 'C';\nq = foreach q generate 'A' as 'Donor Count', 'B' as 'PFY Donor Count', 'C' as 'Avg. Goal Amount', B * C as 'Goal', A/(B * C) as '% to Goal';\n-- 'A', 'B', 'C', B * C as 'D', A/(B * C) as 'E';\nq = limit q 2000;","receiveFacetSource":{"mode":"include","steps":["Territory_Toggle_1"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#1632