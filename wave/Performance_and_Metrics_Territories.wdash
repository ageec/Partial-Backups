' as 'DonorTerritory', q1_A.'DonorTerritorySort' as 'DonorTerritorySort', q1_A.'DonorID' as 'DonorID', unique(q1_A.'DonorID') as 'A', sum(q1_A.'Transaction.AQB__Amount__c') as 'B';\nq1_A = filter q1_A by 'B' != 0;\n\nq1 = cogroup q1_G by ('DonorTerritory', 'DonorTerritorySort') full, q1_A by ('DonorTerritory', 'DonorTerritorySort');\nq1 = foreach q1 generate coalesce(q1_G.'DonorTerritory', q1_A.'DonorTerritory') as 'DonorTerritory', coalesce(q1_G.'DonorTerritorySort', q1_A.'DonorTerritorySort') as 'DonorTerritorySort', sum(q1_G.'A') as 'G', sum(q1_A.'A') as 'A'; -- unique(q1_G.'DonorID') as 'G', unique(q1_A.'DonorID') as 'A';\nq = cogroup q1 by ('DonorTerritory', 'DonorTerritorySort') full, q2 by ('Territory', 'Territory_Sort');\nq = foreach q generate coalesce(q1.'DonorTerritory', q2.'Territory') as 'DonorTerritory', coalesce(q1.'DonorTerritorySort', q2.'Territory_Sort') as 'DonorTerritorySort', first(q1.'G') as 'G', first(q1.'A') as 'A', sum(q2.'Amount') as 'B';\nq = foreach q generate 'DonorTerritory', 'DonorTerritorySort', 'G' as 'CFY Donor Count', 'A' as 'PFY Donor Count', 'B' as 'Goal Amount', A * B as 'Goal', coalesce(G,0)/(A * B) as '% to Goal';\nq = group q by rollup('DonorTerritory', 'DonorTerritorySort');\nq = foreach q generate q.'DonorTerritory' as 'DonorTerritory', q.'DonorTerritorySort' as 'DonorTerritorySort', sum(q.'CFY Donor Count') as 'CFY Donor Count', sum(q.'Goal') as 'Goal', sum(q.'CFY Donor Count') / sum(q.'Goal') as '% to Goal', grouping(q.'DonorTerritory') as 'grouping_DonorTerritory', grouping(q.'DonorTerritorySort') as 'grouping_DonorTerritorySort';\ns = filter q by 'grouping_DonorTerritory' == 1;\nq = filter q by 'grouping_DonorTerritory' == 0 and 'grouping_DonorTerritorySort' == 0;\nq = order q by 'DonorTerritorySort' asc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"include","steps":["Territory_Toggle_1"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false