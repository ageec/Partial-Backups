cal_Year_1.selection, 0, \"Fiscal_Year\"), \"current fiscal_year\").asString()}}\"];\nq1 = filter q1 by ('Campaign_Appeal.Type' not in [\"Officer\", \"Other\"] || 'Campaign_Appeal.Type' is null);\nq1 = filter q1 by 'Campaign_Appeal.Record_Type.Name' in [\"Account Campaign Appeal\", \"Contact Campaign Appeal\"];\nq2 = filter q2 by 'Goal' == \"Direct Marketing\";\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), \"0\").asString()}}\";\nq1 = group q1 by ('Transaction.Name', 'DonorTerritory', 'DonorTerritorySort');\nq1 = foreach q1 generate q1.'Transaction.Name' as 'Transaction.Name', q1.'DonorTerritory' as 'DonorTerritory', q1.'DonorTerritorySort' as 'DonorTerritorySort', avg(q1.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq = cogroup q1 by ('DonorTerritory', 'DonorTerritorySort') full, q2 by ('Territory', 'Territory_Sort');\nq = foreach q generate coalesce(q1.'DonorTerritory', q2.'Territory') as 'DonorTerritory', coalesce(q1.'DonorTerritorySort', q2.'Territory_Sort') as 'DonorTerritorySort', sum(q1.'Transaction.AQB__Amount__c') as 'Direct Marketing', sum(q2.'Amount') as 'Goal';\nq = order q by 'DonorTerritorySort' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"include","steps":["Territory_Toggle_1"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","stack":false,"bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showPoints":true,"compactDecimalDigitsOnLine":-1,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"top-center","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":["Direct Marketing","Goal"],"showNullValues":true,"customizeLegend":true,"showPe