ate q.'DonorTerritory' as 'DonorTerritory', q.'DonorTerritorySort' as 'DonorTerritorySort', sum(q.'Transaction.AQB__Amount__c') as 'Cash Received';\nq = order q by 'DonorTerritorySort' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"include","steps":["Territory_Toggle_1"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"compactDecimalDigitsOnLine":-1,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"top-center","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":["Cash Received"],"showNullValues":true,"customizeLegend":true,"showPercentage":false,"showDimensions":true,"showMeasures":true,"dimensions":["DonorTerritory"]}}},"visualizationType":"vbar","title":{"fontSize":18,"subtitleFontSize":11,"label":"Annual Fund Cash Received","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":["DonorTerritory"],"plots":["Cash Received"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":false,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Annual_Fund_Received_4":{"broadcastFacet":true,"groups":[],"label":"Annual Fund Received Donor Count Summary Table","numbers":[],"query":"q1 = load \"GiftAndPledgeTransactionsExtension\";\nq2 = load \"Territory_Goals\";\nq1 = filter q1 by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq1 = filter q1 by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq1 = filter q1 by 'AnnualFund' == \"true\";\nq2 = filter q2 by 'Goal' == \"Annual Fund Participation\";\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), \"0\").asString()}}\";\nq1_G = filter q1 by 'ARCHCreditedFiscalYearsPassed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), \"0\").asString()}}\";\nq1_A = filter q1 by 'ARCHCreditedFiscalYearsPassed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"PFY_Passed\"), \"1\").asString()}}\";\nq1_G = group q1_G by ('DonorTerritory', 'DonorTerritorySort', 'DonorID');\nq1_G = foreach q1_G generate q1_G.'DonorTerritory' as 'DonorTerritory', q1_G.'DonorTerritorySort' as 'DonorTerritorySort', q1_G.'DonorID' as 'DonorID', unique(q1_G.'DonorID') as 'A', sum(q1_G.'Transaction.AQB__Amount__c') as 'B';\nq1_G = filter q1_G by 'B' != 0;\nq1_A = group q1_A by ('DonorTerritory', 'DonorTerritorySort', 'DonorID');\nq1_A = foreach q1_A generate q1_A.'DonorTerritory' as 'DonorTerritory', q1_A.'DonorTerritorySort' as 'DonorTerritorySort', q1_A.'DonorID' as 'DonorID', unique(q1_A.'DonorID') as 'A', sum(q1_A.'Transaction.AQB__Amount__c') as 'B';\nq1_A = filter q1_A by 'B' != 0;\nq1 = cogroup q1_G by ('DonorTerritory', 'DonorTerritorySort') full, q1_A by ('DonorTerritory', 'DonorTerritorySort');\nq1 = foreach q1 generate coalesce(q1_G.'DonorTerritory', q1_A.'DonorTerritory') as 'DonorTerritory', coalesce(q1_G.'DonorTerritorySort', q1_A.'DonorTerritorySort') as 'DonorTerritorySort', sum(q1_G.'A') as 'G', sum(q1_A.'A') as 'A'; -- unique(q1_G.'DonorID') as 'G', unique(q1_A.'DonorID') as 'A';\nq = cogroup q1 by ('DonorTerritory', 'DonorTerritorySort') full, q2 by ('Territory', 'Territory_Sort');\nq = foreach q generate coalesce(q1.'DonorTerritory', q2.'Territory') as 'DonorTerritory', coalesce(q1.'DonorTerritorySort', q2.'Territory_Sort') as 'DonorTerritorySort', first(q1.'G') as 'G', first(q1.'A') as 'A', sum(q2.'Amount') as 'B';\nq = foreach q generate 'DonorTerritory', 'DonorTerritorySort', 'G' as 'CFY Donor Count', 'A' as 'PFY Donor Count', 'B' as 'Goal Amount', A * B as 'Goal', coalesce(G,0)/(A * B) as '% to Goal';\nq = group q by rollup('DonorTerritory', 'DonorTerritorySort');\nq = foreach q generate q.'DonorTerritory' as 'DonorTerritory', q.'DonorTerritorySort' as 'DonorTerritorySort', sum(q.'CFY Donor Count') as 'CFY Donor Count', sum(q.'Goal') as 'Goal', sum(q.'CFY Donor Count') / sum(q.'Goal') as '% to Goal', grouping(q.'DonorTerritory') as 'grouping_DonorTerritory', grouping(q.'DonorTerritorySort') as 'grouping_DonorTerritorySort';\ns = filter q by 'grouping_DonorTerritory' == 1;\nq = filter q by 'grouping_DonorTerritory' == 0 and 'grouping_DonorTerritorySort' == 0;\nq = order q by 'DonorTerritorySort' asc;\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"include","steps":["Territory_Toggle_1"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"alignment":"left","backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"oddRowColor":"#ffffff","showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Annual_Fund_Received_3":{"broadcastFacet":true,"groups":[],"label":"Annual Fund Received Donor Count","numbers":[],"query":"q1 = load \"GiftAndPledgeTransactionsExtension\";\nq2 = load \"Territory_Goals\";\nq1 = filter q1 by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq1 = filter q1 by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq1 = filter q1 by 'AnnualFund' == \"true\";\nq2 = filter q2 by 'Goal' == \"Annual Fund Participation\";\nq2 = filter q2 by 'Fiscal_Years_Passed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}\";\nq1_A = filter q1 by 'ARCHCreditedFiscalYearsPassed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"Fiscal_Years_Passed\"), 0).asString()}}\";\nq1_B = filter q1 by 'ARCHCreditedFiscalYearsPassed' == \"{{coalesce(cell(Fiscal_Year_1.selection, 0, \"PFY_Passed\"), 1).asString()}}\";\nq1_A = group q1_A by ('DonorID');\nq1_A = foreach q1_A generate q1_A.'DonorID' as 'DonorID', unique(q1_A.'DonorID') as 'A', sum(q1_A.'Transaction.AQB__Amount__c') as 'B';\nq1_A = filter q1_A by 'B' != 0;\nq1_B = group q1_B by ('DonorID');\nq1_B = foreach q1_B generate q1_B.'DonorID' as 'DonorID', unique(q1_B.'DonorID') as 'A', sum(q1_B.'Transaction.AQB__Amount__c') as 'B';\nq1_B = filter q1_B by 'B' != 0;\nq1 = cogroup q1_A by all full, q1_B by all;\nq1 = foreach q1 generate sum(q1_A.'A') as 'A', sum(q1_B.'A') as 'B'; -- unique(q1_A.'DonorID') as 'A', unique(q1_B.'DonorID') as 'B';\nq = cogroup q1 by all full, q2 by all;\nq = foreach q generate first(q1.'A') as 'A', first(q1.'B') as 'B', avg(q2.'Amount') as 'C';\nq = foreach q generate 'A' as 'Donor Count', 'B' as 'PFY Donor Count', 'C' as 'Avg. Goal Amount', B * C as 'Goal', A/(B * C) as '% to Goal';\n-- 'A', 'B', 'C', B * C as 'D', A/(B * C) as 'E';\nq = limit q 2000;","receiveFacetSource":{"mode":"include","steps":["Territory_Toggle_1"]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":