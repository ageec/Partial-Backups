e,"numberColor":"#020821","numberItalic":false,"numberSize":16,"showActionMenu":true,"step":"lens_8","textAlignment":"left","title":"Count of Rows","titleBold":false,"titleColor":"#BA0C2F","titleItalic":false,"titleSize":16,"tooltip":{"content":{"description":{"displayTemplate":"Count of Alternate Channel Records where Instant Address Transaction Batch Job contains \"NCOA\""}},"customizeTooltip":true}},"type":"number"},"filterpanel_7":{"parameters":{"filterItemOptions":{"propertyColor":"#020821","valueColor":"#BA0C2F"},"filters":[{"dataset":{"name":"Instant_Address_Alternate_Channel"},"field":"Contact.ARCH_Contact_ID__c"}],"showAllFilters":false},"type":"filterpanel"},"filterpanel_6":{"parameters":{"filterItemOptions":{"propertyColor":"#020821","valueColor":"#BA0C2F"},"filters":[{"dataset":{"name":"Instant_Address_Alternate_Channel"},"field":"Contact.Name"}],"showAllFilters":false},"type":"filterpanel"},"filterpanel_5":{"parameters":{"filterItemOptions":{"propertyColor":"#020821","valueColor":"#BA0C2F"},"filters":[{"dataset":{"name":"Instant_Address_Alternate_Channel"},"field":"Contact.AQB__SecondaryType__c"}],"showAllFilters":false},"type":"filterpanel"},"filterpanel_4":{"parameters":{"filterItemOptions":{"propertyColor":"#020821","valueColor":"#BA0C2F"},"filters":[{"dataset":{"name":"Instant_Address_Alternate_Channel"},"field":"Contact.ARCH_PrimaryGiftOfficer__c"}],"showAllFilters":false},"type":"filterpanel"},"filterpanel_3":{"parameters":{"filterItemOptions":{"propertyColor":"#020821","valueColor":"#BA0C2F"},"filters":[{"dataset":{"name":"Instant_Address_Alternate_Channel"},"field":"Contact.ARCH_CFYPFY_Eliot_Society_Member__c"}],"showAllFilters":false},"type":"filterpanel"},"image_1":{"parameters":{"alignmentX":"center","alignmentY":"center","fit":"fitwidth","image":{"name":"WashURGBjpg25","namespace":""},"interactions":[]},"type":"image"},"text_3":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px","color":"#020821"},"insert":"The National Change of Address (NCOA) feature included within the Initium Instant Address service allows users to automatically update addresses in their database with the latest information from the USPS when someone moves, ensuring mail is delivered to the correct location by verifying addresses against the USPS's change-of-address database. "},{"attributes":{"align":"left"},"insert":"\n\n"},{"attributes":{"size":"14px","color":"#020821"},"insert":"Note that only the most recent NCOA transaction (based on Transaction Created Date) per Alternate Channel is displayed in the table. Also, note that the table "},{"attributes":{"size":"14px","color":"#020821","underline":true,"bold":true},"insert":"row limit is set to 300,000 records"},{"attributes":{"size":"14px","color":"#020821"},"insert":", so will need to be filtered to a row count of less than or equal to 300,000 rows to include every desired record. Questions? Submit a case or reach out to askarch@wustl.edu."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_2":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ba0c2f","size":"16px"},"insert":"Clear Selections"},{"attributes":{"align":"center"},"insert":"\n"}]},"interactions":[{"actions":[{"resetType":"resetfilters","type":"reset"}],"event":"click"}],"showActionMenu":true},"type":"text"},"listselector_1":{"parameters":{"compact":false,"displayMode":"filter","exploreLink":false,"filterStyle":{"titleColor":"#020821","valueColor":"#BA0C2F"},"instant":false,"interactions":[],"measureField":"count","showActionMenu":true,"step":"InstantAddTransactio_1","title":"Transaction Name (Transaction)"},"type":"listselector"}}}