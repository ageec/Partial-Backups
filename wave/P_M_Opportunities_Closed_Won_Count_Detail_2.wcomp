,"label":"Fiscal Years Passed","name":"parameter_1"},{"defaultValue":"current fiscal_year","description":"","label":"Fiscal Year","name":"parameter_2"}],"steps":{"WHDLS_Engagement_Sum_1":{"broadcastFacet":true,"groups":[],"label":"WHDLS Engagement Summary","numbers":[],"query":"q1 = load \"Activity_Report_Info\";\nq2 = load \"Account_Info\";\nq2 = filter q2 by 'Account.CFYInterestAccounts.CFYAccountInterestTypes' in [\"WHDLS - Tier 1\", \"WHDLS - Tier 2\", \"WHDLS - Tier 3\"];\nq1 = filter q1 by 'Account.Account.CFYInterestAccounts.CFYAccountInterestTypes' in [\"WHDLS - Tier 1\", \"WHDLS - Tier 2\", \"WHDLS - Tier 3\"];\nq1 = filter q1 by date('AQB__Date__c_Year', 'AQB__Date__c_Month', 'AQB__Date__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = group q1 by ('Account.Account.Id');\nq1 = foreach q1 generate q1.'Account.Account.Id' as 'Account.Account.Id', unique(q1.'Id') as 'WHDLS Accounts';\nq1 = filter q1 by 'WHDLS Accounts' >= 7;\nq = cogroup q1 by 'Account.Account.Id' right, q2 by 'Account.Id';\nq = foreach q generate unique(q1.'Account.Account.Id') as 'WHDLS Accounts', unique(q2.'Account.Id') as 'Total Accounts';\nq = group q by all;\nq = foreach q generate sum(q.'WHDLS Accounts') as 'WHDLS Accounts', sum(q.'Total Accounts') as 'Total Accounts', sum(q.'WHDLS Accounts') / sum(q.'Total Accounts') as 'WHDLS Enegagement Rate', 1 as 'Goal', (sum(q.'WHDLS Accounts') / sum(q.'Total Accounts')) / 1 as '% to Goal';\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":true},"headerProperties":{},"i