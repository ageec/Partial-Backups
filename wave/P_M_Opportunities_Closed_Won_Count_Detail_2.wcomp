gregateFilters":[],"columnGroups":["Opportunity.ARCH_Territory__c"],"columnTotals":["Opportunity.ClosedWonGiftBand"],"limit":2000,"orders":[{"name":"Opportunity.ClosedWonGiftBand","filters":[],"ascending":true},{"name":"Opportunity.ARCH_Territory__c","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{"Opportunity_Info":{"filters":[["Opportunity.StageName",["Closed Won","Closed/Won"],"in"],["Opportunity.ClosedWonGiftBand",[],"isnotnull"],["Opportunity.OppRecordType.Name",["Grateful Patients"],"not in"],["Opportunity.CloseDateFiscalYearsPassed",["[[parameter_1]]"],"in"]]}},"sources":[{"columns":[{"field":["count","*"],"name":"A"},{"field":["sum","Opportunity.Amount"],"name":"B"}],"filters":[],"groups":["Opportunity.ClosedWonGiftBand","Opportunity.ARCH_Territory__c"],"joins":[],"name":"Opportunity_Info"}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columnTotals":true,"columns":["A","B","Opportunity.ClosedWonGiftBand","Opportunity.ARCH_Territory__c"],"customBulkActions":[],"evenRowColor":"#f2f6fa","fixedColumnWidth":100,"header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fixed","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"GO___Closed_Won_by_O_1":{"broadcastFacet":false,"groups":[],"label":"GO # Closed/Won by OTM Summary Table","numbers":[],"query":"q1 = load \"OpportunityDetail\";\nq2 = load \"User_Goal_Info\";\nq1 = filter q1 by 'StageName' in [\"Closed Won\", \"Closed/Won\"];\nq1 = filter q1 by date('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by ('OppRecordType.Name' != \"Grateful Patients\" || 'OppRecordType.Name' is null);\nq2 = filter q2 by 'AQB__Classification__c' == \"Number of Opportunities Closed/Won\";\nq2 = filter q2 by 'GiftOfficerTeam' in [\"Med Alumni\", \"Med/Surg\", \"Neuro\", \"Med CFR\", \"Siteman\", \"Momentum/EVC/VC\", \"Other UA\"];\nq2 = filter q2 by date('AQB__LastGoalIntervalDate__c_Year', 'AQB__LastGoalIntervalDate__c_Month', 'AQB__LastGoalIntervalDate__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq = cogroup q1 by ('OpportunityTeamMember.GiftOfficerTeam', 'OpportunityTeamMember.Name') full, q2 by ('GiftOfficerTeam', 'User.Name');\nq = foreach q generate coalesce(q1.'OpportunityTeamMember.GiftOfficerTeam', q2.'GiftOfficerTeam') as 'OpportunityTeamMember.GiftOfficerTeam', coalesce(q1.'OpportunityTeamMember.Name', q2.'User.Name') as 'OpportunityTeamMember.Name', count(q1) as 'A', sum(q2.'AQB__GoalCount__c') as 'B';\nq = foreach q generate 'OpportunityTeamMember.GiftOfficerTeam', 'OpportunityTeamMember.Name', 'A' as '# Closed/Won', 'B' as 'Goal', A/B as '% to Goal';\nq = group q by rollup('OpportunityTeamMember.GiftOfficerTeam', 'OpportunityTeamMember.Name');\nq = foreach q generate q.'OpportunityTeamMember.GiftOfficerTeam' as 'OpportunityTeamMember.GiftOfficerTeam', q.'OpportunityTeamMember.Name' as 'OpportunityTeamMember.Name', sum(q.'# Closed/Won') as '# Closed/Won', sum(q.'Goal') as 'Goal', sum(q.'# Closed/Won') / sum(q.'Goal') as '% to Goal', grouping(q.'OpportunityTeamMember.GiftOfficerTeam') as 'grouping_OpportunityTeamMember.GiftOfficerTeam', grouping(q.'OpportunityTeamMember.Name') as 'grouping_OpportunityTeamMember.Name';\ns = filter q by 'grouping_OpportunityTeamMember.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_OpportunityTeamMember.GiftOfficerTeam' == 0 and 'grouping_OpportunityTeamMember.Name' == 0;\nq = order q by ('OpportunityTeamMember.GiftOfficerTeam' asc, 'OpportunityTeamMember.Name' asc);\nq = limit q 10000;\nq = union q, s;\nq = limit q 10001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Territories_Closed_W_3":{"broadcastFacet":true,"datasets":[{"name":"Opportunity_Info"}],"isGlobal":false,"label":"Territories Closed/Won Gift Band Toggle","query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[{"name":"Opportunity.ClosedWonGiftBand","filters":[],"ascending":true}],"rowTotals":[],"sourceFilters":{"Opportunity_Info":{"filters":[["Opportunity.CloseDateFiscalYearsPassed",["[[parameter_1]]"],"in"],["Opportunity.StageName",["Closed Won","Closed/Won"],"in"],["Opportunity.ClosedWonGiftBand",[],"isnotnull"],["Opportunity.OppRecordType.Name",["Grateful Patients"],"not in"]]}},"sources":[{"columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["Opportunity.ClosedWonGiftBand"],"joins":[],"name":"Opportunity_Info"}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","sortable":true,"type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"bac