portunity.OppRecordType.Name' is null);\nq1 = foreach q1 generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OppRecordType.Name', 'Opportunity.Name', 'Opportunity.OpportunityOwner.User.ARCH_Primary_Fundraising_Lane__c', 'Opportunity.Amount', 'Opportunity.CloseDate', 'Opportunity.DaysFromAskDateToCloseDate', 'Opportunity.Id', 'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', 'Account.Name', 'Account.Id';\n\nq = group q1 by rollup('Opportunity.Name', 'Opportunity.Id', 'Account.AQC_Account_ARCH_ID__c', 'Account.Name', 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', 'Opportunity.OppRecordType.Name', 'Account.Id', 'Opportunity.OpportunityOwner.Name', 'Opportunity.OpportunityOwner.User.ARCH_Primary_Fundraising_Lane__c', 'Opportunity.CloseDate');\nq = foreach q generate q.'Opportunity.Name' as 'Opportunity.Name', q.'Opportunity.Id' as 'Opportunity.Id', q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'Account.Name' as 'Account.Name', q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q.'Opportunity.ClosedWonGiftBandDevelopmentVertical' as 'Opportunity.ClosedWonGiftBandDevelopmentVertical', q.'Account.Id' as 'Account.Id', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', 'Opportunity.OpportunityOwner.User.ARCH_Primary_Fundraising_Lane__c', q.'Opportunity.CloseDate' as 'Opportunity.CloseDate', \nsum(q.'Opportunity.Amount') as '$ - Closed/Won Amount',\ncount(q) as '# - Closed/Won Count', \naverage('Opportunity.DaysFromAskDateToCloseDate') as 'Opportunity.DaysFromAskDateToCloseDate', \ngrouping(q.'Opportunity.Name') as 'grouping_Opportunity.Name', grouping(q.'Opportunity.Id') as 'grouping_Opportunity.Id', grouping(q.'Account.AQC_Account_ARCH_ID__c') as 'grouping_Account.AQC_Account_ARCH_ID__c', grouping(q.'Account.Name') as 'grouping_Account.Name', grouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical', grouping(q.'Account.Id') as 'grouping_Account.Id', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name', grouping(q.'Opportunity.OpportunityOwner.User.ARCH_Primary_Fundraising_Lane__c') as 'grouping_Opportunity.OpportunityOwner.User.ARCH_Primary_Fundraising_Lane__c', grouping(q.'Opportunity.CloseDate') as 'grouping_Opportunity.CloseDate';\n\ns = filter q by 'grouping_Opportunity.Name' == 1;\nq = filter q by 'grouping_Opportunity.Name' == 0 and 'grouping_Opportunity.Id' == 0 and 'grouping_Account.AQC_Account_ARCH_ID__c' == 0 and 'grouping_Account.Name' == 0 and 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 0 and 'grouping_Account.Id' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0 and 'grouping_Opportunity.CloseDate' == 0;\nq = order q by ('Opportunity.Name' asc, 'Opportunity.Id' asc, 'Account.AQC_Account_ARCH_ID__c' asc, 'Account.Name' asc, 'Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.ClosedWonGiftBandDevelopmentVertical' asc, 'Account.Id' asc, 'Opportunity.OpportunityOwner.Name' asc, 'Opportunity.CloseDate');\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Opportunity.Name","Account.AQC_Account_ARCH_ID__c","Account.Name","Opportunity.OpportunityOwner.GiftOfficerTea