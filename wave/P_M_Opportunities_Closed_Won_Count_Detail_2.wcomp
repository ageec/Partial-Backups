Owner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical');\nq = foreach q generate q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam',  q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', 'Opportunity.ClosedWonGiftBandDevelopmentVertical', \nsum(q.'$ - Closed/Won Amount') as '$ - Closed/Won Amount',  \nsum('# - Closed/Won Count') as '# - Closed/Won Count', \navg('Avg. # - Days From Ask Date to Close Date') as 'Avg. # - Days From Ask Date to Close Date',\ngrouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name', grouping(q.'Opportunity.ClosedWonGiftBandDevelopmentVertical') as 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical';\ns = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0 and 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' == 0;\nq = order q by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' asc, 'grouping_Opportunity.ClosedWonGiftBandDevelopmentVertical' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","inte