fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columnSubtotals":false,"columns":["A","ARCH_Metro_Area__c"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fittocontainer","numberOfFrozenColumns":0,"numberOfLines":1,"oddRowColor":"#ffffff","showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Parents_Council_Scho_2":{"broadcastFacet":true,"datasets":[{"name":"Parents"}],"isGlobal":false,"label":"Parents Council School # of Families","query":{"aggregateFilters":[],"columnGroups":["StudentLevel"],"columnTotals":["ChildEducation.AQB__School__c"],"limit":2000,"orders":[{"name":"ChildEducation.AQB__School__c","filters":[],"ascending":true},{"name":"StudentLevel","filters":[],"ascending":true}],"rowTotals":["StudentLevel"],"sourceFilters":{"Parents":{"filters":[["VolunteerPosition.Account.Name",["Parents Council","Parents Council Executive Committee"],"in"],["YoungestChild",[1],"=="]]}},"sources":[{"columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["ChildEducation.AQB__School__c","StudentLevel"],"joins":[],"name":"Parents"}]},"receiveFacetSource":{"mode":"include","steps":["Parents_Council_Togg_1"]},"selectMode":"single","sortable":true,"type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columnTotals":true,"columns":["A","ChildEducation.AQB__School__c","StudentLevel"],"customBulkActions":[],"evenRowColor":"#f2f6fa","fixedColumnWidth":110,"header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"mode":"fixed","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":true,"rowTotals":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"lens_3":{"broadcastFacet":true,"groups":[],"label":"NewProductionTotals","numbers":[],"query":"q = load \"GiftAndPledgeTransactionsExtension\";\nq = filter q by date('ARCHCreditedFiscalYearDate_Year', 'ARCHCreditedFiscalYearDate_Month', 'ARCHCreditedFiscalYearDate_Day') in [\"4 fiscal_years ago\"..\"current fiscal_year\"];\nq = filter q by 'Parents.VolunteerPosition.Account.Name' in [\"Parents Council\", \"Parents Council Executive Committee\"];\nq = filter q by 'Transaction.ARCH_Non_Philanthropic__c' == \"false\";\nq_A = filter q by 'Transaction.ARCH_Classification__c' == \"Pooled\";\nq_C = filter q by 'AnnualFund' == \"true\";\nq_D = filter q by 'Transaction.AQB__Type__c' in [\"Grant Payment\", \"Payment\"];\nq_B = group q by ('Transaction.Name','Parents.StudentLevel', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_B = foreach q_B generate q_B.'Transaction.Name' as 'Transaction.Name', q_B.'Parents.StudentLevel' as 'Parents.StudentLevel', q_B.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_B.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests';\nq_A = group q_A by ('Transaction.Name','Parents.StudentLevel', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_A = foreach q_A generate q_A.'Transaction.Name' as 'Transaction.Name', q_A.'Parents.StudentLevel' as 'Parents.StudentLevel', q_A.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_A.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests';\nq_C = group q_C by ('Transaction.Name','Parents.StudentLevel', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_C = foreach q_C generate q_C.'Transaction.Name' as 'Transaction.Name', q_C.'Parents.StudentLevel' as 'Parents.StudentLevel', q_C.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_C.'NewProductionAmountWithBequests') as 'NewProductionAmountWithBequests';\nq_D = group q_D by ('Transaction.Name','Parents.StudentLevel', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq_D = foreach q_D generate q_D.'Transaction.Name' as 'Transaction.Name', q_D.'Parents.StudentLevel' as 'Parents.StudentLevel', q_D.'ARCHCreditedFiscalYearDate_Year_Fiscal' as 'ARCHCreditedFiscalYearDate_Year_Fiscal', avg(q_D.'Transaction.AQB__Amount__c') as 'Transaction.AQB__Amount__c';\nq = cogroup q by ('Parents.StudentLevel', 'ARCHCreditedFiscalYearDate_Year_Fiscal') full, q_B by ('Parents.StudentLevel', 'ARCHCreditedFiscalYearDate_Year_Fiscal') full, q_A by ('Parents.StudentLevel', 'ARCHCreditedFiscalYearDate_Year_Fiscal') full, q_C by ('Parents.StudentLevel', 'ARCHCreditedFiscalYearDate_Year_Fiscal') full, q_D by ('Parents.StudentLevel', 'ARCHCreditedFiscalYearDate_Year_Fiscal');\nq = foreach q generate coalesce(q.'Parents.StudentLevel', q_B.'Parents.StudentLevel', q_A.'Parents.StudentLevel', q_C.'Parents.StudentLevel', q_D.'Parents.StudentLevel') as 'Class Year', coalesce(q.'ARCHCreditedFiscalYearDate_Year_Fiscal', q_B.'ARCHCreditedFiscalYearDate_Year_Fiscal', q_A.'ARCHCreditedFiscalYearDate_Year_Fiscal', q_C.'ARCHCreditedFiscalYearDate_Year_Fiscal', q_D.'ARCHCreditedFiscalYearDate_Year_Fiscal') as 'Fiscal Year', unique(q.'AccountID') as '# of Families', sum(q_B.'NewProductionAmountWithBequests') as 'New Production w/ Bequests', sum(q_A.'NewProductionAmountWithBequests') as 'New Production w/ Bequests - Pooled Giving', sum(q_C.'NewProductionAmountWithBequests') as 'New Production w/ Bequests - Annual Fund', sum(q_D.'Transaction.AQB__Amount__c') as 'Cash Received';\nq = order q by ('Class Year' asc, 'Fiscal Year' desc);\nq = limit q 2000;","receiveFacetSource":{"mode":"include","steps":["Parents_Council_Togg_1","Parents_Council_Acco_1"]},"selec