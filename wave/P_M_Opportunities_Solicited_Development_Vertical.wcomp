) in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq3 = filter q2 by 'AQB__Classification__c' == \"Number of Opportunities Solicited\";\nq2 = filter q2 by 'AQB__Classification__c' == \"Opportunity Amount Solicited\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed - Funded No Value\", \"Closed Won\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\", \"Negotiation/Review\", \"Proposal Submittal\", \"Solicitation\", \"Solicitation (PG)\"];\nq1 = filter q1 by date('Opportunity.AQC_Date_Asked__c_Year', 'Opportunity.AQC_Date_Asked__c_Month', 'Opportunity.AQC_Date_Asked__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq = cogroup q1 by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name') full, q2 by ('GiftOfficerTeam', 'User.Name') full, q3 by ('GiftOfficerTeam', 'User.Name');\nq = foreach q generate coalesce(q1.'Opportunity.OpportunityOwner.GiftOfficerTeam', q2.'GiftOfficerTeam', q3.'GiftOfficerTeam') as 'Opportunity.OpportunityOwner.GiftOfficerTeam', coalesce(q1.'Opportunity.OpportunityOwner.Name', q2.'User.Name', q3.'User.Name') as 'Opportunity.OpportunityOwner.Name', sum(q1.'Opportunity.AQC_Ask_Amount__c') as 'A', sum(q2.'AQB__GoalCurrencyAmount__c') as 'B', count(q1) as 'C', sum(q3.'AQB__GoalCount__c') as 'D';\nq = foreach q generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'A' as '$ - Solicited Amount', 'B' as '$ - Goal', coalesce(A,0)/B as '$ - % to Goal', 'C' as '# - Solicited Count', 'D' as '# - Goal', coalesce(C,0)/D as '# - % to Goal';\nq = group q by rollup('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name');\nq = foreach q generate q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', sum(q.'$ - Solicited Amount') as '$ - Solicited Amount', sum(q.'$ - Goal') as '$ - Goal', sum(q.'$ - Solicited Amount') / sum(q.'$ - Goal') as '$ - % to Goal', sum('# - Solicited Count') as '# - Solicited Count', sum(q.'# - Goal') as '# - Goal', sum(q.'# - Solicited Count') / sum(q.'# - Goal') as '# - % to Goal', grouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name';\ns = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0;\nq = order q by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Gift_Officer___Solic_4":{"broadcastFacet":false,"groups":[],"label":"Development Vertical $ Solicited by Owner Detail Table","numbers":[],"query":"q = load \"Opportunity_Info\";\nq = filter q by 'Opportunity.StageName' in [\"Closed - Funded No Value\", \"Closed Won\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\", \"Negotiation/Review\", \"Proposal Submittal\", \"Solicitation\", \"Solicitation (PG)\"];\nq = filter q by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq = filter q by date('Opportunity.AQC_Date_Asked__c_Year', 'Opportunity.AQC_Date_Asked__c_Month', 'Opportunity.AQC_Date_Asked__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq = group q by rollup('Opportunity.Name', 'Opportunity.Id', 'Account.AQC_Account_ARCH_ID__c', 'Account.Name', 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.SolictedGiftBandDevelopmentVertical', 'Opportunity.OppRecordType.Name', 'Account.Id', 'Opportunity.OpportunityOwner.Name', 'Opportunity.AQC_Date_Asked__c');\nq = foreach q generate q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', q.'Opportunity.SolictedGiftBandDevelopmentVertical' as 'Opportunity.SolictedGiftBandDevelopmentVertical', q.'Opportunity.OppRecordType.Name' as 'Opportunity.OppRecordType.Name',  q.'Account.AQC_Account_ARCH_ID__c' as 'Account.AQC_Account_ARCH_ID__c', q.'Account.Name' as 'Account.Name',  q.'Account.Id' as 'Account.Id', q.'Opportunity.Name' as 'Opportunity.Name', q.'Opportunity.Id' as 'Opportunity.Id',  q.'Opportunity.AQC_Date_Asked__c' as 'Opportunity.AQC_Date_Asked__c', sum(q.'Opportunity.AQC_Ask_Amount__c') as '$ - Solicited Ask Amount', count(q) as '# - Solicited Count', grouping(q.'Opportunity.Name') as 'grouping_Opportunity.Name', grouping(q.'Opportunity.Id') as 'grouping_Opportunity.Id', grouping(q.'Account.AQC_Account_ARCH_ID__c') as 'grouping_Account.AQC_Account_ARCH_ID__c', grouping(q.'Account.Name') as 'grouping_Account.Name', grouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q.'Opportunity.SolictedGiftBandDevelopmentVertical') as 'grouping_Opportunity.SolictedGiftBandDevelopmentVertical', grouping(q.'Opportunity.OppRecordType.Name') as 'grouping_Opportunity.OppRecordType.Name', grouping(q.'Account.Id') as 'grouping_Account.Id', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name', grouping(q.'Opportunity.AQC_Date_Asked__c') as 'grouping_Opportunity.AQC_Date_Asked__c';\n\ns = filter q by 'grouping_Opportunity.Name' == 1;\nq = filter q by 'grouping_Opportunity.Name' == 0 and 'grouping_Opportunity.Id' == 0 and 'grouping_Account.AQC_Account_ARCH_ID__c' == 0 and 'grouping_Account.Name' == 0 and 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Opportunity.SolictedGiftBandDevelopmentVertical' == 0 and 'grouping_Opportunity.OppRecordType.Name' == 0 and 'grouping_Account.Id' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0 and 'grouping_Opportunity.AQC_Date_Asked__c' == 0;\nq = order q by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' asc, 'Opportunity.SolictedGiftBandDevelopmentVertical' asc, 'Opportunity.OppRecordType.Name' asc,'Account.Name' asc,  'Opportunity.Name' asc,  'Opportunity.AQC_Date_Asked__c');\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Opportunity.OpportunityOwner.GiftOfficerTeam","Opportunity.OpportunityOwner.Name","Opportunity.SolictedGiftBandDevelopmentVertical","Opportunity.OppRecordType.Name","Account.AQC_Account_ARCH_ID__c","Account.Name","Opportunity.Name","Opportunity.AQC_Date_Asked__c","$ - Solicited Ask Amount","# - Solicited Count"],"customBulkActions":[],