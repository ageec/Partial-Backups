sed - Funded No Value\", \"Closed Won\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\", \"Negotiation/Review\", \"Proposal Submittal\", \"Solicitation\", \"Solicitation (PG)\"];\nq1 = filter q1 by date('Opportunity.AQC_Date_Asked__c_Year', 'Opportunity.AQC_Date_Asked__c_Month', 'Opportunity.AQC_Date_Asked__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\n\nq = group q1 by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.SolictedGiftBandDevelopmentVertical', 'Opportunity.OppRecordType.Name');\nq = foreach q generate q1.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q1.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', 'Opportunity.SolictedGiftBandDevelopmentVertical', 'Opportunity.OppRecordType.Name', sum(q1.'Opportunity.AQC_Ask_Amount__c') as 'A',  count(q1) as 'C';\nq = foreach q generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'Opportunity.SolictedGiftBandDevelopmentVertical', 'Opportunity.OppRecordType.Name', 'A' as '$ - Solicted Ask Amount', 'C' as '# - Solicited Count';\n\nq = group q by rollup('Opportunity.SolictedGiftBandDevelopmentVertical');\nq = foreach q generate 'Opportunity.SolictedGiftBandDevelopmentVertical', sum(q.'$ - Solicted Ask Amount') as '$ - Solicted Ask Amount', sum('# - Solicited Count') as '# - Solicited Count', grouping(q.'Opportunity.SolictedGiftBandDevelopmentVertical') as 'grouping_Opportunity.SolictedGiftBandDevelopmentVertical';\n\ns = filter q by 'grouping_Opportunity.SolictedGiftBandDevelopmentVertical' == 1;\n\nq = filter q by 'grouping_Opportunity.SolictedGiftBandDevelopmentVertical' == 0;\nq = order q by ('grouping_Opportunity.SolictedGiftBandDevelopmentVertical' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 200