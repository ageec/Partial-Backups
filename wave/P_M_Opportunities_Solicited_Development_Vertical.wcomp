lkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"PSO___Opportunity_So_1":{"broadcastFacet":false,"groups":[],"label":"PSO $ Opportunity Solicited Summary Table","numbers":[],"query":"q1 = load \"OpportunityDetail\";\nq2 = load \"User_Goal_Info\";\nq1 = filter q1 by 'StageName' in [\"Closed - Funded No Value\", \"Closed Won\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\", \"Negotiation/Review\", \"Proposal Submittal\", \"Solicitation\", \"Solicitation (PG)\"];\nq1 = filter q1 by date('AQC_Date_Asked__c_Year', 'AQC_Date_Asked__c_Month', 'AQC_Date_Asked__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by 'OpportunityTeamMember.GiftOfficerDivision' is not null;\nq1 = filter q1 by ('OppRecordType.Name' != \"Grateful Patients\" || 'OppRecordType.Name' is null);\nq1 = filter q1 by 'AQC_Ask_Amount__c' > 0;\nq2 = filter q2 by date('AQB__LastGoalIntervalDate__c_Year', 'AQB__LastGoalIntervalDate__c_Month', 'AQB__LastGoalIntervalDate__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq2 = filter q2 by 'GiftOfficerDivision' is not null;\nq2_C = filter q2 by 'AQB__Classification__c' == \"Opportunity Amount Solicited\";\nq2_D = filter q2 by 'AQB__Classification__c' == \"Number of Opportunities Solicited\";\nq2 = cogroup q2_C by ('GiftOfficerDivision', 'User.Name') full, q2_D by ('GiftOfficerDivision', 'User.Name');\nq2 = foreach q2 generate coalesce(q2_C.'GiftOfficerDivision', q2_D.'GiftOfficerDivision') as 'GiftOfficerDivision', coalesce(q2_C.'User.Name', q2_D.'User.Name') as 'User.Name', sum(q2_C.'AQB__GoalCurrencyAmount__c') as 'C', sum(q2_D.'AQB__GoalCount__c') as 'D';\nq = cogroup q1 by ('OpportunityTeamMember.GiftOfficerDivision', 'OpportunityTeamMember.Name') full, q2 by ('GiftOfficerDivision', 'User.Name');\nq = foreach q generate coalesce(q1.'OpportunityTeamMember.GiftOfficerDivision', q2.'GiftOfficerDivision') as 'OpportunityTeamMember.GiftOfficerDivision', coalesce(q1.'OpportunityTeamMember.Name', q2.'User.Name') as 'OpportunityTeamMember.Name', sum(q1.'Amount') as '$ - Solicited Amount', first(q2.'C') as '$ - Goal', count(q1) as '# - Solicited Count', first(q2.'D') as '# - Goal';\nq = group q by rollup('OpportunityTeamMember.GiftOfficerDivision', 'OpportunityTeamMember.Name');\nq = foreach q generate q.'OpportunityTeamMember.GiftOfficerDivision' as 'OpportunityTeamMember.GiftOfficerDivision', q.'OpportunityTeamMember.Name' as 'OpportunityTeamMember.Name', sum(q.'$ - Solicited Amount') as '$ - Solicited Amount', sum(q.'$ - Goal') as '$ - Goal', sum(q.'$ - Solicited Amount') / sum(q.'$ - Goal') as '$ - % to Goal', sum(q.'# - Solicited Count') as '# - Solicited Count', sum(q.'# - Goal') as '# - Goal', sum(q.'# - Solicited Count') / sum(q.'# - Goal')  as '# - % to Goal', grouping(q.'OpportunityTeamMember.GiftOfficerDivision') as 'grouping_OpportunityTeamMember.GiftOfficerDivision', grouping(q.'OpportunityTeamMember.Name') as 'grouping_OpportunityTeamMember.Name';\ns = filter q by 'grouping_OpportunityTeamMember.GiftOfficerDivision' == 1 and 'grouping_OpportunityTeamMember.Name' == 1;\nq = filter q by 'grouping_OpportunityTeamMember.GiftOfficerDivision' == 0 and 'grouping_OpportunityTeamMember.Name' == 0;\nq = order q by ('OpportunityTeamMember.GiftOfficerDivision' asc, 'OpportunityTeamMember.Name' asc);\nq = limit q 20000;\nq = union q, s;\nq = limit q 20001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":false,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Med_GO___Solicited_S_1":{"broadcastFacet":false,"groups":[],"label":"Med GO $ Solicited Summary Table","numbers":[],"query":"q1 = load \"Opportunity_Info\";\nq2 = load \"User_Goal_Info\";\nq2 = filter q2 by date('AQB__LastGoalIntervalDate__c_Year', 'AQB__LastGoalIntervalDate__c_Month', 'AQB__LastGoalIntervalDate__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq2 = filter q2 by 'GiftOfficerTeam' in [\"Corporate Rel\", \"Foundation Rel\", \"IG Central\", \"IG East\", \"IG Missouri\", \"IG West\", \"International\", \"PG\"];\nq3 = filter q2 by 'AQB__Classification__c' == \"Number of Opportunities Solicited\";\nq2 = filter q2 by 'AQB__Classification__c' == \"Opportunity Amount Solicited\";\nq1 = filter q1 by 'Opportunity.StageName' in [\"Closed - Funded No Value\", \"Closed Won\", \"Closed/Lost\", \"Closed/Won\", \"Closed/Won - No Value\", \"LOI/Concept Paper Submittal\", \"Negotiation/Review\", \"Proposal Preparation\", \"Proposal Submittal\", \"Solicitation\", \"Solicitation (PG)\"];\nq1 = filter q1 by date('Opportunity.AQC_Date_Asked__c_Year', 'Opportunity.AQC_Date_Asked__c_Month', 'Opportunity.AQC_Date_Asked__c_Day') in [\"[[parameter_2]]\"..\"[[parameter_2]]\"];\nq1 = filter q1 by ('Opportunity.OppRecordType.Name' != \"Grateful Patients\" || 'Opportunity.OppRecordType.Name' is null);\nq = cogroup q1 by ('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name') full, q2 by ('GiftOfficerTeam', 'User.Name') full, q3 by ('GiftOfficerTeam', 'User.Name');\nq = foreach q generate coalesce(q1.'Opportunity.OpportunityOwner.GiftOfficerTeam', q2.'GiftOfficerTeam') as 'Opportunity.OpportunityOwner.GiftOfficerTeam', coalesce(q1.'Opportunity.OpportunityOwner.Name', q2.'User.Name') as 'Opportunity.OpportunityOwner.Name', sum(q1.'Opportunity.AQC_Ask_Amount__c') as 'A', sum(q2.'AQB__GoalCurrencyAmount__c') as 'B', count(q1) as 'C', sum(q3.'AQB__GoalCount__c') as 'D';\nq = foreach q generate 'Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name', 'A' as '$ - Solicited Amount', 'B' as '$ - Goal', coalesce(A,0)/B as '$ - % to Goal', 'C' as '# - Solicited Count', 'D' as '# - Goal', coalesce(C,0)/D as '# - % to Goal';\nq = group q by rollup('Opportunity.OpportunityOwner.GiftOfficerTeam', 'Opportunity.OpportunityOwner.Name');\nq = foreach q generate q.'Opportunity.OpportunityOwner.GiftOfficerTeam' as 'Opportunity.OpportunityOwner.GiftOfficerTeam', q.'Opportunity.OpportunityOwner.Name' as 'Opportunity.OpportunityOwner.Name', sum(q.'$ - Solicited Amount') as '$ - Solicited Amount', sum(q.'$ - Goal') as '$ - Goal', sum(q.'$ - Solicited Amount') / sum(q.'$ - Goal') as '$ - % to Goal', sum('# - Solicited Count') as '# - Solicited Count', sum(q.'# - Goal') as '# - Goal', sum(q.'# - Solicited Count') / sum(q.'# - Goal') as '# - % to Goal', grouping(q.'Opportunity.OpportunityOwner.GiftOfficerTeam') as 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam', grouping(q.'Opportunity.OpportunityOwner.Name') as 'grouping_Opportunity.OpportunityOwner.Name';\ns = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 1;\nq = filter q by 'grouping_Opportunity.OpportunityOwner.GiftOfficerTeam' == 0 and 'grouping_Opportunity.OpportunityOwner.Name' == 0;\nq = order q by ('Opportunity.OpportunityOwner.GiftOfficerTeam' asc, 'Opportunity.OpportunityOwner.Name' asc);\nq = limit q 2000;\nq = union q, s;\nq = limit q 2001;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"rgb(217, 217, 214)","fontColor":"#091A3E","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","interactions":[],"maxColumnWidth":225,"minColumnWidth":100,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}}},"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#747474","borderEdges":[],"borderRadius":0,"borderWidth":1,"tooltipStyle":{"backgroundColor":"#16325c","labelColor":"#9faab5","valueColor":"#ffffff"}},"widgets":{"text_1":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ba0c2f","size":"12px"},"insert":"Clear Selections"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[{"actions":[{"resetType":"resetfilters","type":"reset"}],"event":"click"}],"showActionMenu":true},"type":"text"},"text_10":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"12px"},"insert":"Opportunities Solicited by Gift Band"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[{"actions":[{"destinationLink":{"name":"8b202fbd-76b4-407e-b9f0-fc805f3013be"},"destinationType":"page","type":"navigate"}],"event":"click"}],"showActionMenu":true},"type":"text"},"text_12":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"12px","color":"#ffffff"},"insert":"Opportunities Solicited Detail"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[{"actions":[